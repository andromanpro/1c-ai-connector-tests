#Область ПрограммныйИнтерфейс

// Регистрирует проверки публичных контрактов индекса, текстовых каналов и диаграмм.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Контракты возврата ИИконы")
		.ДобавитьСерверныйТест("ДиаграммаSVG_ТолькоПолеВыбранногоФормата").ВТранзакции()
		.ДобавитьСерверныйТест("ДиаграммаPNG_ТолькоПолеВыбранногоФормата").ВТранзакции()
		.ДобавитьСерверныйТест("ДиаграммаОшибка_БезПолейИзображения").ВТранзакции()
		.ДобавитьСерверныйТест("ТекстКанала_Выключен_СтрокаСохранена").ВТранзакции()
		.ДобавитьСерверныйТест("ТекстКанала_Маскировка_ИсходныхДанныхНет").ВТранзакции()
		.ДобавитьСерверныйТест("ТекстКанала_Блокировка_ОтказСохранен").ВТранзакции()
		.ДобавитьСерверныйТест("Индекс_ПустаяСсылка_ПолныйКонтракт").ВТранзакции()
		.ДобавитьСерверныйТест("Индекс_НесуществующаяСсылка_ПолныйКонтракт").ВТранзакции()
		.ДобавитьСерверныйТест("Индекс_ЗаписаннаяБаза_СовпадаетСПакетным").ВТранзакции()
		.ДобавитьСерверныйТест("Индекс_РезультатыНезависимы").ВТранзакции();

КонецПроцедуры

// Проверяет существующий вариант ответа SVG, включая отсутствие полей других вариантов.
Процедура ДиаграммаSVG_ТолькоПолеВыбранногоФормата() Экспорт

	ПодготовитьЛокальныйРендер();
	Ответ = КИИ_СерверMCPИнструментДиаграмма.ВыполнитьИнструмент("generate_diagram",
		Новый Структура("kind, code, format", "mermaid", "graph TD; A-->B", "svg"));
	ПроверитьОбщиеПоляДиаграммы(Ответ, Истина, "svg");
	ЮТест.ОжидаетЧто(Ответ.svg).Содержит("fixture-diagram");
	ЮТест.ОжидаетЧто(Ответ.Свойство("png_base64")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.Свойство("error")).Равно(Ложь);

КонецПроцедуры

// Проверяет PNG и отсутствие пустого SVG, которое могло бы изменить контракт MCP.
Процедура ДиаграммаPNG_ТолькоПолеВыбранногоФормата() Экспорт

	ПодготовитьЛокальныйРендер();
	Ответ = КИИ_СерверMCPИнструментДиаграмма.ВыполнитьИнструмент("generate_diagram",
		Новый Структура("kind, code, format", "mermaid", "graph TD; A-->B", "png"));
	ПроверитьОбщиеПоляДиаграммы(Ответ, Истина, "png");
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.png_base64)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Ответ.png_base64, "iVBORw0KGgo")).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.Свойство("svg")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.Свойство("error")).Равно(Ложь);

КонецПроцедуры

// Проверяет отказ рендера: ошибка остается отдельным вариантом результата.
Процедура ДиаграммаОшибка_БезПолейИзображения() Экспорт

	ПодготовитьЛокальныйРендер();
	Ответ = КИИ_СерверMCPИнструментДиаграмма.ВыполнитьИнструмент("generate_diagram",
		Новый Структура("kind, code, format", "mermaid", "fixture-error", "svg"));
	ПроверитьОбщиеПоляДиаграммы(Ответ, Ложь, "svg");
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.error)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ответ.error)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.Свойство("svg")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.Свойство("png_base64")).Равно(Ложь);

КонецПроцедуры

// Проверяет сохранение исходного текста в разрешенном канале без контроля.
Процедура ТекстКанала_Выключен_СтрокаСохранена() Экспорт

	ПодготовитьКонтрольТекста(Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен);
	Текст = "Контракт ""строки""" + Символы.ПС + "Вторая строка.";
	Ответ = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
		КИИ_КонтрольПерсональныхДанных.КаналУведомленияТелеграм(), Текст);
	ПроверитьКонтрактТекста(Ответ);
	ЮТест.ОжидаетЧто(Ответ.Разрешено).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.Текст).Равно(Текст);

КонецПроцедуры

// Проверяет, что типизация текста не возвращает исходное значение вместо подстановки.
Процедура ТекстКанала_Маскировка_ИсходныхДанныхНет() Экспорт

	ПодготовитьКонтрольТекста(Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Маскировать);
	Ответ = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
		КИИ_КонтрольПерсональныхДанных.КаналУведомленияТелеграм(), "ИНН 7707083893");
	ПроверитьКонтрактТекста(Ответ);
	ЮТест.ОжидаетЧто(Ответ.Разрешено).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.Решение).Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Ответ.Текст).НеСодержит("7707083893");

КонецПроцедуры

// Проверяет, что приведение типа не разрешает отправку заблокированного текста.
Процедура ТекстКанала_Блокировка_ОтказСохранен() Экспорт

	ПодготовитьКонтрольТекста(Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Блокировать);
	Ответ = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
		КИИ_КонтрольПерсональныхДанных.КаналУведомленияТелеграм(), "ИНН 7707083893");
	ПроверитьКонтрактТекста(Ответ);
	ЮТест.ОжидаетЧто(Ответ.Разрешено).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ответ.КодОтказа)).Равно(Ложь);

КонецПроцедуры

// Проверяет полный результат при отсутствии выбранной базы.
Процедура Индекс_ПустаяСсылка_ПолныйКонтракт() Экспорт

	Ответ = КИИ_RAG.СведенияОбИндексеБазы(Справочники.КИИ_БазаЗнаний.ПустаяСсылка());
	ПроверитьКонтрактИндекса(Ответ);
	ЮТест.ОжидаетЧто(Ответ.Всего).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.ЕстьТекст).Равно(Ложь);

КонецПроцедуры

// Проверяет ветвь, когда заполненная ссылка отсутствует в результатах пакетного чтения.
Процедура Индекс_НесуществующаяСсылка_ПолныйКонтракт() Экспорт

	База = Справочники.КИИ_БазаЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Ответ = КИИ_RAG.СведенияОбИндексеБазы(База);
	ПроверитьКонтрактИндекса(Ответ);
	ЮТест.ОжидаетЧто(Ответ.Всего).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.ЕстьТекст).Равно(Ложь);

КонецПроцедуры

// Проверяет согласованность одиночного и пакетного API на настоящей записанной базе.
Процедура Индекс_ЗаписаннаяБаза_СовпадаетСПакетным() Экспорт

	Объект = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
	Объект.Наименование = "ЮТ контракт состояния индекса";
	Объект.Содержимое = "Текст записан, фрагментов индекса еще нет.";
	Объект.Записать();
	Базы = Новый Массив;
	Базы.Добавить(Объект.Ссылка);
	Пакетный = КИИ_RAG.СведенияОбИндексахБаз(Базы).Получить(Объект.Ссылка);
	Одиночный = КИИ_RAG.СведенияОбИндексеБазы(Объект.Ссылка);
	ПроверитьКонтрактИндекса(Одиночный);
	Для Каждого Поле Из Пакетный Цикл
		Если Поле.Ключ <> "ГотовыеФрагменты" Тогда
			ЮТест.ОжидаетЧто(Одиночный[Поле.Ключ], Поле.Ключ).Равно(Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Одиночный.ГотовыеФрагменты.Количество()).Равно(Пакетный.ГотовыеФрагменты.Количество());

КонецПроцедуры

// Проверяет независимость изменяемого массива двух результатов, в том числе пустого индекса.
Процедура Индекс_РезультатыНезависимы() Экспорт

	Ссылка = Справочники.КИИ_БазаЗнаний.ПустаяСсылка();
	Первый = КИИ_RAG.СведенияОбИндексеБазы(Ссылка);
	Первый.ГотовыеФрагменты.Добавить(Справочники.КИИ_ФрагментыЗнаний.ПустаяСсылка());
	Второй = КИИ_RAG.СведенияОбИндексеБазы(Ссылка);
	ЮТест.ОжидаетЧто(Второй.ГотовыеФрагменты.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьЛокальныйРендер()

	Константы.КИИ_АдресСервераKroki.Установить("http://localhost:8872");
	Константы.КИИ_РендерДиаграммДоверенный.Установить(Истина);
	Константы.КИИ_АдресСервисаРаспознаванияИмен.Установить("");

КонецПроцедуры

Процедура ПодготовитьКонтрольТекста(Знач Режим)

	Константы.КИИ_РежимКонтроляУведомленийТелеграм.Установить(Режим);
	Константы.КИИ_АдресСервисаРаспознаванияИмен.Установить("");
	Константы.КИИ_СервисРаспознаванияИменОбязателен.Установить(Ложь);
	Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Установить("");

КонецПроцедуры

Процедура ПроверитьОбщиеПоляДиаграммы(Знач Ответ, Знач Успех, Знач Формат)

	ЮТест.ОжидаетЧто(ТипЗнч(Ответ)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Ответ.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Ответ.success).Равно(Успех);
	ЮТест.ОжидаетЧто(Ответ.kind).Равно("mermaid");
	ЮТест.ОжидаетЧто(Ответ.format).Равно(Формат);

КонецПроцедуры

Процедура ПроверитьКонтрактТекста(Знач Ответ)

	ЮТест.ОжидаетЧто(Ответ.Количество()).Равно(6);
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Разрешено)).Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Текст)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Решение)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.КодОтказа)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ТекстОтказа)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Контекст)).Равно(Тип("Структура"));

КонецПроцедуры

Процедура ПроверитьКонтрактИндекса(Знач Ответ)

	ЮТест.ОжидаетЧто(Ответ.Количество()).Равно(8);
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Всего)).Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Готово)).Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ТекстИзменился)).Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ДатаЭмбеддинга)).Равно(Тип("Дата"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ГотовыеФрагменты)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ЕстьТекст)).Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.ЗапрещеноПолитикой)).Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(Ответ.Свойство("Модель")).Равно(Истина);

КонецПроцедуры

#КонецОбласти
