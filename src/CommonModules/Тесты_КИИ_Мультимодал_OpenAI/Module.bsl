			.ДобавитьСерверныйТест("Мультимодал_МассивТекстИURL_ContentСодержитImageUrl")
			.ДобавитьСерверныйТест("Мультимодал_МассивТекстИБинарник_DataUriBase64БезПереводов")
			.ДобавитьСерверныйТест("Мультимодал_БинарникБезMIME_Исключение")
			.ДобавитьСерверныйТест("Мультимодал_AnthropicСИзображением_URLБлок")
			.ДобавитьСерверныйТест("Мультимодал_YandexСИзображением_Исключение")
			.ДобавитьСерверныйТест("Мультимодал_ДокументКакТекстовыйКонтент")
