Процедура Мультимодал_ОтветНаВложение_ЕслиМодельНастроена() Экспорт
	
	Модель = ПерваяМультимодальнаяМодель();
	Если Не ЗначениеЗаполнено(Модель) Тогда
		ЮТест.Пропустить(НСтр("ru = 'Нет настроенной OpenAI-совместимой модели в тестовой базе — e2e ответ на вложение не проверяется'"));
		Возврат;
	КонецЕсли;
	
	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("Что на картинке? Ответь одним словом."));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанныеДляТеста(), "image/png"));
	Промпт = Новый Структура("ПользовательскийПромпт", Контент);
	Результат = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Промпт);
	Если Результат.ЭтоОшибка Тогда
		ЮТест.Пропустить(СтрШаблон(
			НСтр("ru = 'e2e ответ на вложение не проверен: модель в тест-базе недоступна для живого вызова (%1)'"),
			Результат.ТекстОшибки));
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.ТекстОтвета), "Пустой ТекстОтвета").Равно(Истина);
	
КонецПроцедуры

Функция ПерваяМультимодальнаяМодель()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КИИ_МоделиИИ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КИИ_МоделиИИ КАК КИИ_МоделиИИ
		|ГДЕ
		|	КИИ_МоделиИИ.ТипФорматаAPI = &ТипФормата
		|	И НЕ КИИ_МоделиИИ.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТипФормата", Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

