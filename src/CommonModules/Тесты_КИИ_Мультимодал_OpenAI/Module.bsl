Функция БазоваяСтруктураПараметров()
	
	П = Новый Структура;
	П.Вставить("Адрес", "");
	П.Вставить("АдресЗапроса", "");
	П.Вставить("ИспользоватьЗащищенноеСоединение", Истина);
	П.Вставить("ТипФорматаAPI", Неопределено);
	П.Вставить("ТипАвторизации", Неопределено);
	П.Вставить("НаименованиеПровайдера", "");
	П.Вставить("НаименованиеПолное", "");
	П.Вставить("Температура", 0.7);
	П.Вставить("МаксимумТокенов", 1000);
	П.Вставить("Таймаут", 30);
	П.Вставить("Заголовки", Новый Массив);
	Возврат П;
	
КонецФункции

Функция ПараметрыOpenAI()
	
	П = БазоваяСтруктураПараметров();
	П.Адрес = "api.openai.com";
	П.АдресЗапроса = "/v1/chat/completions";
	П.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	П.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	П.НаименованиеПровайдера = "OpenAI";
	П.НаименованиеПолное = "gpt-4o-mini";
	Возврат П;
	
КонецФункции

Функция ПараметрыAnthropic()
	
	П = БазоваяСтруктураПараметров();
