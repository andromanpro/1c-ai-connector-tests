Процедура Мультимодал_GeminiInlineDataКартинка() Экспорт
	
	Base64Картинки = Base64Строка(ДвоичныеДанныеДляТеста());
	Части = Новый Массив;
	Части.Добавить(Новый Структура("text", "опис"));
	Части.Добавить(Новый Структура("inlineData", Новый Структура("mimeType, data", "image/png", Base64Картинки)));
	Части.Добавить(Новый Структура("text", " хвост"));
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Новый Структура("content", Новый Структура("parts", Части)));
	ОтветJSON = Новый Структура("candidates", Кандидаты);
	
	Результат = КИИ_КоннекторИИ.РазобратьОтветДляТестов(ПараметрыGoogle(), ОтветJSON);
	
	ЮТест.ОжидаетЧто(Результат.ТекстОтвета).Равно("опис хвост");
	ЮТест.ОжидаетЧто(Результат.ВложенияОтвета.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ВложенияОтвета[0].Тип).Равно("image");
	ЮТест.ОжидаетЧто(Результат.ВложенияОтвета[0].MIME).Равно("image/png");
	
КонецПроцедуры

Процедура Мультимодал_OpenAIImageGenОтвет() Экспорт
	
	МассивData = Новый Массив;
	МассивData.Добавить(Новый Структура("b64_json", Base64Строка(ДвоичныеДанныеДляТеста())));
