Процедура Мультимодал_МассивТекстИБинарник_DataUriBase64БезПереводов() Экспорт
	
	ИсхДанные = ДвоичныеДанныеДляТеста();
	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("опиши"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ИсхДанные, "image/png"));
	Промпт = Новый Структура("ПользовательскийПромпт", Контент);
	
	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыOpenAI(), Промпт);
	
	URL = Результат.ТелоЗапроса.messages[0]["content"][1]["image_url"]["url"];
	Префикс = "data:image/png;base64,";
	ЮТест.ОжидаетЧто(Лев(URL, СтрДлина(Префикс))).Равно(Префикс);
	ЮТест.ОжидаетЧто(СтрНайти(URL, Символы.ПС)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(URL, Символы.ВК)).Равно(0);
	
	ОжидаемыйBase64 = Base64Строка(ИсхДанные);
	ОжидаемыйBase64 = СтрЗаменить(ОжидаемыйBase64, Символы.ПС, "");
	ОжидаемыйBase64 = СтрЗаменить(ОжидаемыйBase64, Символы.ВК, "");
	ФактическийBase64 = Сред(URL, СтрДлина(Префикс) + 1);
	ЮТест.ОжидаетЧто(ФактическийBase64).Равно(ОжидаемыйBase64);
	
КонецПроцедуры

