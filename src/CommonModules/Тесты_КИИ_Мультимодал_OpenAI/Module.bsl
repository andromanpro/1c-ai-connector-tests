#Область СлужебныеПроцедурыИФункции

Процедура ЛичнаяПодписка_СменаАдресаТребуетНовогоСогласия() Экспорт

	СсылкаМодели = МодельЛичнойПодпискиДляКеша();
	КИИ_КоннекторИИ.СохранитьЛичныйКодПодписки(СсылкаМодели, "temporary-route-code");
	Модель = СсылкаМодели.ПолучитьОбъект();
	Модель.Адрес = "127.0.0.1:1";
	Модель.Записать();
	Ответ = КИИ_КоннекторИИ.ЗапросКМодели(СсылкаМодели, "Проверка смены адреса");
	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.ИсходЗапроса).Равно("НеОтправлен");
	ЮТест.ОжидаетЧто(СтрНайти(Ответ.ТекстОшибки, "Параметры личного подключения изменились") > 0).Равно(Истина);

КонецПроцедуры

Процедура ЛичнаяПодписка_ДваОбычныхПользователя() Экспорт

	Описание = ХранилищеОбщихНастроек.Загрузить("КИИ_ЛичныеПодпискиТест", "Фикстура");
	Если Описание = Неопределено Тогда
		ЮТест.Пропустить("Нужен отдельный прогон под двумя обычными пользователями БСП.");
	КонецЕсли;
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	ЮТест.ОжидаетЧто(РольДоступна("ПолныеПрава")).Равно(Ложь);
	ЮТест.ОжидаетЧто(РольДоступна("АдминистраторСистемы")).Равно(Ложь);
	ЮТест.ОжидаетЧто(РольДоступна("КИИ_ПолныеПрава")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Строка(Пользователи.ТекущийПользователь().УникальныйИдентификатор()))
		.Равно(Описание.Пользователь);
	Модель = Справочники.КИИ_МоделиИИ.ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.Модель));
	Если Описание.Шаг = "changed-route" Тогда
		Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Описание.Промпт);
		ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Истина);
		ЮТест.ОжидаетЧто(Ответ.ИсходЗапроса).Равно("НеОтправлен");
		ЮТест.ОжидаетЧто(СтрНайти(Ответ.ТекстОшибки, "Параметры личного подключения изменились") > 0).Равно(Истина);
		Возврат;
	КонецЕсли;
	Если Описание.Шаг = "second" Тогда
		Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Описание.Промпт);
		ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Истина);
		ЮТест.ОжидаетЧто(СтрНайти(Ответ.ТекстОшибки, "личное подключение") > 0).Равно(Истина);
		ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно("");
	КонецЕсли;
	Если Описание.Шаг <> "final" Тогда
		КИИ_КоннекторИИ.СохранитьЛичныйКодПодписки(Модель, Описание.Код);
	КонецЕсли;
	Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Описание.Промпт);
	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно(Описание.Ответ);
	Если Описание.Шаг <> "first" Тогда
		КИИ_КоннекторИИ.УдалитьЛичныйКодПодписки(Модель);
		Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Описание.Промпт);
		ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Истина);
		ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно("");
	КонецЕсли;

КонецПроцедуры

Процедура ЛичнаяПодписка_НеКешируетОтвет() Экспорт

	Модель = МодельЛичнойПодпискиДляКеша();
	Параметры = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	Промпт = Новый Структура("СистемныйПромпт, ПользовательскийПромпт, ИсторияСообщений",
		"", "Одинаковый запрос разных пользователей", Новый Массив);
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИ.КешироватьЗапрос(Параметры, Промпт)).Равно(Ложь);
	Хеш = Строка(Новый УникальныйИдентификатор);
	Ответ = Новый Структура("ЭтоОшибка, ТекстОтвета", Ложь, "Личный ответ");
	КИИ_КоннекторИИ.СохранитьВКеш(Хеш, Модель, Параметры, Ответ);
	ЗаписьКеша = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьМенеджерЗаписи();
	ЗаписьКеша.ХешЗапроса = Хеш;
	ЗаписьКеша.Прочитать();
	ЮТест.ОжидаетЧто(ЗаписьКеша.Выбран()).Равно(Ложь);

КонецПроцедуры

Процедура ЛичнаяПодписка_НеЧитаетСтарыйКешБезВхода() Экспорт

	Модель = МодельЛичнойПодпискиДляКеша();
	Параметры = КИИ_КоннекторИИ.ПараметрыМодели(Модель);
	Промпт = Новый Структура("СистемныйПромпт, ПользовательскийПромпт, ИсторияСообщений",
		"", "Чужой ответ из старого кеша", Новый Массив);
	Хеш = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры);
	ЗаписьКеша = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьМенеджерЗаписи();
	ЗаписьКеша.ХешЗапроса = Хеш;
	ЗаписьКеша.Модель = Модель;
	ЗаписьКеша.Ответ = Новый ХранилищеЗначения(
		Новый Структура("ЭтоОшибка, ТекстОтвета", Ложь, "Ответ другого владельца"));
	ЗаписьКеша.ВерсияСхемыКеша = Параметры.ВерсияСхемыКеша;
	ЗаписьКеша.ДатаДо = ТекущаяДатаСеанса() + 3600;
	ЗаписьКеша.Записать();
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИ.ПолучитьИзКеша(
		Хеш, Модель, Параметры.ВерсияСхемыКеша)).Равно(Неопределено);
	Ответ = КИИ_КоннекторИИ.ЗапросКМодели(Модель, Промпт);
	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Ответ.ТекстОшибки, "личное подключение") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно("");

КонецПроцедуры

Функция МодельЛичнойПодпискиДляКеша()

	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "Личная подписка - изоляция кеша";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.ЛичнаяПодписка;
	Модель.Температура = 0;
	Модель.СрокЖизниКеша = 3600;
	Модель.ВерсияСхемыКеша = 1;
	Модель.Записать();
	Возврат Модель.Ссылка;

КонецФункции

Процедура ЛичнаяПодписка_СохраняетИУдаляетСекретВБСП() Экспорт

	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "Личный код - проверка БСП";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.ЛичнаяПодписка;
	Модель.Записать();
	КИИ_КоннекторИИ.СохранитьЛичныйКодПодписки(Модель.Ссылка, "temporary-unit-code");
	Владелец = Пользователи.ТекущийПользователь();
	ИдентификаторМодели = СтрЗаменить(Строка(Модель.Ссылка.УникальныйИдентификатор()), "-", "");
	КлючХранилища = СтрШаблон("КИИ_Подписка_%1", ИдентификаторМодели);
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		СохраненныйКод = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, КлючХранилища);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	ЮТест.ОжидаетЧто(СохраненныйКод.Код).Равно("temporary-unit-code");
	ЮТест.ОжидаетЧто(ПустаяСтрока(СохраненныйКод.Маршрут)).Равно(Ложь);
	КИИ_КоннекторИИ.УдалитьЛичныйКодПодписки(Модель.Ссылка);
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		СохраненныйКод = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, КлючХранилища);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	ЮТест.ОжидаетЧто(СохраненныйКод).Равно(Неопределено);

КонецПроцедуры

Процедура ЛичнаяПодписка_ТолькоЗаданныйТекст() Экспорт

	Параметры = ПараметрыOpenAI();
	Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.ЛичнаяПодписка;
	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Проверочный текст");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["role"]).Равно("user");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["content"]).Равно("Проверочный текст");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.Свойство("tools")).ЭтоЛожь();

КонецПроцедуры

Процедура ЛичнаяПодписка_ВызовИнструментаСохраняется() Экспорт

	Параметры = ПараметрыOpenAI();
	Параметры.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.ЛичнаяПодписка;
	ОписаниеФункции = Новый Структура("name, arguments", "list_metadata", "{""database_id"":""training""}");
	Вызов = Новый Структура("id, type, function", "call-personal", "function", ОписаниеФункции);
	Вызовы = Новый Массив;
	Вызовы.Добавить(Вызов);
	Сообщение = Новый Структура("role, content, tool_calls", "assistant", Неопределено, Вызовы);
	Выбор = Новый Структура("index, message, finish_reason", 0, Сообщение, "tool_calls");
	Выборы = Новый Массив;
	Выборы.Добавить(Выбор);
	Ответ = Новый Структура("id, model, choices", "resp-personal", "test-model", Выборы);
	Результат = КИИ_КоннекторИИ.РазобратьОтветДляТестов(Параметры, Ответ);
	ЮТест.ОжидаетЧто(Результат.ВызовыИнструментов.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ВызовыИнструментов[0].Идентификатор).Равно("call-personal");
	ЮТест.ОжидаетЧто(Результат.ВызовыИнструментов[0].Имя).Равно("list_metadata");
	ЮТест.ОжидаетЧто(Результат.ПричинаЗавершения).Равно("tool_calls");

КонецПроцедуры

#Область Фабрики

Функция БазоваяСтруктураПараметров()
	
	П = Новый Структура;
	П.Вставить("Адрес", "");
	П.Вставить("АдресЗапроса", "");
	П.Вставить("ИспользоватьЗащищенноеСоединение", Истина);
	П.Вставить("ТипФорматаAPI", Неопределено);
	П.Вставить("ТипАвторизации", Неопределено);
	П.Вставить("НаименованиеПровайдера", "");
	П.Вставить("НаименованиеПолное", "");
	П.Вставить("Температура", 0.7);
	П.Вставить("МаксимумТокенов", 1000);
	П.Вставить("Таймаут", 30);
	П.Вставить("Заголовки", Новый Массив);
	Возврат П;
	
КонецФункции

Функция ПараметрыOpenAI()
	
	П = БазоваяСтруктураПараметров();
	П.Адрес = "api.openai.com";
	П.АдресЗапроса = "/v1/chat/completions";
	П.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	П.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	П.НаименованиеПровайдера = "OpenAI";
	П.НаименованиеПолное = "gpt-4o-mini";
	Возврат П;
	
КонецФункции

