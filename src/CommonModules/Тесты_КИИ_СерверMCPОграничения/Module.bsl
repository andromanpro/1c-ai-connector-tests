	ЮТест.ОжидаетЧто(Результат.user).Равно("alice");

КонецПроцедуры

// Аутентифицированный запрос → ключ бакета per-user (по имени пользователя).
Процедура КлючОграничения_Аутентифицированный_PerUser() Экспорт

	РезультатAuth = Новый Структура("Авторизован, Пользователь", Истина, "alice");

	Ключ = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(РезультатAuth);

	ЮТест.ОжидаетЧто(Ключ).Равно("user:alice");

КонецПроцедуры

// Неаутентифицированный запрос → единый глобальный ключ (не заявленный идентификатор).
Процедура КлючОграничения_Неаутентифицированный_Глобальный() Экспорт

	РезультатAuth = Новый Структура("Авторизован, Пользователь", Ложь, "attacker");

	Ключ = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(РезультатAuth);

	ЮТест.ОжидаетЧто(Ключ).Равно("anon:global");

КонецПроцедуры

// Обход лимита закрыт: ротация заявленного username при проваленной auth НЕ даёт
// разные бакеты - все неаутентифицированные попытки ключуются одним глобальным ключом.
Процедура КлючОграничения_РотацияUsername_НеДаётСвежийБакет() Экспорт

	ПерваяПопытка = Новый Структура("Авторизован, Пользователь", Ложь, "user-001");
	ВтораяПопытка = Новый Структура("Авторизован, Пользователь", Ложь, "user-002");

	КлючПервый = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПерваяПопытка);
	КлючВторой = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ВтораяПопытка);

	ЮТест.ОжидаетЧто(КлючПервый).Равно(КлючВторой);

КонецПроцедуры

// НЕГАТИВНЫЙ E2E: обход лимита закрыт. Ротация заявленного username при проваленной
// auth НЕ даёт свежий бакет — второй «атакующий» ключуется тем же anon:global и,
// когда бакет исчерпан первым, тоже отклоняется.
Процедура КлючОграничения_РотацияНеОбходитЛимит_E2E() Экспорт

	ПопыткаA = Новый Структура("Авторизован, Пользователь", Ложь, "attacker-A");
	ПопыткаB = Новый Структура("Авторизован, Пользователь", Ложь, "attacker-B");

	КлючA = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПопыткаA);
	КлючB = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПопыткаB);

	Попытка

		Для Индекс = 1 По 60 Цикл
			КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(КлючA);
		КонецЦикла;

		ПроверкаB = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(КлючB);
		ЮТест.ОжидаетЧто(ПроверкаB.Разрешено).Равно(Ложь);

	Исключение
		ОчиститьОграниченияВызывающего(КлючA);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьОграниченияВызывающего(КлючA);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УникальныйВызывающий()
	
	Возврат "test-" + Строка(Новый УникальныйИдентификатор);
	
КонецФункции

Процедура ОчиститьОграниченияВызывающего(Знач Вызывающий)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ограничения.КодМинуты КАК КодМинуты
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК Ограничения
	|ГДЕ
	|	Ограничения.Вызывающий = &Вызывающий";
	
	Запрос.УстановитьПараметр("Вызывающий", Вызывающий);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Вызывающий.Установить(Вызывающий);
		НаборЗаписей.Отбор.КодМинуты.Установить(Выборка.КодМинуты);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
