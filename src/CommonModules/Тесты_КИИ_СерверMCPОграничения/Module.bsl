// Обход лимита закрыт: ротация заявленного username при проваленной auth НЕ дает
// разные бакеты - все неаутентифицированные попытки ключуются одним глобальным ключом.
Процедура КлючОграничения_РотацияUsername_НеДаетСвежийБакет() Экспорт

	ПерваяПопытка = Новый Структура("Авторизован, Пользователь", Ложь, "user-001");
	ВтораяПопытка = Новый Структура("Авторизован, Пользователь", Ложь, "user-002");

	КлючПервый = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПерваяПопытка);
	КлючВторой = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ВтораяПопытка);

	ЮТест.ОжидаетЧто(КлючПервый).Равно(КлючВторой);

КонецПроцедуры

// НЕГАТИВНЫЙ E2E: обход лимита закрыт. Ротация заявленного username при проваленной
// auth НЕ дает свежий бакет — второй «атакующий» ключуется тем же anon:global и,
// когда бакет исчерпан первым, тоже отклоняется.
Процедура КлючОграничения_РотацияНеОбходитЛимит_E2E() Экспорт

	ПопыткаA = Новый Структура("Авторизован, Пользователь", Ложь, "attacker-A");
	ПопыткаB = Новый Структура("Авторизован, Пользователь", Ложь, "attacker-B");

	КлючA = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПопыткаA);
	КлючB = КИИ_СерверMCPОграничения.ПолучитьКлючОграничения(ПопыткаB);

	Попытка

		Для Индекс = 1 По 60 Цикл
			КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(КлючA);
		КонецЦикла;

		ПроверкаB = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(КлючB);
		ЮТест.ОжидаетЧто(ПроверкаB.Разрешено).Равно(Ложь);

	Исключение
		ОчиститьОграниченияВызывающего(КлючA);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьОграниченияВызывающего(КлючA);

КонецПроцедуры

Процедура K11_Лимитер_НеЧиститПриЗапросе() Экспорт
	Вызывающий = УникальныйВызывающий();
	СтарыйМомент = ТекущаяУниверсальнаяДата() - 600;
	СидСчетчикK11(Вызывающий, СтарыйМомент);
	Проверка = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(Вызывающий);
	ЮТест.ОжидаетЧто(Проверка.Разрешено).Равно(Истина);
	СтарыйСчетчик = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий, СтарыйМомент);
	ЮТест.ОжидаетЧто(СтарыйСчетчик.ОставшийсяЛимит).Равно(59);
КонецПроцедуры

Процедура K11_Лимитер_СбойУчета() Экспорт
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Ложь);
	Проверка = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(Новый Структура);
	ЮТест.ОжидаетЧто(Проверка.Разрешено).Равно(Ложь);
	ЮТест.ОжидаетЧто(Проверка.ОшибкаУчета).Равно(Истина);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Ложь);
КонецПроцедуры

Процедура K11_Очистка_СтарыеИСвежие() Экспорт
	Вызывающий = УникальныйВызывающий();
	СтарыйМомент = ТекущаяУниверсальнаяДата() - 600;
	ТекущийМомент = ТекущаяУниверсальнаяДата();
	СидСчетчикK11(Вызывающий, СтарыйМомент);
	СидСчетчикK11(Вызывающий, ТекущийМомент);
	Удалено = Вычислить("КИИ_СерверMCPОграничения.ОчиститьУстаревшиеЗаписи()");
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	Старый = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий, СтарыйМомент);
	Текущий = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий, ТекущийМомент);
	ЮТест.ОжидаетЧто(Старый.ОставшийсяЛимит).Равно(60);
	ЮТест.ОжидаетЧто(Текущий.ОставшийсяЛимит).Равно(59);
КонецПроцедуры

Процедура K11_Очистка_ПорцияНеБолее500() Экспорт
	Вызывающий = УникальныйВызывающий();
	Для Индекс = 1 По 501 Цикл
		СидСчетчикK11(Вызывающий, Дата(2020, 1, 1) + Индекс * 60);
	КонецЦикла;
	Удалено = Вычислить("КИИ_СерверMCPОграничения.ОчиститьУстаревшиеЗаписи()");
	ЮТест.ОжидаетЧто(Удалено > 0 И Удалено <= 500).Равно(Истина);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	ЗапросОстатка = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Остаток ИЗ РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК С ГДЕ С.Вызывающий = &Вызывающий"
	);
	ЗапросОстатка.УстановитьПараметр("Вызывающий", Вызывающий);
	ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
	ВыборкаОстатка.Следующий();
	ЮТест.ОжидаетЧто(ВыборкаОстатка.Остаток > 0).Равно(Истина);
КонецПроцедуры


Процедура K11_Лимитер_ВнешняяТранзакция() Экспорт
	Вызывающий = УникальныйВызывающий();
	РезультатУчета = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(Вызывающий);
	ЮТест.ОжидаетЧто(РезультатУчета.Разрешено).Равно(Истина);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	ЮТест.ОжидаетЧто(РезультатУчета.ОставшийсяЛимит).Равно(59);
КонецПроцедуры

Процедура K11_Лимитер_ОшибкаВнешнейТранзакции() Экспорт
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Новый Структура);
	НачатьТранзакцию();
	Попытка
		ЮТест.ОжидаетЧто(КИИ_СерверMCPОграничения).Метод("ПроверитьИЗафиксироватьЛимит", ПараметрыМетода).ВыбрасываетИсключение(
			"Неверный тип значения");
		ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
		ОтменитьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура K11_Регламент_Расписание() Экспорт
	Задание = Вычислить(
		"РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.КИИ_СерверMCPОграниченияОчистка)");
	ЮТест.ОжидаетЧто(Задание = Неопределено).Равно(Ложь);
	ЮТест.ОжидаетЧто(Задание.Расписание.ПериодПовтораДней).Равно(1);
	ЮТест.ОжидаетЧто(Задание.Расписание.ПериодПовтораВТечениеДня).Равно(60);
КонецПроцедуры

Процедура K11_Регламент_Обработчик() Экспорт
	Вызывающий = УникальныйВызывающий();
	СтарыйМомент = Дата(2020, 1, 1);
	СидСчетчикK11(Вызывающий, СтарыйМомент);
	Выполнить("КИИ_СерверMCPОграничения.ВыполнитьОчисткуОграничений();");
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	Счетчик = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий, СтарыйМомент);
	ЮТест.ОжидаетЧто(Счетчик.ОставшийсяЛимит).Равно(60);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УникальныйВызывающий()
	
	Возврат "test-" + Строка(Новый УникальныйИдентификатор);
	
КонецФункции

Процедура ОчиститьОграниченияВызывающего(Знач Вызывающий)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ограничения.КодМинуты КАК КодМинуты
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК Ограничения
	|ГДЕ
	|	Ограничения.Вызывающий = &Вызывающий";
	
	Запрос.УстановитьПараметр("Вызывающий", Вызывающий);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Вызывающий.Установить(Вызывающий);
		НаборЗаписей.Отбор.КодМинуты.Установить(Выборка.КодМинуты);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


Процедура СидСчетчикK11(Вызывающий, Момент)
	НаборСчетчика = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
	НаборСчетчика.Отбор.Вызывающий.Установить(Вызывающий);
	КодМинуты = Формат(Момент, "ДФ='yyyy-MM-dd-HH-mm'");
	НаборСчетчика.Отбор.КодМинуты.Установить(КодМинуты);
	ЗаписьСчетчика = НаборСчетчика.Добавить();
	ЗаписьСчетчика.Вызывающий = Вызывающий;
	ЗаписьСчетчика.КодМинуты = КодМинуты;
	ЗаписьСчетчика.Количество = 1;
	НаборСчетчика.Записать();
КонецПроцедуры

#КонецОбласти
