// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СерверMCP_Ограничения")
			.ДобавитьСерверныйТест("Ограничения_ПодЛимитом_Разрешает")
			.ДобавитьСерверныйТест("Ограничения_РазныеCallers_НезависимыеСчётчики")
			.ДобавитьСерверныйТест("Ограничения_60Вызовов_НаПоследнемПовторитьЧерезПоложительный")
			.ДобавитьСерверныйТест("СокрытиеСекретов_PasswordПолеЗаменено")
			.ДобавитьСерверныйТест("СокрытиеСекретов_NestedTokenТакжеЗаменено");
	
КонецПроцедуры

// Проверяет, что новый caller без записей в регистре проходит лимит.
Процедура Ограничения_ПодЛимитом_Разрешает() Экспорт
	
	Вызывающий = УникальныйВызывающий();
	
	ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий);
	
	ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Истина);
	ЮТест.ОжидаетЧто(ПроверкаЛимита.ОставшийсяЛимит).Равно(60);
	
КонецПроцедуры

// Проверяет, что счётчики разных callers не влияют друг на друга.
Процедура Ограничения_РазныеCallers_НезависимыеСчётчики() Экспорт
	
	ВызывающийA = УникальныйВызывающий();
	ВызывающийB = УникальныйВызывающий();
	
	Попытка
		
		Для Индекс = 1 По 50 Цикл
			КИИ_СерверMCPОграничения.ЗафиксироватьВызов(ВызывающийA);
		КонецЦикла;
		
		ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(ВызывающийB);
		
		ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Истина);
		ЮТест.ОжидаетЧто(ПроверкаЛимита.ОставшийсяЛимит).Равно(60);
		
	Исключение
		
		ОчиститьОграниченияВызывающего(ВызывающийA);
		ОчиститьОграниченияВызывающего(ВызывающийB);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОчиститьОграниченияВызывающего(ВызывающийA);
	ОчиститьОграниченияВызывающего(ВызывающийB);
	
КонецПроцедуры

// Проверяет отказ после исчерпания минутного лимита.
Процедура Ограничения_60Вызовов_НаПоследнемПовторитьЧерезПоложительный() Экспорт
	
	Вызывающий = УникальныйВызывающий();
	
	Попытка
		
		Для Индекс = 1 По 60 Цикл
			КИИ_СерверMCPОграничения.ЗафиксироватьВызов(Вызывающий);
		КонецЦикла;
		
		ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий);
		
		ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Ложь);
		ЮТест.ОжидаетЧто(ПроверкаЛимита.ПовторитьЧерез > 0).Равно(Истина);
		
	Исключение
		
		ОчиститьОграниченияВызывающего(Вызывающий);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОчиститьОграниченияВызывающего(Вызывающий);
	
КонецПроцедуры

// Проверяет замену password-поля на <redacted>.
Процедура СокрытиеСекретов_PasswordПолеЗаменено() Экспорт
	
	Параметры = Новый Структура("user, password", "alice", "secret123");
	
	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);
	
	ЮТест.ОжидаетЧто(Результат.password).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.user).Равно("alice");
	
КонецПроцедуры

// Проверяет рекурсивную замену token-поля во вложенной структуре.
Процедура СокрытиеСекретов_NestedTokenТакжеЗаменено() Экспорт
	
	Авторизация = Новый Структура("api_token, login", "tok-xyz", "bob");
	Параметры = Новый Структура("auth", Авторизация);
	
	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);
	
	ЮТест.ОжидаетЧто(Результат.auth.api_token).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.auth.login).Равно("bob");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УникальныйВызывающий()
	
	Возврат "test-" + Строка(Новый УникальныйИдентификатор);
	
КонецФункции

Процедура ОчиститьОграниченияВызывающего(Знач Вызывающий)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ограничения.КодМинуты КАК КодМинуты
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPОграниченияВызовов КАК Ограничения
	|ГДЕ
	|	Ограничения.Вызывающий = &Вызывающий";
	
	Запрос.УстановитьПараметр("Вызывающий", Вызывающий);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.КИИ_СерверMCPОграниченияВызовов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Вызывающий.Установить(Вызывающий);
		НаборЗаписей.Отбор.КодМинуты.Установить(Выборка.КодМинуты);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
