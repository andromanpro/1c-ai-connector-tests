// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СерверMCP_Ограничения")
			.ДобавитьСерверныйТест("Ограничения_ПодЛимитом_Разрешает")
			.ДобавитьСерверныйТест("Ограничения_РазныеCallers_НезависимыеСчётчики")
			.ДобавитьСерверныйТест("Ограничения_60Вызовов_НаПоследнемПовторитьЧерезПоложительный")
			.ДобавитьСерверныйТест("СокрытиеСекретов_PasswordПолеЗаменено")
			.ДобавитьСерверныйТест("СокрытиеСекретов_NestedTokenТакжеЗаменено")
				.ДобавитьСерверныйТест("Ограничения_ПроверитьИЗафиксировать_ПоследнийРазрешёнПотомОтклонён")
				.ДобавитьСерверныйТест("СокрытиеСекретов_РасширенныеИмена_Заменены")
				.ДобавитьСерверныйТест("СокрытиеСекретов_БизнесПоляСKey_НеЗаменены")
					.ДобавитьСерверныйТест("КлючОграничения_Аутентифицированный_PerUser")
					.ДобавитьСерверныйТест("КлючОграничения_Неаутентифицированный_Глобальный")
					.ДобавитьСерверныйТест("СокрытиеСекретов_ДопМаркеры_Заменены")
					.ДобавитьСерверныйТест("КлючОграничения_РотацияUsername_НеДаётСвежийБакет")
					.ДобавитьСерверныйТест("КлючОграничения_РотацияНеОбходитЛимит_E2E");
	
КонецПроцедуры

// Проверяет, что новый caller без записей в регистре проходит лимит.
Процедура Ограничения_ПодЛимитом_Разрешает() Экспорт
	
	Вызывающий = УникальныйВызывающий();
	
	ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий);
	
	ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Истина);
	ЮТест.ОжидаетЧто(ПроверкаЛимита.ОставшийсяЛимит).Равно(60);
	
КонецПроцедуры

// Проверяет, что счётчики разных callers не влияют друг на друга.
Процедура Ограничения_РазныеCallers_НезависимыеСчётчики() Экспорт
	
	ВызывающийA = УникальныйВызывающий();
	ВызывающийB = УникальныйВызывающий();
	
	Попытка
		
		Для Индекс = 1 По 50 Цикл
			КИИ_СерверMCPОграничения.ЗафиксироватьВызов(ВызывающийA);
		КонецЦикла;
		
		ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(ВызывающийB);
		
		ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Истина);
		ЮТест.ОжидаетЧто(ПроверкаЛимита.ОставшийсяЛимит).Равно(60);
		
	Исключение
		
		ОчиститьОграниченияВызывающего(ВызывающийA);
		ОчиститьОграниченияВызывающего(ВызывающийB);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОчиститьОграниченияВызывающего(ВызывающийA);
	ОчиститьОграниченияВызывающего(ВызывающийB);
	
КонецПроцедуры

// Проверяет отказ после исчерпания минутного лимита.
Процедура Ограничения_60Вызовов_НаПоследнемПовторитьЧерезПоложительный() Экспорт
	
	Вызывающий = УникальныйВызывающий();
	
	Попытка
		
		Для Индекс = 1 По 60 Цикл
			КИИ_СерверMCPОграничения.ЗафиксироватьВызов(Вызывающий);
		КонецЦикла;
		
		ПроверкаЛимита = КИИ_СерверMCPОграничения.ПроверитьЛимит(Вызывающий);
		
		ЮТест.ОжидаетЧто(ПроверкаЛимита.Разрешено).Равно(Ложь);
		ЮТест.ОжидаетЧто(ПроверкаЛимита.ПовторитьЧерез > 0).Равно(Истина);
		
	Исключение
		
		ОчиститьОграниченияВызывающего(Вызывающий);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ОчиститьОграниченияВызывающего(Вызывающий);
	
КонецПроцедуры

// Проверяет замену password-поля на <redacted>.
Процедура СокрытиеСекретов_PasswordПолеЗаменено() Экспорт
	
	Параметры = Новый Структура("user, password", "alice", "secret123");
	
	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);
	
	ЮТест.ОжидаетЧто(Результат.password).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.user).Равно("alice");
	
КонецПроцедуры

// Проверяет рекурсивную замену token-поля во вложенной структуре.
Процедура СокрытиеСекретов_NestedTokenТакжеЗаменено() Экспорт
	
	Авторизация = Новый Структура("api_token, login", "tok-xyz", "bob");
	Параметры = Новый Структура("auth", Авторизация);
	
	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);
	
	ЮТест.ОжидаетЧто(Результат.auth.api_token).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.auth.login).Равно("bob");
	
КонецПроцедуры

// Атомарный лимитер сам инкрементит: 60 вызовов разрешены, 61-й отклонён.
Процедура Ограничения_ПроверитьИЗафиксировать_ПоследнийРазрешёнПотомОтклонён() Экспорт

	Вызывающий = УникальныйВызывающий();

	Попытка

		Для Индекс = 1 По 60 Цикл
			Проверка = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(Вызывающий);
			ЮТест.ОжидаетЧто(Проверка.Разрешено).Равно(Истина);
		КонецЦикла;

		Проверка61 = КИИ_СерверMCPОграничения.ПроверитьИЗафиксироватьЛимит(Вызывающий);
		ЮТест.ОжидаетЧто(Проверка61.Разрешено).Равно(Ложь);

	Исключение
		ОчиститьОграниченияВызывающего(Вызывающий);
		ВызватьИсключение;
	КонецПопытки;

	ОчиститьОграниченияВызывающего(Вызывающий);

КонецПроцедуры

// Расширенный набор имён секретов: apiKey / access_key / key / ключ - заменяются.
Процедура СокрытиеСекретов_РасширенныеИмена_Заменены() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("apiKey", "a");
	Параметры.Вставить("access_key", "b");
	Параметры.Вставить("key", "c");
	Параметры.Вставить("ключ", "d");
	Параметры.Вставить("user", "alice");

	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);

	ЮТест.ОжидаетЧто(Результат.apiKey).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.access_key).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.key).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.ключ).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.user).Равно("alice");

КонецПроцедуры

// Бизнес-поля с «key»/«ключ» как частью слова НЕ должны редактироваться.
Процедура СокрытиеСекретов_БизнесПоляСKey_НеЗаменены() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("primary_key", "pk");
	Параметры.Вставить("keyword", "search");
	Параметры.Вставить("Заключение", "text");

	Результат = КИИ_СерверMCPСокрытиеСекретов.СкрытьСекретыВПараметрах(Параметры);

	ЮТест.ОжидаетЧто(Результат.primary_key).Равно("pk");
	ЮТест.ОжидаетЧто(Результат.keyword).Равно("search");
	ЮТест.ОжидаетЧто(Результат.Заключение).Равно("text");

КонецПроцедуры

// Ломалка (аудит P2): маркеры секретов пропускали распространённые имена ключей.
Процедура СокрытиеСекретов_ДопМаркеры_Заменены() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("cookie", "c");
	Параметры.Вставить("jwt", "j");
	Параметры.Вставить("session_id", "s");
