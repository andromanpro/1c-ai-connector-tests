	ЮТест.ОжидаетЧто(Результат.cookie).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.jwt).Равно("<redacted>");
	ЮТест.ОжидаетЧто(Результат.session_id).Равно("<redacted>");
