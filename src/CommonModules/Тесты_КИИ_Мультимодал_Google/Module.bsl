// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрирует тесты мультимодального запроса Google Gemini.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Мультимодал_Google")
			.ДобавитьСерверныйТест("ТекстИКартинка_ФормируютInlineData")
			.ДобавитьСерверныйТест("КартинкаDataURI_ФормируетInlineData")
			.ДобавитьСерверныйТест("КартинкаПоСсылке_ФормируетFileData")
			.ДобавитьСерверныйТест("КартинкаПоСсылкеСПолемMIME_ФормируетFileData")
			.ДобавитьСерверныйТест("КартинкаПоСсылкеБезРасширения_ИсключениеБезСсылки")
			.ДобавитьСерверныйТест("ТекстИДокумент_ФормируютInlineData")
			.ДобавитьСерверныйТест("Строка_СохраняетСтарыйФормат");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ТекстИКартинка_ФормируютInlineData() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("опиши"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(
		ДвоичныеДанныеДляТеста(), "image/png"));

	Части = СформироватьЗапрос(Контент).ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Части[0]["text"]).Равно("опиши");
	ЮТест.ОжидаетЧто(Части[1]["inline_data"]["mime_type"]).Равно("image/png");
	ЮТест.ОжидаетЧто(СтрНайти(Части[1]["inline_data"]["data"], Символы.ПС)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Части[1]["inline_data"]["data"], Символы.ВК)).Равно(0);
	ЮТест.ОжидаетЧто(ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Части[1]["inline_data"]["data"]),
		КодировкаТекста.UTF8)).Равно(СтрокаДанныхДляТеста());

КонецПроцедуры

// data-URI допускает URL-кодирование любого символа (%HH, любой регистр): %51 - это «Q», %3d - «=».
// В inline_data нужен чистый Base64.
Процедура КартинкаDataURI_ФормируетInlineData() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL("data:Image/JPG;base64,%51UI%3d"));

	Части = СформироватьЗапрос(Контент).ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части[0]["inline_data"]["mime_type"]).Равно("image/jpeg");
	ЮТест.ОжидаетЧто(Части[0]["inline_data"]["data"]).Равно("QUI=");

КонецПроцедуры

Процедура КартинкаПоСсылке_ФормируетFileData() Экспорт

	Ссылка = "https://example.com/files/Cat.PNG?size=large#preview";
	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL(Ссылка));

	Части = СформироватьЗапрос(Контент).ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части[0]["file_data"]["mime_type"]).Равно("image/png");
	ЮТест.ОжидаетЧто(Части[0]["file_data"]["file_uri"]).Равно(Ссылка);

КонецПроцедуры

// Подписанная ссылка без расширения: тип картинки берется из поля MIME элемента.
Процедура КартинкаПоСсылкеСПолемMIME_ФормируетFileData() Экспорт

	Ссылка = "https://storage.example.org/object?signature=abc";
	Картинка = КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL(Ссылка);
	Картинка.Вставить("MIME", "Image/PNG");
	Контент = Новый Массив;
	Контент.Добавить(Картинка);

	Части = СформироватьЗапрос(Контент).ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части[0]["file_data"]["mime_type"]).Равно("image/png");
	ЮТест.ОжидаетЧто(Части[0]["file_data"]["file_uri"]).Равно(Ссылка);

КонецПроцедуры

// Без расширения и без поля MIME запрос останавливается. Текст ошибки уходит в результат и лог ИИ,
// поэтому ссылки в нем быть не должно: у подписанной ссылки в параметрах лежит секрет доступа.
Процедура КартинкаПоСсылкеБезРасширения_ИсключениеБезСсылки() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL("https://example.com/image?token=SECRET"));
	Промпт = Новый Структура("ПользовательскийПромпт", Контент);

	ТекстОшибки = "";
	Попытка
		КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыGoogle(), Промпт);
	Исключение
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "не определил тип изображения") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "SECRET")).Равно(0);

КонецПроцедуры

Процедура ТекстИДокумент_ФормируютInlineData() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("прочитай"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(
		ДвоичныеДанныеДляТеста(), "application/pdf", "report.pdf"));

	Части = СформироватьЗапрос(Контент).ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Части[1]["inline_data"]["mime_type"]).Равно("application/pdf");

КонецПроцедуры

Процедура Строка_СохраняетСтарыйФормат() Экспорт

	Части = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыGoogle(), "привет").ТелоЗапроса.contents[0]["parts"];
	ЮТест.ОжидаетЧто(Части.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Части[0]["text"]).Равно("привет");

КонецПроцедуры

Функция СформироватьЗапрос(Знач Контент)

	Промпт = Новый Структура("ПользовательскийПромпт", Контент);
	Возврат КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыGoogle(), Промпт);

КонецФункции

Функция ПараметрыGoogle()

	Параметры = Новый Структура;
	Параметры.Вставить("Адрес", "generativelanguage.googleapis.com");
	Параметры.Вставить("АдресЗапроса", "/v1beta/models/gemini:generateContent");
	Параметры.Вставить("ИспользоватьЗащищенноеСоединение", Истина);
	Параметры.Вставить("ИспользоватьПрокси", Ложь);
	Параметры.Вставить("ТипФорматаAPI", Перечисления.КИИ_ТипыФорматовAPI.Google);
	Параметры.Вставить("ТипАвторизации", Неопределено);
	Параметры.Вставить("НаименованиеПровайдера", "Google");
	Параметры.Вставить("НаименованиеПолное", "gemini-3.8-flash");
	Параметры.Вставить("Температура", 0.7);
	Параметры.Вставить("МаксимумТокенов", 1000);
	Параметры.Вставить("Таймаут", 30);
	Параметры.Вставить("Заголовки", Новый Массив);
	Возврат Параметры;

КонецФункции

Функция ДвоичныеДанныеДляТеста()

	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрокаДанныхДляТеста(), КодировкаТекста.UTF8);

КонецФункции

Функция СтрокаДанныхДляТеста()

	// Длиннее 57 байт: Base64Строка платформы разобьет результат переводом строки.
	Возврат "multimodal-google-test multimodal-google-test multimodal-google-test";

КонецФункции

#КонецОбласти
