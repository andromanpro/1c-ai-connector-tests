			.Параметр(Фикстура.ЧужойДиалог).Параметр(Фикстура.Материал).Параметр(Ложь)
			.ВыбрасываетИсключение("недоступен текущему пользователю");
		ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
		ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ОтменитьТранзакцию();
КонецПроцедуры

Функция НовыйДиалог()
