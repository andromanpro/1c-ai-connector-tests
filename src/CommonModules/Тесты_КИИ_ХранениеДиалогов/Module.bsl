Функция ДанныеВопроса(Текст)
	Результат = Новый Структура("Вопрос", Текст);
	Возврат Результат;
КонецФункции

Функция ПараметрыВопроса(Диалог)
	Результат = Новый Структура("АдресПодготовки,Диалог", "", Диалог);
	Возврат Результат;
КонецФункции

Функция НачатьПроверочныйЗапрос(Диалог, Текст)
	Данные = ДанныеВопроса(Текст);
	Параметры = ПараметрыВопроса(Диалог);
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, Данные, Настройки);
	Результат = КИИ_ХранениеДиалогов.НачатьЗапрос(Диалог, Данные, Параметры);
	Возврат Результат;
КонецФункции

Функция УспешныйИтог(Текст)
	Ответ = Новый Структура("ЭтоОшибка,ТекстОтвета,ВложенияОтвета", Ложь, Текст, Новый Массив);
	Результат = Новый Структура("Ответ", Ответ);
	Возврат Результат;
КонецФункции

