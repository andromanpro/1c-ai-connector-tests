Процедура НазванияБеседОднострочные() Экспорт
	Диалог = НовыйДиалог();
	Заголовок = "  Первая" + Символы.ВК + Символы.ПС + Символы.Таб + "  вторая  ";
	КИИ_ХранениеДиалогов.ПереименоватьДиалог(Диалог, Заголовок);
	Снимок = КИИ_ХранениеДиалогов.Диалог(Диалог);
	ЮТест.ОжидаетЧто(Снимок.Заголовок).Равно("Первая вторая");
	Список = КИИ_ХранениеДиалогов.МоиДиалоги();
	СтрокаБеседы = Список.Найти(Диалог, "Диалог");
	ЮТест.ОжидаетЧто(СтрокаБеседы.Заголовок).Равно("Первая вторая");
	КИИ_ХранениеДиалогов.ПереименоватьДиалог(Диалог, Символы.ПС + Символы.Таб);
	Снимок = КИИ_ХранениеДиалогов.Диалог(Диалог);
	ЮТест.ОжидаетЧто(Снимок.Заголовок).Равно("Новый диалог");
КонецПроцедуры

Процедура НазваниеИзВопросаСохраняетИсходныйТекст() Экспорт
	Диалог = НовыйДиалог();
	Вопрос = "Сколько" + Символы.ПС + "справочников?" + Символы.ПС;
	Запрос = НачатьПроверочныйЗапрос(Диалог, Вопрос);
	Снимок = КИИ_ХранениеДиалогов.Диалог(Диалог);
	ЮТест.ОжидаетЧто(Снимок.Заголовок).Равно("Сколько справочников?");
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог);
	ЮТест.ОжидаетЧто(История[0].Текст).Равно(Вопрос);
КонецПроцедуры

Процедура ТекстФайлаСохраняетсяВКонтекстеПродолжения() Экспорт
	Диалог = БеседаСОтправленнымФайлом("text/plain");
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Это в нашей базе?"), Настройки);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "Контрольный_файл.txt") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "КИИ_МАРКЕР_СОДЕРЖИМОГО") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Данные.Вложения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Данные.МатериалыОтправки.Количество()).Равно(0);
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог);
	ЮТест.ОжидаетЧто(История[0].Текст).Равно("Что я отправил?");
	Материалы = КИИ_ХранениеДиалогов.МатериалыДиалога(Диалог);
	ЮТест.ОжидаетЧто(Материалы[0].Сообщение).Равно(История[0].Сообщение);
	ЮТест.ОжидаетЧто(Материалы[0].Отправлять).Равно(Ложь);
КонецПроцедуры

Процедура ВложенияИсторииУчитываютНастройки() Экспорт
	Диалог = БеседаСОтправленнымФайлом("text/plain");
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Настройки.ИспользоватьВложения = Ложь;
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Дальше"), Настройки);
	ЮТест.ОжидаетЧто(Данные.История[0].Текст).Равно("Что я отправил?");
	Настройки.ИспользоватьВложения = Истина;
	Настройки.ИспользоватьИсторию = Ложь;
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Дальше"), Настройки);
	Промпт = КИИ_КонтекстДиалога.СобратьПромпт(Данные, Настройки);
	ЮТест.ОжидаетЧто(Промпт.ИсторияСообщений.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Данные.Вложения.Количество()).Равно(0);
	Настройки.ИспользоватьИсторию = Истина;
	Настройки.РазмерКонтекста = 1;
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Дальше"), Настройки);
	Промпт = КИИ_КонтекстДиалога.СобратьПромпт(Данные, Настройки);
	ЮТест.ОжидаетЧто(Промпт.ИсторияСообщений.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(Промпт.ИсторияСообщений[0].Текст, "КИИ_МАРКЕР_СОДЕРЖИМОГО")).Равно(0);
КонецПроцедуры

Процедура БинарныйФайлИсторииНеПересылаетсяНеявно() Экспорт
	Диалог = БеседаСОтправленнымФайлом("application/pdf");
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Что было в файле?"), Настройки);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "Контрольный_файл.txt") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "КИИ_МАРКЕР_СОДЕРЖИМОГО")).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "не включено") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Данные.Вложения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Данные.МатериалыОтправки.Количество()).Равно(0);
КонецПроцедуры

Процедура ЦитатаСохраняетсяВКонтекстеПродолжения() Экспорт
	ИсточникДиалог = НовыйДиалог();
	Запрос = НачатьПроверочныйЗапрос(ИсточникДиалог, "Источник");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(ИсточникДиалог, Запрос, УспешныйИтог("Ответ с цитатой КИИ_ЦИТАТА"), "");
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(ИсточникДиалог);
	Диалог = НовыйДиалог();
	Источник = Новый Структура("Диалог,Сообщение,Фрагмент", ИсточникДиалог, История[1].Сообщение, "КИИ_ЦИТАТА");
	Материал = КИИ_ХранениеДиалогов.ДобавитьИсточник(Диалог, Источник);
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Объясни цитату");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, УспешныйИтог("Объяснение"), "");
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("А подробнее?"), Настройки);
	ЮТест.ОжидаетЧто(СтрНайти(Данные.История[0].Текст, "КИИ_ЦИТАТА") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Данные.Вопрос).Равно("А подробнее?");
КонецПроцедуры

Функция БеседаСОтправленнымФайлом(MIME)
	Диалог = НовыйДиалог();
	Описание = Новый Структура("Имя,MIME", "Контрольный_файл.txt", MIME);
	Содержимое = ПолучитьДвоичныеДанныеИзСтроки("КИИ_МАРКЕР_СОДЕРЖИМОГО", КодировкаТекста.UTF8);
	Материал = КИИ_ХранениеДиалогов.ДобавитьФайл(Диалог, Описание, Содержимое);
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Что я отправил?");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, УспешныйИтог("Первый разбор"), "");
	Возврат Диалог;
КонецФункции

Процедура РазныеБеседыХранятСвоиЧерновики() Экспорт
	Первый = НовыйДиалог();
	Второй = НовыйДиалог();
	ПервыйСнимок = КИИ_ХранениеДиалогов.Диалог(Первый);
	ВторойСнимок = КИИ_ХранениеДиалогов.Диалог(Второй);
	КИИ_ХранениеДиалогов.СохранитьЧерновик(Первый, "Продажи", ПервыйСнимок.Эксперт,
		ПервыйСнимок.Настройки, ПервыйСнимок.Версия);
	КИИ_ХранениеДиалогов.СохранитьЧерновик(Второй, "Остатки", ВторойСнимок.Эксперт,
		ВторойСнимок.Настройки, ВторойСнимок.Версия);
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.Диалог(Первый).Черновик).Равно("Продажи");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.Диалог(Второй).Черновик).Равно("Остатки");
КонецПроцедуры

Процедура УстаревшаяВерсияНеЗатираетЧерновик() Экспорт
	Диалог = НовыйДиалог();
	Снимок = КИИ_ХранениеДиалогов.Диалог(Диалог);
	КИИ_ХранениеДиалогов.СохранитьЧерновик(Диалог, "Первое сохранение", Снимок.Эксперт,
		Снимок.Настройки, Снимок.Версия);
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов).Метод("СохранитьЧерновик")
		.Параметр(Диалог).Параметр("Устаревший текст").Параметр(Снимок.Эксперт)
		.Параметр(Снимок.Настройки).Параметр(Снимок.Версия)
		.ВыбрасываетИсключение("Беседа изменена в другом окне");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.Диалог(Диалог).Черновик).Равно("Первое сохранение");
КонецПроцедуры

Процедура ОдинАктивныйЗапросВБеседе() Экспорт
	Диалог = НовыйДиалог();
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Первый вопрос");
	Данные = ДанныеВопроса("Повтор");
	Параметры = ПараметрыВопроса(Диалог);
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов).Метод("НачатьЗапрос")
		.Параметр(Диалог).Параметр(Данные).Параметр(Параметры)
		.ВыбрасываетИсключение("уже выполняется запрос");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.Диалог(Диалог).АктивныйЗапрос).Равно(Запрос);
КонецПроцедуры

Процедура РезультатСохраняетсяБезФормыИДублей() Экспорт
	Диалог = НовыйДиалог();
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Вопрос без формы");
	Итог = УспешныйИтог("Сохраненный ответ");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, Итог, "");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, Итог, "");
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог);
	ЮТест.ОжидаетЧто(История.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(История[1].Текст).Равно("Сохраненный ответ");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.Диалог(Диалог).АктивныйЗапрос).Равно("");
КонецПроцедуры

Процедура ОтветыДвухБеседНеСмешиваются() Экспорт
	Первый = НовыйДиалог();
	Второй = НовыйДиалог();
	ЗапросПервый = НачатьПроверочныйЗапрос(Первый, "Вопрос А");
	ЗапросВторой = НачатьПроверочныйЗапрос(Второй, "Вопрос Б");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Второй, ЗапросВторой, УспешныйИтог("Ответ Б"), "");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Первый, ЗапросПервый, УспешныйИтог("Ответ А"), "");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.СообщенияДиалога(Первый)[1].Текст).Равно("Ответ А");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.СообщенияДиалога(Второй)[1].Текст).Равно("Ответ Б");
КонецПроцедуры

Процедура ИсторияЧитаетсяПорциями() Экспорт
	Диалог = НовыйДиалог();
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Один");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, УспешныйИтог("Два"), "");
	Запрос = НачатьПроверочныйЗапрос(Диалог, "Три");
	КИИ_ХранениеДиалогов.СохранитьИтогЗапроса(Диалог, Запрос, УспешныйИтог("Четыре"), "");
	ПерваяПорция = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог, 0, 2);
	ВтораяПорция = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог, 2, 2);
	ЮТест.ОжидаетЧто(ПерваяПорция.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ВтораяПорция.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ВтораяПорция[0].Текст).Равно("Три");
КонецПроцедуры

Процедура ФайлДоступенПослеПовторногоЧтения() Экспорт
	Диалог = НовыйДиалог();
	Описание = Новый Структура("Имя,MIME", "Проверка.txt", "text/plain");
	Данные = ПолучитьДвоичныеДанныеИзСтроки("Текст файла", КодировкаТекста.UTF8);
	Файл = КИИ_ХранениеДиалогов.ДобавитьФайл(Диалог, Описание, Данные);
	Чтение = КИИ_ХранениеДиалогов.СодержимоеМатериала(Диалог, Файл);
	ЮТест.ОжидаетЧто(ПолучитьСтрокуИзДвоичныхДанных(Чтение, КодировкаТекста.UTF8)).Равно("Текст файла");
	ЮТест.ОжидаетЧто(КИИ_ХранениеДиалогов.МатериалыДиалога(Диалог).Количество()).Равно(1);
КонецПроцедуры

Процедура ФайлДругойБеседыНеТребуетПовторнойЗагрузки() Экспорт
	Первый = НовыйДиалог();
	Второй = НовыйДиалог();
	Описание = Новый Структура("Имя,MIME", "Общий.txt", "text/plain");
	Данные = ПолучитьДвоичныеДанныеИзСтроки("Исходная версия", КодировкаТекста.UTF8);
	Файл = КИИ_ХранениеДиалогов.ДобавитьФайл(Первый, Описание, Данные);
	Источник = Новый Структура("Диалог,Материал", Первый, Файл);
