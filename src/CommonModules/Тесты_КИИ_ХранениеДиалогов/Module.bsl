Процедура ИсполнительОбращаетсяКМоделиБезПривилегии() Экспорт
	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "ЮТБеседа_" + Строка(Новый УникальныйИдентификатор);
	Модель.НаименованиеПолное = "expert-test-saved-dialog-executor";
	Модель.НаименованиеПровайдера = "OpenAI";
	Модель.Адрес = "127.0.0.1:18770";
	Модель.АдресЗапроса = "/plain/chat/completions";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	Модель.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	Модель.ИспользоватьЗащищенноеСоединение = Ложь;
	Модель.ИспользоватьПрокси = Ложь;
	Модель.Таймаут = 10;
	Модель.РежимКонтроляПерсональныхДанных = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен;
	Модель.Записать();
	Эксперт = Справочники.КИИ_ЭкспертыИИ.СоздатьЭлемент();
	Эксперт.Наименование = "ЮТБеседаЭксперт_" + Строка(Новый УникальныйИдентификатор);
	Эксперт.Модель = Модель.Ссылка;
	Эксперт.Записать();
	Настройки = КИИ_КонтекстДиалога.НастройкиПоУмолчанию();
	Настройки.ИспользоватьЗнания = Ложь;
	Настройки.ИспользоватьВложения = Ложь;
	Диалог = КИИ_ХранениеДиалогов.СоздатьДиалог(Эксперт.Ссылка, Настройки);
	Данные = КИИ_ХранениеДиалогов.ДанныеДляОтправки(Диалог, ДанныеВопроса("Проверка исполнителя"), Настройки);
	Параметры = ПараметрыВопроса(Диалог);
	Параметры.Вставить("Настройки", Настройки);
	Параметры.Вставить("ИспользоватьИнструменты", Ложь);
	Параметры.Вставить("Базы", Неопределено);
	Параметры.Вставить("ВладелецФормы", Новый УникальныйИдентификатор);
	Запрос = КИИ_ХранениеДиалогов.НачатьЗапрос(Диалог, Данные, Параметры);
	Итог = КИИ_ХранениеДиалогов.ВыполнитьЗапрос(Диалог, Запрос);
	История = КИИ_ХранениеДиалогов.СообщенияДиалога(Диалог);
	ЮТест.ОжидаетЧто(Итог.Ответ.ЭтоОшибка, Итог.Ответ.ТекстОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(История.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(История[1].Текст).Равно("PLAIN_OK");
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

