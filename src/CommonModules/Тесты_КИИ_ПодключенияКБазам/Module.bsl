Процедура ЛичнаяЗаписьСохраняетОбаКлюча() Экспорт
	База = НоваяБаза(Истина);
	КИИ_ПодключенияКБазам.СохранитьЛичныйВход(База, "reader-a", "123456", "Заменить");
	Запрос = Новый Запрос("ВЫБРАТЬ Логин
		|ИЗ РегистрСведений.КИИ_ЛичныеПодключенияКБазам
		|ГДЕ Подключение = &Подключение И Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Подключение", База);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Таблица = Запрос.Выполнить().Выгрузить();
	ЮТест.ОжидаетЧто(Таблица.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Таблица[0].Логин).Равно("reader-a");
КонецПроцедуры

