Процедура ЗагрузкаПодключенияСохраняетДанные() Экспорт
	ОбъектБазы = Справочники.КИИ_ПодключенияКБазам.СоздатьЭлемент();
	ОбъектБазы.Наименование = "YAX_" + Строка(Новый УникальныйИдентификатор);
	ОбъектБазы.Адрес = "Загруженный адрес";
	ОбъектБазы.Таймаут = 0;
	ОбъектБазы.ИдентификаторБазы = "Исходная привязка";
