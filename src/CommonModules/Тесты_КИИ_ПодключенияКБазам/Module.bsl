	Сохраненный = ОбъектБазы.Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Сохраненный.Адрес).Равно("Загруженный адрес");
	ЮТест.ОжидаетЧто(Сохраненный.Таймаут).Равно(0);
	ЮТест.ОжидаетЧто(Сохраненный.ИдентификаторБазы).Равно("Исходная привязка");
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

Процедура УдалениеЗагрузкойОчищаетСекреты() Экспорт
	Служебная = НоваяБаза();
	КИИ_ПодключенияКБазам.СохранитьСлужебныйПароль(Служебная, "123456", "Заменить");
	Личная = НоваяБаза(Истина);
	КИИ_ПодключенияКБазам.СохранитьЛичныйВход(Личная, "reader-a", "123456", "Заменить");
	ОбъектБазы = Служебная.ПолучитьОбъект();
	ОбъектБазы.ОбменДанными.Загрузка = Истина;
	ОбъектБазы.Удалить();
	ЮТест.ОжидаетЧто(Секрет(Служебная)).Равно(Неопределено);
	ОбъектБазы = Личная.ПолучитьОбъект();
	ОбъектБазы.ОбменДанными.Загрузка = Истина;
	ОбъектБазы.Удалить();
	ЮТест.ОжидаетЧто(СекретЛичногоВхода(Личная)).Равно(Неопределено);
	Набор = РегистрыСведений.КИИ_ЛичныеПодключенияКБазам.СоздатьНаборЗаписей();
	Набор.Отбор.Подключение.Установить(Личная);
	Набор.Прочитать();
	ЮТест.ОжидаетЧто(Набор.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяБаза(ЛичныйВход = Ложь, ВтораяБаза = Ложь)
	ОбъектБазы = Справочники.КИИ_ПодключенияКБазам.СоздатьЭлемент();
	ОбъектБазы.Наименование = "YAX_" + Строка(Новый УникальныйИдентификатор);
	ОбъектБазы.Адрес = "http://127.0.0.1:8874/" + ?(ВтораяБаза, "source-b", "source-a") + "/hs/iikona-mcp/connection";
	ОбъектБазы.Пользователь = "reader-a";
	ОбъектБазы.ЛичныйВход = ЛичныйВход;
	ОбъектБазы.Используется = Истина;
	ОбъектБазы.Таймаут = 10;
	ОбъектБазы.ИдентификаторБазы = ?(
		ВтораяБаза, "22222222-2222-2222-2222-222222222222", "11111111-1111-1111-1111-111111111111");
	ОбъектБазы.Записать();
	Возврат ОбъектБазы.Ссылка;
КонецФункции

Функция Секрет(Владелец)
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец);
КонецФункции

Функция СекретЛичногоВхода(База)
	Пользователь = Пользователи.ТекущийПользователь();
	Владелец = "КИИ_Базы."
		+ Строка(База.УникальныйИдентификатор())
		+ "."
		+ Строка(Пользователь.УникальныйИдентификатор());
	Возврат Секрет(Владелец);
КонецФункции

Функция АргументыЗапроса()
	Возврат Новый Структура(
		"query_id, query_text, limit, params", "catalog-probe", "ВЫБРАТЬ 1 КАК Value", 10, Новый Структура);
КонецФункции

Функция ОжиданиеВыполнения(База)
	Возврат ЮТест.ОжидаетЧто(КИИ_ПодключенияКБазам).Метод("ВыполнитьИнструмент").Параметр(Строка(База.УникальныйИдентификатор())).Параметр("execute_query").Параметр(
		АргументыЗапроса());
КонецФункции

#КонецОбласти
