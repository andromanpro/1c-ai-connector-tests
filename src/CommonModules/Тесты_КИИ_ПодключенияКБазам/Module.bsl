Процедура КаталогДляМоделиБезРеквизитовВхода() Экспорт
	База = НоваяБаза();
	Найден = Ложь;
	Для Каждого Описание Из КИИ_ПодключенияКБазам.ДоступныеБазы() Цикл
		ЮТест.ОжидаетЧто(Описание.Свойство("Адрес")).Равно(Ложь);
		ЮТест.ОжидаетЧто(Описание.Свойство("Пользователь")).Равно(Ложь);
		ЮТест.ОжидаетЧто(Описание.Свойство("Пароль")).Равно(Ложь);
		Если Описание.database_id = Строка(База.УникальныйИдентификатор()) Тогда
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найден).Равно(Истина);
КонецПроцедуры

