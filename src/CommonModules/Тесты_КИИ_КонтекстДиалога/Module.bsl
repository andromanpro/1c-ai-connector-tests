Процедура Контекст_JSON_ДвоичныеПредставления() Экспорт
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
	Данные = Новый Структура("Контент", ДвоичныеДанные);
	ТекстBase64 = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные, "base64");
	КонтентBase64 = КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(ТекстBase64, Ложь);
	ЮТест.ОжидаетЧто(КонтентBase64.Контент).Равно("QUJD");
	ТекстМетаданных = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные, "metadata");
	МетаданныеКонтента = КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(ТекстМетаданных, Ложь);
	ЮТест.ОжидаетЧто(МетаданныеКонтента.Контент.kind).Равно("binary");
	ЮТест.ОжидаетЧто(МетаданныеКонтента.Контент.size_bytes).Равно(3);
	ЮТест.ОжидаетЧто(МетаданныеКонтента.Контент.sha256_base64).Равно("tdQEXD9Gb6kf4sxqvnkjKhpXzfEE96JucW4KHieJ33g=");
	ЮТест.ОжидаетЧто(ТипЗнч(Данные.Контент)).Равно(Тип("ДвоичныеДанные"));
	ИсходныйBase64 = Base64Строка(Данные.Контент);
	ЮТест.ОжидаетЧто(ИсходныйBase64).Равно("QUJD");
КонецПроцедуры

Процедура Контекст_JSON_СтандартныйКонтракт() Экспорт
	Данные = Новый Структура("Текст,Число,Флаг,Дата", "Привет", 1.5, Истина, Дата(2026, 11, 9));
	СтандартныйJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные);
	JSONBase64 = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные, "base64");
	JSONМетаданных = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные, "metadata");
	ЮТест.ОжидаетЧто(JSONBase64).Равно(СтандартныйJSON);
	ЮТест.ОжидаетЧто(JSONМетаданных).Равно(СтандартныйJSON);
	Данные.Вставить("Идентификатор", Новый УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИОбщий).Метод("ЗначениеВСтрокуJSON").Параметр(Данные)
		.ВыбрасываетИсключение("недопустимых типов");
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИОбщий).Метод("ЗначениеВСтрокуJSON").Параметр(Данные).Параметр("base64")
		.ВыбрасываетИсключение("недопустимых типов");
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИОбщий).Метод("ЗначениеВСтрокуJSON").Параметр(Данные).Параметр("metadata")
		.ВыбрасываетИсключение("недопустимых типов");
	ЮТест.ОжидаетЧто(КИИ_КоннекторИИОбщий).Метод("ЗначениеВСтрокуJSON").Параметр("текст").Параметр("unknown")
		.ВыбрасываетИсключение("Неизвестное представление");
