		ЮТест.ОжидаетЧто(Записи[1].РаундЧата).Равно(2);
		ЮТест.ОжидаетЧто(Записи[0].ИнструментыРаунда).Равно("get_configuration_info");
		ЮТест.ОжидаетЧто(Записи[1].ИнструментыРаунда).Равно("");
	Исключение
		УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ВызватьИсключение;
	КонецПопытки;
