	Данные.Вложения.Очистить();
	Результат = КИИ_КонтекстДиалога.СобратьПромпт(Данные);
	ЮТест.ОжидаетЧто(Результат.СистемныйПромпт).Равно("ИнструкцияЗнания");
	ЮТест.ОжидаетЧто(Результат.ПользовательскийПромпт).Равно("Вопрос");
	ЮТест.ОжидаетЧто(Результат.ИсторияСообщений.Количество()).Равно(2);
КонецПроцедуры

