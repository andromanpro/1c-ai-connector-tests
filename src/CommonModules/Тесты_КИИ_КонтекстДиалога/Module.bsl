Функция ДанныеЗапроса(Знач Сценарий, Знач Маскировать = Ложь)
	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "ЮТКонтекст_" + Строка(Новый УникальныйИдентификатор);
	Модель.НаименованиеПолное = "expert-test-chat-context";
	Модель.НаименованиеПровайдера = "OpenAI";
	Модель.Адрес = "127.0.0.1:18770";
	Модель.АдресЗапроса = "/" + Сценарий + "/chat/completions";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	Модель.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	Модель.ПоддерживаетИнструменты = Истина;
	Модель.ИспользоватьЗащищенноеСоединение = Ложь;
	Модель.ИспользоватьПрокси = Ложь;
	Модель.Таймаут = 10;
	Модель.РежимКонтроляПерсональныхДанных = ?(
		Маскировать,
		Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Маскировать,
		Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен
	);
	Модель.Записать();
	Эксперт = Справочники.КИИ_ЭкспертыИИ.СоздатьЭлемент();
	Эксперт.Наименование = "ЮТКонтекстЭксперт_" + Строка(Новый УникальныйИдентификатор);
	Эксперт.ОписаниеЭксперта = "Инструкция";
	Эксперт.Модель = Модель.Ссылка;
	Эксперт.Записать();
	Данные = ДанныеКонтекста();
	Данные.Вставить("Эксперт", Эксперт.Ссылка);
	Данные.Знания = "";
	Данные.Вложения.Очистить();
	Возврат Данные;
КонецФункции

Функция ПараметрыЗапроса()
	Параметры = Новый Структура;
	Параметры.Вставить("Настройки", КИИ_КонтекстДиалога.НастройкиПоУмолчанию());
	Параметры.Вставить("ИспользоватьИнструменты", Ложь);
	Параметры.Вставить("Базы", Неопределено);
	Параметры.Вставить("Диалог", Строка(Новый УникальныйИдентификатор));
	Параметры.Вставить("ВладелецФормы", Новый УникальныйИдентификатор);
	Параметры.Вставить("АдресПодготовки", ПоместитьВоВременноеХранилище(Неопределено, Параметры.ВладелецФормы));
	Возврат Параметры;
КонецФункции

Процедура ПроверитьПросмотрИОтправку(Знач Сценарий, Знач Инструменты, Знач Маскировать = Ложь)
	Данные = ДанныеЗапроса(Сценарий, Маскировать);
	Если Маскировать Тогда
		Данные.Вопрос = "Почта preview.person@example.org";
	КонецЕсли;
	Параметры = ПараметрыЗапроса();
	Параметры.ИспользоватьИнструменты = Инструменты;
	Попытка
		До = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Просмотр");
		ЮТест.ОжидаетЧто(До.Представление.Готово, До.Представление.Статус).Равно(Истина);
		ПакетДо = ПолучитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ЗапросДо = ПакетДо.Запрос;
		Итог = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Отправка");
		ЮТест.ОжидаетЧто(Итог.Ответ.ЭтоОшибка, Итог.Ответ.ТекстОшибки).Равно(Ложь);
		ЮТест.ОжидаетЧто(Итог.Ответ.ЗапросЧата).Равно(ЗапросДо);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Итог.Ответ.ТекстОтвета);
		Факт = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если Инструменты Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(До.Представление.Сообщения);
			ОжидаютсяСообщения = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			ЮТест.ОжидаетЧто(Факт.messages).Равно(ОжидаютсяСообщения);
		Иначе
			ЮТест.ОжидаетЧто(Факт.messages[0].content).Равно(До.Представление.Инструкция);
			ЮТест.ОжидаетЧто(Факт.messages[Факт.messages.Количество() - 1].content).Равно(До.Представление.Вопрос);
		КонецЕсли;
		Записи = КИИ_КонтекстДиалога.ЖурналДиалога(Параметры.Диалог);
		ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Записи[0].ЗапросЧата).Равно(ЗапросДо);
	Исключение
		УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
КонецПроцедуры

Процедура СоздатьЗаписьДиалога(Знач Диалог, Знач Пользователь)
	Запись = РегистрыСведений.КИИ_ЛогЗапросовИИ.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Новый УникальныйИдентификатор;
	Запись.УниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись.ДиалогЧата = Диалог;
	Запись.ПользовательИБ = Пользователь;
	Запись.Записать();
КонецПроцедуры

#КонецОбласти

Процедура Контекст_RAG_ПодборИсточникиИОтправка() Экспорт
	Данные = ДанныеЗапроса("chat-context-plain");
	ЧатМодель = Данные.Эксперт.Модель.ПолучитьОбъект();
	ЧатМодель.КлассEgress = Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее;
	ЧатМодель.Записать();
	Эмбеддер = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Эмбеддер.Наименование = "000000000 ЮТ контекст эмбеддинг";
	Эмбеддер.НаименованиеПровайдера = "OpenAI";
	Эмбеддер.НаименованиеПолное = "chat-context-embedding";
	Эмбеддер.ТипМодели = Перечисления.КИИ_ТипыМоделей.Эмбеддинг;
	Эмбеддер.КлассEgress = Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее;
	Эмбеддер.РазмерностьЭмбеддинга = 3;
	Эмбеддер.Адрес = "127.0.0.1:8873";
	Эмбеддер.EndpointЭмбеддингов = "/emb-chat-context/embeddings";
	Эмбеддер.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	Эмбеддер.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	Эмбеддер.ИспользоватьЗащищенноеСоединение = Ложь;
	Эмбеддер.ИспользоватьПрокси = Ложь;
	Эмбеддер.Таймаут = 10;
	Эмбеддер.РежимКонтроляПерсональныхДанных = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен;
	Эмбеддер.Записать();
	// До поиска доказываем выбор именно локальной модели, исключая обращения к прежним провайдерам.
	ЮТест.ОжидаетЧто(КИИ_RAG.ТекущаяМодельЭмбеддер()).Равно(Эмбеддер.Ссылка);
	Категория = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.КИИ_КатегорииЗнаний,
		"ЮТ контекст категория",
		Новый Структура("ПолитикаЭмбеддинга", Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее)
	);
	База = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.КИИ_БазаЗнаний,
		"ЮТ контекст источник",
		Новый Структура("Категория,Содержимое", Категория, "Сведения только проверочного индекса.")
	);
	КИИ_RAG.ПереиндексироватьБазу(База);
	Выборка = Справочники.КИИ_ФрагментыЗнаний.Выбрать(, База);
	ЮТест.ОжидаетЧто(Выборка.Следующий()).Равно(Истина);
	Фрагмент = Выборка.Ссылка.ПолучитьОбъект();
	Вектор = Новый Массив;
	Вектор.Добавить(1);
	Вектор.Добавить(0);
	Вектор.Добавить(0);
	Фрагмент.Эмбеддинг = Новый ХранилищеЗначения(Вектор);
	Фрагмент.КодМоделиЭмбеддинга = КИИ_RAG.КодМоделиЭмбеддинга("OpenAI", "chat-context-embedding");
	Фрагмент.Размерность = 3;
	Фрагмент.НормаИсходная = 1;
	Фрагмент.Записать();
	Источник = ПолучитьНавигационнуюСсылку(Фрагмент.Ссылка);
	Эксперт = Данные.Эксперт.ПолучитьОбъект();
	Эксперт.КатегорииЗнаний.Добавить().Категория = Категория;
	Эксперт.Записать();
	ЮТест.ОжидаетЧто(КИИ_RAG.ЕстьКатегорииЗнанийЭксперта(Данные.Эксперт)).Равно(Истина);
	Параметры = ПараметрыЗапроса();
	Попытка
		До = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Просмотр");
		ЮТест.ОжидаетЧто(До.Представление.Готово).Равно(Ложь);
		ЮТест.ОжидаетЧто(До.Представление.Знания).Равно("");
		Подбор = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Знания");
		ЮТест.ОжидаетЧто(Подбор.Представление.Готово, Подбор.Представление.Статус).Равно(Истина);
		ЮТест.ОжидаетЧто(ПолучитьИзВременногоХранилища(Параметры.АдресПодготовки).ДиагностикаЗнаний).Равно("");
		ЮТест.ОжидаетЧто(СтрНайти(Подбор.Представление.Инструкция, "Сведения только проверочного индекса.") > 0).Равно(
			Истина);
		ЮТест.ОжидаетЧто(СтрНайти(Подбор.Представление.Знания, Источник) > 0).Равно(Истина);
		Пакет = ПолучитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ЮТест.ОжидаетЧто(Пакет.ИсточникиЗнаний.Количество()).Равно(1);
		ЗапросПодбора = Пакет.Запрос;
		Данные.Знания = ""; // Следующий вызов формы повторно собирает исходные данные без локально подобранной справки.
		Итог = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Отправка");
		ЮТест.ОжидаетЧто(Итог.Ответ.ЭтоОшибка, Итог.Ответ.ТекстОшибки).Равно(Ложь);
		ЮТест.ОжидаетЧто(Итог.Ответ.ЗапросЧата).Равно(ЗапросПодбора);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Итог.Ответ.ТекстОтвета);
		Факт = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		ЮТест.ОжидаетЧто(Факт.messages[0].content).Равно(Подбор.Представление.Инструкция);
		Инструкция = "";
		Для Номер = 1 По 81 Цикл
			Инструкция = Инструкция
				+ "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
		КонецЦикла;
		БезБюджета = КИИ_RAG.ЗнанияЭкспертаДляДиалога(Данные.Эксперт, Данные.Вопрос, Инструкция);
		ЮТест.ОжидаетЧто(БезБюджета.Дополнение).Равно("");
		ЮТест.ОжидаетЧто(БезБюджета.Источники.Количество()).Равно(0);
		Параметры.Настройки.ИспользоватьЗнания = Ложь;
		БезЗнаний = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Просмотр");
		ЮТест.ОжидаетЧто(БезЗнаний.Представление.Готово).Равно(Истина);
		ЮТест.ОжидаетЧто(БезЗнаний.Представление.Знания).Равно("");
	Исключение
		УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
КонецПроцедуры
