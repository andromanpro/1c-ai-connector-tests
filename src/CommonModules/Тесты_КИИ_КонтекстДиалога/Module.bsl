Процедура Контекст_ПросмотрНеОбращаетсяКМодели() Экспорт
	Данные = ДанныеЗапроса("must-not-send");
	Параметры = ПараметрыЗапроса();
	Попытка
		Итог = КИИ_КонтекстДиалога.ВыполнитьОперацию(Данные, Параметры, "Просмотр");
		ЮТест.ОжидаетЧто(Итог.Представление.Готово).Равно(Истина);
		ЮТест.ОжидаетЧто(Итог.Ответ).Равно(Неопределено);
		ЮТест.ОжидаетЧто(Итог.Представление.Вопрос).Равно("Вопрос");
		ЮТест.ОжидаетЧто(КИИ_КонтекстДиалога.ЖурналДиалога(Параметры.Диалог).Количество()).Равно(0);
	Исключение
		УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Параметры.АдресПодготовки);
КонецПроцедуры

