#Область СлужебныеПроцедурыИФункции

Функция ДанныеКонтекста()
	Данные = Новый Структура;
	Данные.Вставить("Вопрос", "Вопрос");
	Данные.Вставить("Инструкция", "Инструкция");
	Данные.Вставить("Знания", "Знания");
	Данные.Вставить("История", Новый Массив);
	Данные.История.Добавить(Новый Структура("Роль,Текст", "user", "Ранее"));
	Данные.История.Добавить(Новый Структура("Роль,Текст", "assistant", "Ответ"));
	Данные.Вставить("Вложения", Новый Массив);
	Данные.Вложения.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL("https://example.invalid/test.png"));
	Данные.Вставить("ПоследнийВопросДобавлен", Ложь);
	Возврат Данные;
КонецФункции

#КонецОбласти

