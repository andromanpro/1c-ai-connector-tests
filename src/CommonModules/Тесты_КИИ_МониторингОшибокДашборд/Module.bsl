// Критичность журнала переходит в код уровня страницы; без критичности - none (ошибка еще не оценена).
Процедура Модель_УровниКритичности() Экспорт

	День = ДатаОкончанияТеста();
	Вхождения = Новый Массив;
	ОшибкиЖурнала = Новый Массив;
	Уровни = Новый Соответствие;
	Уровни.Вставить("h-crit", Перечисления.КИИ_УровниКритичности.Критическая);
	Уровни.Вставить("h-high", Перечисления.КИИ_УровниКритичности.Высокая);
	Уровни.Вставить("h-mid", Перечисления.КИИ_УровниКритичности.Средняя);
	Уровни.Вставить("h-low", Перечисления.КИИ_УровниКритичности.Низкая);
	Уровни.Вставить("h-none", Перечисления.КИИ_УровниКритичности.ПустаяСсылка());
	Количество = 10;
	Для Каждого ЭлементУровня Из Уровни Цикл
		Вхождения.Добавить(СтрокаВхождений(День, ЭлементУровня.Ключ, Количество));
		ОшибкиЖурнала.Добавить(СтрокаЖурнала(ЭлементУровня.Ключ, ЭлементУровня.Значение));
		Количество = Количество + 1;
	КонецЦикла;

	Модель = КИИ_МониторингОшибокДашборд.СобратьМодель(Вхождения, ОшибкиЖурнала, Новый Массив, Сведения(День));

	ЮТест.ОжидаетЧто(Модель.errors.Количество()).Равно(5);
	ЮТест.ОжидаетЧто(УровеньПоТексту(Модель, "h-crit")).Равно("crit");
	ЮТест.ОжидаетЧто(УровеньПоТексту(Модель, "h-high")).Равно("high");
	ЮТест.ОжидаетЧто(УровеньПоТексту(Модель, "h-mid")).Равно("mid");
	ЮТест.ОжидаетЧто(УровеньПоТексту(Модель, "h-low")).Равно("low");
	ЮТест.ОжидаетЧто(УровеньПоТексту(Модель, "h-none")).Равно("none");

КонецПроцедуры

// Пары [индекс дня, вхождений], флаги журнала и моменты в формате страницы; порядок - по убыванию вхождений.
Процедура Модель_СчетчикиФлагиИМоменты() Экспорт

	ДатаОкончания = ДатаОкончанияТеста();
	Вхождения = Новый Массив;
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания, "h-often", 7));
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания - 86400, "h-often", 5));
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания, "h-rare", 1));

	Частая = СтрокаЖурнала("h-often", Перечисления.КИИ_УровниКритичности.Высокая);
	Частая.Игнорировать = Истина;
	Частая.ПроанализированаИИ = Истина;
	Частая.ОтправленаВТелеграм = Истина;
	Частая.ОписаниеОтИИ = "Совет ИИ";
	Частая.ПерваяДатаВремя = Дата(2026, 9, 15, 8, 5, 0);
	Частая.ПоследнееВхождение = Дата(2026, 9, 16, 18, 40, 0);
	ОшибкиЖурнала = Новый Массив;
	ОшибкиЖурнала.Добавить(Частая);
	ОшибкиЖурнала.Добавить(СтрокаЖурнала("h-rare", Перечисления.КИИ_УровниКритичности.Низкая));

	Модель = КИИ_МониторингОшибокДашборд.СобратьМодель(Вхождения, ОшибкиЖурнала, Новый Массив, Сведения(ДатаОкончания));

	ЮТест.ОжидаетЧто(Модель.days.Количество()).Равно(180);
	ЮТест.ОжидаетЧто(Модель.days[179]).Равно("2026-09-16");
	ЮТест.ОжидаетЧто(Модель.errors.Количество()).Равно(2);

	Первая = Модель.errors[0];
	ЮТест.ОжидаетЧто(Первая.text).Равно("Текст h-often");
	ЮТест.ОжидаетЧто(Первая.ignored).Равно(Истина);
	ЮТест.ОжидаетЧто(Первая.analyzed).Равно(Истина);
	ЮТест.ОжидаетЧто(Первая.telegram).Равно(Истина);
	ЮТест.ОжидаетЧто(Первая.ai).Равно("Совет ИИ");
	ЮТест.ОжидаетЧто(Первая.first).Равно("2026-09-15T08:05");
	ЮТест.ОжидаетЧто(Первая.last).Равно("2026-09-16T18:40");
	ЮТест.ОжидаетЧто(СуммаВхождений(Первая)).Равно(12);
	ЮТест.ОжидаетЧто(ВхожденийВДень(Первая, 179)).Равно(7);
	ЮТест.ОжидаетЧто(ВхожденийВДень(Первая, 178)).Равно(5);

	Вторая = Модель.errors[1];
	ЮТест.ОжидаетЧто(Вторая.ignored).Равно(Ложь);
	ЮТест.ОжидаетЧто(Вторая.ai).Равно("");
	ЮТест.ОжидаетЧто(Вторая.first).Равно("");

КонецПроцедуры

Процедура Модель_ВхожденияВнеОкнаНеПопадают() Экспорт

	ДатаОкончания = ДатаОкончанияТеста();
	Вхождения = Новый Массив;
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания - 180 * 86400, "h-old", 50));
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания + 86400, "h-future", 50));
	Вхождения.Добавить(СтрокаВхождений(ДатаОкончания - 179 * 86400, "h-edge", 2));

	Модель = КИИ_МониторингОшибокДашборд.СобратьМодель(Вхождения, Новый Массив, Новый Массив, Сведения(ДатаОкончания));

	ЮТест.ОжидаетЧто(Модель.errors.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ВхожденийВДень(Модель.errors[0], 0)).Равно(2);

КонецПроцедуры

