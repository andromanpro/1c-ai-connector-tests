// Модель из живых регистров: засев в транзакции, после проверки - откат.
Процедура Модель_ИзРегистров() Экспорт

	Хеш = "dashboard-test-" + Строка(Новый УникальныйИдентификатор);
	ДатаОкончания = ТекущаяДатаСеанса();

	НачатьТранзакцию();
	Попытка
		Статистика = РегистрыСведений.КИИ_МониторингОшибокСтатистика.СоздатьМенеджерЗаписи();
		Статистика.Период = НачалоДня(ДатаОкончания);
		Статистика.ХешОшибки = Хеш;
		Статистика.Количество = 17;
		Статистика.Записать();

		Журнал = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьМенеджерЗаписи();
		Журнал.ХешОшибки = Хеш;
		Журнал.Критичность = Перечисления.КИИ_УровниКритичности.Критическая;
		Журнал.ТекстОшибки = "Тестовая ошибка дашборда";
		Журнал.Метаданные = "Документ.ТестДашборда";
		Журнал.Записать();

		Модель = КИИ_МониторингОшибокДашборд.МодельДашборда(ДатаОкончания);
		Найденная = Неопределено;
		Для Каждого Ошибка Из Модель.errors Цикл
			Если Ошибка.text = "Тестовая ошибка дашборда" Тогда
				Найденная = Ошибка;
			КонецЕсли;
		КонецЦикла;

		ЮТест.ОжидаетЧто(Найденная <> Неопределено).Равно(Истина);
		ЮТест.ОжидаетЧто(Найденная.level).Равно("crit");
		ЮТест.ОжидаетЧто(Найденная.object).Равно("Документ.ТестДашборда");
		ЮТест.ОжидаетЧто(ВхожденийВДень(Найденная, 179)).Равно(17);

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Аудит P2-2: глубокий анализ берет самую частую ошибку за период дашборда (сумма вхождений из статистики),
// а не ошибку с наибольшим накопленным числом повторений в журнале; ошибки под правилами игнорирования не берутся.
Процедура ГлубокийАнализ_СамаяЧастаяЗаПериод() Экспорт

	// Измерение ХешОшибки - 32 символа: длиннее обрежется при записи и не совпадет с ожидаемым.
	Основа = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 29);
	ХешСтарой = "old" + Основа;
	ХешНовой = "new" + Основа;
	ХешИгнорируемой = "ign" + Основа;
	ДатаОкончания = ТекущаяДатаСеанса();
	Сегодня = НачалоДня(ДатаОкончания);

	НачатьТранзакцию();
	Попытка
		// Старая: за историю 900 001 повторение, но в последние 7 дней одно вхождение.
		ЗаписатьСтатистику(Сегодня, ХешСтарой, 1);
		ЗаписатьСтатистику(Сегодня - 30 * 86400, ХешСтарой, 900000);
		ЗаписатьЖурнал(ХешСтарой, 900001, Ложь, ДатаОкончания);
		// Новая: 100 000 вхождений позавчера.
		ЗаписатьСтатистику(Сегодня - 2 * 86400, ХешНовой, 100000);
		ЗаписатьЖурнал(ХешНовой, 100000, Ложь, ДатаОкончания);
		// Под правилом игнорирования: чаще всех, но анализировать ее не нужно.
		ЗаписатьСтатистику(Сегодня, ХешИгнорируемой, 500000);
		ЗаписатьЖурнал(ХешИгнорируемой, 500000, Истина, ДатаОкончания);

		ЮТест.ОжидаетЧто(КИИ_МониторингОшибокДашборд.ХешСамойЧастойОшибки(ДатаОкончания, 7)).Равно(ХешНовой);
		ЮТест.ОжидаетЧто(КИИ_МониторингОшибокДашборд.ХешСамойЧастойОшибки(ДатаОкончания, 90)).Равно(ХешСтарой);

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Контракт старого дашборда «пустой период - заглушка»: на странице есть блок пустого состояния,
