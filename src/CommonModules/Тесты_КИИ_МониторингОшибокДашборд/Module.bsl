	ОбратнаяКосаяЧерта = Символ(92);
	Экранированный = "Вывод " + ОбратнаяКосаяЧерта + "u003c/script" + ОбратнаяКосаяЧерта + "u003e"
		+ ОбратнаяКосаяЧерта + "u003cimg src=x onerror=alert(1)" + ОбратнаяКосаяЧерта + "u003e "
		+ ОбратнаяКосаяЧерта + "u0026 итог %DASHBOARD_DATA%";
	ЮТест.ОжидаетЧто(КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы().ТекстГлубокогоАнализа).Равно("");
	ЮТест.ОжидаетЧто(СтрНайти(Страница, """deep""") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Страница, Экранированный) > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(НРег(Страница), "</script><img") = 0).Равно(Истина);
	ЮТест.ОжидаетЧто(Модель.Свойство("deep")).Равно(Ложь);

