	ЮТест.ОжидаетЧто(СтрНайти(Страница, "src=""/base/hs/iikona-dashboard/echarts?v=6.1.0""") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Страница, "src=""/base/hs/iikona-dashboard/script""") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Страница, "Licensed to the Apache Software Foundation") = 0).Равно(Истина);
	// Аудит P3-1: автообновление - таймером скрипта по адресу с открытым периодом и темой, не meta refresh
