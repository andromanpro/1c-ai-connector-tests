КонецПроцедуры

// Контракт старого дашборда «светлая тема по умолчанию»; неизвестная тема тоже дает светлую.
Процедура Страница_СветлаяТемаПоУмолчанию() Экспорт

	// Страница без встроенной библиотеки: в коде ECharts есть свои onload, и проверка по ним была бы беззубой.
	Модель = ПустаяМодель();
	НастройкиСтраницы = КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы();
	НастройкиСтраницы.ВстроитьСкрипты = Ложь;
	ПоУмолчанию = КИИ_МониторингОшибокДашборд.СобратьСтраницу(Модель, НастройкиСтраницы);
	НастройкиСтраницы.Тема = "evil"" onload=""alert(1)";
	Неизвестная = КИИ_МониторингОшибокДашборд.СобратьСтраницу(Модель, НастройкиСтраницы);
	НастройкиСтраницы.Тема = "dark";
	Темная = КИИ_МониторингОшибокДашборд.СобратьСтраницу(Модель, НастройкиСтраницы);

	ЮТест.ОжидаетЧто(КИИ_МониторингОшибокДашборд.НовыеНастройкиСтраницы().Тема).Равно("light");
	ЮТест.ОжидаетЧто(СтрНайти(ПоУмолчанию, "data-theme=""light""") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Неизвестная, "data-theme=""light""") > 0).Равно(Истина);
