Функция СтрокаВхождений(Знач Период, Знач ХешОшибки, Знач Количество)

	Возврат Новый Структура("Период, ХешОшибки, Количество", Период, ХешОшибки, Количество);

КонецФункции

Функция СтрокаЖурнала(Знач ХешОшибки, Знач Критичность)

	ЗаписьЖурнала = Новый Структура;
	ЗаписьЖурнала.Вставить("ХешОшибки", ХешОшибки);
	ЗаписьЖурнала.Вставить("Критичность", Критичность);
	ЗаписьЖурнала.Вставить("Метаданные", "Документ.Тест");
	ЗаписьЖурнала.Вставить("Событие", "Ошибка выполнения");
	ЗаписьЖурнала.Вставить("ТекстОшибки", "Текст " + ХешОшибки);
	ЗаписьЖурнала.Вставить("ОписаниеОтИИ", "");
	ЗаписьЖурнала.Вставить("Игнорировать", Ложь);
	ЗаписьЖурнала.Вставить("ПроанализированаИИ", Ложь);
	ЗаписьЖурнала.Вставить("ОтправленаВТелеграм", Ложь);
	ЗаписьЖурнала.Вставить("ПерваяДатаВремя", Дата(1, 1, 1));
	ЗаписьЖурнала.Вставить("ПоследнееВхождение", Дата(1, 1, 1));
	Возврат ЗаписьЖурнала;

КонецФункции

Функция УровеньПоТексту(Знач Модель, Знач ХешОшибки)

	Для Каждого Ошибка Из Модель.errors Цикл
		Если Ошибка.text = "Текст " + ХешОшибки Тогда
			Возврат Ошибка.level;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция СуммаВхождений(Знач Ошибка)

	Всего = 0;
	Для Каждого Пара Из Ошибка.counts Цикл
		Всего = Всего + Пара[1];
	КонецЦикла;
	Возврат Всего;

КонецФункции

Функция ВхожденийВДень(Знач Ошибка, Знач ИндексДня)

	Для Каждого Пара Из Ошибка.counts Цикл
		Если Пара[0] = ИндексДня Тогда
			Возврат Пара[1];
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

#КонецОбласти
