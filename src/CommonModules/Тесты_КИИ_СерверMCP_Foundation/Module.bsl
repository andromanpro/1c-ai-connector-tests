// Данные ошибки для клиента содержат только correlation_id, без внутренних деталей.
Процедура Диспетчер_ДанныеОшибкиСКорреляцией_БезДеталей() Экспорт

	Деталь = "Модуль.Метод: внутренняя секретная деталь стека";

	Данные = КИИ_СерверMCPДиспетчер.СформироватьДанныеОшибкиСКорреляцией(Деталь, "ИИКона.Тест.СерверMCPКорреляция");

	ЮТест.ОжидаетЧто(Данные).Свойство("correlation_id").Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(ОбщегоНазначения.ЗначениеВJSON(Данные), "секретная") > 0).Равно(Ложь);

КонецПроцедуры

// Валидационная ошибка инструмента (невалидные входные данные) возвращается клиенту
// текстом с кодом -32602 и БЕЗ correlation_id; внутренние ошибки по-прежнему дают
// Internal error с корреляцией (см. Диспетчер_ДанныеОшибкиСКорреляцией_БезДеталей).
Процедура Диспетчер_ВалидационнаяОшибкаИнструмента_ТекстБезКорреляции() Экспорт
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("object_type", "Абракадабра");
	Аргументы.Вставить("name", "НетТакогоОбъекта");
	
	Параметры = Новый Структура;
	Параметры.Вставить("name", "get_object_structure");
	Параметры.Вставить("arguments", Аргументы);
	
	Ответ = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCP(ЗапросJSON("tools/call", 6, Параметры));
	
	ЮТест.ОжидаетЧто(Ответ.error.code).Равно(-32602);
	ЮТест.ОжидаетЧто(СтрНайти(Ответ.error.message, "Неподдерживаемый тип метаданных") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(ОбщегоНазначения.ЗначениеВJSON(Ответ.error), "correlation_id") > 0).Равно(Ложь);
	
КонецПроцедуры

// Регламентная очистка аудита MCP: записи старше пороговой даты удаляются, свежие остаются.
Процедура Аудит_ОчисткаУдаляетСтарыеЗаписи() Экспорт

	ИдентификаторСтарой = Строка(Новый УникальныйИдентификатор);
	ИдентификаторСвежей = Строка(Новый УникальныйИдентификатор);
	СидЗаписьАудита(ИдентификаторСтарой, ТекущаяУниверсальнаяДата() - 40 * 86400);
	СидЗаписьАудита(ИдентификаторСвежей, ТекущаяУниверсальнаяДата());

	Попытка
		ПороговаяДата = ТекущаяУниверсальнаяДата() - 30 * 86400;
		КИИ_СерверMCPАудит.ОчиститьЗаписиАудитаСтарше(ПороговаяДата);
		ЮТест.ОжидаетЧто(ЗаписьАудитаСуществует(ИдентификаторСтарой)).Равно(Ложь);
		ЮТест.ОжидаетЧто(ЗаписьАудитаСуществует(ИдентификаторСвежей)).Равно(Истина);
	Исключение
		УдалитьЗаписьАудита(ИдентификаторСтарой);
		УдалитьЗаписьАудита(ИдентификаторСвежей);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьЗаписьАудита(ИдентификаторСтарой);
	УдалитьЗаписьАудита(ИдентификаторСвежей);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пишет запись аудита MCP с минимальным набором полей и заданной датой вызова.
Процедура СидЗаписьАудита(Знач Идентификатор, Знач ДатаВызова)

	Набор = РегистрыСведений.КИИ_СерверMCPАудитВызовов.СоздатьНаборЗаписей();
	Набор.Отбор.Идентификатор.Установить(Идентификатор);
	Запись = Набор.Добавить();
	Запись.Идентификатор = Идентификатор;
	Запись.Дата = ДатаВызова;
	Запись.Вызывающий = "тест-очистки";
	Запись.Метод = "tools/call";
	Запись.Результат = "ok";
	Набор.Записать();

КонецПроцедуры

// Истина, если запись аудита с идентификатором существует в регистре.
Функция ЗаписьАудитаСуществует(Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Аудит.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPАудитВызовов КАК Аудит
	|ГДЕ
	|	Аудит.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Удаляет запись аудита по идентификатору (очистка тестовых данных).
Процедура УдалитьЗаписьАудита(Знач Идентификатор)

	Набор = РегистрыСведений.КИИ_СерверMCPАудитВызовов.СоздатьНаборЗаписей();
	Набор.Отбор.Идентификатор.Установить(Идентификатор);
	Набор.Записать();

КонецПроцедуры

Функция ЗапросJSON(Знач ИмяМетода, Знач Идентификатор, Знач Параметры = Неопределено)
	
	ЗапросMCP = Новый Структура;
	ЗапросMCP.Вставить("jsonrpc", "2.0");
	ЗапросMCP.Вставить("id", Идентификатор);
	ЗапросMCP.Вставить("method", ИмяМетода);
	
	Если Параметры <> Неопределено Тогда
		ЗапросMCP.Вставить("params", Параметры);
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеВJSON(ЗапросMCP);
	
КонецФункции

Функция НайтиИнструмент(Инструменты, Знач ИмяИнструмента)
	
	Для Каждого Инструмент Из Инструменты Цикл
		Если Инструмент["name"] = ИмяИнструмента Тогда
			Возврат Инструмент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
