Процедура MCP_ОшибкаЗапросаДоступнаМодели() Экспорт

	Результат = ПробаОшибкиЗапроса("ВЫБРАТЬ Модели.НетТакогоПоля ИЗ Справочник.КИИ_МоделиИИ КАК Модели");
	ЮТест.ОжидаетЧто(Результат.Ответ.Свойство("error")).ЭтоЛожь();
	Ответ = Результат.Ответ.result;
	ЮТест.ОжидаетЧто(Ответ.isError).ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.ok).ЭтоЛожь();
	Ошибка = Ответ.structuredContent.error;
	ЮТест.ОжидаетЧто(Ошибка.code).Равно("query_failed");
	ЮТест.ОжидаетЧто(Ошибка.message).Содержит("НетТакогоПоля");
	ЮТест.ОжидаетЧто(Ошибка.message).Содержит(Ошибка.correlation_id);
	ЮТест.ОжидаетЧто(СтрДлина(Ошибка.correlation_id)).Равно(36);
	ЮТест.ОжидаетЧто(СтрНайти(Ошибка.message, "ОбщийМодуль")).Равно(0);
	ЮТест.ОжидаетЧто(Результат.АудитМета.КодРезультата).Равно("error");

КонецПроцедуры

Процедура MCP_ЗапросИсправляетсяПослеОшибки() Экспорт

	Отказ = ПробаОшибкиЗапроса("ВЫБРАТЬ Модели.НетТакогоПоля ИЗ Справочник.КИИ_МоделиИИ КАК Модели");
	ЮТест.ОжидаетЧто(Отказ.Ответ.result.isError).ЭтоИстина();
	Успех = ПробаОшибкиЗапроса("ВЫБРАТЬ 1 КАК Значение");
	ЮТест.ОжидаетЧто(Успех.Ответ.result.isError).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Успех.Ответ.result.structuredContent.rows[0][0]).Равно(1);
	ЮТест.ОжидаетЧто(Успех.АудитМета.КодРезультата).Равно("ok");

КонецПроцедуры

