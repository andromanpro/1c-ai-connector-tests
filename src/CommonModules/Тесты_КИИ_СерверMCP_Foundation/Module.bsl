// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СерверMCP_Foundation")
			.ДобавитьСерверныйТест("Реестр_СодержитPing")
			.ДобавитьСерверныйТест("Диспетчер_ToolsList_СодержитPing")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_Ping_ВозвращаетPong")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_Ping_МетаДанныеЗаполнены")
			.ДобавитьСерверныйТест("Диспетчер_НеизвестныйМетод_Возвращает32601")
			.ДобавитьСерверныйТест("Диспетчер_НевалидныйJSON_Возвращает32700")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_БезNameПараметра_Возвращает32602")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_НеизвестныйИнструмент_Возвращает32601")
				.ДобавитьСерверныйТест("Диспетчер_ДанныеОшибкиСКорреляцией_БезДеталей")
					.ДобавитьСерверныйТест("Аудит_ПарсЭррор_КодParseError")
					.ДобавитьСерверныйТест("Аудит_ToolsList_КодOk")
					.ДобавитьСерверныйТест("Аудит_НеизвестныйМетод_КодError");
	
КонецПроцедуры

// Проверяет, что container-pattern реестр содержит smoke-инструмент ping.
Процедура Реестр_СодержитPing() Экспорт
	
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	ЗаписьРеестра = Реестр.Найти("ping", "Имя");
	
	ЮТест.ОжидаетЧто(ЗаписьРеестра <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(ЗаписьРеестра.Имя).Равно("ping");
	ЮТест.ОжидаетЧто(ЗаписьРеестра.ИмяМодуля).Равно("КИИ_СерверMCPИнструментPing");
	ЮТест.ОжидаетЧто(ЗаписьРеестра.Схема.type).Равно("object");
	
КонецПроцедуры

// Тест-гэп (аудит P2): аудируемая обёртка ОбработатьЗапросMCPСАудитом — классификация КодРезультата.
Процедура Аудит_ПарсЭррор_КодParseError() Экспорт

	Результат = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCPСАудитом("это не json {");
	ЮТест.ОжидаетЧто(Результат.АудитМета.КодРезультата).Равно("parse_error");

КонецПроцедуры

Процедура Аудит_ToolsList_КодOk() Экспорт

	Результат = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCPСАудитом(ЗапросJSON("tools/list", 1));
	ЮТест.ОжидаетЧто(Результат.АудитМета.КодРезультата).Равно("ok");

КонецПроцедуры

Процедура Аудит_НеизвестныйМетод_КодError() Экспорт

	Результат = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCPСАудитом(ЗапросJSON("нет/такого", 1));
	ЮТест.ОжидаетЧто(Результат.АудитМета.КодРезультата).Равно("error");

КонецПроцедуры

// Проверяет, что tools/list возвращает ping в MCP-формате.
Процедура Диспетчер_ToolsList_СодержитPing() Экспорт
	
	Ответ = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCP(ЗапросJSON("tools/list", 1));
	Инструмент = НайтиИнструмент(Ответ.result.tools, "ping");
	
	ЮТест.ОжидаетЧто(Ответ.jsonrpc).Равно("2.0");
	ЮТест.ОжидаетЧто(Ответ.id).Равно(1);
	ЮТест.ОжидаетЧто(Инструмент <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Инструмент["name"]).Равно("ping");
	ЮТест.ОжидаетЧто(Инструмент["inputSchema"].type).Равно("object");
	
КонецПроцедуры

// Проверяет успешный вызов smoke-инструмента ping через tools/call.
Процедура Диспетчер_ToolsCall_Ping_ВозвращаетPong() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("name", "ping");
	Параметры.Вставить("arguments", Новый Структура);
	
	Ответ = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCP(ЗапросJSON("tools/call", 2, Параметры));
	
	ЮТест.ОжидаетЧто(Ответ.jsonrpc).Равно("2.0");
	ЮТест.ОжидаетЧто(Ответ.id).Равно(2);
	ЮТест.ОжидаетЧто(Ответ.result.ok).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.result.tool).Равно("ping");
	ЮТест.ОжидаетЧто(Ответ.result.data.pong).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.result.data).Свойство("timestamp").Заполнено();
	
КонецПроцедуры

// Проверяет, что result.meta содержит server, version, timestamp.
// Покрывает то что раньше было в smoke-Диспетчер-ping.feature (B.1 cleanup 2026-05-14).
Процедура Диспетчер_ToolsCall_Ping_МетаДанныеЗаполнены() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("name", "ping");
