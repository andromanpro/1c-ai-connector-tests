// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СерверMCP_Foundation")
			.ДобавитьСерверныйТест("Реестр_СодержитPing")
			.ДобавитьСерверныйТест("Диспетчер_ToolsList_СодержитPing")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_Ping_ВозвращаетPong")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_Ping_МетаДанныеЗаполнены")
			.ДобавитьСерверныйТест("Диспетчер_НеизвестныйМетод_Возвращает32601")
			.ДобавитьСерверныйТест("Диспетчер_НевалидныйJSON_Возвращает32700")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_БезNameПараметра_Возвращает32602")
			.ДобавитьСерверныйТест("Диспетчер_ToolsCall_НеизвестныйИнструмент_Возвращает32601")
				.ДобавитьСерверныйТест("Диспетчер_ДанныеОшибкиСКорреляцией_БезДеталей")
					.ДобавитьСерверныйТест("Аудит_ПарсЭррор_КодParseError")
					.ДобавитьСерверныйТест("Аудит_ToolsList_КодOk")
					.ДобавитьСерверныйТест("Аудит_НеизвестныйМетод_КодError")
					.ДобавитьСерверныйТест("Аудит_ОчисткаУдаляетСтарыеЗаписи")
					.ДобавитьСерверныйТест("Диспетчер_ВалидационнаяОшибкаИнструмента_ТекстБезКорреляции");
	
КонецПроцедуры

// Проверяет, что container-pattern реестр содержит smoke-инструмент ping.
Процедура Реестр_СодержитPing() Экспорт
	
	Реестр = КИИ_СерверMCPРеестр.ПолучитьРеестрИнструментов();
	ЗаписьРеестра = Реестр.Найти("ping", "Имя");
	
	ЮТест.ОжидаетЧто(ЗаписьРеестра <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(ЗаписьРеестра.Имя).Равно("ping");
	ЮТест.ОжидаетЧто(ЗаписьРеестра.ИмяМодуля).Равно("КИИ_СерверMCPИнструментPing");
	ЮТест.ОжидаетЧто(ЗаписьРеестра.Схема.type).Равно("object");
	
КонецПроцедуры

