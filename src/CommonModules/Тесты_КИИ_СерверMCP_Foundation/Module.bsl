Функция ПробаОшибкиЗапроса(ТекстЗапроса)

	Аргументы = Новый Структура("query_id,query_text,limit", "query-diagnostics", ТекстЗапроса, 1);
	Параметры = Новый Структура("name,arguments", "execute_query", Аргументы);
	Запрос = Новый Структура("jsonrpc,id,method,params", "2.0", 189, "tools/call", Параметры);
	Тело = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Запрос);
	Возврат КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCPСАудитом(Тело);

КонецФункции

