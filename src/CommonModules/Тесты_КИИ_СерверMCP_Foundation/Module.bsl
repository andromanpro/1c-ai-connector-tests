КонецПроцедуры

// Проверяет JSON-RPC ошибку -32601 для метода вне whitelist.
Процедура Диспетчер_НеизвестныйМетод_Возвращает32601() Экспорт
	
	Ответ = КИИ_СерверMCPДиспетчер.ОбработатьЗапросMCP(ЗапросJSON("resources/list", 3));
	
	ЮТест.ОжидаетЧто(Ответ.error.code).Равно(-32601);
	ЮТест.ОжидаетЧто(Ответ.error.message).Равно("Method not found or not whitelisted");
	
КонецПроцедуры

// Проверяет JSON-RPC ошибку -32700 для невалидного JSON.
