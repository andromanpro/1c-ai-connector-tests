	ЮТТесты.ДобавитьКлиентскийТест("ФормаСтатистикиОшибокОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаПроверкиПоискаОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ЗавершениеПоискаПоказываетНайденныйФрагмент");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаАнализатораКонфигурацииОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаПроверкиПоискаПоСтаройСсылкеЗагружается");
	ЮТТесты.ДобавитьКлиентскийТест("СписокБазЗнанийОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("СписокФрагментовЗнанийОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаГенератораДиаграммОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаДашбордаОшибокОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаНастроекКонтроляДанныхОткрывается");
	ЮТТесты.ДобавитьКлиентскийТест("ФормаТестированияИИОткрывается");

КонецПроцедуры

// Проверяет штатное открытие формы, включая команду копирования разбора.
Процедура ФормаЖурналаОшибокОткрывается() Экспорт

	Форма = ОткрытьФорму("РегистрСведений.КИИ_МониторингОшибокЖурнал.Форма.ФормаСписка");
	Если Форма <> Неопределено Тогда
		Форма.Закрыть();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Форма).НеРавно(Неопределено);

КонецПроцедуры

