// Проверяет заполнение формы и переход к результату после фонового поиска.
// Использует синтетический результат во временном хранилище, без API и записи в базу.
Процедура ЗавершениеПоискаПоказываетНайденныйФрагмент() Экспорт

	Форма = ОткрытьФорму("Обработка.КИИ_ПроверкаПоискаЗнаний.Форма.Форма");
	Попытка
		ИсходнаяСтрока = Форма.НайденныеФрагменты.Добавить();
		Фрагмент = Новый Структура;
		Фрагмент.Вставить("Ссылка", ИсходнаяСтрока.Фрагмент);
		Фрагмент.Вставить("База", ИсходнаяСтрока.База);
		Фрагмент.Вставить("Категория", ИсходнаяСтрока.Категория);
		Фрагмент.Вставить("Score", 0.75);
		Фрагмент.Вставить("Текст", "Синтетический фрагмент без сетевого запроса");
		Знания = Новый Массив;
		Знания.Добавить(Фрагмент);
		ДанныеРезультата = Новый Структура;
		ДанныеРезультата.Вставить("Статус", "ОК");
		ДанныеРезультата.Вставить("Диагностика", "Результат клиентского теста");
		ДанныеРезультата.Вставить("Знания", Знания);
		Адрес = ПоместитьВоВременноеХранилище(ДанныеРезультата, Форма.УникальныйИдентификатор);
		РезультатОперации = Новый Структура("Статус,АдресРезультата", "Выполнено", Адрес);
		Форма.Элементы.СтраницыПоиска.ТекущаяСтраница = Форма.Элементы.СтраницаПараметры;

		КИИ_ПроверкаПоискаКлиент.ПослеПроверкиПоиска(Форма, РезультатОперации, Неопределено);

		ЮТест.ОжидаетЧто(Форма.НайденныеФрагменты.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Форма.ТекстФрагмента).Равно(Фрагмент.Текст);
		ЮТест.ОжидаетЧто(Форма.Элементы.СтраницыПоиска.ТекущаяСтраница.Имя).Равно("СтраницаФрагменты");
		ЮТест.ОжидаетЧто(Форма.ПоискВыполняется).Равно(Ложь);
	Исключение
		Форма.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Форма.Закрыть();

КонецПроцедуры

// Проверяет компиляцию и создание настоящей формы после чистки модулей.
