	Форма = ОткрытьФорму("Обработка.КИИ_АнализаторКонфигурации.Форма.Форма");
	Если Форма <> Неопределено Тогда
		Форма.Закрыть();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Форма).НеРавно(Неопределено);

КонецПроцедуры

// Проверяет компиляцию и создание настоящей формы после чистки модулей.
Процедура ФормаПроверкиПоискаПоСтаройСсылкеЗагружается() Экспорт

	ОткрытьФорму("Справочник.КИИ_БазаЗнаний.Форма.ПроверкаПоиска");
	ФормаПоиска = Неопределено;
	Для Каждого ОкноПриложения Из ПолучитьОкна() Цикл
		Для Каждого ОткрытаяФорма Из ОкноПриложения.Содержимое Цикл
			Если ОткрытаяФорма.ИмяФормы = "Обработка.КИИ_ПроверкаПоискаЗнаний.Форма.Форма" Тогда
				ФормаПоиска = ОткрытаяФорма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ФормаПоиска <> Неопределено Тогда
		ФормаПоиска.Закрыть();
	КонецЕсли;
	ЮТест.ОжидаетЧто(ФормаПоиска).НеРавно(Неопределено);

КонецПроцедуры

