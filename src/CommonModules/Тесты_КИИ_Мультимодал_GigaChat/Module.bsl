// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрирует тесты мультимодального запроса GigaChat.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Мультимодал_GigaChat")
			.ДобавитьСерверныйТест("ТекстИКартинка_ПланируютЗагрузкуИДобавляютID")
			.ДобавитьСерверныйТест("ТекстИДокумент_ПланируютЗагрузкуИВключаютФункции")
			.ДобавитьСерверныйТест("ДваИзображения_Исключение")
			.ДобавитьСерверныйТест("КартинкаПоСсылке_Исключение")
			.ДобавитьСерверныйТест("АдресЗагрузкиФайлов_ИзАдресаМодели")
			.ДобавитьСерверныйТест("АдресЗагрузкиФайлов_ЧужойПуть_Исключение")
			.ДобавитьСерверныйТест("Строка_СохраняетСтарыйФормат");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ТекстИКартинка_ПланируютЗагрузкуИДобавляютID() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("опиши"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(
		ДвоичныеДанныеДляТеста(), "image/png"));

	Результат = СобратьБезСети(Контент, "image-file-id");
	Сообщение = Результат.ТелоЗапроса.messages[0];

	ЮТест.ОжидаетЧто(Результат.КоличествоЗагрузок).Равно(1);
	ЮТест.ОжидаетЧто(Сообщение["content"]).Равно("опиши");
	ЮТест.ОжидаетЧто(Сообщение["attachments"][0]).Равно("image-file-id");

КонецПроцедуры

Процедура ТекстИДокумент_ПланируютЗагрузкуИВключаютФункции() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("прочитай"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(
		ДвоичныеДанныеДляТеста(), "application/pdf", "report.pdf"));

	Результат = СобратьБезСети(Контент, "document-file-id", ОдинИнструмент());
	ТелоЗапроса = Результат.ТелоЗапроса;

	ЮТест.ОжидаетЧто(Результат.КоличествоЗагрузок).Равно(1);
	ЮТест.ОжидаетЧто(ТелоЗапроса.messages[0]["attachments"][0]).Равно("document-file-id");
	ЮТест.ОжидаетЧто(ТелоЗапроса["function_call"]).Равно("auto");
	ЮТест.ОжидаетЧто(ТелоЗапроса["functions"].Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ТелоЗапроса["functions"][1]["name"]).Равно("get_file_content");

КонецПроцедуры

Процедура ДваИзображения_Исключение() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанныеДляТеста(), "image/png"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанныеДляТеста(), "image/jpeg"));

	ЮТест.ОжидаетЧто(КИИ_КоннекторGigaChat)
		.Метод("СформироватьМультимодальноеТелоДляТестов")
		.Параметр(ПараметрыGigaChat())
		.Параметр(ПромптБезСети(Контент))
		.Параметр(Новый Массив)
		.ВыбрасываетИсключение("одно изображение");

КонецПроцедуры

Процедура КартинкаПоСсылке_Исключение() Экспорт

	Контент = Новый Массив;
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL("https://example.com/cat.png"));

	ЮТест.ОжидаетЧто(КИИ_КоннекторGigaChat)
		.Метод("СформироватьМультимодальноеТелоДляТестов")
		.Параметр(ПараметрыGigaChat())
		.Параметр(ПромптБезСети(Контент))
		.Параметр(Новый Массив)
		.ВыбрасываетИсключение("по внешней ссылке");

КонецПроцедуры

Процедура АдресЗагрузкиФайлов_ИзАдресаМодели() Экспорт

	Параметры = ПараметрыGigaChat();
	Параметры.Адрес = "gigachat.devices.sberbank.ru";
	Параметры.АдресЗапроса = "/api/v1/chat/completions";

	ЮТест.ОжидаетЧто(КИИ_КоннекторGigaChat.АдресЗагрузкиФайлов(Параметры))
		.Равно("https://gigachat.devices.sberbank.ru/api/v1/files");

КонецПроцедуры

Процедура АдресЗагрузкиФайлов_ЧужойПуть_Исключение() Экспорт

	Параметры = ПараметрыGigaChat();
	Параметры.АдресЗапроса = "/api/v1/embeddings";

	ЮТест.ОжидаетЧто(КИИ_КоннекторGigaChat)
		.Метод("АдресЗагрузкиФайлов")
		.Параметр(Параметры)
		.ВыбрасываетИсключение("адрес загрузки файлов GigaChat");

КонецПроцедуры

Процедура Строка_СохраняетСтарыйФормат() Экспорт

	ТелоЗапроса = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыGigaChat(), "привет").ТелоЗапроса;
	ЮТест.ОжидаетЧто(ТелоЗапроса.messages[0]["content"]).Равно("привет");

КонецПроцедуры

Функция СобратьБезСети(Знач Контент, Знач ИдентификаторФайла, Знач Инструменты = Неопределено)

	Промпт = ПромптБезСети(Контент);
	Если Инструменты <> Неопределено Тогда
		Промпт.Вставить("Инструменты", Инструменты);
	КонецЕсли;
	ИдентификаторыФайлов = Новый Массив;
	ИдентификаторыФайлов.Добавить(ИдентификаторФайла);

	Возврат КИИ_КоннекторGigaChat.СформироватьМультимодальноеТелоДляТестов(
		ПараметрыGigaChat(), Промпт, ИдентификаторыФайлов);

КонецФункции

Функция ПромптБезСети(Знач Контент)

	Промпт = Новый Структура;
	Промпт.Вставить("СистемныйПромпт", "");
	Промпт.Вставить("ПользовательскийПромпт", Контент);
	Возврат Промпт;

КонецФункции

Функция ОдинИнструмент()

	Схема = Новый Структура("type, properties", "object", Новый Структура);
	ОписаниеФункции = Новый Структура("name, description, parameters",
		"save_summary", "Сохраняет краткое содержание", Схема);
	Инструменты = Новый Массив;
	Инструменты.Добавить(Новый Структура("type, function", "function", ОписаниеФункции));
	Возврат Инструменты;

КонецФункции

Функция ПараметрыGigaChat()

	Параметры = Новый Структура;
	Параметры.Вставить("Адрес", "api.giga.chat");
	Параметры.Вставить("АдресЗапроса", "/v1/chat/completions");
	Параметры.Вставить("ИспользоватьЗащищенноеСоединение", Истина);
	Параметры.Вставить("ИспользоватьПрокси", Ложь);
	Параметры.Вставить("ТипФорматаAPI", Перечисления.КИИ_ТипыФорматовAPI.GigaChat);
	Параметры.Вставить("ТипАвторизации", Неопределено);
	Параметры.Вставить("НаименованиеПровайдера", "GigaChat");
	Параметры.Вставить("НаименованиеПолное", "GigaChat-2-Pro");
	Параметры.Вставить("Температура", 0.7);
	Параметры.Вставить("МаксимумТокенов", 1000);
	Параметры.Вставить("Таймаут", 30);
	Параметры.Вставить("Заголовки", Новый Массив);
	Возврат Параметры;

КонецФункции

Функция ДвоичныеДанныеДляТеста()

	Возврат ПолучитьДвоичныеДанныеИзСтроки("multimodal-gigachat-test", КодировкаТекста.UTF8);

КонецФункции

#КонецОбласти
