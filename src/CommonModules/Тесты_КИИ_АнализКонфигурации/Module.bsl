	Дерево = КИИ_АнализКонфигурации.ПостроитьДеревоМетаданных("общиемодули", Ложь);

	ЮТест.ОжидаетЧто(Дерево.Получить("ОбщиеМодули") <> Неопределено).Равно(Истина);

