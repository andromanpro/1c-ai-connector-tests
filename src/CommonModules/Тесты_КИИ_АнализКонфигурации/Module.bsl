// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("АнализКонфигурации")
			.ДобавитьСерверныйТест("Статистика_ИтогоБольшеНуля")
			.ДобавитьСерверныйТест("Статистика_НесколькоТиповВРезультате")
			.ДобавитьСерверныйТест("СписокОбъектов_ВалидныйТип_НеПусто")
			.ДобавитьСерверныйТест("СписокОбъектов_НеизвестныйТип_Пусто")
			.ДобавитьСерверныйТест("СписокОбъектов_ЭлементИмеетИмя")
			.ДобавитьСерверныйТест("Поиск_НаходитСправочникРасширения")
			.ДобавитьСерверныйТест("Поиск_НесуществующийОбъект_Пусто");

КонецПроцедуры

#КонецОбласти

#Область ТестыСтатистики

// Общий итог статистики положителен (в базе есть объекты метаданных).
Процедура Статистика_ИтогоБольшеНуля() Экспорт

	Статистика = КИИ_АнализКонфигурации.ПолучитьСтатистикуКонфигурации();

	ЮТест.ОжидаетЧто(Статистика.Получить("Итого") > 0).Равно(Истина);

КонецПроцедуры

// В результате несколько типов коллекций (плюс ключ "Итого").
Процедура Статистика_НесколькоТиповВРезультате() Экспорт

	Статистика = КИИ_АнализКонфигурации.ПолучитьСтатистикуКонфигурации();

	ЮТест.ОжидаетЧто(Статистика.Количество() > 1).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыСпискаОбъектов

// Валидный тип метаданных возвращает непустой список.
Процедура СписокОбъектов_ВалидныйТип_НеПусто() Экспорт

	Список = КИИ_АнализКонфигурации.ПолучитьСписокОбъектовТипа("ОбщиеМодули");

	ЮТест.ОжидаетЧто(Список.Количество() > 0).Равно(Истина);

КонецПроцедуры

// Неизвестный тип метаданных возвращает пустой массив (без исключения).
Процедура СписокОбъектов_НеизвестныйТип_Пусто() Экспорт

	Список = КИИ_АнализКонфигурации.ПолучитьСписокОбъектовТипа("НетТакогоТипаМетаданных");

	ЮТест.ОжидаетЧто(Список.Количество()).Равно(0);

КонецПроцедуры

// Элемент списка содержит заполненное имя объекта.
Процедура СписокОбъектов_ЭлементИмеетИмя() Экспорт

	Список = КИИ_АнализКонфигурации.ПолучитьСписокОбъектовТипа("ОбщиеМодули");

	ЮТест.ОжидаетЧто(Список.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Список[0].Получить("Имя"))).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыПоиска

// Поиск находит справочник расширения по имени (интеграция с живыми метаданными).
Процедура Поиск_НаходитСправочникРасширения() Экспорт

	Найденное = КИИ_АнализКонфигурации.НайтиОбъектыМетаданных("КИИ_БазаЗнаний");

	ЮТест.ОжидаетЧто(Найденное.Количество() > 0).Равно(Истина);

КонецПроцедуры

// Поиск несуществующего объекта возвращает пустой результат.
Процедура Поиск_НесуществующийОбъект_Пусто() Экспорт

	Найденное = КИИ_АнализКонфигурации.НайтиОбъектыМетаданных("ЗЗЗНетТакогоОбъектаВообщеXYZ");

	ЮТест.ОжидаетЧто(Найденное.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти
