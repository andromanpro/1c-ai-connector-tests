#Область КонтрактEDT

// Успешный JSON-RPC ответ: ВыполнитьЗапросJSON отдаёт тело напрямую → извлекается result.
Процедура ИзвлечьJSONRPC_Успех_ВозвращаетResult() Экспорт

	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", 1);
	РезультатRPC = Новый Соответствие;
	РезультатRPC.Вставить("content", "данные-EDT");
	Ответ.Вставить("result", РезультатRPC);

	Извлечённое = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(Ответ);

	ЮТест.ОжидаетЧто(Извлечённое.Получить("Ошибка")).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Извлечённое.Получить("content")).Равно("данные-EDT");

КонецПроцедуры

// JSON-RPC error-объект → возвращается message как Ошибка.
Процедура ИзвлечьJSONRPC_ОшибкаОбъект_ВозвращаетСообщение() Экспорт

	Ответ = Новый Соответствие;
	ОшибкаОбъект = Новый Соответствие;
	ОшибкаОбъект.Вставить("code", -32601);
	ОшибкаОбъект.Вставить("message", "Method not found");
	Ответ.Вставить("error", ОшибкаОбъект);

	Извлечённое = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(Ответ);

	ЮТест.ОжидаетЧто(Извлечённое.Получить("Ошибка")).Равно("Method not found");

КонецПроцедуры

// Транспортная/HTTP-ошибка ВыполнитьЗапросJSON = {error, status_code} → Ошибка.
Процедура ИзвлечьJSONRPC_ТранспортнаяОшибка_ВозвращаетОшибку() Экспорт

	Ответ = Новый Соответствие;
	Ответ.Вставить("error", "Нет результата");
	Ответ.Вставить("status_code", 0);

	Извлечённое = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(Ответ);

	ЮТест.ОжидаетЧто(Извлечённое.Получить("Ошибка")).Равно("Нет результата");

КонецПроцедуры

// Ни result, ни error → тело оборачивается в {Данные}, признак ошибки отсутствует.
Процедура ИзвлечьJSONRPC_БезResultИError_ВозвращаетДанные() Экспорт

	Ответ = Новый Соответствие;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", 1);

	Извлечённое = КИИ_HTTPКлиент.ИзвлечьРезультатJSONRPC(Ответ);

	ЮТест.ОжидаетЧто(Извлечённое.Получить("Ошибка")).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Извлечённое.Получить("Данные") <> Неопределено).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область HTTPКлиентURL

// Позитив/регресс: обычный https-URL разбирается на сервер/адрес/порт/схему.
Процедура РазбитьURL_ПростойHttps_КорректныйРазбор() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("https://api.openai.com/v1/chat");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("api.openai.com");
	ЮТест.ОжидаетЧто(Структура.Адрес).Равно("/v1/chat");
	ЮТест.ОжидаетЧто(Структура.Порт).Равно(443);
	ЮТест.ОжидаетЧто(Структура.Защищенное).Равно(Истина);

КонецПроцедуры

// Позитив/регресс: http с явным портом — порт и незащищённая схема.
Процедура РазбитьURL_HttpСПортом_КорректныйПортИСхема() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("http://localhost:8764/mcp");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("localhost");
	ЮТест.ОжидаетЧто(Структура.Порт).Равно(8764);
	ЮТест.ОжидаетЧто(Структура.Защищенное).Равно(Ложь);
	ЮТест.ОжидаетЧто(Структура.Адрес).Равно("/mcp");

КонецПроцедуры

// Ломалка (аудит P1·PLAUSIBLE): СтрЗаменить(URL,"https://","") ГЛОБАЛЬНО вырезал https:// и из
// query → порча параметра. Query-значение с https:// обязано сохраниться целиком.
Процедура РазбитьURL_HttpsВQuery_НеТеряется() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("https://host.example/api?cb=https://callback.example/x");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("host.example");
	ЮТест.ОжидаетЧто(Структура.Адрес).Равно("/api?cb=https://callback.example/x");
	ЮТест.ОжидаетЧто(Структура.Защищенное).Равно(Истина);

КонецПроцедуры

// Ломалка (аудит P1·PLAUSIBLE): http:// внутри query также вырезался глобальным СтрЗаменить.
Процедура РазбитьURL_HttpВПути_НеТеряется() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("https://host.example/redirect?u=http://x.example/p");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("host.example");
	ЮТест.ОжидаетЧто(СтрНайти(Структура.Адрес, "http://x.example/p") > 0).Равно(Истина);

КонецПроцедуры

// Ломалка (аудит P2): userinfo (user:pass@host) — ':' в учётке ломал разбор, сервер=user, порт=0.
Процедура РазбитьURL_Userinfo_СерверБезУчётки() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("https://user:pass@host.example:8080/path");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("host.example");
	ЮТест.ОжидаетЧто(Структура.Порт).Равно(8080);

КонецПроцедуры

// Ломалка (аудит P2): IPv6-литерал [::1]:port — ':' внутри адреса ломал разбор порта.
Процедура РазбитьURL_IPv6_СерверВСкобках() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("http://[::1]:9000/x");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("[::1]");
	ЮТест.ОжидаетЧто(Структура.Порт).Равно(9000);
	ЮТест.ОжидаетЧто(Структура.Адрес).Равно("/x");

КонецПроцедуры

// Ломалка (аудит P2): нечисловой порт молча давал Порт=0 → дефолт схемы (443/80).
Процедура РазбитьURL_БитыйПорт_ДефолтСхемы() Экспорт

	Структура = КИИ_HTTPКлиент.РазбитьURL("https://host.example:notaport/x");

	ЮТест.ОжидаетЧто(Структура.Сервер).Равно("host.example");
	ЮТест.ОжидаетЧто(Структура.Порт).Равно(443);

КонецПроцедуры

