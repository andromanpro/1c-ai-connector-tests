		Настройки = КИИ_МониторингОшибок.ПолучитьНастройкиМониторинга();

		ЮТест.ОжидаетЧто(ТипЗнч(Настройки.УровниОшибокЖР)).Равно(Тип("Массив"));
		ЮТест.ОжидаетЧто(Настройки.ПорогОтправкиВТелеграм).Равно(7);
	Исключение
		Константы.КИИ_МониторингОшибокНастройки.Установить(ИсходноеЗначение);
		ВызватьИсключение;
	КонецПопытки;

	Константы.КИИ_МониторингОшибокНастройки.Установить(ИсходноеЗначение);

