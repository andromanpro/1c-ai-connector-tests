Процедура Фильтр_ТестовыйСтекПодБоевымСобытием_Отсекается() Экспорт

	// Стек взят с РЕАЛЬНОЙ записи ЖР: раннер YAxUnit всегда присутствует в кадрах
	// ({YAXUNIT ОбщийМодуль.ЮТ...}) - именно он служит маркером, а не имя тестового модуля
	// (подстрока "Тесты_" убрана из маркеров: боевой модуль клиента может так называться).
	Массив = Новый Массив;
	Массив.Добавить(ЗаписьЖРДляТеста(
		"Ошибка при вызове метода контекста (ЗаписатьJSON)
		|{ИИКона ОбщийМодуль.КИИ_HTTPКлиент.Модуль(342)}:ЗаписатьJSON(ЗаписьJSON, Данные);
		|{Тесты ОбщийМодуль.Тесты_КИИ_АнализКонфигурации.Модуль(550)}:Результат = КИИ_HTTPКлиент.ВыполнитьЗапрос(""POST"", Тело);
		|{YAXUNIT ОбщийМодуль.ЮТМетодыСлужебный.Модуль(228)}:Выполнить(Выражение);",
		"КИИ.HTTPКлиент.Сериализация"));

	Хеши = КИИ_МониторингОшибокЖР.ВыполнитьДедупликациюВПамяти(Массив);

	ЮТест.ОжидаетЧто(КоличествоКлючей(Хеши)).Равно(0);

КонецПроцедуры

