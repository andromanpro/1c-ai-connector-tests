		+ "{""критичность"":""low"",""описание"":""мелочь""}" + Символы.ПС + "```";
	Результат = КИИ_МониторингОшибок.ПарситьОтветИИДляТестов(Текст);
	ЮТест.ОжидаетЧто(Результат.Успех).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Критичность).Равно(Перечисления.КИИ_УровниКритичности.Низкая);
	ЮТест.ОжидаетЧто(Результат.Описание).Равно("мелочь");
