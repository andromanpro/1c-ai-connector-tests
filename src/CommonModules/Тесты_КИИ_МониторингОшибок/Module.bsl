// Миграция пере-хеширования сливает записи Журнала одного нормализованного класса
// и переносит Статистику на новые ключи. Прогон в транзакции с откатом.
Процедура Миграция_СливаетДублиХешей() Экспорт

	НачатьТранзакцию();

	Хеш1 = КИИ_МониторингОшибокЖР.ВычислитьMD5("уникальный-тест-1");
	Хеш2 = КИИ_МониторингОшибокЖР.ВычислитьMD5("уникальный-тест-2");
	День = НачалоДня(ТекущаяДатаСеанса());

	ЗаписатьТестовуюЗаписьЖурнала(Хеш1, "Сбой обмена 3f2a1b4c-5d6e-4f70-8a9b-0c1d2e3f4a5b", "КИИ.Тест.Миграция", 2);
	ЗаписатьТестовуюЗаписьЖурнала(Хеш2, "Сбой обмена 9e8d7c6b-5a49-4382-b1c0-d9e8f7a6b5c4", "КИИ.Тест.Миграция", 3);
	ЗаписатьТестовуюСтатистику(День, Хеш1, 2);
	ЗаписатьТестовуюСтатистику(День, Хеш2, 3);

	КИИ_МониторингОшибок.ПересчитатьХешиОшибок();

	НовыйХеш = КИИ_МониторингОшибокЖР.ВычислитьХешОшибки("КИИ.Тест.Миграция",
		"Сбой обмена 3f2a1b4c-5d6e-4f70-8a9b-0c1d2e3f4a5b");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ж.КоличествоПовторений КАК Повторений
	|ИЗ РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Ж
	|ГДЕ Ж.ХешОшибки = &Хеш";
	Запрос.УстановитьПараметр("Хеш", НовыйХеш);
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий()).Равно(Истина);
	ЮТест.ОжидаетЧто(Выборка.Повторений).Равно(5);

	ЗапросСтат = Новый Запрос;
	ЗапросСтат.Текст =
	"ВЫБРАТЬ С.Количество КАК Количество
	|ИЗ РегистрСведений.КИИ_МониторингОшибокСтатистика КАК С
	|ГДЕ С.ХешОшибки = &Хеш И С.Период = &Период";
	ЗапросСтат.УстановитьПараметр("Хеш", НовыйХеш);
	ЗапросСтат.УстановитьПараметр("Период", День);
	ВыборкаСтат = ЗапросСтат.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(ВыборкаСтат.Следующий()).Равно(Истина);
	ЮТест.ОжидаетЧто(ВыборкаСтат.Количество).Равно(5);

	ОтменитьТранзакцию();

КонецПроцедуры

// Структура-заглушка записи ЖР для дедупликации.
Функция ЗаписьЖРДляТеста(Знач Комментарий, Знач Событие)

	Возврат Новый Структура("Комментарий, Событие", Комментарий, Событие);

КонецФункции

// Количество пар в соответствии.
Функция КоличествоКлючей(Знач Соответствие)

	Счетчик = 0;
	Для Каждого Пара Из Соответствие Цикл
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Счетчик;

КонецФункции

// Пишет запись Журнала мониторинга с минимальным набором полей.
Процедура ЗаписатьТестовуюЗаписьЖурнала(Знач Хеш, Знач Текст, Знач Событие, Знач Повторений)

	Набор = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьНаборЗаписей();
	Набор.Отбор.ХешОшибки.Установить(Хеш);
	Запись = Набор.Добавить();
	Запись.ХешОшибки = Хеш;
	Запись.ТекстОшибки = Текст;
	Запись.Событие = Событие;
	Запись.КоличествоПовторений = Повторений;
	Запись.ПерваяДатаВремя = ТекущаяДатаСеанса() - 3600;
	Запись.ПоследнееВхождение = ТекущаяДатаСеанса();
	Набор.Записать();

КонецПроцедуры

// Коробочный fail-closed: без разрешения запросов к данным execute_query не попадает
// в whitelist глубокого анализа; с разрешением - полный набор инструментов.
Процедура ГлубокийАнализ_БезРазрешения_ExecuteQueryИсключен() Экспорт

	Инструменты = КИИ_МониторингОшибокАнализ.ИнструментыДляГлубокогоАнализа(Ложь);
	ЮТест.ОжидаетЧто(Инструменты.Найти("execute_query") = Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Инструменты.Количество() > 0).Равно(Истина);

	Инструменты = КИИ_МониторингОшибокАнализ.ИнструментыДляГлубокогоАнализа(Истина);
	ЮТест.ОжидаетЧто(Инструменты.Найти("execute_query") <> Неопределено).Равно(Истина);

КонецПроцедуры

// Пишет строку Статистики мониторинга.
Процедура ЗаписатьТестовуюСтатистику(Знач Период, Знач Хеш, Знач Количество)

	Набор = РегистрыСведений.КИИ_МониторингОшибокСтатистика.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.ХешОшибки.Установить(Хеш);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.ХешОшибки = Хеш;
	Запись.Количество = Количество;
	Набор.Записать();

КонецПроцедуры


#КонецОбласти
