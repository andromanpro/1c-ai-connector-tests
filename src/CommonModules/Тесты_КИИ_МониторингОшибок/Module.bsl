// ==== Хеш (экспортная ВычислитьMD5) ====

Процедура MD5_ДетерминизмИДлина() Экспорт
	Хеш1 = КИИ_МониторингОшибок.ВычислитьMD5("тестовая строка");
	Хеш2 = КИИ_МониторингОшибок.ВычислитьMD5("тестовая строка");
	ЮТест.ОжидаетЧто(Хеш1).Равно(Хеш2);
	ЮТест.ОжидаетЧто(СтрДлина(Хеш1)).Равно(32);
	ЮТест.ОжидаетЧто(КИИ_МониторингОшибок.ВычислитьMD5("a") = КИИ_МониторингОшибок.ВычислитьMD5("b")).Равно(Ложь);
КонецПроцедуры

// ==== МониторингСценарии (интеграция: реальный ВыполнитьСборОшибок против живого ЖР) ====

// Сидируем уникальную ошибку в журнал регистрации и проверяем, что боевой сбор
// прочитал ЖР и записал её в регистр. Ловит «молчаливую смерть» ВыгрузитьЖурналРегистрации
// и неверные имена полей записи ЖР (ЗЖР.Описание и пр.).
Процедура Сбор_СидированнаяОшибкаПопадаетВРегистр() Экспорт

	// Мониторинг сбора ошибок под капремонтом: ВыгрузитьЖурналРегистрации(Массив)
	// вместо ТаблицаЗначений, неверные поля записи ЖР, нет регламентных заданий —
	// см. audit-2026-07-07 (P0). Тест уже доказал баг; пропуск снять после фикса.
	ЮТест.Пропустить(НСтр("ru = 'Мониторинг сбора под капремонтом; см. audit-2026-07-07 P0'"));

	Маркер = "ИИконаТестСбораЖР_" + Строка(Новый УникальныйИдентификатор);

	ЗаписьЖурналаРегистрации("ИИКона.Тест.СборСценарий",
		УровеньЖурналаРегистрации.Ошибка, , , Маркер);

	КИИ_МониторингОшибок.ВыполнитьСборОшибок();

	Найдено = ЕстьОшибкаВРегистре(Маркер);

	УдалитьОшибкуИзРегистра(Маркер);

	ЮТест.ОжидаетЧто(Найдено).Равно(Истина);

КонецПроцедуры

Функция ЕстьОшибкаВРегистре(Знач ТекстОшибки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ж.ХешОшибки КАК ХешОшибки
	|ИЗ
	|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Ж
	|ГДЕ
	|	Ж.ТекстОшибки = &ТекстОшибки";
	Запрос.УстановитьПараметр("ТекстОшибки", ТекстОшибки);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура УдалитьОшибкуИзРегистра(Знач ТекстОшибки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ж.ХешОшибки КАК ХешОшибки
	|ИЗ
	|	РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Ж
	|ГДЕ
	|	Ж.ТекстОшибки = &ТекстОшибки";
	Запрос.УстановитьПараметр("ТекстОшибки", ТекстОшибки);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ХешОшибки.Установить(Выборка.ХешОшибки);
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

