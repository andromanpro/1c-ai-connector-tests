		МЗ.Идентификатор = Ид;
		МЗ.УниверсальнаяДатаВМиллисекундах = Мс;
		МЗ.ВходныеТокены = 1000;
		МЗ.ВыходныеТокены = 234;
		МЗ.ВсегоТокенов = 1234;
		МЗ.Записать();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ВсегоТокенов КАК ВсегоТокенов
		|ИЗ РегистрСведений.КИИ_ЛогЗапросовИИ
		|ГДЕ Идентификатор = &И И УниверсальнаяДатаВМиллисекундах = &М";
		Запрос.УстановитьПараметр("И", Ид);
		Запрос.УстановитьПараметр("М", Мс);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

		ЮТест.ОжидаетЧто(ТипЗнч(Выборка.ВсегоТокенов) = Тип("Число")).Равно(Истина);
		ЮТест.ОжидаетЧто(Выборка.ВсегоТокенов).Равно(1234);

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

