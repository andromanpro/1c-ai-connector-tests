КонецПроцедуры

// ==== СтатистикаStarSchema (аудит P2 #2) ====

// Статистика — фактовая таблица (Период=деньСобытия, ХешОшибки)→Количество. Ключ по дню
// ВОЗНИКНОВЕНИЯ (не сбора): событие 3 дня назад ложится на свой день, количество сохраняется.
Процедура Статистика_КлючДеньСобытияИКоличество() Экспорт

	Хеш = "aaaa0000000000000000000000000001";
	ДатаСобытия = НачалоДня(ТекущаяДатаСеанса()) - 3 * 86400 + 10 * 3600;
	ДеньСобытия = НачалоДня(ДатаСобытия);

	НачатьТранзакцию();
	Попытка
		СидироватьСбор(Хеш, ДатаСобытия, 5);

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ Количество КАК Количество
		|ИЗ РегистрСведений.КИИ_МониторингОшибокСтатистика
		|ГДЕ Период = &Д И ХешОшибки = &Х";
		Запрос.УстановитьПараметр("Д", ДеньСобытия);
		Запрос.УстановитьПараметр("Х", Хеш);
		Выборка = Запрос.Выполнить().Выбрать();
		Количество = ?(Выборка.Следующий(), Выборка.Количество, 0);
		ЮТест.ОжидаетЧто(Количество).Равно(5);

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Инвариант star-schema: критичность в разбивке берется ЖИВОЙ из Журнала (в Статистике не хранится).
// Смена вердикта анализа меняет разбивку БЕЗ касания Статистики — это и есть фикс #2.
Процедура Статистика_КритичностьЖиваяИзЖурнала() Экспорт

	Хеш = "aaaa0000000000000000000000000002";
	ДатаСобытия = ТекущаяДатаСеанса();
	День = НачалоДня(ДатаСобытия);

	НачатьТранзакцию();
	Попытка
		СидироватьСбор(Хеш, ДатаСобытия, 5);

		УстановитьКритичностьЖурнала(Хеш, Перечисления.КИИ_УровниКритичности.Высокая);
		Разбивка = РазбивкаКритичности(День, Хеш);
		ЮТест.ОжидаетЧто(Разбивка.Критичность).Равно(Перечисления.КИИ_УровниКритичности.Высокая);
		ЮТест.ОжидаетЧто(Разбивка.Количество).Равно(5);

		// переоценка анализом → Критическая; Статистику НЕ трогаем, разбивка обязана обновиться
		УстановитьКритичностьЖурнала(Хеш, Перечисления.КИИ_УровниКритичности.Критическая);
		Разбивка2 = РазбивкаКритичности(День, Хеш);
		ЮТест.ОжидаетЧто(Разбивка2.Критичность).Равно(Перечисления.КИИ_УровниКритичности.Критическая);
		ЮТест.ОжидаетЧто(Разбивка2.Количество).Равно(5);

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Прогоняет боевой сбор одной ошибки (Журнал + Статистика) с заданной датой события и количеством.
Процедура СидироватьСбор(Знач Хеш, Знач ДатаСобытия, Знач Количество)
	ЗаписьЖР = Новый Структура(
		"Дата, Комментарий, Событие, ИмяПользователя, Компьютер, МетаданныеПредставление, Данные",
		ДатаСобытия, "star-schema-тест", "ТестСобытие", "тест", "пк", "", "");
	УникальныеОшибки = Новый Соответствие;
	УникальныеОшибки.Вставить(Хеш, Новый Структура("ЗаписьЖР, Количество", ЗаписьЖР, Количество));
	КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВРегистр(УникальныеОшибки);
КонецПроцедуры

// Проставляет вердикт критичности в Журнал (эмуляция АНАЛИЗа).
Процедура УстановитьКритичностьЖурнала(Знач Хеш, Знач Критичность)
	МЗ = РегистрыСведений.КИИ_МониторингОшибокЖурнал.СоздатьМенеджерЗаписи();
	МЗ.ХешОшибки = Хеш;
	МЗ.Прочитать();
	МЗ.Критичность = Критичность;
	МЗ.Записать();
КонецПроцедуры

// Дашборд-джойн: объем из Статистики, критичность — ЖИВАЯ из Журнала по ХешОшибки.
Функция РазбивкаКритичности(Знач День, Знач Хеш)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ж.Критичность КАК Критичность,
	|	СУММА(С.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.КИИ_МониторингОшибокСтатистика КАК С
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КИИ_МониторингОшибокЖурнал КАК Ж
	|		ПО С.ХешОшибки = Ж.ХешОшибки
	|ГДЕ
	|	С.Период = &День
	|	И С.ХешОшибки = &Хеш
	|СГРУППИРОВАТЬ ПО
	|	Ж.Критичность";
	Запрос.УстановитьПараметр("День", День);
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Структура("Критичность, Количество", Неопределено, 0);
	Если Выборка.Следующий() Тогда
		Результат.Критичность = Выборка.Критичность;
		Результат.Количество = Выборка.Количество;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// #18: ресурс ВсегоТокенов был String (хранил число строкой) — теперь Число, как соседи
// ВходныеТокены/ВыходныеТокены. Записанное число читается числом (ТипЗнч=Число), не строкой.
Процедура ЛогИИ_ВсегоТокенов_ЭтоЧисло() Экспорт

	Ид = Строка(Новый УникальныйИдентификатор);
