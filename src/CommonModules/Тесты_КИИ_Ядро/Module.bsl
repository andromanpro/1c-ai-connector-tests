	Параметры = ПараметрыOpenAI();
	Параметры.НаименованиеПровайдера = "Ollama";

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Тест");

	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса).Свойство("stream");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.stream).Равно(Ложь);

КонецПроцедуры

// Система + история + пользовательское → 4 сообщения в правильном порядке.
Процедура OpenAI_СистемныйПромптПлюсИстория() Экспорт

	Параметры = ПараметрыOpenAI();
	История = Новый Массив;
	История.Добавить(Новый Структура("Роль, Текст", "user", "Q1"));
	История.Добавить(Новый Структура("Роль, Текст", "assistant", "A1"));
	Промпт = Новый Структура;
	Промпт.Вставить("СистемныйПромпт", "Будь краток");
	Промпт.Вставить("ПользовательскийПромпт", "Q2");
	Промпт.Вставить("ИсторияСообщений", История);

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, Промпт);

	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["role"]).Равно("system");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["content"]).Равно("Будь краток");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[1]["role"]).Равно("user");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[1]["content"]).Равно("Q1");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[2]["role"]).Равно("assistant");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[2]["content"]).Равно("A1");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[3]["role"]).Равно("user");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[3]["content"]).Равно("Q2");

КонецПроцедуры

// Полный набор полей metadata из OpenAI Chat Completions → корректное преобразование в Результат.
// created (Unix timestamp) → ДатаСоздания (1970-01-01 + N секунд).
Процедура OpenAI_ПарсингМетаданныхПолный() Экспорт

	Параметры = ПараметрыOpenAI();
	ОтветJSON = Новый Структура;
	ОтветJSON.Вставить("id", "chatcmpl-abc");
	ОтветJSON.Вставить("model", "gpt-4o-mini-2024-07-18");
	ОтветJSON.Вставить("created", 1700000000);
	ОтветJSON.Вставить("object", "chat.completion");
	ОтветJSON.Вставить("service_tier", "default");
