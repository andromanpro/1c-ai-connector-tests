// Хеш детерминирован
Процедура Кеш_ВычислитьХеш_Стабилен() Экспорт
	Параметры = ПараметрыКешаДляТестов(60, 1, 0);
	Параметры.МаксимумТокенов = 100;
	Промпт = ПромптДляКеша("стабильный текст");
