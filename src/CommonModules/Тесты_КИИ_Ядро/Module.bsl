#Область OpenAI

Процедура OpenAI_ТелоЗапросаСодержитMessages() Экспорт
	
	Параметры = ПараметрыOpenAI();
	Промпт = "Привет, модель";
	
	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, Промпт);
	
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса).Свойство("messages").Заполнено();
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["role"]).Равно("user");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["content"]).Равно("Привет, модель");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.model).Равно("gpt-4o-mini");
	
КонецПроцедуры

Процедура OpenAI_СистемныйПромптВMessages0() Экспорт
	
	Параметры = ПараметрыOpenAI();
	Промпт = Новый Структура("СистемныйПромпт, ПользовательскийПромпт", "Будь краток", "Привет");
	
	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, Промпт);
	
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["role"]).Равно("system");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[0]["content"]).Равно("Будь краток");
	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.messages[1]["role"]).Равно("user");
	
КонецПроцедуры

Процедура OpenAI_ЗаголовокAuthorization() Экспорт
	
	Параметры = ПараметрыOpenAI();
	
	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Тест", "TEST_KEY");
	
	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("Authorization")).Равно("Bearer TEST_KEY");
	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("Content-Type")).Равно("application/json");
	
КонецПроцедуры

Процедура OpenAI_ПарсингТекста() Экспорт
	
	Параметры = ПараметрыOpenAI();
	ОтветJSON = Новый Структура;
	ОтветJSON.Вставить("id", "chatcmpl-123");
	ОтветJSON.Вставить("model", "gpt-4o-mini");
	Сообщение = Новый Структура("role, content", "assistant", "Привет!");
	Выбор = Новый Структура("message, finish_reason", Сообщение, "stop");
	Выборы = Новый Массив;
	Выборы.Добавить(Выбор);
	ОтветJSON.Вставить("choices", Выборы);
	
	Результат = КИИ_КоннекторИИ.РазобратьОтветДляТестов(Параметры, ОтветJSON);
	
	ЮТест.ОжидаетЧто(Результат.ТекстОтвета).Равно("Привет!");
	ЮТест.ОжидаетЧто(Результат.ЭтоОшибка).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ПричинаЗавершения).Равно("stop");
	ЮТест.ОжидаетЧто(Результат.IDЗапроса).Равно("chatcmpl-123");
	
КонецПроцедуры

Процедура OpenAI_ПарсингТокенов() Экспорт
	
	Параметры = ПараметрыOpenAI();
	ОтветJSON = Новый Структура;
	ОтветJSON.Вставить("choices", Новый Массив);
	Использование = Новый Структура;
	Использование.Вставить("prompt_tokens", 12);
	Использование.Вставить("completion_tokens", 34);
	Использование.Вставить("total_tokens", 46);
	ОтветJSON.Вставить("usage", Использование);
	
	Результат = КИИ_КоннекторИИ.РазобратьОтветДляТестов(Параметры, ОтветJSON);
	
	ЮТест.ОжидаетЧто(Результат.ВходныеТокены).Равно(12);
	ЮТест.ОжидаетЧто(Результат.ВыходныеТокены).Равно(34);
	ЮТест.ОжидаетЧто(Результат.ВсегоТокенов).Равно(46);
	
КонецПроцедуры

Процедура OpenAI_ПарсингОшибки() Экспорт

	Параметры = ПараметрыOpenAI();
	ОтветJSON = Новый Структура;
	Ошибка = Новый Структура("message, type", "Invalid API key", "auth");
	ОтветJSON.Вставить("error", Ошибка);

	Результат = КИИ_КоннекторИИ.РазобратьОтветДляТестов(Параметры, ОтветJSON);

	// ОбработатьОтветПоТипуМодели делегирует в OpenAI парсер; ЕстьОшибкаВОтветеAPI ставит ЭтоОшибка для OpenAI choices.
	// Для Anthropic поведение другое — здесь проверяем что ОпеnAI-парсер не падает с error-структурой.
	ЮТест.ОжидаетЧто(Результат).Свойство("ТекстОтвета");

КонецПроцедуры

// Контракт OpenAI-совместимого профиля для OpenRouter / Helicone / любых сторонних шлюзов:
// поле НаименованиеПолное передаётся в JSON.model AS-IS, включая префикс провайдера со слэшем.
Процедура OpenAI_МодельСПрефиксомПровайдера() Экспорт

	Параметры = ПараметрыOpenAI();
	Параметры.НаименованиеПолное = "google/gemini-2.0-flash";

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Тест");

	ЮТест.ОжидаетЧто(Результат.ТелоЗапроса.model).Равно("google/gemini-2.0-flash");

КонецПроцедуры

// Контракт ТЧ КИИ_МоделиИИ.Заголовки: каждая строка попадает в HTTP-заголовки запроса
// один-в-один (после стандартных заголовков провайдера). Используется для HTTP-Referer/X-Title
// (OpenRouter), Helicone-Auth/Helicone-Target-Url (Helicone) и пр.
Процедура OpenAI_ДополнительныеЗаголовкиИзТЧ() Экспорт

	Параметры = ПараметрыOpenAI();
	Параметры.Заголовки.Добавить(Новый Структура("Ключ, Значение", "HTTP-Referer", "https://androman.pro"));
	Параметры.Заголовки.Добавить(Новый Структура("Ключ, Значение", "X-Title", "ИИкона"));

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Тест");

	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("HTTP-Referer")).Равно("https://androman.pro");
	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("X-Title")).Равно("ИИкона");
	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("Authorization")).Равно("Bearer TEST_KEY");

КонецПроцедуры

// Пустой ключ API → провайдер НЕ добавляет Authorization (для anonymous endpoints / Ollama без auth).
Процедура OpenAI_ПустойКлюч_БезAuthorization() Экспорт

	Параметры = ПараметрыOpenAI();

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, "Тест", "");

	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("Authorization")).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Заголовки.Получить("Content-Type")).Равно("application/json");

КонецПроцедуры

