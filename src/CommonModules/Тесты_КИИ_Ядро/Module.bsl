// Хеш меняется при смене ВерсияСхемыКеша
Процедура Кеш_ВычислитьХеш_МеняетсяПриСменеВерсии() Экспорт
	Параметры1 = ПараметрыКешаДляТестов(60, 1, 0);
	Параметры1.МаксимумТокенов = 100;
	Параметры2 = ПараметрыКешаДляТестов(60, 2, 0);
	Параметры2.МаксимумТокенов = 100;
	Промпт = ПромптДляКеша();
	Модель = МодельДляКешТестов();
	Хеш1 = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры1);
	Хеш2 = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры2);
	ЮТест.ОжидаетЧто(Хеш1 = Хеш2).Равно(Ложь);
КонецПроцедуры

// Полный цикл: miss → store → hit
Процедура Кеш_СохранитьИПолучить_HitНаПовторе() Экспорт
	Параметры = ПараметрыКешаДляТестов(60, 1, 0);
	Промпт = ПромптДляКеша("уникальный hit-тест");
	Модель = МодельДляКешТестов();
	Хеш = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры);
	УдалитьЗаписьКешаПоХешу(Хеш);

	Кеш1 = КИИ_КоннекторИИ.ПолучитьИзКеша(Хеш, Модель, 1);
	ЮТест.ОжидаетЧто(Кеш1).Равно(Неопределено);

	КИИ_КоннекторИИ.СохранитьВКеш(Хеш, Модель, Параметры, РезультатДляКеша("ответ-hit"));

	Кеш2 = КИИ_КоннекторИИ.ПолучитьИзКеша(Хеш, Модель, 1);
	ЮТест.ОжидаетЧто(Кеш2 = Неопределено).Равно(Ложь);
	ЮТест.ОжидаетЧто(Кеш2.Текст).Равно("ответ-hit");

	УдалитьЗаписьКешаПоХешу(Хеш);
КонецПроцедуры

// Запись со старой версией схемы → miss
Процедура Кеш_ВерсияИзменилась_Miss() Экспорт
	Параметры = ПараметрыКешаДляТестов(60, 1, 0);
	Промпт = ПромптДляКеша("уникальный version-тест");
	Модель = МодельДляКешТестов();
	Хеш = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры);
	УдалитьЗаписьКешаПоХешу(Хеш);

	КИИ_КоннекторИИ.СохранитьВКеш(Хеш, Модель, Параметры, РезультатДляКеша("ответ-старая-схема"));

	Результат = КИИ_КоннекторИИ.ПолучитьИзКеша(Хеш, Модель, 99);
	ЮТест.ОжидаетЧто(Результат).Равно(Неопределено);

	УдалитьЗаписьКешаПоХешу(Хеш);
КонецПроцедуры

// Запись с просроченной ДатаДо → miss
Процедура Кеш_Просрочена_Miss() Экспорт
	Параметры = ПараметрыКешаДляТестов(60, 1, 0);
	Промпт = ПромптДляКеша("уникальный expired-тест");
	Модель = МодельДляКешТестов();
	Хеш = КИИ_КоннекторИИ.ВычислитьХешЗапроса(Модель, Промпт, Параметры);
	УдалитьЗаписьКешаПоХешу(Хеш);

	МенеджерЗаписи = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ХешЗапроса = Хеш;
	МенеджерЗаписи.Ответ = Новый ХранилищеЗначения(РезультатДляКеша("протухший"));
	МенеджерЗаписи.Модель = Модель;
	МенеджерЗаписи.ДатаСоздания = ТекущаяДатаСеанса() - 7200;
	МенеджерЗаписи.РазмерБайт = 0;
	МенеджерЗаписи.ВерсияСхемыКеша = 1;
	МенеджерЗаписи.ДатаДо = ТекущаяДатаСеанса() - 3600;
	МенеджерЗаписи.Записать();

	Результат = КИИ_КоннекторИИ.ПолучитьИзКеша(Хеш, Модель, 1);
	ЮТест.ОжидаетЧто(Результат).Равно(Неопределено);

	УдалитьЗаписьКешаПоХешу(Хеш);
КонецПроцедуры

