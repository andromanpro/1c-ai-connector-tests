#Область Кеш

Функция ПараметрыКешаДляТестов(СрокЖизни = 60, Версия = 1, Температура = 0)
	П = БазоваяСтруктураПараметров();
	П.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	П.Температура = Температура;
	П.Вставить("СрокЖизниКеша", СрокЖизни);
	П.Вставить("ВерсияСхемыКеша", Версия);
	Возврат П;
КонецФункции

Функция ПромптДляКеша(Текст = "Привет")
	Возврат Новый Структура("СистемныйПромпт, ПользовательскийПромпт, ИсторияСообщений",
		"Ты ассистент.", Текст, Новый Массив);
КонецФункции

Функция РезультатДляКеша(Текст = "ответ")
	Результат = Новый Структура;
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Возврат Результат;
КонецФункции

Функция МодельДляКешТестов()
	Возврат Справочники.КИИ_МоделиИИ.ПустаяСсылка();
КонецФункции

Процедура УдалитьЗаписьКешаПоХешу(Хеш)
	НаборЗаписей = РегистрыСведений.КИИ_КешОтветовИИ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ХешЗапроса.Установить(Хеш);
	НаборЗаписей.Записать();
КонецПроцедуры

