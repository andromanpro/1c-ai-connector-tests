// Закрывает дыру в покрытии, через которую жил баг с server-flag (Codex починил 2026-05-06).
// Все 6 коннектор-модулей должны быть доступны на сервере, во внешнем соединении и в обычном клиенте —
// иначе провайдер-делегаты упадут как «неопределено» в любом контексте кроме спец-test-runner.
Процедура Метаданные_СерверныйКонтекстПровайдеров() Экспорт

	ИменаМодулей = Новый Массив;
	ИменаМодулей.Добавить("КИИ_КоннекторOpenAI");
	ИменаМодулей.Добавить("КИИ_КоннекторAnthropic");
	ИменаМодулей.Добавить("КИИ_КоннекторGoogle");
	ИменаМодулей.Добавить("КИИ_КоннекторYandex");
	ИменаМодулей.Добавить("КИИ_КоннекторGigaChat");
	ИменаМодулей.Добавить("КИИ_КоннекторИИОбщий");

	Для Каждого ИмяМодуля Из ИменаМодулей Цикл
		ОписаниеМодуля = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
		ЮТест.ОжидаетЧто(ОписаниеМодуля <> Неопределено).Равно(Истина);
		Если ОписаниеМодуля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЮТест.ОжидаетЧто(ОписаниеМодуля.Сервер).Равно(Истина);
		ЮТест.ОжидаетЧто(ОписаниеМодуля.ВнешнееСоединение).Равно(Истина);
		ЮТест.ОжидаетЧто(ОписаниеМодуля.КлиентОбычноеПриложение).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
