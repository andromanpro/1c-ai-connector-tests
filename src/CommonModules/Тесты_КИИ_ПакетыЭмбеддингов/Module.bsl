Процедура ПроверитьУсловнуюЗапись(Знач Изменение, Знач ОжидаемыйСтатус)
	Стенд = ПодготовитьДанные("valid", 1, "OpenAI", 0);
	Если Изменение = "category-policy" Тогда
		Категория = ЮТТестовыеДанные.СоздатьЭлемент(
			Справочники.КИИ_КатегорииЗнаний,
			"K07 category",
			Новый Структура("ПолитикаЭмбеддинга", Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее)
		);
		Объект = Стенд.База.ПолучитьОбъект();
		Объект.Категория = Категория;
		Объект.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка();
		Объект.Записать();
	КонецЕсли;
	Версия = КИИ_RAGЭмбеддинги.ВерсияМодели(Стенд.Модель);
	Условия = КИИ_RAGЭмбеддинги.УсловияФрагмента(Стенд.Фрагменты[0]);
	Контроль = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
		КИИ_КонтрольПерсональныхДанных.КаналЗапросыКМоделям(), Условия.Текст, Стенд.Модель);
	ЮТест.ОжидаетЧто(Контроль.Разрешено).Равно(Истина);
	Задание = Новый Структура("Условия,Контроль", Условия, Контроль);
	Задания = Новый Массив;
	Задания.Добавить(Задание);
	Сведения = Новый Структура(
		"НаименованиеПолное,Endpoint,Размерность,КлассEgress",
		Стенд.Модель.НаименованиеПолное,
		Стенд.Модель.EndpointЭмбеддингов,
		3,
		Стенд.Модель.КлассEgress
	);
	Ответ = КИИ_RAGЭмбеддинги.ПолучитьВекторы(Задания, Стенд.Модель, Сведения, Истина);
	ЮТест.ОжидаетЧто(ТипЗнч(Ответ.Векторы)).Равно(Тип("Массив"));
	// Изменение выполняется после настоящего HTTP и до общего метода условной записи.
	Если Изменение = "text" Или Изменение = "deleted" Или Изменение = "owner" Тогда
		Объект = Стенд.Фрагменты[0].ПолучитьОбъект();
		Если Изменение = "text" Тогда
			Объект.ТекстФрагмента = "Измененный после HTTP текст";
		ИначеЕсли Изменение = "deleted" Тогда
			Объект.ПометкаУдаления = Истина;
		Иначе
			Объект.Владелец = ЮТТестовыеДанные.СоздатьЭлемент(Справочники.КИИ_БазаЗнаний, "K07 other owner");
		КонецЕсли;
		Объект.Записать();
	ИначеЕсли Изменение = "category" Или Изменение = "base-policy" Тогда
		Объект = Стенд.База.ПолучитьОбъект();
		Если Изменение = "category" Тогда
			Объект.Категория = ЮТТестовыеДанные.СоздатьЭлемент(Справочники.КИИ_КатегорииЗнаний, "K07 other category");
		Иначе
			Объект.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
		КонецЕсли;
		Объект.Записать();
	ИначеЕсли Изменение = "category-policy" Тогда
		Объект = Категория.ПолучитьОбъект();
		Объект.ПолитикаЭмбеддинга = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
		Объект.Записать();
	ИначеЕсли Изменение <> "unchanged" Тогда
		Объект = Стенд.Модель.ПолучитьОбъект();
		Если Изменение = "model-name" Тогда
			Объект.НаименованиеПолное = "changed-model";
		ИначеЕсли Изменение = "dimension" Тогда
			Объект.РазмерностьЭмбеддинга = 4;
		ИначеЕсли Изменение = "endpoint" Тогда
			Объект.EndpointЭмбеддингов = "/changed-endpoint";
		ИначеЕсли Изменение = "address" Тогда
			Объект.Адрес = "localhost:8874";
		ИначеЕсли Изменение = "egress" Тогда
			Объект.КлассEgress = Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ;
		ИначеЕсли Изменение = "cosmetic" Тогда
			Объект.Наименование = "K07 cosmetic rename";
		КонецЕсли;
		Объект.Записать();
	КонецЕсли;
	Код = КИИ_RAG.КодМоделиЭмбеддинга("OpenAI", Сведения.НаименованиеПолное);
	Статус = КИИ_RAGЭмбеддинги.ЗаписатьВектор(Задание, Стенд.Модель, Версия, Сведения, Код, Ответ.Векторы[0]);
	ЮТест.ОжидаетЧто(Статус).Равно(ОжидаемыйСтатус);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	ЮТест.ОжидаетЧто(Стенд.Фрагменты[0].КодМоделиЭмбеддинга).Равно(?(ОжидаемыйСтатус = "Обновлен", Код, ""));
	ЮТест.ОжидаетЧто(СтатистикаСтенда(Стенд.Маркер).requests).Равно(1);
КонецПроцедуры

