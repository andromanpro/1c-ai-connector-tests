Процедура ПроверитьПересечениеКонтекстов(Знач Оригинал)
	Стенд = ПодготовитьДанные("valid", 0, "OpenAI", 0);
	Оригиналы = Новый Соответствие;
	Оригиналы.Вставить(Оригинал, "[SYNTHETIC]");
	Контекст = Новый Структура("ПроверятьТело,Оригиналы", Истина, Оригиналы);
	Задания = Новый Массив;
	Задания.Добавить(Новый Структура("Контроль", Новый Структура("Текст,Контекст", "[SYNTHETIC]", Контекст)));
	Задания.Добавить(Новый Структура("Контроль", Новый Структура("Текст,Контекст", Оригинал, Неопределено)));
	Сведения = Новый Структура(
		"НаименованиеПолное,Endpoint,Размерность", Стенд.Модель.НаименованиеПолное, "/emb-valid", 3);
	Ответ = КИИ_RAGЭмбеддинги.ПолучитьВекторы(Задания, Стенд.Модель, Сведения, Истина);
	ЮТест.ОжидаетЧто(Ответ.ИсходЗапроса).Равно("НеОтправлен");
	ЮТест.ОжидаетЧто(Ответ.Векторы).Равно(Неопределено);
	ЮТест.ОжидаетЧто(СтатистикаСтенда(Стенд.Маркер).requests).Равно(0);
КонецПроцедуры

