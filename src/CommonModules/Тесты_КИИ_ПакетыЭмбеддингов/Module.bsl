#Область СлужебныеПроцедурыИФункции
Процедура ПроверитьПакет(Знач Режим, Знач Количество, Знач Запросов, Знач Провайдер, Знач Длина, Знач ОжидаетсяОтказ)
	Стенд = ПодготовитьДанные(Режим, Количество, Провайдер, Длина);
	Итог = КИИ_RAG.ОбновитьЭмбеддингиБазы(Стенд.База);
	ЮТест.ОжидаетЧто(Итог.Модель).Равно(Стенд.Модель);
	ЮТест.ОжидаетЧто(Итог.Всего).Равно(Количество);
	Статистика = СтатистикаСтенда(Стенд.Маркер);
	ЮТест.ОжидаетЧто(Статистика.requests).Равно(Запросов);
	Для Индекс = 0 По Статистика.requests - 1 Цикл
		ОжидаетсяМассив = Провайдер <> "unknown-compatible" И Длина <= 64000;
		ЮТест.ОжидаетЧто(Статистика.array_inputs[Индекс]).Равно(ОжидаетсяМассив);
		Если ОжидаетсяМассив Тогда
			ЮТест.ОжидаетЧто(Статистика.total_lengths[Индекс] <= 64000).Равно(Истина);
		КонецЕсли;
	КонецЦикла;
	Если Длина > 0 Тогда
		Для Каждого ФактическаяДлина Из Статистика.text_lengths Цикл
			ЮТест.ОжидаетЧто(ФактическаяДлина).Равно(Длина);
		КонецЦикла;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Итог.НеизвестныйИсход).Равно(?(Режим = "http500" Или Режим = "disconnect", Количество, 0));
	Если ОжидаетсяОтказ Тогда
		ЮТест.ОжидаетЧто(Итог.Обновлено).Равно(0);
		ЮТест.ОжидаетЧто(Итог.Ошибок).Равно(Количество);
		Для Каждого Ссылка Из Стенд.Фрагменты Цикл
			ЮТест.ОжидаетЧто(Ссылка.КодМоделиЭмбеддинга).Равно("");
		КонецЦикла;
	Иначе
		ЮТест.ОжидаетЧто(Итог.Ошибок).Равно(0);
		ЮТест.ОжидаетЧто(Итог.Обновлено).Равно(Количество);
		Номер = 0;
		Для Каждого Ссылка Из Стенд.Фрагменты Цикл
			Номер = Номер + 1;
			Вектор = Ссылка.Эмбеддинг.Получить();
			ЮТест.ОжидаетЧто(Вектор.Количество()).Равно(3);
			ЮТест.ОжидаетЧто(Окр(Вектор[0], 8)).Равно(Окр(Номер / Pow(Номер * Номер + 1, 0.5), 8));
			ЮТест.ОжидаетЧто(Окр(Вектор[1], 8)).Равно(Окр(1 / Pow(Номер * Номер + 1, 0.5), 8));
			ЮТест.ОжидаетЧто(Вектор[2]).Равно(0);
		КонецЦикла;
		Для Каждого Размер Из Статистика.sizes Цикл
			ЮТест.ОжидаетЧто(Размер <= 32).Равно(Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПодготовитьДанные(Знач Режим, Знач Количество, Знач Провайдер, Знач Длина)
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	Константы.КИИ_АдресСервисаРаспознаванияИмен.Установить("");
	Константы.КИИ_СервисРаспознаванияИменОбязателен.Установить(Ложь);
	Маркер = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Настройки = Новый Структура;
	Настройки.Вставить("НаименованиеПровайдера", Провайдер);
	Настройки.Вставить("НаименованиеПолное", "fixture-" + Маркер);
	Настройки.Вставить("ТипМодели", Перечисления.КИИ_ТипыМоделей.Эмбеддинг);
	Настройки.Вставить(
		"ТипФорматаAPI",
		?(
			Провайдер = "GigaChat",
			Перечисления.КИИ_ТипыФорматовAPI.GigaChat,
			Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible
		)
	);
	Настройки.Вставить("РазмерностьЭмбеддинга", 3);
	Настройки.Вставить("Адрес", "localhost:8873");
	Настройки.Вставить("ИспользоватьЗащищенноеСоединение", Ложь);
	Настройки.Вставить("ИспользоватьПрокси", Ложь);
	Настройки.Вставить("ТипАвторизации", Перечисления.КИИ_ТипыАвторизации.Bearer);
	Настройки.Вставить(
		"РежимКонтроляПерсональныхДанных", Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Маскировать);
	Настройки.Вставить("Таймаут", 3);
	Настройки.Вставить("EndpointЭмбеддингов", "/emb-" + Режим);
	Модель = ЮТТестовыеДанные.СоздатьЭлемент(Справочники.КИИ_МоделиИИ, "000 K07 embedding fixture", Настройки);
	База = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.КИИ_БазаЗнаний,
		"K07 synthetic knowledge",
		Новый Структура("ПолитикаЭмбеддингаПереопределение", Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее)
	);
	Фрагменты = Новый Массив;
	Для Номер = 1 По Количество Цикл
		Текст = "k07-vector:" + Формат(Номер, "ЧГ=0") + " synthetic knowledge";
		Если Длина > 0 Тогда
			Пока СтрДлина(Текст) < Длина Цикл
				Текст = Текст + " synthetic content";
			КонецЦикла;
			Текст = Лев(Текст, Длина);
		КонецЕсли;
		Значения = Новый Структура("Владелец, НомерФрагмента, ТекстФрагмента", База, Номер, Текст);
		Фрагменты.Добавить(
			ЮТТестовыеДанные.СоздатьЭлемент(
				Справочники.КИИ_ФрагментыЗнаний, "K07 synthetic fragment " + Строка(Номер), Значения)
		);
	КонецЦикла;
	Возврат Новый Структура("Модель, База, Фрагменты, Маркер", Модель, База, Фрагменты, Маркер);
КонецФункции

Функция СтатистикаСтенда(Знач Маркер)
	Соединение = Новый HTTPСоединение("localhost", 8873, , , , 3);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/embedding-events/" + Маркер));
	ЮТест.ОжидаетЧто(Ответ.КодСостояния).Равно(200);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции
