// Помечает все модели-эмбеддеры на удаление, чтобы ТекущаяМодельЭмбеддер() вернула Неопределено.
// Только для теста «нет эмбеддера»; вызывать внутри транзакции с последующим откатом.
Процедура СкрытьМоделиЭмбеддераДляТеста()
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КИИ_МоделиИИ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КИИ_МоделиИИ КАК КИИ_МоделиИИ
		|ГДЕ
		|	КИИ_МоделиИИ.ТипМодели = &ТипЭмбеддинг
		|	И НЕ КИИ_МоделиИИ.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТипЭмбеддинг", Перечисления.КИИ_ТипыМоделей.Эмбеддинг);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ПометкаУдаления = Истина;
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

