// Perf-замер (НЕ зарегистрирован в CI — запускать вручную: тяжёлый ~83с, машинозависимый).
// Ядро поиска: десериализация ValueStorage + скалярное произведение + ранжирование, 5000 × 1536.
// Измерено 2026-06-03: ~17 300 мс (~3.46 мс/фрагмент). Гейт спеки v2 §7 (<1с) нативным линейным
// поиском при 5K НЕ достигается — порог <1с ≈ 290 фрагментов. Для крупных БЗ — Путь B (Qdrant/pgvector).
Процедура Перф_Поиск5000х1536() Экспорт

	Размерность = 1536;
	Количество = 5000;
	Генератор = Новый ГенераторСлучайныхЧисел(20260603);

	// Подготовка (вне замера): 5000 ХранилищЗначения с нормализованными векторами
	Хранилища = Новый Массив;
	Для Сч = 1 По Количество Цикл
		Хранилища.Добавить(Новый ХранилищеЗначения(КИИ_RAG.НормализоватьВектор(СлучайныйВектор(Генератор, Размерность))));
	КонецЦикла;
	Запрос = КИИ_RAG.НормализоватьВектор(СлучайныйВектор(Генератор, Размерность));

	// Замер: десериализация фрагментов + ранжирование (ядро ПоискаПоВектору без SQL-выборки)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Фрагменты = Новый Массив;
	Для Каждого Хранилище Из Хранилища Цикл
		Фрагменты.Добавить(Новый Структура("Ссылка, Текст, Категория, Вектор",
			Неопределено, "", Неопределено, Хранилище.Получить()));
	КонецЦикла;
	Результат = КИИ_RAG.РанжироватьФрагменты(Запрос, Фрагменты, 3, -1);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ЗаписьЖурналаРегистрации("КИИ.RAG.Перф", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Поиск %1 фрагментов x %2: %3 мс (десериализация + скаляр + ранжирование)'"),
			Количество, Размерность, Длительность));

	ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(3);

КонецПроцедуры

// Псевдослучайный вектор заданной размерности с координатами в [-0.5, 0.5].
Функция СлучайныйВектор(Знач Генератор, Знач Размерность)

	Вектор = Новый Массив;
	Для Сч = 1 По Размерность Цикл
		Вектор.Добавить(Генератор.СлучайноеЧисло(0, 1000) / 1000 - 0.5);
	КонецЦикла;
	Возврат Вектор;

КонецФункции

// Трёхкомпонентный вектор.
Функция Вектор3(Знач X, Знач Y, Знач Z)

	Вектор = Новый Массив;
	Вектор.Добавить(X);
	Вектор.Добавить(Y);
	Вектор.Добавить(Z);
	Возврат Вектор;

КонецФункции

// Фрагмент-кандидат для РанжироватьФрагменты (вектор нормализуется).
Функция ФрагментДляРанжирования(Знач Текст, Знач Вектор)

	Возврат Новый Структура("Ссылка, Текст, Категория, Вектор",
		Неопределено, Текст, Неопределено, КИИ_RAG.НормализоватьВектор(Вектор));

КонецФункции

// Количество незаархивированных фрагментов базы знаний.
Функция КоличествоФрагментов(Знач База)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|ГДЕ
		|	Фрагменты.Владелец = &База
		|	И НЕ Фрагменты.ПометкаУдаления";
	Запрос.УстановитьПараметр("База", База);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Создаёт модель-эмбеддер для тестов регламента.
Функция СоздатьТестовыйЭмбеддер(Знач Провайдер, Знач ИмяМодели, Знач КлассEgress)

	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "Тест эмбеддер";
	Модель.НаименованиеПровайдера = Провайдер;
	Модель.НаименованиеПолное = ИмяМодели;
	Модель.ТипМодели = Перечисления.КИИ_ТипыМоделей.Эмбеддинг;
	Модель.КлассEgress = КлассEgress;
	Модель.РазмерностьЭмбеддинга = 3;
	Модель.Записать();
	Возврат Модель.Ссылка;

КонецФункции

// Создаёт элемент Справочник.КИИ_ФрагментыЗнаний с нормализованным эмбеддингом.
Функция СоздатьТестовыйФрагмент(Знач Владелец, Знач Текст, Знач Вектор, Знач КодМодели)

	Нормализованный = КИИ_RAG.НормализоватьВектор(Вектор);

	Фрагмент = Справочники.КИИ_ФрагментыЗнаний.СоздатьЭлемент();
	Фрагмент.Владелец = Владелец;
	Фрагмент.Наименование = Текст;
	Фрагмент.ТекстФрагмента = Текст;
	Фрагмент.Эмбеддинг = Новый ХранилищеЗначения(Нормализованный);
	Фрагмент.КодМоделиЭмбеддинга = КодМодели;
	Фрагмент.Размерность = Нормализованный.Количество();
	Фрагмент.Записать();

	Возврат Фрагмент.Ссылка;

КонецФункции

// Повторяет строку заданное число раз.
Функция Повтор(Знач Текст, Знач Раз)

	Результат = "";
	Для Сч = 1 По Раз Цикл
		Результат = Результат + Текст;
	КонецЦикла;
	Возврат Результат;

КонецФункции

