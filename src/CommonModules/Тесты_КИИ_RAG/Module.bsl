Процедура ОбновитьЭмбеддинги_СменаПолитикиНаЗапрещено_Инвалидирует() Экспорт

	НачатьТранзакцию();
	Попытка

		Категория = Справочники.КИИ_КатегорииЗнаний.СоздатьЭлемент();
		Категория.Наименование = "Запрещённая категория";
		Категория.ПолитикаЭмбеддинга = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
		Категория.Записать();

		База = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
		База.Наименование = "Запрещённая база";
		База.Категория = Категория.Ссылка;
		База.Записать();

		// фрагмент УЖЕ проиндексирован (вектор + код модели заполнены)
		ФрагментСсылка = СоздатьТестовыйФрагмент(База.Ссылка, "Секретный текст", Вектор3(1, 0, 0), "наша:модель");

		// модель-эмбеддер существует (иначе регламент выйдет рано); egress разрешён,
		// но политика документа ЗапрещеноВнешнее должна победить и инвалидировать фрагмент
		СоздатьТестовыйЭмбеддер("наша", "модель", Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее);

		КИИ_RAG.ОбновитьЭмбеддинги();

		Объект = ФрагментСсылка.ПолучитьОбъект();
		ВекторПосле = Неопределено;
		Если ТипЗнч(Объект.Эмбеддинг) = Тип("ХранилищеЗначения") Тогда
			ВекторПосле = Объект.Эмбеддинг.Получить();
		КонецЕсли;

		ЮТест.ОжидаетЧто(Объект.КодМоделиЭмбеддинга).Равно("");
		ЮТест.ОжидаетЧто(ВекторПосле = Неопределено Или ВекторПосле.Количество() = 0).Равно(Истина);

		ОтменитьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

