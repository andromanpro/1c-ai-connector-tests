Функция КоличествоФрагментов(Знач База)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.КИИ_ФрагментыЗнаний КАК Фрагменты
		|ГДЕ
		|	Фрагменты.Владелец = &База
		|	И НЕ Фрагменты.ПометкаУдаления";
	Запрос.УстановитьПараметр("База", База);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

