#Область ТестовыеПроцедуры

// Сохраненная ссылка определяет подключение при нескольких одинаковых моделях.
Процедура Автомодель_СохраненнаяСвязь_РазрешаетДубли() Экспорт

	Модель = ЭмбеддерКарточкиДляТеста();
	База = ГотоваяБазаКарточкиДляТеста();
	Другая = ДругаяМодельДляАвтовыбора("ЮТ второе подключение", "модель");
	ЮТТестовыеДанные.УстановитьЗначениеРеквизита(База, "МодельИндекса", Модель);
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, База, Неопределено, Другая);
	ЮТест.ОжидаетЧто(Сведения.Статус).Равно("ОК");
	ЮТест.ОжидаетЧто(Сведения.Модель).Равно(Модель);

КонецПроцедуры

// Измененная сохраненная настройка не заменяется другим ключом или подключением.
Процедура Автомодель_СвязьИзменена_НеПодменяетсяДругой() Экспорт

	Модель = ЭмбеддерКарточкиДляТеста();
	База = ГотоваяБазаКарточкиДляТеста();
	ЮТТестовыеДанные.УстановитьЗначениеРеквизита(База, "МодельИндекса", Модель);
	ЮТТестовыеДанные.УстановитьЗначениеРеквизита(Модель, "НаименованиеПолное", "измененная");
	Другая = ДругаяМодельДляАвтовыбора("ЮТ другое подключение", "модель");
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, База, Неопределено, Другая);
	ЮТест.ОжидаетЧто(Сведения.Статус).Равно("НастройкаИндексаИзменена");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Сведения.Модель)).Равно(Ложь);

КонецПроцедуры

// Выбранная база определяет модель независимо от общей и переданной настройки.
Процедура Автомодель_ВыбраннаяБаза_ИспользуетсяЕеИндекс() Экспорт

	Модель = ЭмбеддерКарточкиДляТеста();
	База = ГотоваяБазаКарточкиДляТеста();
	Другая = ДругаяМодельДляАвтовыбора("000 ЮТ другая модель", "другая");
	ЮТест.ОжидаетЧто(КИИ_RAG.ТекущаяМодельЭмбеддер()).Равно(Другая);
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, База, Неопределено, Другая);
	ЮТест.ОжидаетЧто(Сведения.Статус).Равно("ОК");
	ЮТест.ОжидаетЧто(Сведения.Модель).Равно(Модель);
	ЮТест.ОжидаетЧто(Сведения.КодМодели).Равно("юти:модель");
	ЮТест.ОжидаетЧто(КИИ_RAG.ТекущаяМодельЭмбеддер()).Равно(Другая);

КонецПроцедуры

// Смена базы должна переключить модель на индекс нового документа.
Процедура Автомодель_СменаБазы_МеняетМодель() Экспорт

	Модель = ЭмбеддерКарточкиДляТеста();
	Первая = ГотоваяБазаКарточкиДляТеста();
	Вторая = ГотоваяБазаКарточкиДляТеста();
	Другая = ДругаяМодельДляАвтовыбора("ЮТ модель второй базы", "вторая");
	Выборка = Справочники.КИИ_ФрагментыЗнаний.Выбрать(, Вторая);
	Выборка.Следующий();
	ЮТТестовыеДанные.УстановитьЗначениеРеквизита(Выборка.Ссылка, "КодМоделиЭмбеддинга", "юти:вторая");
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, Первая, Неопределено, Другая);
	ЮТест.ОжидаетЧто(Сведения.Модель).Равно(Модель);
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, Вторая, Неопределено, Модель);
	ЮТест.ОжидаетЧто(Сведения.Статус).Равно("ОК");
	ЮТест.ОжидаетЧто(Сведения.Модель).Равно(Другая);

КонецПроцедуры

// Пустой индекс не должен получать произвольную общую модель.
Процедура Автомодель_НетИндекса_ПонятнаяПричина() Экспорт

	Модель = ЭмбеддерКарточкиДляТеста();
	База = ЮТТестовыеДанные.СоздатьЭлемент(Справочники.КИИ_БазаЗнаний, "ЮТ еще без индекса");
	Сведения = КИИ_ИнтерфейсВызовСервера.СведенияПоиска(Неопределено, База, Неопределено, Модель);
	ЮТест.ОжидаетЧто(Сведения.Статус).Равно("ИндексНеГотов");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Сведения.Модель)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Сведения.Диагностика)).Равно(Ложь);

КонецПроцедуры

