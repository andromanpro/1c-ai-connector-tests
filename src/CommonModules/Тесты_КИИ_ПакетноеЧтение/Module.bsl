Функция СтатистикаHTTP()
	Соединение = Новый HTTPСоединение("localhost", 8871, , , Новый ИнтернетПрокси(Ложь), 5);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/__stats"));
	Возврат КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.ПолучитьТелоКакСтроку(), Ложь);
КонецФункции

Процедура ОчиститьОчередь()
	Для Каждого Модель Из СтрРазделить("тест:queue-http,тест:queue-policy,тест:sweep-a,тест:sweep-b", ",") Цикл
		Набор = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьНаборЗаписей();
		Набор.Отбор.КодМодели.Установить(Модель);
		Набор.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ОчиститьПоколенияТеста()
	Для Каждого Модель Из СтрРазделить("тест:sweep-a,тест:sweep-b", ",") Цикл
		Запись = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьМенеджерЗаписи();
		Запись.КодМодели = Модель;
		Запись.Удалить();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьОчередь(Знач Фрагмент, Знач Модель, Знач Номер)
	Запись = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = UUID(Фрагмент);
	Запись.КодМодели = Модель;
	Запись.НомерПоПорядку = Номер;
	Запись.Операция = "upsert";
	Запись.ДатаПостановки = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

#КонецОбласти

#Область СобытияТестов

// Изолирует только текущий тестовый сеанс и направляет HTTP на локальную оснастку.
Процедура ПередКаждымТестом() Экспорт
	Контекст = ЮТест.КонтекстТеста();
	Настройки = Новый Структура(
		"Блокировка,Адрес",
		ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована,
		Константы.КИИ_QdrantАдрес.Получить()
	);
	Контекст.Вставить("HTTPКонтекстQdrant", Настройки);
	Попытка
		ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована = Ложь;
		Константы.КИИ_QdrantАдрес.Установить("http://localhost:8871");
	Исключение
		ВосстановитьКонтекстHTTPТеста();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Восстанавливает настройки сеанса и адрес также после упавшего теста.
Процедура ПослеКаждогоТеста() Экспорт
	ВосстановитьКонтекстHTTPТеста();
КонецПроцедуры

Процедура ВосстановитьКонтекстHTTPТеста()
	Контекст = ЮТест.КонтекстТеста();
	Настройки = Неопределено;
	Если Контекст = Неопределено Или Не Контекст.Свойство("HTTPКонтекстQdrant", Настройки) Тогда
		Возврат;
	КонецЕсли;
	Контекст.Удалить("HTTPКонтекстQdrant");
	Попытка
		Константы.КИИ_QdrantАдрес.Установить(Настройки.Адрес);
	Исключение
		ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована = Настройки.Блокировка;
		ВызватьИсключение;
	КонецПопытки;
	ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована = Настройки.Блокировка;
КонецПроцедуры

#КонецОбласти
