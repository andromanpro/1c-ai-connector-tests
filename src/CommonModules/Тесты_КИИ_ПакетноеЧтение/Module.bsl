// Порядок Qdrant и повторные точки не должны зависеть от порядка строк SQL.
Процедура Поиск_ПорядокОценкиИДублиСохраняются() Экспорт

	База = СоздатьБазу();
	Первый = СоздатьФрагмент(База, "первый");
	Второй = СоздатьФрагмент(База, "второй");
	Точки = Новый Массив;
	Точки.Добавить(Точка(ВРег(UUID(Второй)), 0.91));
	Точки.Добавить(Точка(" " + UUID(Первый) + " ", 0.82));
	Точки.Добавить(Точка(UUID(Второй), 0.73));
	Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветПоиска(Точки), "тест:порция");
	ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Результат.Знания[0].Текст).Равно("второй");
	ЮТест.ОжидаетЧто(Результат.Знания[1].Текст).Равно("первый");
	ЮТест.ОжидаетЧто(Результат.Знания[2].Текст).Равно("второй");
	ЮТест.ОжидаетЧто(Результат.Знания[0].Score).Равно(0.91);
	ЮТест.ОжидаетЧто(Результат.Знания[1].Score).Равно(0.82);
	ЮТест.ОжидаетЧто(Результат.Знания[2].Score).Равно(0.73);

КонецПроцедуры

// В одной порции присутствуют разрешенные, удаленные, отсутствующие и запрещенные данные.
Процедура Поиск_СмешаннаяПорцияБезУтечки() Экспорт

	Модель = "тест:смешанная-порция";
	Разрешенный = СоздатьФрагмент(СоздатьБазу(), "публичный");
	Запрещенный = СоздатьФрагмент(СоздатьБазу(Истина), "секрет");
	Удаленный = СоздатьФрагмент(СоздатьБазу(), "удален");
	ОбъектФрагмента = Удаленный.ПолучитьОбъект();
	ОбъектФрагмента.УстановитьПометкуУдаления(Истина);
	НетФрагмента = Строка(Новый УникальныйИдентификатор);
	Точки = Новый Массив;
	Точки.Добавить(Точка(UUID(Запрещенный), 0.99));
	Точки.Добавить(Точка(UUID(Удаленный), 0.98));
	Точки.Добавить(Точка(НетФрагмента, 0.97));
	Точки.Добавить(Точка("не-uuid", 0.96));
	Точки.Добавить(Новый Соответствие);
	Точки.Добавить(Точка(UUID(Разрешенный), 0.95));
	Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветПоиска(Точки), Модель);
	ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Знания[0].Текст).Равно("публичный");
	ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Запрещенный), Модель).Операция).Равно("delete");
	ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Удаленный), Модель).Операция).Равно("delete");
	ЮТест.ОжидаетЧто(ДанныеОчереди(НетФрагмента, Модель).Операция).Равно("delete");

КонецПроцедуры

// Для текста результата не требуется наличие корректного массива эмбеддинга.
Процедура Поиск_БезЧтенияНенужногоВектора() Экспорт

	Фрагмент = СоздатьФрагмент(СоздатьБазу(), "текст без вектора");
	ОбъектФрагмента = Фрагмент.ПолучитьОбъект();
	ОбъектФрагмента.Эмбеддинг = Новый ХранилищеЗначения("не массив");
	ОбъектФрагмента.Записать();
	Точки = Новый Массив;
	Точки.Добавить(Точка(UUID(Фрагмент), 0.8));
	Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветПоиска(Точки), "тест:нет-вектора");
	ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Знания[0].Текст).Равно("текст без вектора");

КонецПроцедуры

// Повторное обращение использует текущую политику, даже если точка уже найдена ранее.
Процедура Поиск_ИзмененнаяПолитикаУчитывается() Экспорт

	База = СоздатьБазу();
	Фрагмент = СоздатьФрагмент(База, "теперь секрет");
	Точки = Новый Массив;
	Точки.Добавить(Точка(UUID(Фрагмент), 0.8));
	Ответ = ОтветПоиска(Точки);
	РезультатДоЗапрета = КИИ_RAGQdrant.РазобратьОтветПоиска(Ответ, "тест:смена-политики");
	ЮТест.ОжидаетЧто(РезультатДоЗапрета.Знания.Количество()).Равно(1);
	ОбъектБазы = База.ПолучитьОбъект();
	ОбъектБазы.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	ОбъектБазы.Записать();
	После = КИИ_RAGQdrant.РазобратьОтветПоиска(Ответ, "тест:смена-политики");
	ЮТест.ОжидаетЧто(После.Знания.Количество()).Равно(0);

КонецПроцедуры

// Активность, пометка удаления, пустые критерии и сочетание всех условий сохранены.
Процедура Мониторинг_ПравилаПрименяютсяКПачке() Экспорт

	ВыключитьПравила();
	Маркер = Строка(Новый УникальныйИдентификатор);
	СоздатьПравило(Маркер, "Каталог", "совпадение", Истина, Ложь);
	СоздатьПравило(Маркер, "", "выключено", Ложь, Ложь);
	СоздатьПравило(Маркер, "", "удалено", Истина, Истина);
	СоздатьПравило("", "", "", Истина, Ложь);
	Пачка = Новый Соответствие;
	Хеш1 = ДобавитьОшибку(Пачка, Маркер, "Каталог", "совпадение", 2);
	Хеш2 = ДобавитьОшибку(Пачка, Маркер, "Другой", "совпадение", 3);
	Хеш3 = ДобавитьОшибку(Пачка, Маркер, "Каталог", "выключено", 4);
	Хеш4 = ДобавитьОшибку(Пачка, Маркер, "Каталог", "удалено", 5);
	КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВРегистр(Пачка);
	ЮТест.ОжидаетЧто(ДанныеОшибки(Хеш1).Игнорировать).Равно(Истина);
	ЮТест.ОжидаетЧто(ДанныеОшибки(Хеш2).Игнорировать).Равно(Ложь);
	ЮТест.ОжидаетЧто(ДанныеОшибки(Хеш3).Игнорировать).Равно(Ложь);
	ЮТест.ОжидаетЧто(ДанныеОшибки(Хеш4).Игнорировать).Равно(Ложь);
	ЮТест.ОжидаетЧто(КИИ_МониторингОшибокРегистры.ЭтоПодавляемаяОшибка(Маркер, "Каталог", "совпадение")).Равно(Истина);
	ЮТест.ОжидаетЧто(КИИ_МониторингОшибокРегистры.ЭтоПодавляемаяОшибка(Маркер, "Другой", "совпадение")).Равно(Ложь);

КонецПроцедуры

// Повторное событие увеличивает статистику и не пересчитывает сохраненный ручной флаг.
Процедура Мониторинг_ПовторСохраняетФлагИСчетчики() Экспорт

	ВыключитьПравила();
	Маркер = Строка(Новый УникальныйИдентификатор);
	Правило = СоздатьПравило(Маркер, "", "повтор", Истина, Ложь);
	Пачка = Новый Соответствие;
	Хеш = ДобавитьОшибку(Пачка, Маркер, "", "повтор", 2);
	КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВРегистр(Пачка);
	ОбъектПравила = Правило.ПолучитьОбъект();
	ОбъектПравила.Активно = Ложь;
	ОбъектПравила.Записать();
	Пачка[Хеш].Количество = 3;
	КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВРегистр(Пачка);
	Данные = ДанныеОшибки(Хеш);
	ЮТест.ОжидаетЧто(Данные.Игнорировать).Равно(Истина);
	ЮТест.ОжидаетЧто(Данные.КоличествоПовторений).Равно(5);
	Отбор = Новый Структура("ХешОшибки", Хеш);
	Статистика = РегистрыСведений.КИИ_МониторингОшибокСтатистика.Получить(НачалоДня(ТекущаяДатаСеанса()), Отбор);
	ЮТест.ОжидаетЧто(Статистика.Количество).Равно(5);

КонецПроцедуры

// Пустая выборка журнала не должна менять состояние транзакции.
Процедура Мониторинг_ПустаяПачкаДопустима() Экспорт
	КИИ_МониторингОшибокРегистры.ЗаписатьУникальныеОшибкиВРегистр(Новый Соответствие);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
КонецПроцедуры

// Ошибка HTTP одной точки оставляет ее в очереди, следующая обрабатывается успешно.
Процедура Очередь_ОшибкаОднойТочкиНеМешаетСледующей() Экспорт
	Контур = Тесты_КИИ_ОчередьQdrant.ПодготовитьКонтур();
	Контур.Модели.Добавить("тест:queue-http");
	Контур.Модели.Добавить("тест:queue-policy");
	Контур.Модели.Добавить("тест:sweep-a");
	Контур.Модели.Добавить("тест:sweep-b");
	Попытка
		ПодготовитьHTTP();
		ОчиститьОчередь();
		Первый = СоздатьФрагмент(СоздатьБазу(Ложь, Контур.Ссылки), "HTTP ошибка", "тест:queue-http", Контур.Ссылки);
		Второй = СоздатьФрагмент(СоздатьБазу(Ложь, Контур.Ссылки), "HTTP успех", "тест:queue-http", Контур.Ссылки);
		НастроитьHTTP(Новый Структура("fail_uuid", UUID(Первый)));
		ЗаписатьОчередь(Первый, "тест:queue-http", 1);
		ЗаписатьОчередь(Второй, "тест:queue-http", 2);
		Настройки = КИИ_ОчередьQdrant.ПараметрыОбработки();
		Настройки.КоличествоИсполнителей = 1;
		КИИ_ОчередьQdrant.Обработать(Настройки);
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Первый), "тест:queue-http").Попыток).Равно(1);
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Второй), "тест:queue-http").Операция).Равно("");
		Статистика = СтатистикаHTTP();
		ЮТест.ОжидаетЧто(Статистика.batch_requests).Равно(3);
	Исключение
		Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
		ВызватьИсключение;
	КонецПопытки;
	Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
КонецПроцедуры

// Запрещенный фрагмент удаляется из внешнего индекса без отправки текста и вектора.
Процедура Очередь_ЗапрещеннаяПолитикаТолькоУдаление() Экспорт
	Контур = Тесты_КИИ_ОчередьQdrant.ПодготовитьКонтур();
	Контур.Модели.Добавить("тест:queue-http");
	Контур.Модели.Добавить("тест:queue-policy");
	Контур.Модели.Добавить("тест:sweep-a");
	Контур.Модели.Добавить("тест:sweep-b");
	Попытка
		ПодготовитьHTTP();
		ОчиститьОчередь();
		НастроитьHTTP(Новый Структура);
		Фрагмент = СоздатьФрагмент(СоздатьБазу(Истина, Контур.Ссылки), "запрещено отправлять",
			"тест:queue-policy", Контур.Ссылки);
		КИИ_RAGQdrant.ОбеспечитьКоллекцию("тест:queue-policy", 3);
		ЗаписатьОчередь(Фрагмент, "тест:queue-policy", 1);
		Настройки = КИИ_ОчередьQdrant.ПараметрыОбработки();
		Настройки.КоличествоИсполнителей = 1;
		КИИ_ОчередьQdrant.Обработать(Настройки);
		Статистика = СтатистикаHTTP();
		ЮТест.ОжидаетЧто(Статистика.puts).Равно(0);
		ЮТест.ОжидаетЧто(Статистика.deletes).Равно(1);
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Фрагмент), "тест:queue-policy").Операция).Равно("");
	Исключение
		Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
		ВызватьИсключение;
	КонецПопытки;
	Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
КонецПроцедуры

// Сверка читает порцию точек и сохраняет отдельный обход моделей.
Процедура Сверка_НесколькоМоделейИОсиротевшиеТочки() Экспорт
	Контур = Тесты_КИИ_ОчередьQdrant.ПодготовитьКонтур();
	Контур.Модели.Добавить("тест:queue-http");
	Контур.Модели.Добавить("тест:queue-policy");
	Контур.Модели.Добавить("тест:sweep-a");
	Контур.Модели.Добавить("тест:sweep-b");
	Попытка
		ПодготовитьHTTP();
		ОчиститьОчередь();
		Точки = Новый Массив;
		Живой = СоздатьФрагмент(СоздатьБазу(Ложь, Контур.Ссылки), "живет", "тест:sweep-a", Контур.Ссылки);
		СоздатьФрагмент(СоздатьБазу(Ложь, Контур.Ссылки), "вторая модель", "тест:sweep-b", Контур.Ссылки);
		Точки.Добавить(Точка(UUID(Живой), 1));
		НетФрагмента = Строка(Новый УникальныйИдентификатор);
		Точки.Добавить(Точка(НетФрагмента, 1));
		Запрещенный = СоздатьФрагмент(СоздатьБазу(Истина, Контур.Ссылки), "секрет", "тест:sweep-a", Контур.Ссылки);
		Точки.Добавить(Точка(UUID(Запрещенный), 1));
		НастроитьHTTP(Новый Структура("points", Точки));
		Первый = КИИ_RAGQdrant.Сверить("тест:sweep-a", 3);
		Второй = КИИ_RAGQdrant.Сверить("тест:sweep-b", 3);
		ЮТест.ОжидаетЧто(Первый.Удалено).Равно(2);
		ЮТест.ОжидаетЧто(Первый.Поставлено).Равно(1);
		ЮТест.ОжидаетЧто(Второй.Поставлено).Равно(1);
		ЮТест.ОжидаетЧто(ДанныеОчереди(НетФрагмента, "тест:sweep-a").Операция).Равно("delete");
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Запрещенный), "тест:sweep-a").Операция).Равно("delete");
	
		ОчиститьОчередь();
		ОчиститьПоколенияТеста();
		КИИ_RAGQdrant.ОбеспечитьКоллекцию("тест:sweep-a", 3);
		КИИ_RAGQdrant.ОтметитьПоколение("тест:sweep-a", Истина);
		КИИ_RAGQdrant.ОбеспечитьКоллекцию("тест:sweep-b", 3);
		КИИ_RAGQdrant.ОтметитьПоколение("тест:sweep-b", Истина);
		НастроитьHTTP(Новый Структура("points", Точки));
		КИИ_RAGQdrant.СверитьВсе();
		Статистика = СтатистикаHTTP();
		ЮТест.ОжидаетЧто(Статистика.scrolls).Равно(2);
		ЮТест.ОжидаетЧто(Статистика.puts).Равно(2);
		ЮТест.ОжидаетЧто(Статистика.deletes).Равно(4);
	Исключение
		Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
		ВызватьИсключение;
	КонецПопытки;
	Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
КонецПроцедуры

// Необязательная пустая категория сохраняет прежнее разрешение, но не возвращает NULL.
Процедура Чтение_БезКатегорииИмеетЯвнуюПолитику() Экспорт
	Фрагмент = СоздатьФрагмент(СоздатьБазу(), "без категории");
	Данные = ПрочитатьФрагмент(Фрагмент);
	ЮТест.ОжидаетЧто(Данные.Категория).Равно(Справочники.КИИ_КатегорииЗнаний.ПустаяСсылка());
	ЮТест.ОжидаетЧто(Данные.ЭффективнаяПолитика).Равно(Перечисления.КИИ_ПолитикиЭмбеддинга.ПустаяСсылка());
КонецПроцедуры

// Отсутствующий владелец не превращает осиротевший текст в разрешенный результат поиска.
Процедура Поиск_БезБазыНеВозвращаетТекст() Экспорт
	НетБазы = Справочники.КИИ_БазаЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Фрагмент = СоздатьФрагмент(НетБазы, "осиротевший текст");
	ПроверитьОтсутствиеВПоиске(Фрагмент);
КонецПроцедуры

// Пометка владельца также исключает текст из результата, даже если фрагмент еще существует.
Процедура Поиск_ПомеченнаяБазаНеВозвращаетТекст() Экспорт
	База = СоздатьБазу();
	Фрагмент = СоздатьФрагмент(База, "текст удаляемой базы");
	ОбъектБазы = База.ПолучитьОбъект();
	ОбъектБазы.УстановитьПометкуУдаления(Истина);
	ПроверитьОтсутствиеВПоиске(Фрагмент);
КонецПроцедуры

// Непустая ссылка на отсутствующую категорию не дает неявного разрешения на отправку.
Процедура Чтение_НетКатегорииБезПереопределенияЗапрещено() Экспорт
	База = БазаСОтсутствующейКатегорией();
	Фрагмент = СоздатьФрагмент(База, "неизвестная политика");
	Данные = ПрочитатьФрагмент(Фрагмент);
	ЮТест.ОжидаетЧто(Данные.ЭффективнаяПолитика).Равно(Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее);
КонецПроцедуры

// Явная политика владельца имеет приоритет над отсутствующей категорией.
Процедура Чтение_ПереопределениеСохраняетсяБезКатегории() Экспорт
	База = БазаСОтсутствующейКатегорией();
	ОбъектБазы = База.ПолучитьОбъект();
	ОбъектБазы.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ;
	ОбъектБазы.Записать();
	Данные = ПрочитатьФрагмент(СоздатьФрагмент(База, "явная политика"));
	ЮТест.ОжидаетЧто(Данные.ЭффективнаяПолитика).Равно(Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ);
КонецПроцедуры

// Запрет действующей категории наследуется без изменения.
Процедура Чтение_ЗапретКатегорииНаследуется() Экспорт
	Категория = Справочники.КИИ_КатегорииЗнаний.СоздатьЭлемент();
	Категория.Наименование = "Категория запрета " + Строка(Новый УникальныйИдентификатор);
	Категория.ПолитикаЭмбеддинга = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	Категория.Записать();
	База = СоздатьБазу();
	ОбъектБазы = База.ПолучитьОбъект();
	ОбъектБазы.Категория = Категория.Ссылка;
	ОбъектБазы.Записать();
	Данные = ПрочитатьФрагмент(СоздатьФрагмент(База, "наследуемый запрет"));
	ЮТест.ОжидаетЧто(Данные.ЭффективнаяПолитика).Равно(Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее);
КонецПроцедуры

// Второй запрос сверки не ставит обновление для осиротевших/неопределенных политик.
Процедура Сверка_НетБазыИКатегорииНеСтавитОбновление() Экспорт
	Контур = Тесты_КИИ_ОчередьQdrant.ПодготовитьКонтур();
	Контур.Модели.Добавить("тест:sweep-a");
	Попытка
		ПодготовитьHTTP();
		НетБазы = Справочники.КИИ_БазаЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Первый = СоздатьФрагмент(НетБазы, "нет владельца", "тест:sweep-a", Контур.Ссылки);
		База = БазаСОтсутствующейКатегорией(Контур.Ссылки);
		Второй = СоздатьФрагмент(База, "нет категории", "тест:sweep-a", Контур.Ссылки);
		СоздатьФрагмент(СоздатьБазу(Ложь, Контур.Ссылки), "разрешенный", "тест:sweep-a", Контур.Ссылки);
		Точки = Новый Массив;
		Точки.Добавить(Точка(UUID(Первый), 1));
		Точки.Добавить(Точка(UUID(Второй), 1));
		НастроитьHTTP(Новый Структура("points", Точки));
		Итог = КИИ_RAGQdrant.Сверить("тест:sweep-a", 3);
		ЮТест.ОжидаетЧто(Итог.Удалено).Равно(2);
		ЮТест.ОжидаетЧто(Итог.Поставлено).Равно(1);
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Первый), "тест:sweep-a").Операция).Равно("delete");
		ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Второй), "тест:sweep-a").Операция).Равно("delete");
	Исключение
		Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
		ВызватьИсключение;
	КонецПопытки;
	Тесты_КИИ_ОчередьQdrant.ОчиститьКонтур(Контур);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьФрагмент(Знач Фрагмент)
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(UUID(Фрагмент));
	Данные = КИИ_RAGQdrant.ПрочитатьФрагментыОчереди(Идентификаторы, Ложь);
	Возврат Данные[UUID(Фрагмент)];
КонецФункции

Процедура ПроверитьОтсутствиеВПоиске(Знач Фрагмент)
	Точки = Новый Массив;
	Точки.Добавить(Точка(UUID(Фрагмент), 1));
	Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветПоиска(Точки), "тест:порция");
	ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ДанныеОчереди(UUID(Фрагмент), "тест:порция").Операция).Равно("delete");
КонецПроцедуры

Функция БазаСОтсутствующейКатегорией(Созданные = Неопределено)
	База = СоздатьБазу(Ложь, Созданные);
	ОбъектБазы = База.ПолучитьОбъект();
	ОбъектБазы.Категория = Справочники.КИИ_КатегорииЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ОбъектБазы.Записать();
	Возврат База;
КонецФункции


Функция СоздатьБазу(Знач Запрещено = Ложь, Созданные = Неопределено)
	ОбъектБазы = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
	ОбъектБазы.Наименование = "Порция " + Строка(Новый УникальныйИдентификатор);
	Если Запрещено Тогда
		ОбъектБазы.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	КонецЕсли;
	ОбъектБазы.Записать();
	Если Созданные <> Неопределено Тогда
		Созданные.Добавить(ОбъектБазы.Ссылка);
	КонецЕсли;
	Возврат ОбъектБазы.Ссылка;
КонецФункции

Функция СоздатьФрагмент(Знач База, Знач Текст, Знач Модель = "тест:порция", Созданные = Неопределено)
	Вектор = Новый Массив;
	Вектор.Добавить(1);
	Вектор.Добавить(0);
	Вектор.Добавить(0);
	ОбъектФрагмента = Справочники.КИИ_ФрагментыЗнаний.СоздатьЭлемент();
	ОбъектФрагмента.Владелец = База;
	ОбъектФрагмента.Наименование = Текст;
	ОбъектФрагмента.ТекстФрагмента = Текст;
	ОбъектФрагмента.Эмбеддинг = Новый ХранилищеЗначения(Вектор);
	ОбъектФрагмента.КодМоделиЭмбеддинга = Модель;
	ОбъектФрагмента.Размерность = 3;
	ОбъектФрагмента.Записать();
	Если Созданные <> Неопределено Тогда
		Созданные.Добавить(ОбъектФрагмента.Ссылка);
	КонецЕсли;
	Возврат ОбъектФрагмента.Ссылка;
КонецФункции

Функция UUID(Знач Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция Точка(Знач Идентификатор, Знач Оценка)
	Payload = Новый Соответствие;
	Payload.Вставить("фрагмент", Идентификатор);
	Результат = Новый Соответствие;
	Результат.Вставить("payload", Payload);
	Результат.Вставить("score", Оценка);
	Возврат Результат;
КонецФункции

Функция ОтветПоиска(Знач Точки)
	Результат = Новый Соответствие;
	Результат.Вставить("points", Точки);
	Ответ = Новый Соответствие;
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
КонецФункции

Процедура ВыключитьПравила()
	Выборка = Справочники.КИИ_ПравилаИгнорированияОшибок.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектПравила = Выборка.ПолучитьОбъект();
		ОбъектПравила.Активно = Ложь;
		ОбъектПравила.Записать();
	КонецЦикла;
КонецПроцедуры

Функция СоздатьПравило(Знач Событие, Знач ИмяМетаданных, Знач Текст, Знач Активно, Знач Удалено)
	Правило = Справочники.КИИ_ПравилаИгнорированияОшибок.СоздатьЭлемент();
	Правило.Наименование = "Правило порции";
	Правило.Событие = Событие;
	Правило.Метаданные = ИмяМетаданных;
	Правило.ТекстСодержит = Текст;
	Правило.Активно = Активно;
	Правило.ПометкаУдаления = Удалено;
	Правило.Записать();
	Возврат Правило.Ссылка;
КонецФункции

Функция ДобавитьОшибку(Пачка, Знач Событие, Знач ИмяМетаданных, Знач Текст, Знач Количество)
	Хеш = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Запись = Новый Структура;
	Запись.Вставить("Дата", ТекущаяДатаСеанса());
	Запись.Вставить("Комментарий", Текст);
	Запись.Вставить("Событие", Событие);
	Запись.Вставить("ИмяПользователя", "тест");
	Запись.Вставить("Компьютер", "стенд");
	Запись.Вставить("МетаданныеПредставление", ИмяМетаданных);
	Запись.Вставить("Данные", "");
	Пачка.Вставить(Хеш, Новый Структура("ЗаписьЖР,Количество", Запись, Количество));
	Возврат Хеш;
КонецФункции

Функция ДанныеОшибки(Знач Хеш)
	Возврат РегистрыСведений.КИИ_МониторингОшибокЖурнал.Получить(Новый Структура("ХешОшибки", Хеш));
КонецФункции

Функция ДанныеОчереди(Знач Идентификатор, Знач Модель)
	Отбор = Новый Структура("ФрагментИдентификатор,КодМодели", Идентификатор, Модель);
	Возврат РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
КонецФункции

Процедура ПодготовитьHTTP()
	Константы.КИИ_QdrantАдрес.Установить("http://localhost:8871");
КонецПроцедуры

Процедура НастроитьHTTP(Знач Настройки)
	ЗапросHTTP = Новый HTTPЗапрос("/__fixture");
	ЗапросHTTP.УстановитьТелоИзСтроки(КИИ_HTTPКлиент.СтруктураВJson(Настройки));
	Соединение = Новый HTTPСоединение("localhost", 8871, , , Новый ИнтернетПрокси(Ложь), 5);
	Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния).Равно(200);
