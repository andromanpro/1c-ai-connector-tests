	Контент = Новый Массив;
	Контент.Добавить(Новый Структура("Тип, Текст", "text", "Что на скане?"));
	Контент.Добавить(Новый Структура("Тип, ИмяФайла, Данные", "image", "скан.png", "iVBORw0KGgo="));

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", Контент), Неопределено, Контекст);

	ЮТест.ОжидаетЧто(Подготовка.Разрешено, "разрешено").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Подготовка.КодОтказа, "код отказа").Равно("ВложенияПриБлокировке");
	ЮТест.ОжидаетЧто(Подготовка.ТекстОтказа, "текст отказа").Содержит("вложения").НеСодержит("()");

