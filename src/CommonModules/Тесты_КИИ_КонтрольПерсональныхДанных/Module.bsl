Процедура Восстановление_ОтветМодели_ВосстановленоПолностью() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Текст = "Клиент Иванов Петр Сергеевич, ИНН 7707083893";
	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", Текст), Неопределено, Контекст);
	ФИО = ПодстановкаОригинала(Контекст, "Иванов Петр Сергеевич");
	ИНН = ПодстановкаОригинала(Контекст, "7707083893");
	Ответ = СтрШаблон("Проверьте карточку %1: у ИНН %2 не заполнен КПП. %1 указан ответственным.", ФИО, ИНН);

	Восстановление = КИИ_КонтрольПерсональныхДанных.ВосстановитьДляЧеловека(Ответ, Контекст);

	ЮТест.ОжидаетЧто(Подготовка.Решение, "решение").Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Восстановление.Статус, "статус").Равно("ВосстановленоПолностью");
	ЮТест.ОжидаетЧто(Восстановление.Текст, "текст").Равно("Проверьте карточку Иванов Петр Сергеевич: "
		+ "у ИНН 7707083893 не заполнен КПП. Иванов Петр Сергеевич указан ответственным.");

КонецПроцедуры

