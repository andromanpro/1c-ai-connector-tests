// Пустая настройка защиту не выключает: запросы к моделям и Telegram маскируются, Kroki логируется.
Процедура Режим_ПустыеНастройки_ПоУмолчаниюКанала() Экспорт

	НачатьТранзакцию();
	Попытка
		ОчиститьНастройкиКаналов();

		Модели = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
			КИИ_КонтрольПерсональныхДанных.КаналЗапросыКМоделям(), "ИНН 7707083893");
		Телеграм = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
			КИИ_КонтрольПерсональныхДанных.КаналУведомленияТелеграм(), "ИНН 7707083893");
		Диаграммы = КИИ_КонтрольПерсональныхДанных.ПодготовитьТекстКанала(
			КИИ_КонтрольПерсональныхДанных.КаналРендерДиаграмм(), "ИНН 7707083893");

		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЮТест.ОжидаетЧто(Модели.Решение, "запросы к моделям").Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Модели.Текст, "текст запроса").НеСодержит("7707083893");
	ЮТест.ОжидаетЧто(Телеграм.Решение, "телеграм").Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Диаграммы.Решение, "диаграммы").Равно("Записано");
	ЮТест.ОжидаетЧто(Диаграммы.Текст, "текст диаграммы").Равно("ИНН 7707083893");

КонецПроцедуры

Процедура Режим_ДоверенныйРендерДиаграмм_Выключен() Экспорт

	НачатьТранзакцию();
	Попытка
		ОчиститьНастройкиКаналов();
		Константы.КИИ_РежимКонтроляРендераДиаграмм.Установить(
			Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Блокировать);
