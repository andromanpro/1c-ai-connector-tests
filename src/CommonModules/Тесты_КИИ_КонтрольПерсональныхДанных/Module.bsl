// Находка в формате КИИ_ПравилаПерсональныхДанных.НайтиСущности для проверки пересечений.
Функция НаходкаДляПересечения(Знач Тип, Знач Значение, Знач Начало, Знач Уверенность)

	Находка = Новый Структура;
	Находка.Вставить("Тип", Тип);
	Находка.Вставить("Значение", Значение);
	Находка.Вставить("НормализованныйКлюч", КИИ_ПравилаПерсональныхДанных.НормализоватьЗначение(Тип, Значение));
	Находка.Вставить("Начало", Начало);
	Находка.Вставить("Длина", СтрДлина(Значение));
	Находка.Вставить("Уверенность", Уверенность);
	Находка.Вставить("Детектор", "Тест");
	Возврат Находка;

КонецФункции


