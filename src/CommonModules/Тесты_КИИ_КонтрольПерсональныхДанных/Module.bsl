Функция СобытияОперации(Знач Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	Журнал.Канал КАК Канал,
		|	Журнал.Операция КАК Операция,
		|	Журнал.Режим КАК Режим,
		|	Журнал.Решение КАК Решение,
		|	Журнал.КодОтказа КАК КодОтказа,
		|	Журнал.ТипыСущностей КАК ТипыСущностей,
		|	Журнал.КоличествоЗамен КАК КоличествоЗамен,
		|	Журнал.БылиЗамены КАК БылиЗамены,
		|	Журнал.ВерсияПравил КАК ВерсияПравил,
		|	Журнал.ВерсияГенератораПодстановок КАК ВерсияГенератораПодстановок,
		|	Журнал.СтатусАудита КАК СтатусАудита
		|ИЗ
		|	РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных КАК Журнал
		|ГДЕ
		|	Журнал.Операция = &Операция";
	Запрос.УстановитьПараметр("Операция", Контекст.ИдентификаторОперации);

	События = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Событие = Новый Структура("ИдентификаторСобытия, Канал, Операция, Режим, Решение, КодОтказа, "
			+ "ТипыСущностей, КоличествоЗамен, БылиЗамены, ВерсияПравил, ВерсияГенератораПодстановок, СтатусАудита");
		ЗаполнитьЗначенияСвойств(Событие, Выборка);
		События.Добавить(Событие);
	КонецЦикла;

	Возврат События;

