// Пакет со всеми полями закрытого перечня; в каждом поле все три исходных значения.
Функция ПромптСоВсемиПолями()

	Данные = "Иванов Петр Сергеевич, ИНН 7707083893, petrov@example.org";

	Контент = Новый Массив;
	Контент.Добавить(Новый Структура("Тип, Текст", "text", "Разбери: " + Данные));
	Контент.Добавить(Новый Структура("Тип, ИмяФайла, Данные", "document",
		"Иванов Петр Сергеевич 7707083893 petrov@example.org.pdf", "JVBERi0="));

	История = Новый Массив;
	История.Добавить(Новый Структура("Роль, Текст", "user", "Ранее: " + Данные));

	ОписаниеФункции = Новый Структура("name, arguments", "find_counterparty",
		"{""query"": """ + Данные + """}");
	Вызов = Новый Структура("id, type, function", "call_1", "function", ОписаниеФункции);
	ВызовыИнструментов = Новый Массив;
	ВызовыИнструментов.Добавить(Вызов);

	Сырые = Новый Массив;
	Сырые.Добавить(Новый Структура("role, content", "system", "Ты помощник."));
	Сырые.Добавить(Новый Структура("role, content", "user", "Проверь " + Данные));
	Сырые.Добавить(Новый Структура("role, content, tool_calls", "assistant", "", ВызовыИнструментов));

	Промпт = Новый Структура;
	Промпт.Вставить("СистемныйПромпт", "Контекст: " + Данные);
	Промпт.Вставить("ПользовательскийПромпт", Контент);
	Промпт.Вставить("ИсторияСообщений", История);
	Промпт.Вставить("СырыеСообщения", Сырые);

	Возврат Промпт;

КонецФункции

Функция ПодстановкаОригинала(Знач Контекст, Знач Оригинал)

	Для Каждого Элемент Из Контекст.ОригиналПоПодстановке Цикл
		Если Элемент.Значение = Оригинал Тогда
			Возврат Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция СобытияОперации(Знач Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.ИдентификаторСобытия КАК ИдентификаторСобытия,
		|	Журнал.Канал КАК Канал,
		|	Журнал.Операция КАК Операция,
		|	Журнал.Режим КАК Режим,
		|	Журнал.Решение КАК Решение,
		|	Журнал.КодОтказа КАК КодОтказа,
		|	Журнал.ТипыСущностей КАК ТипыСущностей,
		|	Журнал.КоличествоЗамен КАК КоличествоЗамен,
		|	Журнал.БылиЗамены КАК БылиЗамены,
		|	Журнал.ВерсияПравил КАК ВерсияПравил,
		|	Журнал.ВерсияГенератораПодстановок КАК ВерсияГенератораПодстановок,
		|	Журнал.СтатусАудита КАК СтатусАудита
		|ИЗ
		|	РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных КАК Журнал
		|ГДЕ
		|	Журнал.Операция = &Операция";
	Запрос.УстановитьПараметр("Операция", Контекст.ИдентификаторОперации);

	События = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Событие = Новый Структура("ИдентификаторСобытия, Канал, Операция, Режим, Решение, КодОтказа, "
			+ "ТипыСущностей, КоличествоЗамен, БылиЗамены, ВерсияПравил, ВерсияГенератораПодстановок, СтатусАудита");
		ЗаполнитьЗначенияСвойств(Событие, Выборка);
		События.Добавить(Событие);
	КонецЦикла;

	Возврат События;

КонецФункции

Функция ЧислоОтказовМодели(Знач Модель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных КАК Журнал
		|ГДЕ
		|	Журнал.Модель = &Модель
		|	И Журнал.Решение = ""Заблокировано""";
	Запрос.УстановитьПараметр("Модель", Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

