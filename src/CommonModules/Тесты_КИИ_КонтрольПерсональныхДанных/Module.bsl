// Каждое текстовое поле закрытого перечня уходит без исходных значений.
Процедура Маскировка_ВсеПоляПромпта_ОригиналовНет() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Промпт = ПромптСоВсемиПолями();

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(Промпт, Неопределено, Контекст);

	ЮТест.ОжидаетЧто(Подготовка.Разрешено, "разрешено").ЭтоИстина();
	ЮТест.ОжидаетЧто(Подготовка.Решение, "решение").Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Подготовка.БылиЗамены, "были замены").ЭтоИстина();
	ЮТест.ОжидаетЧто(Контекст.ПроверятьТело, "проверять тело").ЭтоИстина();

	Отправляемое = Подготовка.СтруктураПромпта;
	Для Каждого Оригинал Из ОригиналыПромптаСоВсемиПолями() Цикл
		ЮТест.ОжидаетЧто(Отправляемое.СистемныйПромпт, "системный промпт").НеСодержит(Оригинал);
		ЮТест.ОжидаетЧто(Отправляемое.ПользовательскийПромпт[0].Текст, "текст контента").НеСодержит(Оригинал);
		ЮТест.ОжидаетЧто(Отправляемое.ПользовательскийПромпт[1].ИмяФайла, "имя файла").НеСодержит(Оригинал);
		ЮТест.ОжидаетЧто(Отправляемое.ИсторияСообщений[0].Текст, "история").НеСодержит(Оригинал);
		// Первым сообщением встала инструкция модели, исходные сдвинулись на одно.
		ЮТест.ОжидаетЧто(Отправляемое.СырыеСообщения[2].content, "сырое сообщение").НеСодержит(Оригинал);
		ЮТест.ОжидаетЧто(Отправляемое.СырыеСообщения[3].tool_calls[0].function.arguments, "аргументы вызова")
			.НеСодержит(Оригинал);
	КонецЦикла;

	ЮТест.ОжидаетЧто(КИИ_КонтрольПерсональныхДанных.ТелоСодержитОригиналы(
		ОбщегоНазначения.ЗначениеВСтрокуXML(Отправляемое), Контекст), "оригиналы в сериализованном пакете").ЭтоЛожь();

КонецПроцедуры

// Маскируется независимая копия: структура вызывающего остается с исходными значениями.
Процедура Маскировка_ИсходнаяСтруктураНеМеняется() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Промпт = ПромптСоВсемиПолями();
	ДоПодготовки = ОбщегоНазначения.ЗначениеВСтрокуXML(Промпт);

	КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(Промпт, Неопределено, Контекст);

	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеВСтрокуXML(Промпт), "исходная структура").Равно(ДоПодготовки);

КонецПроцедуры

// Одно значение в разных полях и разном написании получает одну подстановку.
Процедура Маскировка_ОдноЗначение_ОднаПодстановка() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Промпт = Новый Структура;
	Промпт.Вставить("СистемныйПромпт", "Контрагент с ИНН 7707083893 найден.");
	Промпт.Вставить("ПользовательскийПромпт", "Почему ИНН 7707083893 не проходит, а инн 7707083893 проходит?");

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(Промпт, Неопределено, Контекст);

	Подстановка = ПодстановкаОригинала(Контекст, "7707083893");
	ЮТест.ОжидаетЧто(Подстановка, "подстановка ИНН").Заполнено();
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Подготовка.СтруктураПромпта.ПользовательскийПромпт, Подстановка),
		"вхождений в пользовательском промпте").Равно(2);
	ЮТест.ОжидаетЧто(Подготовка.СтруктураПромпта.СистемныйПромпт, "системный промпт").Содержит(Подстановка);
	ЮТест.ОжидаетЧто(Контекст.ОригиналПоПодстановке.Количество(), "размер карты").Равно(1);
	ЮТест.ОжидаетЧто(Контекст.КоличествоЗамен, "количество замен").Равно(3);

КонецПроцедуры

// Агентская петля несет прошлые ответы модели с подстановками: повторная подготовка их не трогает,
// а исходные значения получают те же подстановки, что и в прошлом раунде.
Процедура Маскировка_ПовторнаяПодготовка_ПодстановкиНеМеняются() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Текст = ТекстСоВсемиТипами();

	Первая = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", Текст), Неопределено, Контекст);
	Маска = Первая.СтруктураПромпта.ПользовательскийПромпт;
	РазмерКарты = Контекст.ОригиналПоПодстановке.Количество();

	Вторая = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", Маска + Символы.ПС + Текст), Неопределено, Контекст);

	ЮТест.ОжидаетЧто(Вторая.СтруктураПромпта.ПользовательскийПромпт, "второй раунд")
		.Равно(Маска + Символы.ПС + Маска);
	ЮТест.ОжидаетЧто(Контекст.ОригиналПоПодстановке.Количество(), "размер карты после второго раунда")
		.Равно(РазмерКарты);

КонецПроцедуры

// В агентском сценарии системный промпт до модели не доходит: инструкция встает первым сообщением.
Процедура Маскировка_ИнструкцияМодели_ВСырыхСообщениях() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "user", "Проверь контрагента ИНН 7707083893"));

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("СырыеСообщения", Сообщения), Неопределено, Контекст);

	Отправляемые = Подготовка.СтруктураПромпта.СырыеСообщения;
	ЮТест.ОжидаетЧто(Отправляемые.Количество(), "количество сообщений").Равно(2);
	ЮТест.ОжидаетЧто(Отправляемые[0].role, "роль первого").Равно("system");
	ЮТест.ОжидаетЧто(Отправляемые[0].content, "инструкция").Содержит("подстановками");
	ЮТест.ОжидаетЧто(Сообщения.Количество(), "исходный массив").Равно(1);

КонецПроцедуры

// Уведомление в Telegram читает человек: инструкция для модели туда не добавляется.
Процедура Маскировка_КаналТелеграм_БезИнструкцииМодели() Экспорт

	Контекст = КИИ_КонтрольПерсональныхДанных.НовыйКонтекст(
		КИИ_КонтрольПерсональныхДанных.КаналУведомленияТелеграм());
	Контекст.Режим = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Маскировать;

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", "Ошибка у клиента ivanov@mail.ru"), Неопределено, Контекст);

	ЮТест.ОжидаетЧто(Подготовка.Решение, "решение").Равно("Замаскировано");
	ЮТест.ОжидаетЧто(Подготовка.СтруктураПромпта.Свойство("СистемныйПромпт"), "системный промпт").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Подготовка.СтруктураПромпта.ПользовательскийПромпт, "текст").НеСодержит("ivanov@mail.ru");

КонецПроцедуры

// Без персональных данных запрос уходит как есть и журнал не засоряется.
Процедура Маскировка_НетДанных_Пропущено() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Промпт = Новый Структура("ПользовательскийПромпт", "Почему документ РеализацияТоваровУслуг 12 не проводится?");

	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(Промпт, Неопределено, Контекст);

	ЮТест.ОжидаетЧто(Подготовка.Разрешено, "разрешено").ЭтоИстина();
	ЮТест.ОжидаетЧто(Подготовка.Решение, "решение").Равно("Пропущено");
	ЮТест.ОжидаетЧто(Подготовка.БылиЗамены, "были замены").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СобытияОперации(Контекст).Количество(), "событий журнала").Равно(0);

КонецПроцедуры

// Вызов фасада с контекстом контроля: число параметров проверяется только при исполнении,
// поэтому вызов доводится до отказа по незаполненной модели.
Процедура Фасад_КонтекстТретьимПараметром_ВызовРазрешается() Экспорт

	ТекстОшибки = "";
	Попытка
		Результат = КИИ_КоннекторИИ.ЗапросКМодели(Справочники.КИИ_МоделиИИ.ПустаяСсылка(), "проба",
			КонтекстСРежимом("Маскировать"));
		ТекстОшибки = Результат.ТекстОшибки;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "причина отказа").Содержит("модель").НеСодержит("параметр");

КонецПроцедуры

#КонецОбласти

#Область Подстановки

// Подстановка не может принадлежать человеку, но проходит те же проверки формата, что и оригинал.
Процедура Подстановки_НесуществующиеДиапазоныИВалидныеСуммы() Экспорт

	Проверка = КИИ_КонтрольПерсональныхДанных.ПроверитьТекст(ТекстСоВсемиТипами());
	Подстановки = Новый Соответствие;
	Для Каждого Находка Из Проверка.Находки Цикл
		Подстановки.Вставить(Находка.Тип + "|" + Находка.Значение, Находка.Подстановка);
	КонецЦикла;

	ИНН10 = Подстановки["ИНН|7707083893"];
	ЮТест.ОжидаетЧто(ИНН10, "ИНН юрлица").НачинаетсяС("00").ИмеетДлину(10);
	ЮТест.ОжидаетЧто(КИИ_ПравилаПерсональныхДанных.ИННКорректен(ИНН10), "сумма ИНН юрлица").ЭтоИстина();

	ИНН12 = Подстановки["ИНН|500100732259"];
	ЮТест.ОжидаетЧто(ИНН12, "ИНН физлица").НачинаетсяС("00").ИмеетДлину(12);
	ЮТест.ОжидаетЧто(КИИ_ПравилаПерсональныхДанных.ИННКорректен(ИНН12), "сумма ИНН физлица").ЭтоИстина();

	СНИЛС = Подстановки["СНИЛС|112-233-445 95"];
	ЮТест.ОжидаетЧто(СНИЛС, "СНИЛС").НачинаетсяС("000-");
	ЮТест.ОжидаетЧто(КИИ_ПравилаПерсональныхДанных.СНИЛСКорректен(
		КИИ_ПравилаПерсональныхДанных.НормализоватьЗначение("СНИЛС", СНИЛС)), "сумма СНИЛС").ЭтоИстина();

	Карта = Подстановки["КАРТА|4026843483168683"];
	ЮТест.ОжидаетЧто(Карта, "карта").НачинаетсяС("0000");
	ЮТест.ОжидаетЧто(КИИ_ПравилаПерсональныхДанных.НомерКартыКорректен(
		КИИ_ПравилаПерсональныхДанных.НормализоватьЗначение("КАРТА", Карта)), "Луна карты").ЭтоИстина();

	ЮТест.ОжидаетЧто(Подстановки["ТЕЛЕФОН|+7 903 123-45-67"], "телефон").НачинаетсяС("+7 000 ");
	ЮТест.ОжидаетЧто(Подстановки["EMAIL|petrov@mail.ru"], "почта").ЗаканчиваетсяНа("@example.com");
	ЮТест.ОжидаетЧто(Подстановки["ПАСПОРТ|45 06 123456"], "паспорт").НачинаетсяС("00 00 ");
	ЮТест.ОжидаетЧто(Подстановки["ФИО|Иванов Петр Сергеевич"], "ФИО").ЗаканчиваетсяНа("ич");

КонецПроцедуры

// Женское отчество дает женскую подстановку: согласованность рода в тексте сохраняется.
Процедура Подстановки_ЖенскоеФИО_ЖенскаяПодстановка() Экспорт

	Проверка = КИИ_КонтрольПерсональныхДанных.ПроверитьТекст("Заявка от Петровой Анны Ивановны отклонена, "
		+ "ответственный Петрова Анна Ивановна");

	Подстановка = "";
	Для Каждого Находка Из Проверка.Находки Цикл
		Если Находка.Значение = "Петрова Анна Ивановна" Тогда
			Подстановка = Находка.Подстановка;
		КонецЕсли;
