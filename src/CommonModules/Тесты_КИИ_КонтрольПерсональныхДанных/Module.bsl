// Контрольная проверка тела ловит исходное значение, прошедшее в обход подготовки.
Процедура ТелоЗапроса_ОригиналВТеле_Обнаружен() Экспорт

	Контекст = КонтекстСРежимом("Маскировать");
	Подготовка = КИИ_КонтрольПерсональныхДанных.ПодготовитьЗапрос(
		Новый Структура("ПользовательскийПромпт", "Почта клиента petrov@example.org"), Неопределено, Контекст);
	Чистое = "{""messages"":[{""content"":""" + Подготовка.СтруктураПромпта.ПользовательскийПромпт + """}]}";
	СУтечкой = "{""messages"":[{""content"":""Почта клиента petrov@example.org""}]}";

	ЮТест.ОжидаетЧто(КИИ_КонтрольПерсональныхДанных.ТелоСодержитОригиналы(Чистое, Контекст), "чистое тело")
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(КИИ_КонтрольПерсональныхДанных.ТелоСодержитОригиналы(СУтечкой, Контекст), "тело с утечкой")
		.ЭтоИстина();

