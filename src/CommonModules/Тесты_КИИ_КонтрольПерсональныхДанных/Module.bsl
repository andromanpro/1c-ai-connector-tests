КонецПроцедуры

// Тип находки -> подстановка для текста, где есть организация, адрес и имя без отчества.
Функция ПодстановкиЖивогоСервиса(Знач Стиль)

	Проверка = КИИ_КонтрольПерсональныхДанных.ПроверитьТекст(
		"Клиент ООО «Ромашка», менеджер Петрова Анна, адрес доставки: г. Казань, ул. Баумана, д. 5", Стиль);
	Подстановки = Новый Соответствие;
	Для Каждого Находка Из Проверка.Находки Цикл
		Подстановки.Вставить(Находка.Тип, Находка.Подстановка);
	КонецЦикла;
	Подстановки.Вставить("ТекстПослеЗамены", Проверка.ТекстПослеЗамены);

	Возврат Подстановки;

КонецФункции

