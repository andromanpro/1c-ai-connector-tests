	Первая = КИИ_КонтрольПерсональныхДанных.ПроверитьТекст("ИНН 7707083893");
	Вторая = КИИ_КонтрольПерсональныхДанных.ПроверитьТекст("ИНН 7707083893");

	ЮТест.ОжидаетЧто(Первая.Находки[0].Подстановка, "подстановки двух операций")
