Функция ЧислоОтказовМодели(Знач Модель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.КИИ_ЖурналКонтроляПерсональныхДанных КАК Журнал
		|ГДЕ
		|	Журнал.Модель = &Модель
		|	И Журнал.Решение = ""Заблокировано""";
	Запрос.УстановитьПараметр("Модель", Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

