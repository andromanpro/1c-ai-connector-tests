#Область СлужебныйПрограммныйИнтерфейс
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТестовыйНабор("Состав библиотеки ИИкона");
	ЮТТесты.ДобавитьСерверныйТест("ФункциональныйКореньСодержитВсеСобственныеОбъекты");
	ЮТТесты.ДобавитьСерверныйТест("ПользовательскийРазделСохраняетСостав");
	ЮТТесты.ДобавитьСерверныйТест("РеестрИнструментовMCPСохраняетСостав");
КонецПроцедуры
#КонецОбласти

#Область Тесты
Процедура ФункциональныйКореньСодержитВсеСобственныеОбъекты() Экспорт
	Состав = Новый Соответствие;
	СобратьФункциональныйСостав(Метаданные.Подсистемы.КИИ_КоннекторСлужебная, Состав);
	Отсутствуют = Новый Массив;
	Для Каждого ПолноеИмя Из СобственныеОбъектыБиблиотеки() Цикл
		ЮТест.ОжидаетЧто(Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено, ПолноеИмя).Равно(Истина);
		Если Состав.Получить(ПолноеИмя) = Неопределено Тогда
			Отсутствуют.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Отсутствуют.Количество(), СтрСоединить(Отсутствуют, "; ")).Равно(0);
	ЮТест.ОжидаетЧто(Метаданные.Подсистемы.КИИ_КоннекторСлужебная.ВключатьВКомандныйИнтерфейс).Равно(Ложь);
КонецПроцедуры

Процедура ПользовательскийРазделСохраняетСостав() Экспорт
	ПроверитьПрямойСостав(Метаданные.Подсистемы.КИИ_Коннектор, СоставПользовательскогоРаздела());
КонецПроцедуры

Процедура РеестрИнструментовMCPСохраняетСостав() Экспорт
	ПроверитьПрямойСостав(Метаданные.Подсистемы.КИИ_СерверMCPИнструменты, СоставРеестраИнструментов());
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура СобратьФункциональныйСостав(Знач Подсистема, Состав)
	ПолноеИмяПодсистемы = Подсистема.ПолноеИмя();
	Если Состав.Получить(ПолноеИмяПодсистемы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Состав.Вставить(ПолноеИмяПодсистемы, Истина);
	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если СтрНачинаетсяС(ПолноеИмя, "Подсистема.") Тогда
			СобратьФункциональныйСостав(ОбъектМетаданных, Состав);
		Иначе
			Состав.Вставить(ПолноеИмя, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПрямойСостав(Знач Подсистема, Знач ОжидаемыйСостав)
	Состав = Подсистема.Состав;
	ЮТест.ОжидаетЧто(Состав.Количество()).Равно(ОжидаемыйСостав.Количество());
	ФактическиеИмена = Новый Соответствие;
	Для Каждого ОбъектМетаданных Из Состав Цикл
		ФактическиеИмена.Вставить(ОбъектМетаданных.ПолноеИмя(), Истина);
	КонецЦикла;
	Для Каждого ПолноеИмя Из ОжидаемыйСостав Цикл
		ЮТест.ОжидаетЧто(ФактическиеИмена.Получить(ПолноеИмя), ПолноеИмя).Равно(Истина);
	КонецЦикла;
КонецПроцедуры

