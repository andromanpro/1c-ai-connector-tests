// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрирует тесты мультимодального запроса Anthropic.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Мультимодал_Anthropic")
			.ДобавитьСерверныйТест("ТекстИКартинка_ФормируютBase64Блок")
			.ДобавитьСерверныйТест("КартинкаDataURI_ФормируетBase64Блок")
			.ДобавитьСерверныйТест("КартинкаСНестроковымURL_БерутсяДанные")
			.ДобавитьСерверныйТест("ТекстИДокумент_ФормируютPDFБлок")
			.ДобавитьСерверныйТест("ДокументНеPDF_Исключение")
			.ДобавитьСерверныйТест("Строка_СохраняетСтарыйФормат");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ТекстИКартинка_ФормируютBase64Блок() Экспорт

	ДвоичныеДанные = ДвоичныеДанныеДляТеста();
	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("опиши"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанные, "image/png"));

	Результат = СформироватьЗапрос(Контент);
	Части = Результат.ТелоЗапроса.messages[0]["content"];

	ЮТест.ОжидаетЧто(Части.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Части[1]["type"]).Равно("image");
	ЮТест.ОжидаетЧто(Части[1]["source"]["type"]).Равно("base64");
	ЮТест.ОжидаетЧто(Части[1]["source"]["media_type"]).Равно("image/png");
	ЮТест.ОжидаетЧто(Части[1]["source"]["data"]).Равно(Base64БезПереводовСтрок(ДвоичныеДанные));

КонецПроцедуры

Процедура КартинкаDataURI_ФормируетBase64Блок() Экспорт

	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентИзображениеURL("data:IMAGE/PNG;base64,QUJD"));

	Результат = СформироватьЗапрос(Контент);
	Источник = Результат.ТелоЗапроса.messages[0]["content"][0]["source"];

	ЮТест.ОжидаетЧто(Источник["type"]).Равно("base64");
	ЮТест.ОжидаетЧто(Источник["media_type"]).Равно("image/png");
	ЮТест.ОжидаетЧто(Источник["data"]).Равно("QUJD");

КонецПроцедуры

// Валидатор фасада не считает нестроковый URL адресом и принимает элемент по паре данных и MIME.
// Коннектор обязан поступить так же, а не отправить число источником url.
Процедура КартинкаСНестроковымURL_БерутсяДанные() Экспорт

	ДвоичныеДанные = ДвоичныеДанныеДляТеста();
	Картинка = КИИ_КоннекторИИ.ПостроитьКонтентИзображениеДанные(ДвоичныеДанные, "image/png");
	Картинка.Вставить("URL", 123);
	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(Картинка);

	Источник = СформироватьЗапрос(Контент).ТелоЗапроса.messages[0]["content"][0]["source"];

	ЮТест.ОжидаетЧто(Источник["type"]).Равно("base64");
	ЮТест.ОжидаетЧто(Источник["data"]).Равно(Base64БезПереводовСтрок(ДвоичныеДанные));

КонецПроцедуры

Процедура ТекстИДокумент_ФормируютPDFБлок() Экспорт

	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентТекст("прочитай"));
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(
		ДвоичныеДанныеДляТеста(), "application/pdf", "report.pdf"));

	Результат = СформироватьЗапрос(Контент);
	Документ = Результат.ТелоЗапроса.messages[0]["content"][1];

	ЮТест.ОжидаетЧто(Документ["type"]).Равно("document");
	ЮТест.ОжидаетЧто(Документ["source"]["type"]).Равно("base64");
	ЮТест.ОжидаетЧто(Документ["source"]["media_type"]).Равно("application/pdf");
	ЮТест.ОжидаетЧто(Документ["title"]).Равно("report.pdf");

КонецПроцедуры

Процедура ДокументНеPDF_Исключение() Экспорт

	Контент = КИИ_КоннекторИИ.ПостроитьКонтентМассив();
	Контент.Добавить(КИИ_КоннекторИИ.ПостроитьКонтентДокументДанные(ДвоичныеДанныеДляТеста(),
		"application/vnd.openxmlformats-officedocument.wordprocessingml.document", "report.docx"));
	Промпт = Новый Структура("ПользовательскийПромпт", Контент);

	ЮТест.ОжидаетЧто(КИИ_КоннекторИИ)
		.Метод("СформироватьЗапросДляТестов")
		.Параметр(ПараметрыAnthropic())
		.Параметр(Промпт)
		.ВыбрасываетИсключение("только в PDF");

КонецПроцедуры

Процедура Строка_СохраняетСтарыйФормат() Экспорт

	Результат = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыAnthropic(), "привет");
	Сообщение = Результат.ТелоЗапроса.messages[0];

	ЮТест.ОжидаетЧто(ТипЗнч(Сообщение["content"])).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(Сообщение["content"]).Равно("привет");

КонецПроцедуры

Функция СформироватьЗапрос(Знач Контент)

	Промпт = Новый Структура("ПользовательскийПромпт", Контент);
	Возврат КИИ_КоннекторИИ.СформироватьЗапросДляТестов(ПараметрыAnthropic(), Промпт);

КонецФункции

Функция ПараметрыAnthropic()

	Параметры = Новый Структура;
	Параметры.Вставить("Адрес", "api.anthropic.com");
	Параметры.Вставить("АдресЗапроса", "/v1/messages");
	Параметры.Вставить("ИспользоватьЗащищенноеСоединение", Истина);
	Параметры.Вставить("ИспользоватьПрокси", Ложь);
	Параметры.Вставить("ТипФорматаAPI", Перечисления.КИИ_ТипыФорматовAPI.Anthropic);
	Параметры.Вставить("ТипАвторизации", Неопределено);
	Параметры.Вставить("НаименованиеПровайдера", "Anthropic");
	Параметры.Вставить("НаименованиеПолное", "claude-sonnet-5");
	Параметры.Вставить("Температура", 0.7);
	Параметры.Вставить("МаксимумТокенов", 1000);
	Параметры.Вставить("Таймаут", 30);
	Параметры.Вставить("Заголовки", Новый Массив);
	Возврат Параметры;

КонецФункции

Функция ДвоичныеДанныеДляТеста()

	// Длиннее 57 байт: Base64Строка платформы разобьет результат переводом строки,
	// и сравнение со сплошной строкой проверяет очистку, а не совпадает само собой.
	Возврат ПолучитьДвоичныеДанныеИзСтроки(
		"multimodal-anthropic-test multimodal-anthropic-test multimodal-anthropic-test", КодировкаТекста.UTF8);

КонецФункции

Функция Base64БезПереводовСтрок(Знач ДвоичныеДанные)

	Результат = Base64Строка(ДвоичныеДанные);
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Возврат СтрЗаменить(Результат, Символы.ВК, "");

КонецФункции

#КонецОбласти
