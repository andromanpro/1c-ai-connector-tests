// Подготовка только собственных моделей для клиентского получения формы.
Функция СоздатьМодельФормы(Знач Настроить, Знач Выбрать) Экспорт
	НачатьТранзакцию();
	Попытка
		Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
		Модель.Наименование = "ЮТФормаНабора_" + Строка(Новый УникальныйИдентификатор);
		Модель.ПоддерживаетИнструменты = Истина;
		Модель.НастроитьНаборИнструментов = Настроить;
		Если Выбрать Тогда
			Модель.Инструменты.Добавить().ИмяИнструмента = "get_metadata_tree";
		КонецЕсли;
		Модель.Записать();
		Ссылка = Модель.Ссылка;
		ЗафиксироватьТранзакцию();
		Возврат Ссылка;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Процедура УдалитьМодельФормы(Знач Ссылка) Экспорт
	Модель = Ссылка.ПолучитьОбъект();
	Если Модель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрНачинаетсяС(Модель.Наименование, "ЮТФормаНабора_") Тогда
		Модель.Удалить();
	Иначе
		ВызватьИсключение "Очистка ограничена собственной моделью проверки формы";
	КонецЕсли;
КонецПроцедуры

 
// Результат передается настоящему клиентскому обработчику формы. Внешних запросов и записей ИБ нет.
Функция ПодготовитьРезультатЧата(Знач ИдентификаторФормы, Знач Режим) Экспорт
	Представление = Новый Структура;
	Представление.Вставить("Статус", "");
	Представление.Вставить("Готово", Истина);
	Представление.Вставить("Получатель", "");
	Представление.Вставить("Инструкция", "");
	Представление.Вставить("Вопрос", "");
	Представление.Вставить("Знания", "");
	Представление.Вставить("Сообщения", "");
	Представление.Вставить("Инструменты", "");
	Представление.Вставить("Вложения", "");
	Ответ = Новый Структура;
	Ответ.Вставить("ЭтоОшибка", Ложь);
	Ответ.Вставить("МодельОтвета", "Контрольная модель");
	Ответ.Вставить("ВсегоТокенов", 3070);
	Ответ.Вставить("ВремяОтветаСекунд", 2);
	Ответ.Вставить("ВложенияОтвета", Новый Массив);
	Ответ.Вставить("ТекстОтвета", "Проверочный ответ");
	Ответ.Вставить("ВызововИнструментов", 2);
	Если Режим = "ДлиннаяПодпись" Тогда
		Источники = Новый Массив;
		Для НомерИсточника = 1 По 4 Цикл
			ИмяБазы = "Длинное наименование проверочного подключения для сохранения полного списка источников и стоимости ";
			Источники.Добавить(Новый Структура(
				"database_id, database_name", Строка(Новый УникальныйИдентификатор), ИмяБазы + Строка(НомерИсточника)));
		КонецЦикла;
		Ответ.Вставить("Источники", Источники);
	КонецЕсли;
	Ответ.Вставить("ОтветМодели", Новый Структура("ОценкаСтоимости", 0.00017));
	Если Режим <> "Прежний" Тогда
		Ответ.Вставить("ЕстьОценкаСтоимости", Режим <> "Неполная");
		Ответ.Вставить("ОценкаСтоимости", ?(Режим = "Нулевая", 0, 0.00838));
		Ответ.Вставить("ВалютаОценкиСтоимости", "USD");
	КонецЕсли;
	Если Режим = "ОшибкаИсточника" Или Режим = "ОтказИсточникаИDSML" Или Режим = "ОшибкаИсточникаHTML" Тогда
        ИмяИсточника = ?(Режим = "ОшибкаИсточникаHTML", "<script>test</script>", "11_5_new_fixture");
        ТекстСообщения = "Не удалось выполнить инструмент в базе " + ИмяИсточника + ". Проверьте доступность подключения и права.";
        ОшибкиИсточников = Новый Массив;
        ОшибкиИсточников.Добавить(Новый Структура("database_id,database_name,Сообщение", "test-source", ИмяИсточника, ТекстСообщения));
        Ответ.Вставить("ОшибкиИсточников", ОшибкиИсточников);
        Если Режим = "ОтказИсточникаИDSML" Тогда
            Ответ.ЭтоОшибка = Истина;
            Ответ.Вставить("ТекстОшибки", "Модель вернула служебные команды текстом вместо ответа.");
            Ответ.ТекстОтвета = "<|DSML|function_calls>";
        КонецЕсли;
    КонецЕсли;
	ДанныеРезультата = Новый Структура("Представление, Ответ", Представление, Ответ);
	Возврат ПоместитьВоВременноеХранилище(ДанныеРезультата, ИдентификаторФормы);
КонецФункции
