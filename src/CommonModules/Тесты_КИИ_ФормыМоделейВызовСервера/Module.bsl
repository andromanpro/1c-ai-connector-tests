// Подготовка только собственных моделей для клиентского получения формы.
Функция СоздатьМодельФормы(Знач Настроить, Знач Выбрать) Экспорт
	НачатьТранзакцию();
	Попытка
		Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
		Модель.Наименование = "ЮТФормаНабора_" + Строка(Новый УникальныйИдентификатор);
		Модель.ПоддерживаетИнструменты = Истина;
		Модель.НастроитьНаборИнструментов = Настроить;
		Если Выбрать Тогда
			Модель.Инструменты.Добавить().ИмяИнструмента = "get_metadata_tree";
		КонецЕсли;
		Модель.Записать();
		Ссылка = Модель.Ссылка;
		ЗафиксироватьТранзакцию();
		Возврат Ссылка;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Процедура УдалитьМодельФормы(Знач Ссылка) Экспорт
	Модель = Ссылка.ПолучитьОбъект();
	Если Модель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СтрНачинаетсяС(Модель.Наименование, "ЮТФормаНабора_") Тогда
		Модель.Удалить();
	Иначе
		ВызватьИсключение "Очистка ограничена собственной моделью проверки формы";
	КонецЕсли;
КонецПроцедуры
