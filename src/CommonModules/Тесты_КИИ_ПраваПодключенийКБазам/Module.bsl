Процедура СобственныйЛичныйВходСохраняется() Экспорт
	Описание = Фикстура();
	База = БазаПоID(Описание.Личная);
	КИИ_ПодключенияКБазам.СохранитьЛичныйВход(База, "reader-a", "123456", "Заменить");
	Состояние = КИИ_ПодключенияКБазам.СостояниеВхода(База);
	ЮТест.ОжидаетЧто(Состояние.Логин).Равно("reader-a");
	ЮТест.ОжидаетЧто(Состояние.ПарольСохранен).Равно(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Подключение, Пользователь, Логин
        |ИЗ РегистрСведений.КИИ_ЛичныеПодключенияКБазам
        |ГДЕ Подключение = &Подключение");
	Запрос.УстановитьПараметр("Подключение", База);
	Таблица = Запрос.Выполнить().Выгрузить();
	ЮТест.ОжидаетЧто(Таблица.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Таблица[0].Пользователь).Равно(Пользователи.ТекущийПользователь());
	ЮТест.ОжидаетЧто(Таблица[0].Подключение).Равно(База);
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

