Процедура УстановитьФикстуру(ИмяИспытуемого, Описание) Экспорт
	ПроверитьАдминистратора();
	ХранилищеОбщихНастроек.Сохранить("КИИ_ПраваПодключений", "Фикстура", Описание, , ИмяИспытуемого);
КонецПроцедуры

Процедура УдалитьФикстуру(ИмяИспытуемого) Экспорт
	ПроверитьАдминистратора();
	ХранилищеОбщихНастроек.Удалить("КИИ_ПраваПодключений", "Фикстура", ИмяИспытуемого);
КонецПроцедуры

Процедура СоздатьПодключение(Знач Загрузка = Ложь) Экспорт
	ОбъектБазы = Справочники.КИИ_ПодключенияКБазам.СоздатьЭлемент();
	ОбъектБазы.Наименование = Фикстура().Метка;
	ОбъектБазы.ОбменДанными.Загрузка = Загрузка;
	ОбъектБазы.Записать();
КонецПроцедуры

Процедура ЗаписатьЧужойВход() Экспорт
	Описание = Фикстура();
	Запись = РегистрыСведений.КИИ_ЛичныеПодключенияКБазам.СоздатьМенеджерЗаписи();
	Запись.Подключение = БазаПоID(Описание.Личная);
	Запись.Пользователь = Справочники.Пользователи.ПолучитьСсылку(
		Новый УникальныйИдентификатор(Описание.ЧужойПользователь));
	Запись.Логин = "tamper";
	Запись.Записать();
КонецПроцедуры

Функция ПрочитатьСекрет() Экспорт
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(БазаПоID(Фикстура().Служебная));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Фикстура()
	Описание = ХранилищеОбщихНастроек.Загрузить("КИИ_ПраваПодключений", "Фикстура");
	ЮТест.ОжидаетЧто(Описание <> Неопределено, "Не подготовлена отдельная профильная оснастка подключений").Равно(
		Истина);
	Возврат Описание;
КонецФункции

Функция БазаПоID(Идентификатор)
	Возврат Справочники.КИИ_ПодключенияКБазам.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
КонецФункции

Функция АргументыЗапроса()
	Возврат Новый Структура(
		"query_id, query_text, limit, params", "catalog-rights", "ВЫБРАТЬ 1 КАК Value", 10, Новый Структура);
КонецФункции

Процедура ПроверитьАдминистратора()
	Если Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Фикстура доступна только администратору изолированного стенда";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
