// Повторное задание заменяет прежнее и получает большую версию.
Процедура Версия_ПовторнаяПостановкаМонотонна() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Первый = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert", "хеш1");
	Второй = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "delete");
	ЮТест.ОжидаетЧто(Второй.Версия > Первый.Версия).Равно(Истина);
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").Операция).Равно("delete");
КонецПроцедуры

// Удаление подтвержденного задания не удаляет постоянный счетчик версий.
Процедура Версия_СохраняетсяПослеПодтверждения() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Первый = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "delete");
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.Подтвердить(Первый)).Равно(Истина);
	Второй = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	ЮТест.ОжидаетЧто(Второй.Версия > Первый.Версия).Равно(Истина);
КонецПроцедуры

// Перевод системных часов назад не уменьшает следующую версию.
Процедура Версия_СчетчикВышеЧасов() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.КИИ_ВерсииСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = Идентификатор;
	Запись.КодМодели = "тест:версия";
	Запись.Версия = 900000000000000;
	Запись.Записать();
	Снимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	ЮТест.ОжидаетЧто(Снимок.Версия).Равно(900000000000001);
КонецПроцедуры

// Ответ прежней отправки не подтверждает повторно поставленное задание.
Процедура Подтверждение_НоваяВерсияУцелела() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Старый = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	НовыйСнимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "delete");
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.Подтвердить(Старый)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").Версия).Равно(НовыйСнимок.Версия);
КонецПроцедуры

// Отказ старой отправки не увеличивает попытки нового задания.
Процедура Ошибка_УстаревшаяНеМеняетНовыйСнимок() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Старый = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	НовыйСнимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "delete");
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.ОтметитьОшибку(Старый, "отказ старой отправки")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").Попыток).Равно(0);
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").Версия).Равно(НовыйСнимок.Версия);
КонецПроцедуры

// Повторные отказы одного снимка накапливаются по текущему состоянию базы.
Процедура Ошибка_СчетчикБеретсяИзБазы() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Снимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	КИИ_ОчередьQdrant.ОтметитьОшибку(Снимок, "первый");
	КИИ_ОчередьQdrant.ОтметитьОшибку(Снимок, "второй");
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").Попыток).Равно(2);
	ЮТест.ОжидаетЧто(ДанныеОчереди(Идентификатор, "тест:версия").ПоследняяОшибка).Равно("второй");
КонецПроцедуры

// Новое задание сбрасывает попытки и прежнюю ошибку.
Процедура ПовторнаяПостановка_СбрасываетОтказ() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Снимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert");
	КИИ_ОчередьQdrant.ОтметитьОшибку(Снимок, "ошибка");
	КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:версия", "upsert", "новый");
	Данные = ДанныеОчереди(Идентификатор, "тест:версия");
	ЮТест.ОжидаетЧто(Данные.Попыток).Равно(0);
	ЮТест.ОжидаетЧто(Данные.ПоследняяОшибка).Равно("");
	ЮТест.ОжидаетЧто(Данные.Хеш).Равно("новый");
КонецПроцедуры

// Обработка не открывает сетевой вызов внутри транзакции вызывающего кода.
Процедура Обработка_ОтказываетВнутриТранзакции() Экспорт
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant).Метод("Обработать")
		.ВыбрасываетИсключение("не допускается внутри транзакции");
КонецПроцедуры

// Фильтр записи отсекает равную и большую внешнюю версию.
Процедура Условие_РавнаяИБольшаяВерсияНеПерезаписывается() Экспорт
	Точка = Новый Структура("id, vector, payload", "ид", Новый Массив, Новый Структура);
	Операция = КИИ_ОчередьQdrant.УсловнаяОперация(Точка, 123);
	ЮТест.ОжидаетЧто(Операция.upsert.update_filter.must_not[0].key).Равно("_kii_revision");
	ЮТест.ОжидаетЧто(Операция.upsert.update_filter.must_not[0].range.gte).Равно(123);
	ЮТест.ОжидаетЧто(Операция.upsert.points[0].id).Равно("ид");
КонецПроцедуры

// Распределение фрагмента постоянно для моделей и вариантов регистра UUID.
Процедура Раздел_ПостояненИНеЗависитОтРегистраUUID() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Раздел = КИИ_ОчередьQdrant.РазделФрагмента(Идентификатор);
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.РазделФрагмента(ВРег(Идентификатор))).Равно(Раздел);
	ЮТест.ОжидаетЧто(Раздел >= 0 И Раздел <= 15).Равно(Истина);
	Первый = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:модель1", "delete");
	Второй = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:модель2", "upsert");
	ЮТест.ОжидаетЧто(Первый.Раздел).Равно(Второй.Раздел);
КонецПроцедуры

// Счетчик новой записи сохраняет полный ключ после отсутствующего чтения.
Процедура Версия_СчетчикХранитсяПоКлючуФрагмента() Экспорт
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Снимок = КИИ_ОчередьQdrant.Поставить(Идентификатор, "тест:ключ", "upsert");
	Счетчик = РегистрыСведений.КИИ_ВерсииСинхронизацииQdrant.Получить(
		Новый Структура("ФрагментИдентификатор, КодМодели", Идентификатор, "тест:ключ"));
	ЮТест.ОжидаетЧто(Счетчик.Версия).Равно(Снимок.Версия);
КонецПроцедуры

// Будущая версия одного фрагмента не изменяет счетчик другого.
Процедура Версия_ЧужойБудущийСчетчикНеВлияет() Экспорт
	ПервыйИД = Строка(Новый УникальныйИдентификатор);
	ВторойИД = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.КИИ_ВерсииСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = ПервыйИД;
	Запись.КодМодели = "тест:ключ";
	Запись.Версия = 900000000000000;
	Запись.Записать();
	Второй = КИИ_ОчередьQdrant.Поставить(ВторойИД, "тест:ключ", "upsert");
	ЮТест.ОжидаетЧто(Второй.Версия < Запись.Версия).Равно(Истина);
КонецПроцедуры

// Пакетное подтверждение удаляет только совпавшие версии и сохраняет новое задание.
Процедура ПодтверждениеПакета_НовоеЗаданиеУцелело() Экспорт
	ПервыйИД = Строка(Новый УникальныйИдентификатор);
	ВторойИД = Строка(Новый УникальныйИдентификатор);
	Старый = КИИ_ОчередьQdrant.Поставить(ПервыйИД, "тест:пакет", "upsert");
	Другой = КИИ_ОчередьQdrant.Поставить(ВторойИД, "тест:пакет", "upsert");
	НовыйСнимок = КИИ_ОчередьQdrant.Поставить(ПервыйИД, "тест:пакет", "delete");
	Снимки = Новый Массив;
	Снимки.Добавить(Старый);
	Снимки.Добавить(Другой);
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.ПодтвердитьПакет(Снимки)).Равно(1);
	ЮТест.ОжидаетЧто(ДанныеОчереди(ПервыйИД, "тест:пакет").Версия).Равно(НовыйСнимок.Версия);
	ЮТест.ОжидаетЧто(ДанныеОчереди(ВторойИД, "тест:пакет").Версия).Равно(0);
КонецПроцедуры

// Пустое подтверждение не изменяет состояние транзакции вызывающего кода.
Процедура ПодтверждениеПакета_ПустойСохраняетТранзакцию() Экспорт
	ЮТест.ОжидаетЧто(КИИ_ОчередьQdrant.ПодтвердитьПакет(Новый Массив)).Равно(0);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
КонецПроцедуры

// Повторные вызовы возвращают один идентификатор контура.
Процедура Контур_ИдентификаторБСПНеМеняетсяМеждуВызовами() Экспорт
	Первый = КИИ_RAGQdrant.ВычислитьTenantId();
	ЮТест.ОжидаетЧто(СтрДлина(Первый)).Равно(16);
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ВычислитьTenantId()).Равно(Первый);
КонецПроцедуры

// Первый вызов заполняет штатный идентификатор БСП; изменение откатывается тестом.
Процедура Контур_ПустойИдентификаторБСПЗаполняется() Экспорт
	Константы.ИдентификаторИнформационнойБазы.Установить("");
	Первый = КИИ_RAGQdrant.ВычислитьTenantId();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Константы.ИдентификаторИнформационнойБазы.Получить())).Равно(Истина);
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ВычислитьTenantId()).Равно(Первый);
КонецПроцедуры

// Новый экземпляр БСП получает другое имя коллекции; изменение откатывается транзакцией теста.
Процедура Контур_СменаЭкземпляраМеняетИмяКоллекции() Экспорт
	Первый = КИИ_RAGQdrant.ИмяКоллекции("тест:контур", 3);
	Константы.ИдентификаторИнформационнойБазы.Установить(Строка(Новый УникальныйИдентификатор));
	Второй = КИИ_RAGQdrant.ИмяКоллекции("тест:контур", 3);
	ЮТест.ОжидаетЧто(Первый <> Второй).Равно(Истина);
КонецПроцедуры

// Миграция контура снимает готовность старого индекса, сохраняя его размерность.
Процедура Контур_СнимаетГотовностьИСохраняетРазмерность() Экспорт
	КодМодели = "тест:миграцияконтура";
	КИИ_RAGQdrant.ВычислитьTenantId();
	Запись = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьМенеджерЗаписи();
	Запись.КодМодели = КодМодели;
	Запись.Поколение = 7;
	Запись.ИндексПостроен = Истина;
	Запись.Размерность = 3;
	Запись.Записать();
	Константы.КИИ_ИдентификаторTenantQdrant.Установить("прежнийконтур");
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ИндексПостроен(КодМодели)).Равно(Ложь);
	Поколение = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.Получить(Новый Структура("КодМодели", КодМодели));
	ЮТест.ОжидаетЧто(Поколение.Поколение).Равно(8);
	ЮТест.ОжидаетЧто(Поколение.Размерность).Равно(3);
КонецПроцедуры

// Повторный расчет в прежнем экземпляре не сбрасывает построенный индекс.
Процедура Контур_ПовторныйРасчетНеСнимаетГотовность() Экспорт
	КодМодели = "тест:стабильностьконтура";
	КИИ_RAGQdrant.ОтметитьПоколение(КодМодели, Истина, 7);
	КИИ_RAGQdrant.ВычислитьTenantId();
