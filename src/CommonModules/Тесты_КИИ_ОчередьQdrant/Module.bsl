// Возвращает только безопасные признаки развертывания для сравнения контекстов.
// Возвращаемое значение:
//  Структура:
//   * Каталог - Строка - каталог файловой базы.
//   * Сервер - Строка - сервер из параметров соединения.
//   * База - Строка - имя базы из параметров соединения.
//   * Компьютер - Строка - имя компьютера текущего исполнения.
//   * ХешСтроки - Строка - хеш полного представления строки соединения.
//   * Контур - Строка - текущий идентификатор коллекций.
Функция КонтекстРазвертыванияДляТестов() Экспорт
	СтрокаПодключения = СтрокаСоединенияИнформационнойБазы();
	Параметры = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(
		СтрокаПодключения);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрокаПодключения);
	Результат = Новый Структура;
	Результат.Вставить("Каталог", Параметры.КаталогИнформационнойБазы);
	Результат.Вставить("Сервер", Параметры.ИмяСервера1СПредприятия);
	Результат.Вставить("База", Параметры.ИмяИнформационнойБазыНаСервере1СПредприятия);
	Результат.Вставить("Компьютер", ИмяКомпьютера());
	Результат.Вставить("ХешСтроки", ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	Результат.Вставить("Контур", КИИ_RAGQdrant.ВычислитьTenantId());
	Возврат Результат;
КонецФункции

// Локальный HTTP-стенд и явный учет созданных данных для обоих исходов теста.
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - прежний адрес Qdrant.
//   * Модель - Строка - уникальная модель текущего теста.
//   * Ссылки - Массив из СправочникСсылка.КИИ_БазаЗнаний, СправочникСсылка.КИИ_ФрагментыЗнаний
//   * Модели - Массив из Строка - модели, принадлежащие тесту.
//   * Разделы - Массив из Число - разделы, занятые самим тестом.
Функция ПодготовитьКонтур() Экспорт
	Контур = Новый Структура;
	Контур.Вставить("Адрес", Константы.КИИ_QdrantАдрес.Получить());
	Контур.Вставить("Модель", "тест:batch-" + Строка(Новый УникальныйИдентификатор));
	Контур.Вставить("Ссылки", Новый Массив);
	Контур.Вставить("Модели", Новый Массив);
	Контур.Вставить("Разделы", Новый Массив);
	Контур.Модели.Добавить(Контур.Модель);
	Попытка
		Константы.КИИ_QdrantАдрес.Установить("http://localhost:8871");
		НастроитьHTTP(Новый Структура);
	Исключение
		Константы.КИИ_QdrantАдрес.Установить(Контур.Адрес);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Контур;
КонецФункции

// Удаляет учтенные ссылки и регистровые записи; восстанавливает адрес HTTP-стенда.
// Параметры:
//  Контур - см. Тесты_КИИ_ОчередьQdrant.ПодготовитьКонтур
Процедура ОчиститьКонтур(Знач Контур) Экспорт
	Константы.КИИ_QdrantАдрес.Установить(Контур.Адрес);
	// Объекты удаляются прежде очереди: подписки удаления могут поставить свои задания.
	Индекс = Контур.Ссылки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ОбъектДанных = Контур.Ссылки[Индекс].ПолучитьОбъект();
		Если ОбъектДанных <> Неопределено Тогда
			ОбъектДанных.ОбменДанными.Загрузка = Истина;
			ОбъектДанных.Удалить();
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Для Каждого Модель Из Контур.Модели Цикл
		Набор = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьНаборЗаписей();
		Набор.Отбор.КодМодели.Установить(Модель);
		Набор.Записать();
		Набор = РегистрыСведений.КИИ_ВерсииСинхронизацииQdrant.СоздатьНаборЗаписей();
		Набор.Отбор.КодМодели.Установить(Модель);
		Набор.Записать();
		Запись = РегистрыСведений.КИИ_ПоколениеИндексаQdrant.СоздатьМенеджерЗаписи();
		Запись.КодМодели = Модель;
		Запись.Удалить();
	КонецЦикла;
	Для Каждого Раздел Из Контур.Разделы Цикл
		Запись = РегистрыСведений.КИИ_ИсполнителиОчередиQdrant.СоздатьМенеджерЗаписи();
		Запись.Раздел = Раздел;
		Запись.Удалить();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция UUID(Знач Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ДанныеОчереди(Знач Идентификатор, Знач Модель)
	Возврат РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(
		Новый Структура("ФрагментИдентификатор, КодМодели", Идентификатор, Модель));
КонецФункции

Функция СоздатьФрагментКонтура(Контур, Знач Запрещено = Ложь)
	База = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
	База.Наименование = "Пакетные тесты " + Контур.Модель;
	Если Запрещено Тогда
		База.ПолитикаЭмбеддингаПереопределение = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	КонецЕсли;
	База.Записать();
	Контур.Ссылки.Добавить(База.Ссылка);
	Вектор = Новый Массив;
	Вектор.Добавить(1);
	Вектор.Добавить(0);
	Вектор.Добавить(0);
	Фрагмент = Справочники.КИИ_ФрагментыЗнаний.СоздатьЭлемент();
	Фрагмент.Владелец = База.Ссылка;
	Фрагмент.Наименование = "Пакетный тест";
	Фрагмент.ТекстФрагмента = ?(Запрещено, "секретный текст", "разрешенный текст");
	Фрагмент.Эмбеддинг = Новый ХранилищеЗначения(Вектор);
	Фрагмент.КодМоделиЭмбеддинга = Контур.Модель;
	Фрагмент.Размерность = 3;
	Фрагмент.Записать();
	Контур.Ссылки.Добавить(Фрагмент.Ссылка);
	Возврат Фрагмент.Ссылка;
КонецФункции

Функция ПоставитьФрагмент(Знач Контур, Знач Фрагмент)
	Возврат КИИ_ОчередьQdrant.Поставить(UUID(Фрагмент), Контур.Модель, "upsert");
КонецФункции

Функция НастройкиКонтура(Знач Контур)
	Настройки = КИИ_ОчередьQdrant.ПараметрыОбработки();
	Настройки.КодМодели = Контур.Модель;
	Настройки.КоличествоИсполнителей = 1;
	Возврат Настройки;
КонецФункции

Функция ОбработатьКонтур(Знач Контур)
	Возврат КИИ_ОчередьQdrant.Обработать(НастройкиКонтура(Контур));
КонецФункции

Процедура НастроитьHTTP(Знач Настройки)
	ЗапросHTTP = Новый HTTPЗапрос("/__fixture");
	ЗапросHTTP.УстановитьТелоИзСтроки(КИИ_HTTPКлиент.СтруктураВJson(Настройки));
	Соединение = Новый HTTPСоединение("localhost", 8871, , , Новый ИнтернетПрокси(Ложь), 5);
	Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния).Равно(200);
КонецПроцедуры

Функция СтатистикаHTTP()
	Соединение = Новый HTTPСоединение("localhost", 8871, , , Новый ИнтернетПрокси(Ложь), 5);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/__stats"));
	Возврат КИИ_HTTPКлиент.JsonВСтруктуру(Ответ.ПолучитьТелоКакСтроку(), Ложь);
КонецФункции

#КонецОбласти
