// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СерверMCP_Tools")
			.ДобавитьСерверныйТест("ИнфоКонфигурации_СодержитИмяИВерсиюПлатформы")
			.ДобавитьСерверныйТест("ДеревоМетаданных_БезФильтра_СодержитCounts")
			.ДобавитьСерверныйТест("ДеревоМетаданных_ФильтрCatalog_ВозвращаетВсеСправочники")
			.ДобавитьСерверныйТест("ДеревоМетаданных_НесуществующийТип_Исключение")
			.ДобавитьСерверныйТест("СтруктураОбъекта_Справочник_СодержитAttributes")
			.ДобавитьСерверныйТест("СтруктураОбъекта_НеизвестныйОбъект_Исключение")
			.ДобавитьСерверныйТест("ВыполнитьЗапрос_HappyPath_RowCount")
			.ДобавитьСерверныйТест("ВыполнитьЗапрос_DELETE_Reject")
			.ДобавитьСерверныйТест("ВыполнитьЗапрос_LimitНаПорядокБольше1000_Reject")
			.ДобавитьСерверныйТест("БезопасностьЗапросов_ПрименитьЛимит_БезПЕРВЫЕ_Добавляет")
				.ДобавитьСерверныйТест("ВыполнитьЗапрос_ДробныйЛимит_Reject")
				.ДобавитьСерверныйТест("БезопасностьЗапросов_ЛимитВКомментарий_ВРеальныйЗапрос")
				.ДобавитьСерверныйТест("БезопасностьЗапросов_ВложенныйПЕРВЫЕ_ОграничиваетВнешний")
				.ДобавитьСерверныйТест("БезопасностьЗапросов_ЛимитСПробой_ДобавляетЛимитПлюс1");
	
КонецПроцедуры

Процедура ИнфоКонфигурации_СодержитИмяИВерсиюПлатформы() Экспорт
	
	Результат = КИИ_СерверMCPИнструментИнфоКонфигурации.ВыполнитьИнструмент(
		"get_configuration_info",
		Новый Структура);
	
	ЮТест.ОжидаетЧто(Результат).Свойство("configuration_name").Заполнено();
	ЮТест.ОжидаетЧто(Результат).Свойство("platform_version").Заполнено();
	ЮТест.ОжидаетЧто(ДопустимыйРежимБазы(Результат.database_mode)).Равно(Истина);
	
КонецПроцедуры

Процедура ДеревоМетаданных_БезФильтра_СодержитCounts() Экспорт
	
	Результат = КИИ_СерверMCPИнструментДеревоМетаданных.ВыполнитьИнструмент(
		"get_metadata_tree",
		Новый Структура);
	
	ЮТест.ОжидаетЧто(Результат).Свойство("objects");
	ЮТест.ОжидаетЧто(Результат).Свойство("counts");
	ЮТест.ОжидаетЧто(Результат.counts).Свойство("Catalog");
	ЮТест.ОжидаетЧто(Результат.counts).Свойство("Document");
	
КонецПроцедуры

Процедура ДеревоМетаданных_ФильтрCatalog_ВозвращаетВсеСправочники() Экспорт
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("filter", "Catalog.*");
	
	Результат = КИИ_СерверMCPИнструментДеревоМетаданных.ВыполнитьИнструмент(
		"get_metadata_tree",
		Аргументы);
	
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.objects)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Результат.objects.Количество() > 0).Равно(Истина);
	
	Для Каждого ОбъектМетаданных Из Результат.objects Цикл
		ЮТест.ОжидаетЧто(СтрНачинаетсяС(ОбъектМетаданных.canonical_ref, "Catalog.")).Равно(Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДеревоМетаданных_НесуществующийТип_Исключение() Экспорт
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("filter", "NoSuchType.*");
	
	ЮТест.ОжидаетЧто(КИИ_СерверMCPИнструментДеревоМетаданных)
		.Метод("ВыполнитьИнструмент")
		.Параметр("get_metadata_tree")
		.Параметр(Аргументы)
		.ВыбрасываетИсключение("Неподдерживаемый тип");
	
КонецПроцедуры

Процедура СтруктураОбъекта_Справочник_СодержитAttributes() Экспорт
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("object_type", "Catalog");
	Аргументы.Вставить("name", "КИИ_МоделиИИ");
	
	Результат = КИИ_СерверMCPИнструментСтруктураОбъекта.ВыполнитьИнструмент(
		"get_object_structure",
		Аргументы);
	
	ЮТест.ОжидаетЧто(Результат.canonical_ref).Равно("Catalog.КИИ_МоделиИИ");
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.attributes)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Результат.attributes.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.tabular_sections)).Равно(Тип("Массив"));
	
	ПервыйРеквизит = Результат.attributes[0];
	ЮТест.ОжидаетЧто(ПервыйРеквизит).Свойство("name").Заполнено();
	ЮТест.ОжидаетЧто(ПервыйРеквизит).Свойство("synonym");
	ЮТест.ОжидаетЧто(ПервыйРеквизит).Свойство("type").Заполнено();
	
КонецПроцедуры

Процедура СтруктураОбъекта_НеизвестныйОбъект_Исключение() Экспорт
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("object_type", "Catalog");
	Аргументы.Вставить("name", "НеСуществует");
	
	ЮТест.ОжидаетЧто(КИИ_СерверMCPИнструментСтруктураОбъекта)
		.Метод("ВыполнитьИнструмент")
		.Параметр("get_object_structure")
		.Параметр(Аргументы)
		.ВыбрасываетИсключение("Объект метаданных не найден");
	
КонецПроцедуры

Процедура ВыполнитьЗапрос_HappyPath_RowCount() Экспорт
	
	Аргументы = АргументыЗапроса(
		"row_count:Catalog.КИИ_МоделиИИ",
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Cnt ИЗ Справочник.КИИ_МоделиИИ",
		1);
	
	Результат = КИИ_СерверMCPИнструментВыполнитьЗапрос.ВыполнитьИнструмент(
		"execute_query",
		Аргументы);
	
	ЮТест.ОжидаетЧто(Результат.query_id).Равно("row_count:Catalog.КИИ_МоделиИИ");
	ЮТест.ОжидаетЧто(Результат.rows.Количество() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.rows[0][0])).Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(Результат.rows[0][0] >= 0).Равно(Истина);
	
КонецПроцедуры

Процедура ВыполнитьЗапрос_DELETE_Reject() Экспорт
	
	Аргументы = АргументыЗапроса("delete:test", "DELETE FROM SomeTable", 1);
	
	ЮТест.ОжидаетЧто(КИИ_СерверMCPИнструментВыполнитьЗапрос)
		.Метод("ВыполнитьИнструмент")
		.Параметр("execute_query")
		.Параметр(Аргументы)
		.ВыбрасываетИсключение("mutation_keyword_detected");
	
КонецПроцедуры

Процедура ВыполнитьЗапрос_LimitНаПорядокБольше1000_Reject() Экспорт
	
	Аргументы = АргументыЗапроса(
		"limit:test",
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Cnt ИЗ Справочник.КИИ_МоделиИИ",
		10000);
	
	ЮТест.ОжидаетЧто(КИИ_СерверMCPИнструментВыполнитьЗапрос)
		.Метод("ВыполнитьИнструмент")
		.Параметр("execute_query")
		.Параметр(Аргументы)
		.ВыбрасываетИсключение("limit_out_of_range");
	
КонецПроцедуры

Процедура БезопасностьЗапросов_ПрименитьЛимит_БезПЕРВЫЕ_Добавляет() Экспорт
	
	ТекстЗапроса = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимит(
		"ВЫБРАТЬ * ИЗ Справочник.КИИ_МоделиИИ",
		100);
	
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЗапроса, "ПЕРВЫЕ 100") > 0).Равно(Истина);
	
КонецПроцедуры

// Дробный лимит (10.5) отклоняется валидацией: нецелое ломает текст ПЕРВЫЕ/TOP.
Процедура ВыполнитьЗапрос_ДробныйЛимит_Reject() Экспорт

	Аргументы = АргументыЗапроса(
		"frac:test",
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Cnt ИЗ Справочник.КИИ_МоделиИИ",
		10.5);

	ЮТест.ОжидаетЧто(КИИ_СерверMCPИнструментВыполнитьЗапрос)
		.Метод("ВыполнитьИнструмент")
		.Параметр("execute_query")
		.Параметр(Аргументы)
		.ВыбрасываетИсключение("limit_out_of_range");

КонецПроцедуры

// Ведущий комментарий с «ВЫБРАТЬ» не должен уводить лимит мимо реального запроса.
Процедура БезопасностьЗапросов_ЛимитВКомментарий_ВРеальныйЗапрос() Экспорт

	Запрос = "// ВЫБРАТЬ фейк из комментария" + Символы.ПС
		+ "ВЫБРАТЬ Наименование ИЗ Справочник.КИИ_МоделиИИ";

	Результат = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимит(Запрос, 100);

	ЮТест.ОжидаетЧто(СтрНайти(Результат, "ВЫБРАТЬ ПЕРВЫЕ 100 Наименование") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Результат, "фейк") > 0).Равно(Ложь);

КонецПроцедуры

// ПЕРВЫЕ во вложенном подзапросе не должен считаться ограничением внешнего.
Процедура БезопасностьЗапросов_ВложенныйПЕРВЫЕ_ОграничиваетВнешний() Экспорт

	Запрос = "ВЫБРАТЬ Т.Поле ИЗ (ВЫБРАТЬ ПЕРВЫЕ 5 Поле ИЗ Справочник.КИИ_МоделиИИ) КАК Т";

	Результат = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимит(Запрос, 100);

	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Результат, "ВЫБРАТЬ ПЕРВЫЕ 100")).Равно(Истина);

КонецПроцедуры

// Пробный лимит вставляет ПЕРВЫЕ (Лимит + 1) для детекции усечения.
Процедура БезопасностьЗапросов_ЛимитСПробой_ДобавляетЛимитПлюс1() Экспорт

	Результат = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимитСПробой(
		"ВЫБРАТЬ Поле ИЗ Справочник.КИИ_МоделиИИ",
		10);

	ЮТест.ОжидаетЧто(СтрНайти(Результат, "ПЕРВЫЕ 11") > 0).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АргументыЗапроса(Знач ИдентификаторЗапроса, Знач ТекстЗапроса, Знач Лимит)
	
	Аргументы = Новый Структура;
	Аргументы.Вставить("query_id", ИдентификаторЗапроса);
	Аргументы.Вставить("query_text", ТекстЗапроса);
	Аргументы.Вставить("params", Новый Структура);
	Аргументы.Вставить("limit", Лимит);
	Возврат Аргументы;
	
КонецФункции

Функция ДопустимыйРежимБазы(Знач РежимБазы)
	
	Возврат РежимБазы = "file"
		Или РежимБазы = "server"
		Или РежимБазы = "unknown";
	
КонецФункции

#КонецОбласти
