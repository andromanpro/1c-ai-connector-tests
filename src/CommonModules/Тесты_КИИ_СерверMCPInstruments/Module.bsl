Процедура ИнфоКонфигурации_СписокРасширенийСоответствуетПлатформе() Экспорт
	Ожидаемые = РасширенияКонфигурации.Получить();
	Результат = КИИ_СерверMCPИнструментИнфоКонфигурации.ВыполнитьИнструмент("get_configuration_info", Новый Структура);
	ЮТест.ОжидаетЧто(Результат.extensions.Количество(), "В установленной базе есть исходное и тестовые расширения").Равно(
		Ожидаемые.Количество());
	Для Каждого Расширение Из Ожидаемые Цикл
		Найдено = Ложь;
		Для Каждого Описание Из Результат.extensions Цикл
			Если Описание.name = Расширение.Имя Тогда
				ЮТест.ОжидаетЧто(Описание.version).Равно(Расширение.Версия);
				ЮТест.ОжидаетЧто(Описание.active).Равно(Расширение.Активно);
				Найдено = Истина;
			КонецЕсли;
		КонецЦикла;
		ЮТест.ОжидаетЧто(Найдено, Расширение.Имя).Равно(Истина);
	КонецЦикла;
КонецПроцедуры

