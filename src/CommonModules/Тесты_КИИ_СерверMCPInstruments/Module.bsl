Процедура ЗапросАудит_ИтогиСохраняютЗначение() Экспорт
    Запросы = Новый Массив;
    Запросы.Добавить("ВЫБРАТЬ ПЕРВЫЕ 100 Данные.Номер КАК Номер ИЗ (" + ЗапросАудитИсточник()
        + ") КАК Данные ИТОГИ СУММА(Номер) ПО ОБЩИЕ");
    Запросы.Добавить(ЗапросАудитИсточник() + " ИТОГИ СУММА(Номер) ПО ОБЩИЕ");
    Для Каждого Текст Из Запросы Цикл
        Аргументы = АргументыЗапроса("audit-totals", Текст, 1);
        Данные = КИИ_СерверMCPИнструментВыполнитьЗапрос.ВыполнитьИнструмент("execute_query", Аргументы);
        ЮТест.ОжидаетЧто(Данные.rows.Количество()).Равно(1);
        ЮТест.ОжидаетЧто(Данные.rows[0][0], "Предел чтения не меняет прежнюю сумму").Равно(21);
        ЮТест.ОжидаетЧто(Данные.truncated).Равно(Истина);
    КонецЦикла;
КонецПроцедуры

