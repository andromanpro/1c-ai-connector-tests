	Результат = КИИ_СерверMCPИнструментИнфоКонфигурации.ВыполнитьИнструмент("get_configuration_info", Новый Структура);
	ЮТест.ОжидаетЧто(Результат).Свойство("database_id").Заполнено();
	ПовторныйРезультат = КИИ_СерверMCPИнструментИнфоКонфигурации.ВыполнитьИнструмент(
		"get_configuration_info", Новый Структура);
	ЮТест.ОжидаетЧто(ПовторныйРезультат.database_id).Равно(Результат.database_id);
