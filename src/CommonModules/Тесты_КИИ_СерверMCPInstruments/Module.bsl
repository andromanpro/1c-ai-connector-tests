Процедура СтруктураАудитСверитьСтраницы(ТипОбъекта, ИмяОбъекта, ОжидаемыеПути)
    ПолученныеПути = Новый Соответствие;
    Смещение = 0;
    Завершено = Ложь;
    Для НомерСтраницы = 1 По 1000 Цикл
        Аргументы = Новый Структура("object_type,name,offset,limit", ТипОбъекта, ИмяОбъекта, Смещение, 2);
        Страница = КИИ_СерверMCPИнструментСтруктураОбъекта.ВыполнитьИнструмент("get_object_structure", Аргументы);
        ЮТест.ОжидаетЧто(Страница.Свойство("paged"), "Запрошена адресуемая страница, а не полный старый результат").Равно(Истина);
        ЮТест.ОжидаетЧто(Страница.total_count).Равно(ОжидаемыеПути.Количество());
        ЮТест.ОжидаетЧто(Страница.items.Количество() <= 2).Равно(Истина);
        Для Каждого Поле Из Страница.items Цикл
            ЮТест.ОжидаетЧто(ПолученныеПути.Получить(Поле.path), Поле.path).Равно(Неопределено);
            ЮТест.ОжидаетЧто(ОжидаемыеПути.Получить(Поле.path), Поле.path).Равно(Поле.name);
            ПолученныеПути.Вставить(Поле.path, Поле.name);
        КонецЦикла;
        ЮТест.ОжидаетЧто(Страница.returned_count).Равно(Страница.items.Количество());
        ЮТест.ОжидаетЧто(Страница.next_offset).Равно(Смещение + Страница.items.Количество());
        Если Не Страница.has_more Тогда
            Завершено = Истина;
            Прервать;
        КонецЕсли;
        ЮТест.ОжидаетЧто(Страница.next_offset > Смещение).Равно(Истина);
        Смещение = Страница.next_offset;
    КонецЦикла;
    ЮТест.ОжидаетЧто(Завершено).Равно(Истина);
    ЮТест.ОжидаетЧто(ПолученныеПути.Количество()).Равно(ОжидаемыеПути.Количество());
КонецПроцедуры

