Процедура ЗапросАудитПроверитьМатериализацию(Знач Текст, Знач ОжидаемоеЧислоСтрок, Знач ПервоеЗначение)
    ТекстСЛимитом = КИИ_СерверMCPБезопасностьЗапросов.ПрименитьЛимитСПробой(Текст, 1);
    Запрос = Новый Запрос(ТекстСЛимитом);
    Таблица = Запрос.Выполнить().Выгрузить();
    ЮТест.ОжидаетЧто(Таблица.Количество(), "Считается вся таблица до построения DTO").Равно(ОжидаемоеЧислоСтрок);
    ЮТест.ОжидаетЧто(Таблица[0].Номер).Равно(ПервоеЗначение);
    Аргументы = АргументыЗапроса("audit-query-cap", Текст, 1);
    Данные = КИИ_СерверMCPИнструментВыполнитьЗапрос.ВыполнитьИнструмент("execute_query", Аргументы);
    ЮТест.ОжидаетЧто(Данные.rows.Количество()).Равно(1);
    ЮТест.ОжидаетЧто(Данные.rows[0][0]).Равно(ПервоеЗначение);
    ЮТест.ОжидаетЧто(Данные.truncated).Равно(ОжидаемоеЧислоСтрок > 1);
КонецПроцедуры

Функция ЗапросАудитДанныеJSON(Знач Текст)
    Аргументы = АргументыЗапроса("audit-query-json", Текст, 1);
    Данные = КИИ_СерверMCPИнструментВыполнитьЗапрос.ВыполнитьИнструмент("execute_query", Аргументы);
    СтрокаJSON = КИИ_КоннекторИИОбщий.ЗначениеВСтрокуJSON(Данные);
    Возврат КИИ_КоннекторИИОбщий.ЗначениеИзСтрокиJSON(СтрокаJSON, Ложь);
КонецФункции

Процедура СтруктураАудит_СтарыйКонтракт() Экспорт
    Аргументы = Новый Структура("object_type,name", "Catalog", "КИИ_МоделиИИ");
    Данные = КИИ_СерверMCPИнструментСтруктураОбъекта.ВыполнитьИнструмент("get_object_structure", Аргументы);
    ЮТест.ОжидаетЧто(Данные.Количество()).Равно(8);
    ЮТест.ОжидаетЧто(Данные.Свойство("paged")).Равно(Ложь);
    ЮТест.ОжидаетЧто(Данные.attributes.Количество()).Равно(Метаданные.Справочники.КИИ_МоделиИИ.Реквизиты.Количество());
    ЮТест.ОжидаетЧто(Данные.tabular_sections.Количество()).Равно(Метаданные.Справочники.КИИ_МоделиИИ.ТабличныеЧасти.Количество());
КонецПроцедуры

Процедура СтруктураАудит_ДокументДоКонца() Экспорт
    ВыбранныйОбъект = Неопределено;
    Максимум = -1;
    Для Каждого Описание Из Метаданные.Документы Цикл
        Размер = Описание.Реквизиты.Количество() + Описание.ТабличныеЧасти.Количество();
        Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
            Размер = Размер + ТабличнаяЧасть.Реквизиты.Количество();
        КонецЦикла;
        Если Размер > Максимум Тогда
            ВыбранныйОбъект = Описание;
            Максимум = Размер;
        КонецЕсли;
    КонецЦикла;
    ЮТест.ОжидаетЧто(ВыбранныйОбъект <> Неопределено).Равно(Истина);
    ОжидаемыеПути = Новый Соответствие;
    СтруктураАудитОжиданияПолей(ОжидаемыеПути, ВыбранныйОбъект.Реквизиты, "attributes.");
    Для Каждого ТабличнаяЧасть Из ВыбранныйОбъект.ТабличныеЧасти Цикл
        ОжидаемыеПути.Вставить("tabular_sections." + ТабличнаяЧасть.Имя, ТабличнаяЧасть.Имя);
        СтруктураАудитОжиданияПолей(ОжидаемыеПути, ТабличнаяЧасть.Реквизиты,
            "tabular_sections." + ТабличнаяЧасть.Имя + ".attributes.");
    КонецЦикла;
    СтруктураАудитСверитьСтраницы("Document", ВыбранныйОбъект.Имя, ОжидаемыеПути);
КонецПроцедуры

Процедура СтруктураАудит_РегистрДоКонца() Экспорт
    Описание = Метаданные.РегистрыСведений.ВерсииОбъектов;
    ОжидаемыеПути = Новый Соответствие;
    СтруктураАудитОжиданияПолей(ОжидаемыеПути, Описание.Реквизиты, "attributes.");
    СтруктураАудитОжиданияПолей(ОжидаемыеПути, Описание.Измерения, "dimensions.");
    СтруктураАудитОжиданияПолей(ОжидаемыеПути, Описание.Ресурсы, "resources.");
    СтруктураАудитСверитьСтраницы("InformationRegister", Описание.Имя, ОжидаемыеПути);
КонецПроцедуры

Процедура СтруктураАудит_РазделИКонец() Экспорт
    Аргументы = Новый Соответствие;
    Аргументы.Вставить("object_type", "InformationRegister");
    Аргументы.Вставить("name", "КИИ_ЛогЗапросовИИ");
    Аргументы.Вставить("section", "resources");
    Аргументы.Вставить("limit", 2);
    Данные = КИИ_СерверMCPИнструментСтруктураОбъекта.ВыполнитьИнструмент("get_object_structure", Аргументы);
    ЮТест.ОжидаетЧто(Данные.Свойство("paged")).Равно(Истина);
    ЮТест.ОжидаетЧто(Данные.total_count).Равно(Метаданные.РегистрыСведений.КИИ_ЛогЗапросовИИ.Ресурсы.Количество());
    Для Каждого Поле Из Данные.items Цикл
        ЮТест.ОжидаетЧто(Поле.section).Равно("resources");
    КонецЦикла;
    Аргументы.Вставить("offset", Данные.total_count + 10);
    Данные = КИИ_СерверMCPИнструментСтруктураОбъекта.ВыполнитьИнструмент("get_object_structure", Аргументы);
    ЮТест.ОжидаетЧто(Данные.items.Количество()).Равно(0);
    ЮТест.ОжидаетЧто(Данные.has_more).Равно(Ложь);
КонецПроцедуры

Процедура СтруктураАудит_НеверныеГраницы() Экспорт
    Примеры = Новый Массив;
    Примеры.Добавить(Новый Структура("offset", -1));
    Примеры.Добавить(Новый Структура("limit", 0));
    Примеры.Добавить(Новый Структура("limit", 201));
    Примеры.Добавить(Новый Структура("offset", 0.5));
    Примеры.Добавить(Новый Структура("limit", "2"));
    Примеры.Добавить(Новый Структура("section", "no_such_section"));
    Для Каждого Аргументы Из Примеры Цикл
        Аргументы.Вставить("object_type", "Catalog");
