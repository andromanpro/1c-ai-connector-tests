// --- Фикстуры/сидеры для РазобратьОтветПоиска ---

Функция ОтветQdrant(Знач Точка)
	Точки = Новый Массив;
	Точки.Добавить(Точка);
	Результат = Новый Соответствие;
	Результат.Вставить("points", Точки);
	Ответ = Новый Соответствие;
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
КонецФункции

Функция ТочкаQdrant(Знач ФрагментUUID, Знач Score)
	Payload = Новый Соответствие;
	Payload.Вставить("фрагмент", ФрагментUUID);
	Точка = Новый Соответствие;
	Точка.Вставить("payload", Payload);
	Точка.Вставить("score", Score);
	Возврат Точка;
КонецФункции

Функция СоздатьФрагментДляРазбора(Знач Владелец, Знач Текст)
	Вектор = Новый Массив;
	Вектор.Добавить(1);
	Вектор.Добавить(0);
	Вектор.Добавить(0);
	Фрагмент = Справочники.КИИ_ФрагментыЗнаний.СоздатьЭлемент();
	Фрагмент.Владелец = Владелец;
	Фрагмент.Наименование = Текст;
	Фрагмент.ТекстФрагмента = Текст;
	Фрагмент.Эмбеддинг = Новый ХранилищеЗначения(Вектор);
	Фрагмент.КодМоделиЭмбеддинга = "тест:разбор";
	Фрагмент.Размерность = 3;
	Фрагмент.Записать();
	Возврат Фрагмент.Ссылка;
КонецФункции

// --- ВыбратьЭлементыОчереди: FIFO-выборка + исключение ядовитых строк ---

// Тест-гэп (аудит P2): выбор очереди FIFO + исключение «ядовитых» строк (Попыток ≥ лимит) не покрыт.
Процедура Qdrant_ВыборОчереди_FIFO_И_ЯдовитыеИсключены() Экспорт
	НачатьТранзакцию();
	Попытка
		КодМодели = "тест:очередь-выбор";
		ЗаписатьЭлементОчереди("poison", КодМодели, 10, 1000000);  // ядовитая (Попыток ≥ лимит) — исключается
		ЗаписатьЭлементОчереди("second", КодМодели, 200, 0);
		ЗаписатьЭлементОчереди("first",  КодМодели, 100, 0);

		Наши = Новый Массив;
		Для Каждого Элемент Из КИИ_RAGQdrant.ВыбратьЭлементыОчереди() Цикл
			Если Элемент.КодМодели = КодМодели Тогда
				Наши.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;

		ЮТест.ОжидаетЧто(Наши.Количество()).Равно(2);                    // ядовитая исключена
		ЮТест.ОжидаетЧто(Наши[0].ФрагментИдентификатор).Равно("first");  // FIFO: НомерПоПорядку 100 < 200
		ЮТест.ОжидаетЧто(Наши[1].ФрагментИдентификатор).Равно("second");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьЭлементОчереди(Знач ФрагИд, Знач КодМодели, Знач НомерПоПорядку, Знач Попыток)
	Запись = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = ФрагИд;
	Запись.КодМодели = КодМодели;
	Запись.НомерПоПорядку = НомерПоПорядку;
	Запись.Операция = "upsert";
	Запись.Хеш = "h";
	Запись.Попыток = Попыток;
	Запись.ПоследняяОшибка = "";
	Запись.ДатаПостановки = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

