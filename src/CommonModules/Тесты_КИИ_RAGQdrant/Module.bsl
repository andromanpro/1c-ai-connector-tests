// --- Тело запроса поиска (Query API) ---

Процедура Qdrant_ТелоПоиска_БазовыеПоля() Экспорт
	Вектор = Новый Массив;
	Вектор.Добавить(0.1);
	Вектор.Добавить(0.2);
	Тело = КИИ_RAGQdrant.ПостроитьТелоПоиска(Вектор, 5, 0.3, Неопределено);
	ЮТест.ОжидаетЧто(Тело.limit).Равно(5);
	ЮТест.ОжидаетЧто(Тело.score_threshold).Равно(0.3);
	ЮТест.ОжидаетЧто(Тело.query.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Тело.with_payload.Количество()).Равно(5);
	ЮТест.ОжидаетЧто(Тело.Свойство("filter")).Равно(Ложь);
КонецПроцедуры

Процедура Qdrant_ТелоПоиска_ФильтрКатегорий() Экспорт
	Вектор = Новый Массив;
	Вектор.Добавить(0.1);
	Категория = Справочники.КИИ_КатегорииЗнаний.ПолучитьСсылку(Новый УникальныйИдентификатор("aaaaaaaa-0000-0000-0000-000000000001"));
	Категории = Новый Массив;
	Категории.Добавить(Категория);
	Тело = КИИ_RAGQdrant.ПостроитьТелоПоиска(Вектор, 3, 0.0, Категории);
	ЮТест.ОжидаетЧто(Тело.Свойство("filter")).Равно(Истина);
	Условия = Тело.filter.must;
	ЮТест.ОжидаетЧто(Условия.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Условия[0].key).Равно("категория");
	ЮТест.ОжидаетЧто(Условия[0].match.any.Количество()).Равно(1);
КонецПроцедуры

// --- Consumer-policy-check ---

Процедура Qdrant_РазрешёнФрагментДляМодели() Экспорт
	Запрещено = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
	ТолькоРФ = Перечисления.КИИ_ПолитикиЭмбеддинга.ТолькоРФ;
	Разрешено = Перечисления.КИИ_ПолитикиЭмбеддинга.РазрешеноВнешнее;
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.РазрешёнФрагментДляМодели(Запрещено, Разрешено)).Равно(Ложь);
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.РазрешёнФрагментДляМодели(ТолькоРФ, Разрешено)).Равно(Ложь);
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.РазрешёнФрагментДляМодели(ТолькоРФ, ТолькоРФ)).Равно(Истина);
	ЮТест.ОжидаетЧто(КИИ_RAGQdrant.РазрешёнФрагментДляМодели(Разрешено, Разрешено)).Равно(Истина);
КонецПроцедуры

// --- Readiness-gate (build-marker) ---

Процедура Qdrant_ОтметитьПоколение_ИндексПостроен() Экспорт
	КодМодели = "тест:readiness";
	НачатьТранзакцию();
	Попытка
		КИИ_RAGQdrant.ОтметитьПоколение(КодМодели, Истина);
		ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ИндексПостроен(КодМодели)).Равно(Истина);
		КИИ_RAGQdrant.ОтметитьПоколение(КодМодели, Ложь);
		ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ИндексПостроен(КодМодели)).Равно(Ложь);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// --- Outbox (очередь синхронизации) ---

Процедура Qdrant_ПоставитьВОчередь_ПишетСтроку() Экспорт
	КодМодели = "тест:очередь1";
	ФрагИд = "frag-q1";
	НачатьТранзакцию();
	Попытка
		КИИ_RAGQdrant.ПоставитьВОчередь(ФрагИд, КодМодели, "upsert", "hash-1");
		Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", ФрагИд, КодМодели);
		Данные = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
		ЮТест.ОжидаетЧто(Данные.Операция).Равно("upsert");
		ЮТест.ОжидаетЧто(Данные.Хеш).Равно("hash-1");
		ЮТест.ОжидаетЧто(Данные.Попыток).Равно(0);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура Qdrant_ПоставитьВОчередь_Коалесцирование() Экспорт
	КодМодели = "тест:очередь2";
	ФрагИд = "frag-q2";
	НачатьТранзакцию();
	Попытка
		КИИ_RAGQdrant.ПоставитьВОчередь(ФрагИд, КодМодели, "upsert", "h1");
		КИИ_RAGQdrant.ПоставитьВОчередь(ФрагИд, КодМодели, "delete", "");

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ФрагИд", ФрагИд);
		Запрос.УстановитьПараметр("КодМодели", КодМодели);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ
		|	РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Т
		|ГДЕ
		|	Т.ФрагментИдентификатор = &ФрагИд
		|	И Т.КодМодели = &КодМодели";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		// Одна пара измерений → перезапись; последняя операция побеждает (коалесцирование).
		ЮТест.ОжидаетЧто(Выборка.Кол).Равно(1);

		Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", ФрагИд, КодМодели);
		Данные = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
		ЮТест.ОжидаетЧто(Данные.Операция).Равно("delete");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Гонка delete-after-process (#158): снимок выборки взял строку, но до удаления пришла новая
// (коалесцированная) операция с бОльшим НомерПоПорядку. Удаление по ключу стёрло бы её → потеря.
Процедура Qdrant_УдалениеОчереди_КоалесцированнаяУцелела() Экспорт
	КодМодели = "тест:очередь-гонка";
	ФрагИд = "frag-race";
	НачатьТранзакцию();
	Попытка
		ЗаписатьСтрокуОчередиСоСтампом(ФрагИд, КодМодели, 1000, "h1");
		СтампСнимка = 1000;
		// коалесцирование во время обработки: новая операция перезаписала строку (стамп больше)
		ЗаписатьСтрокуОчередиСоСтампом(ФрагИд, КодМодели, 1050, "h2");
		// диспетчер удаляет по СНИМКУ (старый стамп) — новая операция обязана уцелеть
		КИИ_RAGQdrant.УдалитьСтрокуОчередиДляТестов(ФрагИд, КодМодели, СтампСнимка);

		ЮТест.ОжидаетЧто(КоличествоСтрокОчереди(ФрагИд, КодМодели)).Равно(1);
		Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", ФрагИд, КодМодели);
		Данные = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
		ЮТест.ОжидаетЧто(Данные.Хеш).Равно("h2");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Штатный путь: снимок совпал с текущим НомерПоПорядку → обработанная строка удаляется.
Процедура Qdrant_УдалениеОчереди_СнимокСовпал_Удалена() Экспорт
	КодМодели = "тест:очередь-удал";
	ФрагИд = "frag-del";
	НачатьТранзакцию();
	Попытка
		ЗаписатьСтрокуОчередиСоСтампом(ФрагИд, КодМодели, 2000, "h1");
		КИИ_RAGQdrant.УдалитьСтрокуОчередиДляТестов(ФрагИд, КодМодели, 2000);
		ЮТест.ОжидаетЧто(КоличествоСтрокОчереди(ФрагИд, КодМодели)).Равно(0);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Хелпер: сид строки очереди с явным НомерПоПорядку (ПоставитьВОчередь ставит now-ms и не даёт
// контролировать стамп для теста гонки коалесцирования).
Процедура ЗаписатьСтрокуОчередиСоСтампом(ФрагИд, КодМодели, Стамп, Хеш)
	Запись = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.СоздатьМенеджерЗаписи();
	Запись.ФрагментИдентификатор = ФрагИд;
	Запись.КодМодели = КодМодели;
	Запись.НомерПоПорядку = Стамп;
	Запись.Операция = "upsert";
	Запись.Хеш = Хеш;
	Запись.Попыток = 0;
	Запись.ПоследняяОшибка = "";
	Запись.ДатаПостановки = ТекущаяДатаСеанса();
	Запись.Записать();
КонецПроцедуры

// Хелпер: количество строк очереди по ключу (ФрагментИдентификатор + КодМодели).
Функция КоличествоСтрокОчереди(ФрагИд, КодМодели)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФрагИд", ФрагИд);
	Запрос.УстановитьПараметр("КодМодели", КодМодели);
	Запрос.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
	|ИЗ
	|	РегистрСведений.КИИ_ОчередьСинхронизацииQdrant КАК Т
	|ГДЕ
	|	Т.ФрагментИдентификатор = &ФрагИд
	|	И Т.КодМодели = &КодМодели";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Кол;
КонецФункции

// --- Backend-switch ---

Процедура Qdrant_ЭтоБэкендQdrant_Переключение() Экспорт
	НачатьТранзакцию();
	Попытка
		Константы.КИИ_БэкендВекторногоПоиска.Установить(Перечисления.КИИ_БэкендыВекторногоПоиска.Нативный);
		ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ЭтоБэкендQdrant()).Равно(Ложь);
		Константы.КИИ_БэкендВекторногоПоиска.Установить(Перечисления.КИИ_БэкендыВекторногоПоиска.Qdrant);
		ЮТест.ОжидаетЧто(КИИ_RAGQdrant.ЭтоБэкендQdrant()).Равно(Истина);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// --- РазобратьОтветПоиска: rehydrate + orphan-delete + policy-recheck (security-путь) ---

// Позитив: валидный фрагмент (политика разрешает) → в Знания с Текст/Score.
Процедура Qdrant_РазборОтвета_ВалидныйФрагмент_ВЗнаниях() Экспорт
	НачатьТранзакцию();
	Попытка
		База = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
		База.Наименование = "Qdrant разбор — валид";
		База.Записать();
		ФрагСсылка = СоздатьФрагментДляРазбора(База.Ссылка, "Разрешённый текст");
		UUID = Строка(ФрагСсылка.УникальныйИдентификатор());

		Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветQdrant(ТочкаQdrant(UUID, 0.87)), "тест:разбор");

		ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Результат.Знания[0].Текст).Равно("Разрешённый текст");
		ЮТест.ОжидаетЧто(Результат.Знания[0].Score).Равно(0.87);
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Осиротевшая точка (фрагмента нет в 1С) → исключена + delete поставлен в очередь.
Процедура Qdrant_РазборОтвета_ОсиротевшаяТочка_DeleteВОчереди() Экспорт
	НачатьТранзакцию();
	Попытка
		КодМодели = "тест:разбор-orphan";
		ОтсутствующийUUID = "99999999-8888-7777-6666-555555555555";

		Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветQdrant(ТочкаQdrant(ОтсутствующийUUID, 0.9)), КодМодели);

		ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(0);
		Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", ОтсутствующийUUID, КодМодели);
		Данные = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
		ЮТест.ОжидаетЧто(Данные.Операция).Равно("delete");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Политика ЗапрещеноВнешнее → фрагмент исключён + delete (защита от утечки запрещённого контента).
Процедура Qdrant_РазборОтвета_ПолитикаЗапрещено_ИсключёнИDelete() Экспорт
	НачатьТранзакцию();
	Попытка
		КодМодели = "тест:разбор-policy";
		Категория = Справочники.КИИ_КатегорииЗнаний.СоздатьЭлемент();
		Категория.Наименование = "Запрещённая (разбор)";
		Категория.ПолитикаЭмбеддинга = Перечисления.КИИ_ПолитикиЭмбеддинга.ЗапрещеноВнешнее;
		Категория.Записать();
		База = Справочники.КИИ_БазаЗнаний.СоздатьЭлемент();
		База.Наименование = "База запрещённая (разбор)";
		База.Категория = Категория.Ссылка;
		База.Записать();
		ФрагСсылка = СоздатьФрагментДляРазбора(База.Ссылка, "Секрет не для внешних");
		UUID = Строка(ФрагСсылка.УникальныйИдентификатор());

		Результат = КИИ_RAGQdrant.РазобратьОтветПоиска(ОтветQdrant(ТочкаQdrant(UUID, 0.95)), КодМодели);

		ЮТест.ОжидаетЧто(Результат.Знания.Количество()).Равно(0);
		Отбор = Новый Структура("ФрагментИдентификатор, КодМодели", UUID, КодМодели);
		Данные = РегистрыСведений.КИИ_ОчередьСинхронизацииQdrant.Получить(Отбор);
		ЮТест.ОжидаетЧто(Данные.Операция).Равно("delete");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

