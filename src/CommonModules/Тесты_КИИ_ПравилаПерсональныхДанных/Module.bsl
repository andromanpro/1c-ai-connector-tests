// Вложенный интервал снимается целиком: хвоста чувствительного значения остаться не должно.
Процедура Арбитр_ВложенныйИнтервал_Снят() Экспорт

	Находки = Новый Массив;
	Находки.Добавить(НаходкаДляАрбитра("ФИО", 10, 21, "Высокая"));
	Находки.Добавить(НаходкаДляАрбитра("ИНН", 15, 10, "Высокая"));
	Находки.Добавить(НаходкаДляАрбитра("EMAIL", 40, 6, "Высокая"));

	Принятые = КИИ_ПравилаПерсональныхДанных.РазрешитьПересечения(Находки);

	ЮТест.ОжидаетЧто(Принятые.Количество(), "принято интервалов").Равно(2);
	ЮТест.ОжидаетЧто(Принятые[0].Тип, "первый принятый").Равно("ФИО");
	ЮТест.ОжидаетЧто(Принятые[1].Тип, "второй принятый").Равно("EMAIL");

КонецПроцедуры

