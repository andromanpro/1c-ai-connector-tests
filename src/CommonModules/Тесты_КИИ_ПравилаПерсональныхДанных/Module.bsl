Процедура ПроверитьНаходку(Знач Находка, Знач Тип, Знач Начало, Знач Длина)

	ЮТест.ОжидаетЧто(Находка.Тип, "тип находки").Равно(Тип);
	ЮТест.ОжидаетЧто(Находка.Начало, "начало интервала " + Тип).Равно(Начало);
	ЮТест.ОжидаетЧто(Находка.Длина, "длина интервала " + Тип).Равно(Длина);

КонецПроцедуры

Функция НаходкаДляАрбитра(Знач Тип, Знач Начало, Знач Длина, Знач Уверенность)

	Находка = Новый Структура;
	Находка.Вставить("Тип", Тип);
	Находка.Вставить("Значение", "значение");
	Находка.Вставить("НормализованныйКлюч", "значение");
	Находка.Вставить("Начало", Начало);
	Находка.Вставить("Длина", Длина);
	Находка.Вставить("Уверенность", Уверенность);
	Находка.Вставить("Детектор", "тест");

	Возврат Находка;

КонецФункции

#КонецОбласти
