// В одной строке находятся и имя, и идентификационный номер; интервалы заданы в тесте вручную.
Процедура ФИОиИНН_НайденыОба() Экспорт

	Текст = "Не найден контрагент Иванов Петр Сергеевич, ИНН 7707083893, договор 12.";

	Находки = КИИ_ПравилаПерсональныхДанных.РазрешитьПересечения(
		КИИ_ПравилаПерсональныхДанных.НайтиСущности(Текст));

	ЮТест.ОжидаетЧто(Находки.Количество(), "количество находок").Равно(2);
	ПроверитьНаходку(Находки[0], "ФИО", 22, 21);
	ПроверитьНаходку(Находки[1], "ИНН", 49, 10);

КонецПроцедуры

