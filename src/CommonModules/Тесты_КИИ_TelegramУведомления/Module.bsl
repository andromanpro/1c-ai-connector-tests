// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("TelegramУведомления")
			.ДобавитьСерверныйТест("ДлинаСообщения_ВПределахЛимита_Истина")
			.ДобавитьСерверныйТест("ДлинаСообщения_ПревышаетЛимит_Ложь")
			.ДобавитьСерверныйТест("Обрезка_КороткоеБезИзменений")
			.ДобавитьСерверныйТест("Обрезка_ДлинноеОбрезаетсяСМаркером")
			.ДобавитьСерверныйТест("Обрезка_ДлинаРезультатаРавнаЛимиту")
				.ДобавитьСерверныйТест("Обрезка_HTMLНеРвётТег")
			.ДобавитьСерверныйТест("Клавиатура_Inline_СодержитМаркеры")
			.ДобавитьСерверныйТест("Клавиатура_Reply_СодержитResizeKeyboard")
				.ДобавитьСерверныйТест("СкрытиеТокена_ВТекстеОшибки_Замаскирован")
				.ДобавитьСерверныйТест("СкрытиеТокена_ПустойТокен_БезИзменений");

КонецПроцедуры

#КонецОбласти

#Область ТестыДлиныИОбрезки

// Сообщение в пределах лимита проходит проверку.
Процедура ДлинаСообщения_ВПределахЛимита_Истина() Экспорт

	ЮТест.ОжидаетЧто(КИИ_TelegramУведомления.ПроверитьДлинуСообщения("привет", 10)).Равно(Истина);

КонецПроцедуры

// Сообщение длиннее лимита не проходит проверку.
Процедура ДлинаСообщения_ПревышаетЛимит_Ложь() Экспорт

	ЮТест.ОжидаетЧто(КИИ_TelegramУведомления.ПроверитьДлинуСообщения("привет", 3)).Равно(Ложь);

КонецПроцедуры

// Короткое сообщение возвращается без изменений.
Процедура Обрезка_КороткоеБезИзменений() Экспорт

	ЮТест.ОжидаетЧто(КИИ_TelegramУведомления.ОбрезатьСообщениеДоЛимита("привет", 100)).Равно("привет");

КонецПроцедуры

// Длинное сообщение обрезается с маркером "...".
Процедура Обрезка_ДлинноеОбрезаетсяСМаркером() Экспорт

	Результат = КИИ_TelegramУведомления.ОбрезатьСообщениеДоЛимита("abcdefghij", 8);

	ЮТест.ОжидаетЧто(Результат).Равно("abcde...");

КонецПроцедуры

// Длина обрезанного сообщения точно равна лимиту.
Процедура Обрезка_ДлинаРезультатаРавнаЛимиту() Экспорт

	Результат = КИИ_TelegramУведомления.ОбрезатьСообщениеДоЛимита("abcdefghij", 8);

	ЮТест.ОжидаетЧто(СтрДлина(Результат)).Равно(8);

КонецПроцедуры

// Ломалка (аудит P2): обрезка не должна оставить оборванный HTML-тег (иначе parse_mode=HTML → 400).
Процедура Обрезка_HTMLНеРвётТег() Экспорт

	Сообщение = "aaaaaaaaaaaaaaaa<b>жирный текст</b>";
	Результат = КИИ_TelegramУведомления.ОбрезатьСообщениеДоЛимита(Сообщение, 20);

	ЮТест.ОжидаетЧто(СтрДлина(Результат) <= 20).Равно(Истина);
	ПоследнийОткрытый = СтрНайти(Результат, "<", НаправлениеПоиска.СКонца);
	ПоследнийЗакрытый = СтрНайти(Результат, ">", НаправлениеПоиска.СКонца);
	ЮТест.ОжидаетЧто(ПоследнийОткрытый <= ПоследнийЗакрытый).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыМаскировкиТокена

// Ломалка (аудит P2): токен бота вшит в URL метода и без маскировки утекает в ЖР при ошибке.
Процедура СкрытиеТокена_ВТекстеОшибки_Замаскирован() Экспорт

	Токен = "123456:ABC-SECRET-TOKEN";
	Текст = "Ошибка запроса к https://api.telegram.org/bot123456:ABC-SECRET-TOKEN/sendMessage: timeout";

	Результат = КИИ_TelegramУведомления.СкрытьТокенВТексте(Текст, Токен);

	ЮТест.ОжидаетЧто(СтрНайти(Результат, "123456:ABC-SECRET-TOKEN") > 0).Равно(Ложь);
	ЮТест.ОжидаетЧто(СтрНайти(Результат, "<скрыт>") > 0).Равно(Истина);

КонецПроцедуры

// Пустой токен не ломает и не меняет текст.
Процедура СкрытиеТокена_ПустойТокен_БезИзменений() Экспорт

	ЮТест.ОжидаетЧто(КИИ_TelegramУведомления.СкрытьТокенВТексте("текст без токена", "")).Равно("текст без токена");

КонецПроцедуры

#КонецОбласти

#Область ТестыКлавиатуры

// Inline-клавиатура содержит маркеры inline_keyboard и callback_data.
Процедура Клавиатура_Inline_СодержитМаркеры() Экспорт

	Кнопки = Новый Массив;
	Кнопки.Добавить("Да");
	Кнопки.Добавить("Нет");

	JSON = КИИ_TelegramУведомления.СформироватьКлавиатуруПоМассивуКнопок(Кнопки, Истина, Истина);

	ЮТест.ОжидаетЧто(Содержит(JSON, "inline_keyboard")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(JSON, "callback_data")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(JSON, "Да")).Равно(Истина);

КонецПроцедуры

// Reply-клавиатура (не под сообщением) содержит keyboard и resize_keyboard.
Процедура Клавиатура_Reply_СодержитResizeKeyboard() Экспорт

	Кнопки = Новый Массив;
	Кнопки.Добавить("Меню");

	JSON = КИИ_TelegramУведомления.СформироватьКлавиатуруПоМассивуКнопок(Кнопки, Ложь, Истина);

	ЮТест.ОжидаетЧто(Содержит(JSON, "resize_keyboard")).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Содержит(Знач Текст, Знач Фрагмент)

	Возврат СтрНайти(Текст, Фрагмент) > 0;

КонецФункции

#КонецОбласти
