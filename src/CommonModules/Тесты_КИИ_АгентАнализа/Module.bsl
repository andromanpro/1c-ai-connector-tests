Процедура МетаданныеСтраницы_Первая() Экспорт
	Аргументы = Новый Структура("filter,offset,limit", "Catalog.*", 0, 3);
	Страница = КИИ_СерверMCPИнструментДеревоМетаданных.ВыполнитьИнструмент("get_metadata_tree", Аргументы);
	ОжидаемоеКоличество = Мин(3, Метаданные.Справочники.Количество());
	ЮТест.ОжидаетЧто(Страница.objects.Количество()).Равно(ОжидаемоеКоличество);
	ЮТест.ОжидаетЧто(Страница.total_count).Равно(Метаданные.Справочники.Количество());
	ЮТест.ОжидаетЧто(Страница.returned_count).Равно(ОжидаемоеКоличество);
	ЮТест.ОжидаетЧто(Страница.next_offset).Равно(ОжидаемоеКоличество);
КонецПроцедуры

Процедура МетаданныеСтраницы_ПродолжениеБезПропусков() Экспорт
	ВсеОбъекты = КИИ_СерверMCPИнструментДеревоМетаданных.ВыполнитьИнструмент(
		"get_metadata_tree", Новый Структура("filter", "Catalog.*"));
	Смещение = 0;
	Проверено = 0;
	Пока Проверено < ВсеОбъекты.objects.Количество() Цикл
		Аргументы = Новый Структура("filter,offset,limit", "Catalog.*", Смещение, 3);
		Страница = КИИ_СерверMCPИнструментДеревоМетаданных.ВыполнитьИнструмент("get_metadata_tree", Аргументы);
		ЮТест.ОжидаетЧто(Страница.objects.Количество() > 0).Равно(Истина);
		Для Каждого Описание Из Страница.objects Цикл
			ЮТест.ОжидаетЧто(Описание.canonical_ref).Равно(ВсеОбъекты.objects[Проверено].canonical_ref);
			Проверено = Проверено + 1;
		КонецЦикла;
		ЮТест.ОжидаетЧто(Страница.next_offset).Равно(Проверено);
		ЮТест.ОжидаетЧто(Страница.has_more).Равно(Проверено < ВсеОбъекты.objects.Количество());
		Смещение = Страница.next_offset;
	КонецЦикла;
КонецПроцедуры

