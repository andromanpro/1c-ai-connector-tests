	ЮТест.ОжидаетЧто(Ответ.ВходныеТокены).Равно(1000);
	ЮТест.ОжидаетЧто(Ответ.ВыходныеТокены).Равно(200);
	Оценка = КИИ_КоннекторИИ.ОценитьСтоимостьПоТарифам(Ответ, КонтрольныеТарифы());
	ЮТест.ОжидаетЧто(Оценка.ОценкаСтоимости).Равно(0.00288);

