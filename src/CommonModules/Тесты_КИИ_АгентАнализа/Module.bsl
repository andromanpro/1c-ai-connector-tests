Функция МодельСКонтрольнымиТарифами(Знач Сценарий)

	СсылкаМодели = СоздатьМодельПетли(Сценарий);
	Модель = СсылкаМодели.ПолучитьОбъект();
	ЗаполнитьЗначенияСвойств(Модель, КонтрольныеТарифы());
	Модель.Записать();
	Возврат СсылкаМодели;

КонецФункции

Функция ЖурналТарифовМодели(Знач Модель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   Лог.ОценкаСтоимости,
		|   Лог.ЕстьОценкаСтоимости,
		|   Лог.ВалютаОценкиСтоимости,
		|   Лог.ТарифыОценкиСтоимости,
		|   Лог.ИзКеша
		|ИЗ РегистрСведений.КИИ_ЛогЗапросовИИ КАК Лог
		|ГДЕ Лог.Модель = &Модель";
	Запрос.УстановитьПараметр("Модель", Модель);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

