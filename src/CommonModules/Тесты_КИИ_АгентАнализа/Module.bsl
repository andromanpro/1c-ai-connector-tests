Функция СоздатьМодельНабора(Знач Сценарий, Знач Настроить, Знач Имена)
	Ссылка = СоздатьМодельПетли(Сценарий);
	ОбъектМодели = Ссылка.ПолучитьОбъект();
	ОбъектМодели.НастроитьНаборИнструментов = Настроить;
	Для Каждого ИмяИнструмента Из СтрРазделить(Имена, ",", Ложь) Цикл
		ОбъектМодели.Инструменты.Добавить().ИмяИнструмента = ИмяИнструмента;
	КонецЦикла;
	ОбъектМодели.Записать();
	Возврат Ссылка;
КонецФункции

