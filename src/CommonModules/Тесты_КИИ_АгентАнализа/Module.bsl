Функция КонтентВопросаСИзображением()
	Контент = Новый Массив;
	Контент.Добавить(Новый Структура("Тип, Текст", "text", "посмотри изображение"));
	Контент.Добавить(Новый Структура("Тип, URL", "image", "https://example.test/image.png"));
	Возврат Контент;
КонецФункции

Функция ТелоИнструментальногоЗапроса(Знач ФорматAPI)
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "user", КонтентВопросаСИзображением()));
	Промпт = Новый Структура("СырыеСообщения, Инструменты", Сообщения, КИИ_АгентАнализа.СобратьИнструментыДляМодели());
	Параметры = Новый Структура;
	Параметры.Вставить("ТипФорматаAPI", ФорматAPI);
	Параметры.Вставить("ТипАвторизации", Перечисления.КИИ_ТипыАвторизации.Bearer);
	Параметры.Вставить("НаименованиеПровайдера", "test-provider");
	Параметры.Вставить("НаименованиеПолное", "test-model");
	Параметры.Вставить("Температура", 0.7);
	Параметры.Вставить("МаксимумТокенов", 1000);
	Параметры.Вставить("Заголовки", Новый Массив);

	Запрос = КИИ_КоннекторИИ.СформироватьЗапросДляТестов(Параметры, Промпт);
	Возврат Запрос.ТелоЗапроса;
КонецФункции

