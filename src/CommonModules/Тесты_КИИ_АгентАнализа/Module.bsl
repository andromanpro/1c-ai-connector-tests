Функция СоздатьМодельПетли(Знач Сценарий, Знач Режим = Неопределено)
	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Наименование = "Тест инструментов " + Сценарий;
	Модель.НаименованиеПолное = "expert-test-" + Строка(Новый УникальныйИдентификатор);
	Модель.НаименованиеПровайдера = "OpenAI";
	Модель.Адрес = "127.0.0.1:18770";
	Модель.АдресЗапроса = "/" + Сценарий + "/chat/completions";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	Модель.ТипАвторизации = Перечисления.КИИ_ТипыАвторизации.Bearer;
	Модель.ПоддерживаетИнструменты = Истина;
	Модель.ИспользоватьЗащищенноеСоединение = Ложь;
	Модель.ИспользоватьПрокси = Ложь;
	Модель.Таймаут = 10;
	Модель.РежимКонтроляПерсональныхДанных = ?(
		Режим = Неопределено, Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен, Режим);
	Модель.Записать();
	Возврат Модель.Ссылка;
КонецФункции

// Вызывает тело фонового метода в текущем серверном контексте теста.
// Реальные фоновые задания этой оснасткой не создаются; временное хранилище удаляется в обеих ветвях.
Функция ВыполнитьФоновыйМетодПетли(Знач Модель, Знач Промпт, Знач ВключитьИнструменты = Неопределено)
	Параметры = Новый Структура("Модель, Промпт", Модель, Промпт);
	Если ВключитьИнструменты <> Неопределено Тогда
		Параметры.Вставить("ИспользоватьИнструменты", ВключитьИнструменты);
	КонецЕсли;
	Адрес = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Попытка
		КИИ_КоннекторИИ.ЗапросКМоделиФоновоеЗадание(Параметры, Адрес);
		Ответ = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		УдалитьИзВременногоХранилища(Адрес);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Адрес);
	Возврат Ответ;
КонецФункции

