// Проверяет исполнение встроенного инструмента и суммарный результат двух раундов.
Процедура Петля_ДваРаундаСИсторией() Экспорт
	// { androman 2026-10-15
	Модель = СоздатьМодельПетли("rounds");
	История = Новый Массив;
	История.Добавить(Новый Структура("Роль, Текст", "user", "первый вопрос"));
	История.Добавить(Новый Структура("Роль, Текст", "assistant", "первый ответ"));
	Промпт = Новый Структура(
		"СистемныйПромпт, ПользовательскийПромпт, ИсторияСообщений", "инструкция", "уточнение", История);
	Ответ = КИИ_КоннекторИИ.ЗапросКМоделиСИнструментами(Модель, Промпт);

	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка, Ответ.ТекстОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно("TOOLS_OK");
	ЮТест.ОжидаетЧто(Ответ.Раундов).Равно(2);
	ЮТест.ОжидаетЧто(Ответ.ВызововИнструментов).Равно(1);
	ЮТест.ОжидаетЧто(Ответ.ВходныеТокены).Равно(30);
	ЮТест.ОжидаетЧто(Ответ.ВыходныеТокены).Равно(12);
	ЮТест.ОжидаетЧто(Ответ.ВсегоТокенов).Равно(42);
	ЮТест.ОжидаетЧто(Ответ.МодельОтвета).Равно("fixture-expert-tools");
	ЮТест.ОжидаетЧто(Ответ.Модель).Равно(Модель);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния).Равно(200);
	ЮТест.ОжидаетЧто(Ответ.ПричинаЗавершения).Равно("stop");
	ЮТест.ОжидаетЧто(Ответ.ВложенияОтвета.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.КорреляцияАгента).Заполнено();
КонецПроцедуры // } androman 2026-10-15

