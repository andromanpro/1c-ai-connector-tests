	ОбъектМодели.ТарифВыходныхТокенов = 200;
	ОбъектМодели.Записать();
	Второй = КИИ_КоннекторИИ.ЗапросКМодели(Модель, "контроль кеша и тарифа");
	ЮТест.ОжидаетЧто(Второй.ЭтоОшибка, Второй.ТекстОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Второй.ЕстьОценкаСтоимости).Равно(Истина);
	ЮТест.ОжидаетЧто(Второй.ОценкаСтоимости).Равно(0);
	ЮТест.ОжидаетЧто(Второй.Идентификатор = Первый.Идентификатор).Равно(Ложь);
	Строки = ЖурналТарифовМодели(Модель);
	ЮТест.ОжидаетЧто(Строки.Количество()).Равно(2);
	Кешированных = 0;
	Для Каждого Запись Из Строки Цикл
		Если Запись.ИзКеша Тогда
			Кешированных = Кешированных + 1;
			ЮТест.ОжидаетЧто(Запись.ОценкаСтоимости).Равно(0);
		Иначе
			ЮТест.ОжидаетЧто(Запись.ОценкаСтоимости).Равно(0.000096);
			СнимокТарифа = РазобратьJSONДляТеста(Запись.ТарифыОценкиСтоимости);
			ЮТест.ОжидаетЧто(СнимокТарифа.ТарифВходныхТокенов).Равно(2);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Кешированных).Равно(1);

