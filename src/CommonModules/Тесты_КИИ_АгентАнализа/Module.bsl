// В журнал нельзя вернуть оригинал ПД ни из инструкции, ни из вопроса, ни из ответа инструмента.
Процедура ЖурналПетли_КонтекстПослеМаскировки() Экспорт

	Константы.КИИ_ВключенныеПравилаПерсональныхДанных.Установить("EMAIL");
	Модель = СоздатьМодельПетли("masked", Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Маскировать);
	Почта = "tools.person@example.org";
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", "инструкция " + Почта));
	Сообщения.Добавить(Новый Структура("role, content", "user", "почта " + Почта));
	Вызовы = Новый Массив;
	Вызовы.Добавить(Новый Структура("Идентификатор, Имя, Аргументы", "call_config", "get_configuration_info", "{}"));
	Сообщения.Добавить(КИИ_АгентАнализа.СообщениеАссистентаСВызовамиДляТестов(Вызовы, ""));
	ИтогВызова = Новый Структура(
		"Идентификатор, Имя, Успех, Результат", "call_config", "get_configuration_info", Истина, Почта);
	Сообщения.Добавить(КИИ_АгентАнализа.СообщениеРезультатаИнструментаДляТестов("call_config", ИтогВызова, 2000));
	Корреляция = Строка(Новый УникальныйИдентификатор);

	Ответ = КИИ_КоннекторИИ.ЗапросКМоделиСообщениями(
		Модель, Сообщения, КИИ_АгентАнализа.СобратьИнструментыДляМодели(), Корреляция);
	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка, Ответ.ТекстОшибки).Равно(Ложь);
	Записи = ПрочитатьЖурналРаундов(Корреляция);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	Запись = Записи[0];
	ЮТест.ОжидаетЧто(Запись.ПользовательскийПромпт).Заполнено();
	ЮТест.ОжидаетЧто(Запись.СистемныйПромпт).Заполнено();
	ЮТест.ОжидаетЧто(Запись.ИсторияСообщенийJSON).Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ПользовательскийПромпт, Почта)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Запись.СистемныйПромпт, Почта)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Запись.ИсторияСообщенийJSON, Почта)).Равно(0);
	Контекст = ОбщегоНазначения.JSONВЗначение(Запись.ИсторияСообщенийJSON, , Ложь);
	КоличествоРезультатов = 0;
	Для Каждого Сообщение Из Контекст.messages Цикл
		Если Сообщение.role = "tool" Тогда
			КоличествоРезультатов = КоличествоРезультатов + 1;
			ЮТест.ОжидаетЧто(Сообщение.tool_call_id).Равно("call_config");
			ЮТест.ОжидаетЧто(Сообщение.content).Заполнено();
			ЮТест.ОжидаетЧто(Сообщение.content = Почта).Равно(Ложь);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(КоличествоРезультатов).Равно(1);
	ЮТест.ОжидаетЧто(Сообщения[0].content).Равно("инструкция " + Почта);
	ЮТест.ОжидаетЧто(Сообщения[3].content).Равно(Почта);

КонецПроцедуры

