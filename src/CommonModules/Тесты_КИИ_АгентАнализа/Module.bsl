// Проверяет, что включение инструментов не теряет историю обычного чата.
Процедура История_СохраняетПорядок() Экспорт
	История = Новый Массив;
	История.Добавить(Новый Структура("Роль, Текст", "user", "первый вопрос"));
	История.Добавить(Новый Структура("Роль, Текст", "assistant", "первый ответ"));
	Промпт = Новый Структура(
		"СистемныйПромпт, ПользовательскийПромпт, ИсторияСообщений", "инструкция", "уточнение", История);

	Сообщения = КИИ_АгентАнализа.НачальныеСообщенияДляТестов(Промпт);

	ЮТест.ОжидаетЧто(Сообщения.Количество()).Равно(4);
	ЮТест.ОжидаетЧто(Сообщения[0].content).Равно("инструкция");
	ЮТест.ОжидаетЧто(Сообщения[1].role).Равно("user");
	ЮТест.ОжидаетЧто(Сообщения[1].content).Равно("первый вопрос");
	ЮТест.ОжидаетЧто(Сообщения[2].role).Равно("assistant");
	ЮТест.ОжидаетЧто(Сообщения[2].content).Равно("первый ответ");
	ЮТест.ОжидаетЧто(Сообщения[3].content).Равно("уточнение");
КонецПроцедуры

