	База.Таймаут = 10;
	База.ИдентификаторБазы = ?(Вторая, "22222222-2222-2222-2222-222222222222", "11111111-1111-1111-1111-111111111111");
	База.Записать();
	Если Личная Тогда
		КИИ_ПодключенияКБазам.СохранитьЛичныйВход(База.Ссылка, База.Пользователь, "123456", "Заменить");
