Функция ПрочитатьЖурналРаундов(Знач Корреляция)

	// Читаем все сохранённые раунды одной операции для проверки содержимого журнала.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		| Лог.ПользовательскийПромпт КАК ПользовательскийПромпт,
		| Лог.СистемныйПромпт КАК СистемныйПромпт,
		| Лог.ИсторияСообщенийJSON КАК ИсторияСообщенийJSON,
		| Лог.ПричинаЗавершения КАК ПричинаЗавершения,
		| Лог.ЭтоОшибка КАК ЭтоОшибка,
		| Лог.ТекстОшибки КАК ТекстОшибки
		|ИЗ
		| РегистрСведений.КИИ_ЛогЗапросовИИ КАК Лог
		|ГДЕ
		| Лог.КорреляцияАгента = &Корреляция";
	Запрос.УстановитьПараметр("Корреляция", Корреляция);
	Возврат Запрос.Выполнить().Выгрузить();

