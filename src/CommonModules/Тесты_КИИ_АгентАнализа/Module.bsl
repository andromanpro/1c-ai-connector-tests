// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit для подсистемы инструментального анализа (КИИ_АгентАнализа).
// Все тесты сетевно-независимы: реестр инструментов и whitelist - локальная логика.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("АгентАнализа")
			.ДобавитьСерверныйТест("Каталог_ДефолтныйБезPing")
			.ДобавитьСерверныйТест("Каталог_ExecuteQuery_ПодсказкаСинтаксиса1С")
			.ДобавитьСерверныйТест("Каталог_Whitelist_Фильтрует")
			.ДобавитьСерверныйТест("Каталог_НевалидныйWhitelist_FailClosed")
			.ДобавитьСерверныйТест("Вызов_ВнеWhitelist_FailClosed")
			.ДобавитьСерверныйТест("Опции_ДефолтныеЗначения")
			.ДобавитьСерверныйТест("Хелпер_АссистентСВызовами_ContentИСписок")
			.ДобавитьСерверныйТест("Хелпер_РезультатИнструмента_ПривязкаКВызову")
			.ДобавитьСерверныйТест("Хелпер_Обрезка_ВалидныйJSONКонверт")
			.ДобавитьСерверныйТест("Хелпер_НачальныеСообщения_СистемаИПользователь");

КонецПроцедуры

#КонецОбласти

#Область ТестыКаталога

// Дефолтный каталог: 4 инструмента, ping отфильтрован (бесполезен для анализа).
Процедура Каталог_ДефолтныйБезPing() Экспорт

	Инструменты = КИИ_АгентАнализа.СобратьИнструментыДляМодели();

	ЮТест.ОжидаетЧто(Инструменты.Количество()).Равно(4);

	Имена = ИменаИнструментов(Инструменты);
	ЮТест.ОжидаетЧто(Имена.Найти("ping") = Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Имена.Найти("execute_query") <> Неопределено).Равно(Истина);
	ЮТест.ОжидаетЧто(Имена.Найти("get_metadata_tree") <> Неопределено).Равно(Истина);

КонецПроцедуры

// Описание execute_query дополнено подсказкой синтаксиса 1С (модель по умолчанию пишет SQL).
Процедура Каталог_ExecuteQuery_ПодсказкаСинтаксиса1С() Экспорт

	Инструменты = КИИ_АгентАнализа.СобратьИнструментыДляМодели();
	Описание = ОписаниеИнструмента(Инструменты, "execute_query");

	ЮТест.ОжидаетЧто(Описание).Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(Описание, "ВЫБРАТЬ") > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Описание, "SQL") > 0).Равно(Истина);

КонецПроцедуры

// Whitelist ограничивает набор: просим один инструмент - получаем только его.
Процедура Каталог_Whitelist_Фильтрует() Экспорт

	Whitelist = Новый Массив;
	Whitelist.Добавить("get_configuration_info");

	Инструменты = КИИ_АгентАнализа.СобратьИнструментыДляМодели(Whitelist);

	ЮТест.ОжидаетЧто(Инструменты.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ОписаниеИнструмента(Инструменты, "get_configuration_info")).Заполнено();

КонецПроцедуры

// Мусорный whitelist (не массив и не "не задано") - fail-closed: пустой каталог,
// а не молчаливое расширение до дефолтного набора с execute_query.
Процедура Каталог_НевалидныйWhitelist_FailClosed() Экспорт

	Инструменты = КИИ_АгентАнализа.СобратьИнструментыДляМодели("не массив");

	ЮТест.ОжидаетЧто(Инструменты.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ТестыДиспатча

// Инструмент вне whitelist отвергается fail-closed: Успех=Ложь, реестр не вызывается.
Процедура Вызов_ВнеWhitelist_FailClosed() Экспорт

	Вызов = Новый Структура("Идентификатор, Имя, Аргументы", "call_1", "drop_table", "{}");

	Итог = КИИ_АгентАнализа.ВыполнитьВызовИнструмента(Вызов);

	ЮТест.ОжидаетЧто(Итог.Успех).Равно(Ложь);
	ЮТест.ОжидаетЧто(СтрНайти(Строка(Итог.Результат), "не разрешен") > 0).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыОпций

// Опции по умолчанию: разумные пределы петли.
Процедура Опции_ДефолтныеЗначения() Экспорт

	Опции = КИИ_АгентАнализа.ОпцииПоУмолчанию();

	ЮТест.ОжидаетЧто(Опции.МаксРаундов).Равно(5);
	ЮТест.ОжидаетЧто(Опции.МаксВызововИнструментов).Равно(10);
	ЮТест.ОжидаетЧто(Опции.МаксСимволовРезультата).Равно(2000);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хелпер петли: assistant-сообщение сохраняет текст модели и все tool_calls по порядку.
Процедура Хелпер_АссистентСВызовами_ContentИСписок() Экспорт

	Вызовы = Новый Массив;
	Вызовы.Добавить(Новый Структура("Идентификатор, Имя, Аргументы", "call_1", "ping", "{}"));
	Вызовы.Добавить(Новый Структура("Идентификатор, Имя, Аргументы", "call_2", "execute_query", "{""limit"":1}"));

	Сообщение = КИИ_АгентАнализа.СообщениеАссистентаСВызовамиДляТестов(Вызовы, "промежуточная мысль");

	ЮТест.ОжидаетЧто(Сообщение.role).Равно("assistant");
	ЮТест.ОжидаетЧто(Сообщение.content).Равно("промежуточная мысль");
	ЮТест.ОжидаетЧто(Сообщение.tool_calls.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Сообщение.tool_calls[0].id).Равно("call_1");
	ЮТест.ОжидаетЧто(Сообщение.tool_calls[1].function.name).Равно("execute_query");

КонецПроцедуры

// Хелпер петли: tool-ответ ссылается ровно на переданный tool_call_id.
Процедура Хелпер_РезультатИнструмента_ПривязкаКВызову() Экспорт

	ИтогВызова = Новый Структура("Идентификатор, Имя, Успех, Результат", "call_9", "ping", Истина, "ok");

	Сообщение = КИИ_АгентАнализа.СообщениеРезультатаИнструментаДляТестов("call_9", ИтогВызова, 100);

	ЮТест.ОжидаетЧто(Сообщение.role).Равно("tool");
	ЮТест.ОжидаетЧто(Сообщение.tool_call_id).Равно("call_9");
	ЮТест.ОжидаетЧто(Сообщение.content).Равно("ok");

КонецПроцедуры

// Хелпер петли: усечение отдает ВАЛИДНЫЙ JSON-конверт {truncated, preview}, а не рваный фрагмент.
Процедура Хелпер_Обрезка_ВалидныйJSONКонверт() Экспорт

	Длинный = "";
	Для Ном = 1 По 50 Цикл
		Длинный = Длинный + "0123456789";
	КонецЦикла;
	ИтогВызова = Новый Структура("Идентификатор, Имя, Успех, Результат", "c", "t", Истина, Длинный);

	Текст = КИИ_АгентАнализа.ОбрезатьРезультатИнструментаДляТестов(ИтогВызова, 100);

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Конверт = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ЮТест.ОжидаетЧто(Конверт.truncated).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрДлина(Конверт.preview)).Равно(100);

КонецПроцедуры

// Хелпер петли: начальные messages содержат system (если задан) и user в правильном порядке.
Процедура Хелпер_НачальныеСообщения_СистемаИПользователь() Экспорт

	Промпт = Новый Структура("СистемныйПромпт, ПользовательскийПромпт", "система", "задача");

	Сообщения = КИИ_АгентАнализа.НачальныеСообщенияДляТестов(Промпт);

	ЮТест.ОжидаетЧто(Сообщения.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Сообщения[0].role).Равно("system");
	ЮТест.ОжидаетЧто(Сообщения[0].content).Равно("система");
	ЮТест.ОжидаетЧто(Сообщения[1].role).Равно("user");
	ЮТест.ОжидаетЧто(Сообщения[1].content).Равно("задача");

КонецПроцедуры

// Массив имен инструментов из OpenAI-каталога.
Функция ИменаИнструментов(Знач Инструменты)

	Имена = Новый Массив;
	Для Каждого Инструмент Из Инструменты Цикл
		Имена.Добавить(Инструмент.function.name);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Описание инструмента по имени (пустая строка, если не найден).
Функция ОписаниеИнструмента(Знач Инструменты, Знач ИмяИнструмента)

	Для Каждого Инструмент Из Инструменты Цикл
		Если Инструмент.function.name = ИмяИнструмента Тогда
			Возврат Инструмент.function.description;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
