Процедура Сеть_ОшибкаЗапросаСохраняетДиагностику() Экспорт

	Попытка
		Результат = КИИ_УдаленныеБазыMCP.ВыполнитьИнструмент(
			СоединениеФикстуры("query-error"), "execute_query", АргументыФикстуры());
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;
	Ошибка = КИИ_СерверMCPДиспетчер.ДанныеОшибкиИнструмента(ДанныеОшибки);
	ЮТест.ОжидаетЧто(Ошибка.code).Равно("query_failed");
	ЮТест.ОжидаетЧто(Ошибка.message).Содержит("НетТакогоПоля");
	ЮТест.ОжидаетЧто(Ошибка.correlation_id).Равно("18918918-9189-4189-8189-189189189189");

КонецПроцедуры

Функция СоединениеФикстуры(
	Знач Маршрут, Знач Пользователь = "reader-a", Знач ИдентификаторБазы = "11111111-1111-1111-1111-111111111111")
	Результат = Новый Структура;
	Результат.Вставить("Адрес", "http://127.0.0.1:8874/" + Маршрут + "/hs/iikona-mcp/connection");
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Пароль", "123456");
	Результат.Вставить("Таймаут", 10);
	Результат.Вставить("ИдентификаторБазы", ИдентификаторБазы);
	Возврат Результат;
КонецФункции

Функция АргументыФикстуры()
	Возврат Новый Структура(
		"query_id, query_text, limit, params", "same_query", "ВЫБРАТЬ 1 КАК Value", 1, Новый Структура);
КонецФункции
