Процедура Сеть_ИсточникиНеСмешиваются() Экспорт
	Аргументы = АргументыФикстуры();
	ОтветА = КИИ_УдаленныеБазыMCP.ВыполнитьИнструмент(СоединениеФикстуры("source-a"), "execute_query", Аргументы);
	ОтветБ = КИИ_УдаленныеБазыMCP.ВыполнитьИнструмент(
		СоединениеФикстуры("source-b", "reader-b", "22222222-2222-2222-2222-222222222222"), "execute_query", Аргументы);
	ПовторА = КИИ_УдаленныеБазыMCP.ВыполнитьИнструмент(СоединениеФикстуры("source-a"), "execute_query", Аргументы);
	ЮТест.ОжидаетЧто(ОтветА.rows[0][0]).Равно(11);
	ЮТест.ОжидаетЧто(ОтветБ.rows[0][0]).Равно(22);
	ЮТест.ОжидаетЧто(ПовторА.rows[0][0]).Равно(11);
КонецПроцедуры

