Процедура ПодготовитьДанныеЖурнала() Экспорт

	ЮТест.ОжидаетЧто(РольДоступна("ПолныеПрава")).Равно(Истина);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Ложь);
	Описание = ФикстураПользователя();
	ЮТест.ОжидаетЧто(Описание.Режим).Равно("подготовка");
	РежимДоПроверки = ПривилегированныйРежим();
	ПроверитьВнешнийРежимMCP(Описание.ПользовательAPI);
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(РежимДоПроверки);
	Модель = Справочники.КИИ_МоделиИИ.СоздатьЭлемент();
	Модель.Заполнить(Неопределено);
	СсылкаМодели = Справочники.КИИ_МоделиИИ.ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.ИдентификаторМодели));
	Модель.УстановитьСсылкуНового(СсылкаМодели);
	Модель.Наименование = Описание.Метка;
	Модель.НаименованиеПолное = "legacy-fixture";
	Модель.Адрес = "localhost:8873";
	Модель.АдресЗапроса = "/k09rights";
	Модель.ТипФорматаAPI = Перечисления.КИИ_ТипыФорматовAPI.OpenAI_Compatible;
	Модель.ИспользоватьЗащищенноеСоединение = Ложь;
	Модель.ИспользоватьПрокси = Ложь;
	Модель.Таймаут = 5;
	Модель.Температура = 0;
	Модель.МаксимумТокенов = 128;
	Модель.СрокЖизниКеша = 0;
	Модель.РежимКонтроляПерсональныхДанных = Перечисления.КИИ_РежимыКонтроляПерсональныхДанных.Выключен;
	НачатьТранзакцию();
	Попытка
		Модель.Записать();
		Для Каждого ОписаниеЗаписи Из Описание.Записи Цикл
			ЗаписатьПробнуюЗапись(ОписаниеЗаписи.Идентификатор, ОписаниеЗаписи.Владелец, Описание.ДатаЗаписи);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Для Каждого ОписаниеЗаписи Из Описание.Записи Цикл
		ЮТест.ОжидаетЧто(КоличествоВидимыхЗаписей(ОписаниеЗаписи.Идентификатор)).Равно(1);
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьДанныеЖурнала() Экспорт

	ЮТест.ОжидаетЧто(РольДоступна("ПолныеПрава")).Равно(Истина);
	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Ложь);
	Описание = ФикстураПользователя();
	ЮТест.ОжидаетЧто(Описание.Режим).Равно("подготовка");
	СсылкаМодели = Справочники.КИИ_МоделиИИ.ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.ИдентификаторМодели));
	Для Каждого ОписаниеЗаписи Из Описание.Записи Цикл
		УдалитьПробнуюЗапись(ОписаниеЗаписи.Идентификатор, Описание.ДатаЗаписи);
	КонецЦикла;
	Для Каждого ИмяИспытуемого Из Описание.Испытуемые Цикл
		РезультатВызова = ХранилищеОбщихНастроек.Загрузить("КИИ_АудитK09", "РезультатВызова", , ИмяИспытуемого);
		Если РезультатВызова <> Неопределено Тогда
			ЮТест.ОжидаетЧто(РезультатВызова.Метка).Равно(Описание.Метка);
			УдалитьПробнуюЗапись(РезультатВызова.Идентификатор, РезультатВызова.ДатаЗаписи);
			ХранилищеОбщихНастроек.Удалить("КИИ_АудитK09", "РезультатВызова", ИмяИспытуемого);
		КонецЕсли;
	КонецЦикла;
	Если ОбщегоНазначения.СсылкаСуществует(СсылкаМодели) Тогда
		Модель = СсылкаМодели.ПолучитьОбъект();
		ЮТест.ОжидаетЧто(Модель.Наименование).Равно(Описание.Метка);
		Модель.Удалить();
	КонецЕсли;
	Для Каждого ОписаниеЗаписи Из Описание.Записи Цикл
		ЮТест.ОжидаетЧто(КоличествоВидимыхЗаписей(ОписаниеЗаписи.Идентификатор)).Равно(0);
	КонецЦикла;

КонецПроцедуры

