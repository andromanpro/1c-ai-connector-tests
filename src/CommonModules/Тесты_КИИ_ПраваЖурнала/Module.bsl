Процедура ЧтениеНастроекTelegramОграниченоПравом() Экспорт
	Описание = ФикстураПользователя();
	ХешДо = ХешСостоянияTelegramДляПроверки();
	Если Не ПравоДоступа("Чтение", Метаданные.Константы.КИИ_МониторингОшибокНастройки)
		Или Не ПравоДоступа("Чтение", Метаданные.Константы.КИИ_МониторингОшибокМодельАнализа) Тогда
		Ожидание = ЮТест.ОжидаетЧто(Тесты_КИИ_ПраваЖурнала);
		Ожидание.Метод("ПробаЧтенияНастроекTelegram");
		Ожидание.ВыбрасываетИсключение("прав");
	Иначе
		Настройки = ПробаЧтенияНастроекTelegram();
		Если Описание.УправлениеМониторингом Тогда
			Совпало = Настройки.ТокенБотаТелеграм = Описание.ТокенTelegram
				И Настройки.ChatIDТелеграм = Описание.ЧатTelegram;
			ЮТест.ОжидаетЧто(Совпало, "Администратор должен получить тестовые реквизиты").Равно(Истина);
		Иначе
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Настройки.ТокенБотаТелеграм), "Секрет выдан обычному пользователю").Равно(
				Ложь);
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Настройки.ChatIDТелеграм)).Равно(Ложь);
		КонецЕсли;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ХешСостоянияTelegramДляПроверки(), "Чтение не должно менять настройки или секреты").Равно(ХешДо);
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
