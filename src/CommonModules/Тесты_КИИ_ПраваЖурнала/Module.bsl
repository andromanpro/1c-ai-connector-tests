Процедура ПраваМетодовHTTPСоответствуютПрофилю() Экспорт
	Описание = ФикстураПользователя();
	ЮТест.ОжидаетЧто(РольДоступна("ПолныеПрава")).Равно(Ложь);
	ОжидаетсяДоступ = Описание.Режим = "diagnostic";
	ДоступHealth = ПравоДоступа("Использование", Метаданные.HTTPСервисы.КИИ_СерверMCPAPI.ШаблоныURL.health.Методы.GET);
	ДоступRPC = ПравоДоступа("Использование", Метаданные.HTTPСервисы.КИИ_СерверMCPAPI.ШаблоныURL.rpc.Методы.POST);
	Подробности = "health.GET=" + ?(ДоступHealth, "1", "0") + "; rpc.POST=" + ?(ДоступRPC, "1", "0");
	ЮТест.ОжидаетЧто(ДоступHealth = ОжидаетсяДоступ И ДоступRPC = ОжидаетсяДоступ, Подробности).Равно(Истина);
КонецПроцедуры

Процедура АутентификацияMCPВПрофиле() Экспорт
	Описание = ФикстураПользователя();
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	Заголовок = ЗаголовокАутентификацииMCP(Описание.ПользовательAPI, "123456");
	Если Описание.Режим = "diagnostic" Тогда
		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(Заголовок);
		ЮТест.ОжидаетЧто(Результат.Авторизован, Результат.Причина).Равно(Истина);
		ЮТест.ОжидаетЧто(Результат.Причина).Равно("ok");
		ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(ЗаголовокАутентификацииMCP(Описание.ПользовательAPI, "wrong"));
		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
		ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(ЗаголовокАутентификацииMCP("another-api-user", "123456"));
		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
		ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	Иначе
		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(Заголовок);
		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
		ЮТест.ОжидаетЧто(Результат.Причина).Равно("credentials_not_configured");
	КонецЕсли;
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	Ожидание = ЮТест.ОжидаетЧто(Тесты_КИИ_ПраваЖурнала);
	Ожидание.Метод("ПрямоеЧтениеИмениAPIMCP");
	Ожидание.ВыбрасываетИсключение("прав");
	Ожидание = ЮТест.ОжидаетЧто(Тесты_КИИ_ПраваЖурнала);
	Ожидание.Метод("ПрямоеЧтениеПароляAPIMCP");
	Ожидание.ВыбрасываетИсключение("прав");
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

Процедура ОбычныйВызовМоделиЗаписываетВладельца() Экспорт

	Описание = ФикстураПользователя();
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
	СсылкаМодели = Справочники.КИИ_МоделиИИ.ПолучитьСсылку(Новый УникальныйИдентификатор(Описание.ИдентификаторМодели));
	Промпт = СтрШаблон("Проверка журнала K09 без персональных данных: %1", Описание.Метка);
	Ответ = КИИ_КоннекторИИ.ЗапросКМодели(СсылкаМодели, Промпт, , Ложь);
	ИдентификаторОтвета = Строка(Ответ.Идентификатор);
	РезультатВызова = Новый Структура(
		"Метка, Идентификатор, ДатаЗаписи", Описание.Метка, ИдентификаторОтвета, Ответ.УниверсальнаяДатаВМиллисекундах);
	ХранилищеОбщихНастроек.Сохранить("КИИ_АудитK09", "РезультатВызова", РезультатВызова);
	ЮТест.ОжидаетЧто(Ответ.ЭтоОшибка, Ответ.ТекстОшибки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.ТекстОтвета).Равно("Совместимость подтверждена");
	ЮТест.ОжидаетЧто(КоличествоВидимыхЗаписей(ИдентификаторОтвета)).Равно(1);
	ЗапросВладельца = Новый Запрос;
