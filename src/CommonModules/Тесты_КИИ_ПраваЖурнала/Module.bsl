Процедура ПроверитьИзменениеСекретовTelegram(Знач ИмяМетода)
	Описание = ФикстураПользователя();
	ХешДо = ХешСостоянияTelegramДляПроверки();
	Разрешено = Описание.УправлениеМониторингом;
	Если ИмяМетода = "ПробаСохраненияНастроекTelegram" Тогда
		Разрешено = Описание.СохранениеМониторинга;
	КонецЕсли;
	Если Разрешено Тогда
		Если ИмяМетода = "ПробаЗаписиТокенаTelegram" Тогда
			ПробаЗаписиТокенаTelegram();
		ИначеЕсли ИмяМетода = "ПробаЗаписиЧатаTelegram" Тогда
			ПробаЗаписиЧатаTelegram();
		Иначе
			ПробаСохраненияНастроекTelegram();
		КонецЕсли;
		ЮТест.ОжидаетЧто(ХешСостоянияTelegramДляПроверки() <> ХешДо).Равно(Истина);
	Иначе
		Ожидание = ЮТест.ОжидаетЧто(Тесты_КИИ_ПраваЖурнала);
		Ожидание.Метод(ИмяМетода);
		Ожидание.ВыбрасываетИсключение("прав");
		ЮТест.ОжидаетЧто(ХешСостоянияTelegramДляПроверки(), "Отказ не должен оставлять частичные изменения секретов или настроек").Равно(
			ХешДо);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ПривилегированныйРежим()).Равно(Ложь);
КонецПроцедуры

Функция ХешСостоянияTelegramДляПроверки()
	// Только тестовая оснастка: читает фиксированные данные для утверждения об отсутствии записи.
	// Реальные реквизиты заранее заменены синтетическими; наружу возвращается только хеш.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Данные = Новый Структура;
		Данные.Вставить(
			"Хранилище", ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("КИИ_МониторингОшибок", Неопределено));
		Данные.Вставить("Настройки", Константы.КИИ_МониторингОшибокНастройки.Получить());
		Данные.Вставить("Модель", Константы.КИИ_МониторингОшибокМодельАнализа.Получить());
		Сериализовано = ЗначениеВСтрокуВнутр(Данные);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Сериализовано);
	Возврат Base64Строка(Хеширование.ХешСумма);
КонецФункции

