Процедура Признаки_ЛегкаяИПолнаяПроверки_Совпадают() Экспорт

	Данные = СоздатьГотовуюБазу(16);
	Легкая = КИИ_RAG.СведенияДляПроверкиПоиска(Неопределено, Данные.База, Неопределено, Данные.Модель);
	Базы = Новый Массив;
	Базы.Добавить(Данные.База);
	Полная = КИИ_RAG.СведенияОбИндексахБаз(Базы, Данные.Модель).Получить(Данные.База);
