	ЮТест.ОжидаетЧто(Итог.Завершено).Равно(Истина);
	ЮТест.ОжидаетЧто(Итог.Эмбеддинги.УжеГотово).Равно(Данные.Количество);
	ЮТест.ОжидаетЧто(Итог.Эмбеддинги.Обновлено).Равно(0);
