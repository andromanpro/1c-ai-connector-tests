#Область СлужебныеПроцедурыИФункции

Процедура ИзмеритьГотовуюБазу(Знач Абзацев, Знач Этап)

	Данные = СоздатьГотовуюБазу(Абзацев);
	ЮТест.ОжидаетЧто(КИИ_RAG.ТекущаяМодельЭмбеддер()).Равно(Данные.Модель);
	Для Номер = 0 По 3 Цикл
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Этап = "search_preparation" Тогда
			Результат = КИИ_RAG.СведенияДляПроверкиПоиска(Неопределено, Данные.База, Неопределено, Данные.Модель);
		Иначе
			Результат = КИИ_RAG.ОбновитьЭмбеддингиБазы(Данные.База);
		КонецЕсли;
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Если Этап = "search_preparation" Тогда
			ЮТест.ОжидаетЧто(Результат.Статус).Равно("ОК");
			ЮТест.ОжидаетЧто(Результат.Готово).Равно(Данные.Количество);
			ЮТест.ОжидаетЧто(Результат.ГотовыеФрагменты.Количество()).Равно(Данные.Количество);
		Иначе
			ЮТест.ОжидаетЧто(Результат.Статус).Равно("Успешно");
			ЮТест.ОжидаетЧто(Результат.УжеГотово).Равно(Данные.Количество);
			ЮТест.ОжидаетЧто(Результат.Обновлено).Равно(0);
			ЮТест.ОжидаетЧто(Результат.Ошибок).Равно(0);
		КонецЕсли;
		Замер = Новый Структура;
		Замер.Вставить("stage", Этап);
		Замер.Вставить("paragraphs", Абзацев);
		Замер.Вставить("fragments", Данные.Количество);
		Замер.Вставить("dimensions", 1536);
		Замер.Вставить("text_chars", Данные.ДлинаТекста);
		Замер.Вставить("sample", Номер);
		Замер.Вставить("warmup", Номер = 0);
		Замер.Вставить("elapsed_ms", Длительность);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Замер);
		ЮТЛогирование.Информация("K06_K07_MEASURE " + Запись.Закрыть());
	КонецЦикла;

КонецПроцедуры

Функция СоздатьГотовуюБазу(Знач Абзацев)

	ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Истина);
	РеквизитыМодели = Новый Структура;
	РеквизитыМодели.Вставить("НаименованиеПровайдера", "k06-local");
	РеквизитыМодели.Вставить("НаименованиеПолное", "fixture-1536");
	РеквизитыМодели.Вставить("ТипМодели", Перечисления.КИИ_ТипыМоделей.Эмбеддинг);
	РеквизитыМодели.Вставить("РазмерностьЭмбеддинга", 1536);
	РеквизитыМодели.Вставить("Адрес", "http://127.0.0.1:1");
	Модель = ЮТТестовыеДанные.СоздатьЭлемент(
		Справочники.КИИ_МоделиИИ, "000 K06 K07 local measurement", РеквизитыМодели);
	Слова = Новый Массив;
	Для Индекс = 1 По 160 Цикл
		Слова.Добавить("синтетический");
	КонецЦикла;
	Абзац = СтрСоединить(Слова, " ");
	Части = Новый Массив;
	Для Индекс = 1 По Абзацев Цикл
		Части.Добавить(Строка(Индекс) + ". " + Абзац + ".");
	КонецЦикла;
	Текст = СтрСоединить(Части, Символы.ПС + Символы.ПС);
	РеквизитыБазы = Новый Структура("Содержимое", Текст);
	База = ЮТТестовыеДанные.СоздатьЭлемент(Справочники.КИИ_БазаЗнаний, "K06 K07 synthetic measurement", РеквизитыБазы);
	ИтогНарезки = КИИ_RAG.ПереиндексироватьБазу(База);
	ЮТест.ОжидаетЧто(ИтогНарезки.Ошибок).Равно(0);
	Вектор = Новый Массив;
	Для Индекс = 1 По 1536 Цикл
		Вектор.Добавить(1);
	КонецЦикла;
	Вектор = КИИ_RAG.НормализоватьВектор(Вектор);
	Фрагменты = Новый Массив;
	Запрос = Новый Запрос;
	// Получаем только ссылки на фрагменты, созданные штатной переиндексацией.
	Запрос.Текст =
		"ВЫБРАТЬ
		| Ф.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.КИИ_ФрагментыЗнаний КАК Ф
		|ГДЕ
		| Ф.Владелец = &База
		| И НЕ Ф.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| Ф.НомерФрагмента";
	Запрос.УстановитьПараметр("База", База);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Эмбеддинг = Новый ХранилищеЗначения(Вектор);
		Объект.Размерность = 1536;
		Объект.КодМоделиЭмбеддинга = "k06-local:fixture-1536";
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Объект.Записать();
		Фрагменты.Добавить(Объект.Ссылка);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Фрагменты.Количество() > 0).Равно(Истина);
	Результат = Новый Структура;
	Результат.Вставить("База", База);
	Результат.Вставить("Модель", Модель);
	Результат.Вставить("Фрагменты", Фрагменты);
	Результат.Вставить("Количество", Фрагменты.Количество());
	Результат.Вставить("ДлинаТекста", СтрДлина(Текст));
	Возврат Результат;

КонецФункции

Функция СоздатьСтарыйГотовыйИндекс()

	Данные = СоздатьГотовуюБазу(1);
	База = Данные.База.ПолучитьОбъект();
	База.МодельИндекса = Данные.Модель;
	База.ОбменДанными.Загрузка = Истина;
	База.Записать();
	Для Каждого СсылкаФрагмента Из Данные.Фрагменты Цикл
		Фрагмент = СсылкаФрагмента.ПолучитьОбъект();
		Фрагмент.ОбменДанными.Загрузка = Истина;
		Фрагмент.Записать();
	КонецЦикла;
	Возврат Данные;

КонецФункции

Функция СнимокИсходныхПолейИндекса(Знач Данные)

	База = Данные.База.ПолучитьОбъект();
	Снимок = Новый Массив;
	Снимок.Добавить(
		Новый Структура(
			"Содержимое, Наименование, Дата, Модель",
			База.Содержимое,
			База.Наименование,
			База.ДатаОбновления,
			База.МодельИндекса
		)
	);
	Для Каждого СсылкаФрагмента Из Данные.Фрагменты Цикл
		Фрагмент = СсылкаФрагмента.ПолучитьОбъект();
		СтрокаСнимка = Новый Структура;
		ИменаРеквизитов = "Код,Наименование,Владелец,НомерФрагмента,ТекстФрагмента,ХешТекстаФрагмента,"
			+ "КодМоделиЭмбеддинга,ДатаОбновления,Размерность,НормаИсходная,ПометкаУдаления";
		РеквизитыФрагмента = СтрРазделить(ИменаРеквизитов, ",");
		Для Каждого ИмяРеквизита Из РеквизитыФрагмента Цикл
			СтрокаСнимка.Вставить(ИмяРеквизита, Фрагмент[ИмяРеквизита]);
		КонецЦикла;
		СтрокаСнимка.Вставить("Вектор", Фрагмент.Эмбеддинг.Получить());
		Снимок.Добавить(СтрокаСнимка);
	КонецЦикла;
	Возврат ЗначениеВСтрокуВнутр(Снимок);

КонецФункции

#КонецОбласти

