Функция СообщениеДиалогаПоРоли(Форма, Роль)
	ОтборСообщений = Новый Структура("Роль", Роль);
	Сообщения = Форма.ИсторияДиалога.НайтиСтроки(ОтборСообщений);
	ЮТест.ОжидаетЧто(Сообщения.Количество(), "В истории ожидается одно сообщение указанной роли").Равно(1);
	Возврат Сообщения[0];
КонецФункции

Функция ПолучитьОтветВФорме(Знач Режим)
	ИсходнаяФорма = НоваяФормаЧата();
	Диалог = ИсходнаяФорма.ИдентификаторДиалога;
	Запрос = Тесты_КИИ_ФормыМоделейВызовСервера.НачатьЗапросБеседыПроверкиФорм(Диалог);
	Тесты_КИИ_ФормыМоделейВызовСервера.ЗавершитьЗапросБеседыПроверкиФорм(Диалог, Запрос, Режим);
	Форма = ФормаСохраненнойБеседы(Диалог);
	Возврат Форма;
КонецФункции

Процедура Чат_ОтказИсточникаНеДублируется() Экспорт
    Для Каждого Режим Из СтрРазделить("ОшибкаИсточника,ОтказИсточникаИDSML", ",") Цикл
        ИсходнаяФорма = НоваяФормаЧата();
        Диалог = ИсходнаяФорма.ИдентификаторДиалога;
        Запрос = Тесты_КИИ_ФормыМоделейВызовСервера.НачатьЗапросБеседыПроверкиФорм(Диалог);
        Тесты_КИИ_ФормыМоделейВызовСервера.ЗавершитьЗапросБеседыПроверкиФорм(Диалог, Запрос, Режим);
        Тесты_КИИ_ФормыМоделейВызовСервера.ЗавершитьЗапросБеседыПроверкиФорм(Диалог, Запрос, Режим);
        Форма = ФормаСохраненнойБеседы(Диалог);
        ЮТест.ОжидаетЧто(Форма.ИсторияДиалога.Количество()).Равно(3);
        ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Роль).Равно("error");
        ЮТест.ОжидаетЧто(СтрНайти(Форма.ИсторияДиалога[1].Текст, "11_5_new_fixture") > 0).Равно(Истина);
        ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[2].Роль).Равно(?(Режим = "ОшибкаИсточника", "assistant", "error"));
    КонецЦикла;
КонецПроцедуры

Процедура Чат_ОтказИсточникаПоказанОтдельно() Экспорт
    Форма = ПолучитьОтветВФорме("ОшибкаИсточника");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога.Количество()).Равно(3);
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Роль).Равно("error");
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ИсторияДиалога[1].Текст, "11_5_new_fixture") > 0).Равно(Истина);
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[2].Роль).Равно("assistant");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[2].Текст).Равно("Проверочный ответ");
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ОтветHTML, "11_5_new_fixture") > 0).Равно(Истина);
КонецПроцедуры

