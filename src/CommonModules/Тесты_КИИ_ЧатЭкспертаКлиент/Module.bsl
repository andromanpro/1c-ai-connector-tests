Функция ПолучитьОтветВФорме(Знач Режим)
	Форма = ПолучитьФорму("Обработка.КИИ_ТестИИ.Форма.Форма", , , Новый УникальныйИдентификатор);
	Адрес = Тесты_КИИ_ФормыМоделейВызовСервера.ПодготовитьРезультатЧата(Форма.УникальныйИдентификатор, Режим);
	Завершение = Новый Структура("Статус, АдресРезультата", "Выполнено", Адрес);
	Форма.ОбработатьЗавершениеФоновогоЗадания(Завершение, Неопределено);
	Возврат Форма;
КонецФункции

Процедура Чат_ОтказИсточникаПоказанОтдельно() Экспорт
    Форма = ПолучитьОтветВФорме("ОшибкаИсточника");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога.Количество()).Равно(2);
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[0].Роль).Равно("error");
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ИсторияДиалога[0].Текст, "11_5_new_fixture") > 0).Равно(Истина);
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Роль).Равно("assistant");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Текст).Равно("Проверочный ответ");
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ОтветHTML, "11_5_new_fixture") > 0).Равно(Истина);
КонецПроцедуры

Процедура Чат_ОтказИсточникаСохраненПриОшибкеМодели() Экспорт
    Форма = ПолучитьОтветВФорме("ОтказИсточникаИDSML");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога.Количество()).Равно(2);
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[0].Роль).Равно("error");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Роль).Равно("error");
    ЮТест.ОжидаетЧто(Форма.ИсторияДиалога[1].Текст).Равно("Модель вернула служебные команды текстом вместо ответа.");
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ОтветHTML, "function_calls")).Равно(0);
    ЮТест.ОжидаетЧто(СтрНайти(Форма.ОтветHTML, "11_5_new_fixture") > 0).Равно(Истина);
КонецПроцедуры

