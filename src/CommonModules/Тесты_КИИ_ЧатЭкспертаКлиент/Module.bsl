#Область ЖизненныйЦиклБесед

Процедура ПослеКаждогоТеста() Экспорт
	Контекст = КонтекстПроверкиБесед();
    Если Контекст.ФормыПроверок <> Неопределено Тогда
        Для Каждого ФормаПроверки Из Контекст.ФормыПроверок Цикл
            Если ФормаПроверки.Открыта() Тогда
                ФормаПроверки.Закрыть();
                Если ФормаПроверки.Открыта() Тогда
                    ВызватьИсключение "Проверочная форма не закрылась; данные не удаляются";
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Контекст.ДиалогиФормПроверки <> Неопределено Тогда
        Тесты_КИИ_ФормыМоделейВызовСервера.УдалитьБеседыПроверокФорм(Контекст.ДиалогиФормПроверки);
    КонецЕсли;
    Контекст.ФормыПроверок = Неопределено;
    Контекст.ДиалогиФормПроверки = Неопределено;
КонецПроцедуры

Функция НоваяФормаЧата()
	Контекст = КонтекстПроверкиБесед();
    Если Контекст.ДиалогиФормПроверки = Неопределено Тогда
        Контекст.ДиалогиФормПроверки = Новый Массив;
        Контекст.ФормыПроверок = Новый Массив;
    КонецЕсли;
    Диалог = Тесты_КИИ_ФормыМоделейВызовСервера.СоздатьБеседуПроверкиФорм();
    Контекст.ДиалогиФормПроверки.Добавить(Диалог);
    Форма = ФормаСохраненнойБеседы(Диалог);
    Возврат Форма;
КонецФункции

Функция ФормаСохраненнойБеседы(Диалог)
	Контекст = КонтекстПроверкиБесед();
    Параметры = Новый Структура("Диалог", Диалог);
    Форма = ПолучитьФорму("Обработка.КИИ_ТестИИ.Форма.Форма", Параметры, , Новый УникальныйИдентификатор);
    Контекст.ФормыПроверок.Добавить(Форма);
    Возврат Форма;
КонецФункции

Процедура Беседы_ЧерновикВосстанавливаетсяПослеЗакрытия() Экспорт
    Форма = НоваяФормаЧата();
    Диалог = Форма.ИдентификаторДиалога;
    Форма.Открыть();
    Форма.Промпт = "Черновик после закрытия";
    Форма.Закрыть();
    ПовторнаяФорма = ФормаСохраненнойБеседы(Диалог);
    ЮТест.ОжидаетЧто(ПовторнаяФорма.Промпт).Равно("Черновик после закрытия");
