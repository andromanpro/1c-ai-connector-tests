КонецПроцедуры

Процедура ПроверитьПолучениеФормыМодели(Знач Настроить, Знач Выбрать, Знач ОжидаетсяОтметок)
	Модель = Тесты_КИИ_ФормыМоделейВызовСервера.СоздатьМодельФормы(Настроить, Выбрать);
	Форма = Неопределено;
	Попытка
		ОшибкаПолучения = "";
		Попытка
			Форма = ПолучитьФорму("Справочник.КИИ_МоделиИИ.Форма.ФормаЭлемента", Новый Структура("Ключ", Модель));
		Исключение
			ОшибкаПолучения = ИнформацияОбОшибке().Описание;
		КонецПопытки;
		ЮТест.ОжидаетЧто(ОшибкаПолучения, "Инициализация настоящей формы сохраненной модели").Равно("");
		ЮТест.ОжидаетЧто(Форма.Открыта()).Равно(Ложь);
		ЮТест.ОжидаетЧто(Форма.НаборИнструментов.Количество()).Равно(4);
		Отметок = 0;
		Для Каждого СтрокаНабора Из Форма.НаборИнструментов Цикл
			Если СтрокаНабора.Использовать Тогда
				Отметок = Отметок + 1;
			КонецЕсли;
		КонецЦикла;
		ЮТест.ОжидаетЧто(Отметок).Равно(ОжидаетсяОтметок);
		ЮТест.ОжидаетЧто(Форма.Объект.НастроитьНаборИнструментов).Равно(Настроить);
	Исключение
		Форма = Неопределено;
		Тесты_КИИ_ФормыМоделейВызовСервера.УдалитьМодельФормы(Модель);
		ВызватьИсключение;
	КонецПопытки;
	Форма = Неопределено;
	Тесты_КИИ_ФормыМоделейВызовСервера.УдалитьМодельФормы(Модель);
КонецПроцедуры

#КонецОбласти

Процедура Чат_ФормаКонтекстаПолучается() Экспорт
	Форма = ПолучитьФорму("Обработка.КИИ_ТестИИ.Форма.Форма");
	ЮТест.ОжидаетЧто(Форма.Открыта()).Равно(Ложь);
	ЮТест.ОжидаетЧто(Форма.ИспользоватьИсторию).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.ИспользоватьЗнания).Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.ИспользоватьВложения).Равно(Истина);
	ЮТест.ОжидаетЧто(СтрДлина(Форма.ИдентификаторДиалога)).Равно(36);
	ЮТест.ОжидаетЧто(Форма.ДиалогЖурнала).Равно(Форма.ИдентификаторДиалога);
	ЮТест.ОжидаетЧто(Форма.ЖурналДиалога.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Форма.ПросмотрГотово).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Форма.ПросмотрСтатус)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Форма.АдресПодготовкиДиалога)).Равно(Ложь);
КонецПроцедуры

Процедура Чат_ДлинныйКонтекстНеУсекается() Экспорт
	Форма = ПолучитьФорму("Обработка.КИИ_ТестИИ.Форма.Форма");
	ЮТест.ОжидаетЧто(Форма.Открыта()).Равно(Ложь);
	ПолныйТекст = "";
	Для Номер = 1 По 30 Цикл
		ПолныйТекст = ПолныйТекст + "Строка полного контекста; конец должен сохраниться." + Символы.ПС;
	КонецЦикла;
	ПолныйТекст = ПолныйТекст + "КОНЕЦ ПРОВЕРЯЕМОГО ТЕКСТА";
	Нарушения = Новый Массив;
	РеквизитыКонтекста = Новый Массив;
	РеквизитыКонтекста.Добавить("АдресПодготовкиДиалога");
	РеквизитыКонтекста.Добавить("ПросмотрСтатус");
	РеквизитыКонтекста.Добавить("ПросмотрПолучатель");
	РеквизитыКонтекста.Добавить("ПросмотрИнструкция");
	РеквизитыКонтекста.Добавить("ПросмотрВопрос");
	РеквизитыКонтекста.Добавить("ПросмотрЗнания");
	РеквизитыКонтекста.Добавить("ПросмотрСообщения");
	РеквизитыКонтекста.Добавить("ПросмотрИнструменты");
	РеквизитыКонтекста.Добавить("ПросмотрВложения");
	РеквизитыКонтекста.Добавить("КонтекстЗаписиДиалога");
	РеквизитыКонтекста.Добавить("СостояниеЗапросаДиалога");
	РеквизитыКонтекста.Добавить("СостояниеЖурналаДиалога");
	Для Каждого ИмяРеквизита Из РеквизитыКонтекста Цикл
		Форма[ИмяРеквизита] = ПолныйТекст;
		Если Форма[ИмяРеквизита] <> ПолныйТекст Тогда
			Нарушения.Добавить(ИмяРеквизита + ":" + Строка(СтрДлина(Форма[ИмяРеквизита])));
		КонецЕсли;
	КонецЦикла;
	СтрокаЖурнала = Форма.ЖурналДиалога.Добавить();
	СтрокаЖурнала.ИнструментыРаунда = ПолныйТекст;
	Если СтрокаЖурнала.ИнструментыРаунда <> ПолныйТекст Тогда
		Нарушения.Добавить("ЖурналДиалога.ИнструментыРаунда:" + Строка(СтрДлина(СтрокаЖурнала.ИнструментыРаунда)));
	КонецЕсли;
	ЮТест.ОжидаетЧто(СтрСоединить(Нарушения, "; "), "Полные тексты формы не должны усекаться").Равно("");
КонецПроцедуры

 
Процедура Чат_ПоказываетОценкуВсейПетли() Экспорт
