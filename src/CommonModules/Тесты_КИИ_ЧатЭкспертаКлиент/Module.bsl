// Инициализирует настоящую управляемую форму, не открывая окно пользователя.
Процедура Форма_ПолучениеБезОткрытия() Экспорт
	Форма = НоваяФормаЧата();
	ЮТест.ОжидаетЧто(Форма.Открыта()).Равно(Ложь);
	ЮТест.ОжидаетЧто(ТипЗнч(Форма.ИспользоватьИнструменты)).Равно(Тип("Булево"));
	ЮТест.ОжидаетЧто(Форма.ИспользоватьИнструменты).Равно(Ложь);
	Форма = Неопределено;
КонецПроцедуры

// Проверяет привязку флажка к булевому реквизиту формы.
Процедура Форма_ФлажокПривязанКРеквизиту() Экспорт
	Форма = НоваяФормаЧата();
	Элемент = Форма.Элементы.Найти("ИспользоватьИнструменты");
	ЮТест.ОжидаетЧто(Элемент.Доступность).Равно(Истина);
	Форма.ИспользоватьИнструменты = Истина;
	ЮТест.ОжидаетЧто(Форма.ИспользоватьИнструменты).Равно(Истина);
	Форма.ИспользоватьИнструменты = Ложь;
	Форма = Неопределено;
КонецПроцедуры

