Процедура ПроверитьПолучениеФормыМодели(Знач Настроить, Знач Выбрать, Знач ОжидаетсяОтметок)
	Модель = Тесты_КИИ_ФормыМоделейВызовСервера.СоздатьМодельФормы(Настроить, Выбрать);
	Форма = Неопределено;
	Попытка
		ОшибкаПолучения = "";
		Попытка
			Форма = ПолучитьФорму("Справочник.КИИ_МоделиИИ.Форма.ФормаЭлемента", Новый Структура("Ключ", Модель));
		Исключение
			ОшибкаПолучения = ИнформацияОбОшибке().Описание;
		КонецПопытки;
		ЮТест.ОжидаетЧто(ОшибкаПолучения, "Инициализация настоящей формы сохраненной модели").Равно("");
		ЮТест.ОжидаетЧто(Форма.Открыта()).Равно(Ложь);
		ЮТест.ОжидаетЧто(Форма.НаборИнструментов.Количество()).Равно(4);
		Отметок = 0;
		Для Каждого СтрокаНабора Из Форма.НаборИнструментов Цикл
			Если СтрокаНабора.Использовать Тогда
				Отметок = Отметок + 1;
			КонецЕсли;
		КонецЦикла;
		ЮТест.ОжидаетЧто(Отметок).Равно(ОжидаетсяОтметок);
		ЮТест.ОжидаетЧто(Форма.Объект.НастроитьНаборИнструментов).Равно(Настроить);
	Исключение
		Форма = Неопределено;
		Тесты_КИИ_ФормыМоделейВызовСервера.УдалитьМодельФормы(Модель);
		ВызватьИсключение;
	КонецПопытки;
	Форма = Неопределено;
	Тесты_КИИ_ФормыМоделейВызовСервера.УдалитьМодельФормы(Модель);
КонецПроцедуры

#КонецОбласти

