#Область ТестыФоновойГенерации

// Форма генератора запускает генерацию фоновым заданием по имени функции модуля обработки: тот же путь,
// что у СгенерироватьДиаграмму, с петлей агент-анализа для моделей с инструментами. Тест исполняет
// ровно эту строку имени и проверяет поля результата, которые разбирает форма. Пустое описание
// отсекается до обращения к модели, поэтому сеть не нужна.
Процедура ФоноваяГенерация_ИмяФункцииФормыИсполняется() Экспорт

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ОписаниеДиаграммы", "");
	ПараметрыЗадания.Вставить("Эксперт",           Справочники.КИИ_ЭкспертыИИ.ПустаяСсылка());

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = Неопределено;

	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработка.КИИ_ГенераторДиаграмм.МодульОбъекта.СгенерироватьКодДиаграммыФоново", ПараметрыЗадания);

	ЮТест.ОжидаетЧто(ФоновоеЗадание.Статус).Равно("Выполнено");
	Результат = ПолучитьИзВременногоХранилища(ФоновоеЗадание.АдресРезультата);
	ЮТест.ОжидаетЧто(Результат.ЭтоОшибка).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Результат.ТекстОшибки, "Не заполнено описание диаграммы")).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.КодДиаграммы).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Содержит(Знач Текст, Знач Фрагмент)

	Возврат СтрНайти(Текст, Фрагмент) > 0;

КонецФункции

