			.ДобавитьСерверныйТест("СтруктураОбъектов_ПодставляетРеальныеПоля")
			.ДобавитьСерверныйТест("СтруктураОбъектов_БезОбъектовПусто")
			.ДобавитьСерверныйТест("ПостроитьHTMLБинарного_PNG_ПравильныйMIME")
			.ДобавитьСерверныйТест("ПостроитьHTMLБинарного_PDF_Embed")
