#КонецОбласти

#Область ТестыИзвлеченияКода

// Из ответа ИИ извлекается код внутри именованного fenced-блока, без обрамления.
Процедура ИзвлечьКод_ИзИменованногоБлока() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ОтветИИ = "Вот диаграмма:" + Символы.ПС
		+ "```plantuml" + Символы.ПС
		+ "@startuml" + Символы.ПС
		+ "A->B" + Символы.ПС
		+ "@enduml" + Символы.ПС
		+ "```";

	Код = Обработка.ИзвлечьКодИзОтветаИИ(ОтветИИ);

	ЮТест.ОжидаетЧто(Содержит(Код, "@startuml")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "```")).Равно(Ложь);

КонецПроцедуры

// Из безымянного fenced-блока (нераспознанный язык-токен) код извлекается без
// хвостового закрывающего ``` и текста после него. Регрессия на СтрНайти(…, "")
// (пустой маркер конца), из-за которого хвост блока оставался в коде.
Процедура ИзвлечьКод_ИзБезымянногоБлока() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ОтветИИ = "Вот схема:" + Символы.ПС
		+ "```mmd" + Символы.ПС
		+ "graph TD" + Символы.ПС
		+ "A-->B" + Символы.ПС
		+ "```" + Символы.ПС
		+ "Готово, отрисуй.";

	Код = Обработка.ИзвлечьКодИзОтветаИИ(ОтветИИ);

	ЮТест.ОжидаетЧто(Содержит(Код, "graph TD")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "A-->B")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "```")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Содержит(Код, "Готово")).Равно(Ложь);

КонецПроцедуры

// Ломалка: без ограждения блоком ``` модель дописывает пояснение после кода, а разбор по маркеру
// забирал текст до конца ответа - проза уезжала в диаграмму, и сервис рендеринга отвечал ошибкой синтаксиса.
Процедура ИзвлечьКод_ПрозаПослеКодаОтбрасывается() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ОтветИИ = "graph TD" + Символы.ПС
		+ "    Журнал[Журнал ошибок] -->|хеш| Статистика[Статистика]" + Символы.ПС
		+ "    Статистика --> Дашборд[Дашборд ошибок]" + Символы.ПС
		+ Символы.ПС
		+ "Добавим, возможно, связь между журналом и логом запросов.";

	Код = Обработка.ИзвлечьКодИзОтветаИИ(ОтветИИ);

	ЮТест.ОжидаетЧто(Содержит(Код, "graph TD")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "Дашборд ошибок")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "Добавим")).Равно(Ложь);

КонецПроцедуры

// Ломалка: в erDiagram поля внутри блока («string ХешОшибки») не содержат знаков связей, и отбрасывание
// пояснений рубило код на первом же поле. Внутри фигурных скобок строки берутся целиком.
Процедура ИзвлечьКод_ДиаграммаСБлокамиПолей() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ОтветИИ = "erDiagram" + Символы.ПС
		+ "    КИИ_МониторингОшибокЖурнал {" + Символы.ПС
		+ "        string ХешОшибки" + Символы.ПС
		+ "        int КоличествоПовторений" + Символы.ПС
		+ "    }" + Символы.ПС
		+ "    КИИ_МониторингОшибокЖурнал ||--|| КИИ_МониторингОшибокСтатистика : ""ХешОшибки""" + Символы.ПС
		+ Символы.ПС
		+ "Такая схема отражает связи регистров.";

	Код = Обработка.ИзвлечьКодИзОтветаИИ(ОтветИИ);

	ЮТест.ОжидаетЧто(Содержит(Код, "string ХешОшибки")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "КоличествоПовторений")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "||--||")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "Такая схема")).Равно(Ложь);

КонецПроцедуры

// Человек пишет «покажи связи регистра», а не перечисляет поля руками: структуру объекта генератор
// берет из конфигурации сам и кладет в промпт.
Процедура СтруктураОбъектов_ПодставляетРеальныеПоля() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Блок = Обработка.СтруктураУпомянутыхОбъектов(
		"Покажи связи РегистрСведений.КИИ_МониторингОшибокЖурнал и Справочник.КИИ_МоделиИИ");

	ЮТест.ОжидаетЧто(Содержит(Блок, "КИИ_МониторингОшибокЖурнал")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Блок, "ХешОшибки")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Блок, "КоличествoПовторений")).Равно(Ложь);
	ЮТест.ОжидаетЧто(Содержит(Блок, "КоличествоПовторений")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Блок, "КИИ_МоделиИИ")).Равно(Истина);

КонецПроцедуры

// Обычное описание без имен объектов конфигурации структуру не подмешивает.
Процедура СтруктураОбъектов_БезОбъектовПусто() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Блок = Обработка.СтруктураУпомянутыхОбъектов("Нарисуй процесс приемки товара на склад");

	ЮТест.ОжидаетЧто(ПустаяСтрока(Блок)).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыПостроенияHTML

// PNG-результат встраивается через data URI с MIME image/png, а не svg+xml.
Процедура ПостроитьHTMLБинарного_PNG_ПравильныйMIME() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Данные = ПолучитьДвоичныеДанныеИзСтроки("PNGBYTES", КодировкаТекста.UTF8);
	HTML = Обработка.ПостроитьHTMLДляПросмотраБинарного(Данные, "png");

	ЮТест.ОжидаетЧто(Содержит(HTML, "data:image/png;base64,")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(HTML, "data:image/svg+xml")).Равно(Ложь);

КонецПроцедуры

// PDF-результат встраивается тегом embed с MIME application/pdf.
Процедура ПостроитьHTMLБинарного_PDF_Embed() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Данные = ПолучитьДвоичныеДанныеИзСтроки("PDFBYTES", КодировкаТекста.UTF8);
