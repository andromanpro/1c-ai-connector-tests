// @strict-types

#Область ПрограммныйИнтерфейс

// Регистрация тестов YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ГенераторДиаграмм")
			.ДобавитьСерверныйТест("ВидДиаграммы_PlantUML")
			.ДобавитьСерверныйТест("ВидДиаграммы_GraphViz")
			.ДобавитьСерверныйТест("ВидДиаграммы_Mermaid")
			.ДобавитьСерверныйТест("ВидДиаграммы_ПоУмолчаниюMermaid")
			.ДобавитьСерверныйТест("ГотовыйКод_PlantUML_Истина")
			.ДобавитьСерверныйТест("ГотовыйКод_ПростойТекст_Ложь")
			.ДобавитьСерверныйТест("ИзвлечьКод_ИзИменованногоБлока")
			.ДобавитьСерверныйТест("РазобратьURL_HTTPS_ПортПоУмолчанию443")
			.ДобавитьСерверныйТест("РазобратьURL_HTTPСЯвнымПортом");

КонецПроцедуры

#КонецОбласти

#Область ТестыОпределенияВида

// PlantUML определяется по @startuml.
Процедура ВидДиаграммы_PlantUML() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ЮТест.ОжидаетЧто(Обработка.ОпределитьВидДиаграммы("@startuml A->B @enduml")).Равно("plantuml");

КонецПроцедуры

// GraphViz определяется по digraph.
Процедура ВидДиаграммы_GraphViz() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ЮТест.ОжидаетЧто(Обработка.ОпределитьВидДиаграммы("digraph G { a -> b }")).Равно("graphviz");

КонецПроцедуры

// Mermaid определяется по graph TD.
Процедура ВидДиаграммы_Mermaid() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ЮТест.ОжидаетЧто(Обработка.ОпределитьВидДиаграммы("graph TD; A-->B")).Равно("mermaid");

КонецПроцедуры

// Неопознанный код по умолчанию считается Mermaid.
Процедура ВидДиаграммы_ПоУмолчаниюMermaid() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ЮТест.ОжидаетЧто(Обработка.ОпределитьВидДиаграммы("непонятное описание словами")).Равно("mermaid");

КонецПроцедуры

#КонецОбласти

#Область ТестыГотовностиКода

// Код PlantUML распознаётся как готовый код диаграммы.
Процедура ГотовыйКод_PlantUML_Истина() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ГотовыйКод = "@startuml" + Символы.ПС + "A->B" + Символы.ПС + "@enduml";

	ЮТест.ОжидаетЧто(Обработка.ЭтоГотовыйКодДиаграммы(ГотовыйКод)).Равно(Истина);

КонецПроцедуры

// Обычное текстовое задание не является готовым кодом.
Процедура ГотовыйКод_ПростойТекст_Ложь() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ЮТест.ОжидаетЧто(Обработка.ЭтоГотовыйКодДиаграммы("нарисуй схему процесса продаж")).Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ТестыИзвлеченияКода

// Из ответа ИИ извлекается код внутри именованного fenced-блока, без обрамления.
Процедура ИзвлечьКод_ИзИменованногоБлока() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	ОтветИИ = "Вот диаграмма:" + Символы.ПС
		+ "```plantuml" + Символы.ПС
		+ "@startuml" + Символы.ПС
		+ "A->B" + Символы.ПС
		+ "@enduml" + Символы.ПС
		+ "```";

	Код = Обработка.ИзвлечьКодИзОтветаИИ(ОтветИИ);

	ЮТест.ОжидаетЧто(Содержит(Код, "@startuml")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(Код, "```")).Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ТестыРазбораURL

// https без явного порта -> порт 443, защищённое соединение.
Процедура РазобратьURL_HTTPS_ПортПоУмолчанию443() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Результат = Обработка.РазобратьURL("https://kroki.io");

	ЮТест.ОжидаетЧто(Результат.Хост).Равно("kroki.io");
	ЮТест.ОжидаетЧто(Результат.Порт).Равно(443);
	ЮТест.ОжидаетЧто(Результат.Защищенное).Равно(Истина);

КонецПроцедуры

// http с явным портом -> этот порт, соединение не защищённое.
Процедура РазобратьURL_HTTPСЯвнымПортом() Экспорт

	Обработка = Обработки.КИИ_ГенераторДиаграмм.Создать();

	Результат = Обработка.РазобратьURL("http://192.168.31.189:8000");

	ЮТест.ОжидаетЧто(Результат.Порт).Равно(8000);
	ЮТест.ОжидаетЧто(Результат.Защищенное).Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Содержит(Знач Текст, Знач Фрагмент)

	Возврат СтрНайти(Текст, Фрагмент) > 0;

КонецФункции

#КонецОбласти
