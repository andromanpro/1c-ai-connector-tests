#Область ТестыЭкранированияHTML

// Угловые скобки заменяются на HTML-сущности.
Процедура Экранирование_УгловыеСкобки() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("<script>");

	ЮТест.ОжидаетЧто(Результат).Равно("&lt;script&gt;");

КонецПроцедуры

// Амперсанд экранируется ПЕРВЫМ, иначе последующие сущности удвоятся.
Процедура Экранирование_АмперсандПервымВПорядке() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("&<");

	ЮТест.ОжидаетЧто(Результат).Равно("&amp;&lt;");

КонецПроцедуры

// Двойные кавычки заменяются на &quot;.
Процедура Экранирование_Кавычки() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("""x""");

	ЮТест.ОжидаетЧто(Результат).Равно("&quot;x&quot;");

КонецПроцедуры

// Апостроф заменяется на &#39;.
Процедура Экранирование_Апостроф() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("it's");

	ЮТест.ОжидаетЧто(Результат).Равно("it&#39;s");

КонецПроцедуры

// Комбинированный XSS-вектор экранируется полностью.
Процедура Экранирование_XSSПример() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("<script>alert('XSS')</script>");

	ЮТест.ОжидаетЧто(Результат).Равно("&lt;script&gt;alert(&#39;XSS&#39;)&lt;/script&gt;");

КонецПроцедуры

// Пустая строка возвращается без изменений.
Процедура Экранирование_ПустаяСтрокаБезИзменений() Экспорт

	Результат = КИИ_МаркдаунПарсерКлиентСервер.ЭкранироватьHTML("");

	ЮТест.ОжидаетЧто(Результат).Равно("");

КонецПроцедуры

#КонецОбласти

#Область ТестыОпределенияМаркдаун

// Пустая строка не является Markdown.
Процедура ЭтоМаркдаун_ПустаяСтрока_Ложь() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("")).Равно(Ложь);

КонецПроцедуры

// Обычный текст без разметки не является Markdown.
Процедура ЭтоМаркдаун_ОбычныйТекст_Ложь() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("Просто текст без всякой разметки")).Равно(Ложь);

КонецПроцедуры

// Строгий маркер блока кода (тройной бэктик) распознаётся как Markdown.
Процедура ЭтоМаркдаун_БлокКода_Истина() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("```bsl")).Равно(Истина);

КонецПроцедуры

// Строгий маркер ссылки ](http распознаётся как Markdown.
Процедура ЭтоМаркдаун_Ссылка_Истина() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("смотри [тут](http://x)")).Равно(Истина);

КонецПроцедуры

// Строгий маркер разделителя таблицы |--- распознаётся как Markdown.
Процедура ЭтоМаркдаун_РазделительТаблицы_Истина() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("|---|")).Равно(Истина);

КонецПроцедуры

// Балльная эвристика: жирный (**) + инлайн-код (``) дают >= 2 балла.
Процедура ЭтоМаркдаун_ЖирныйИИнлайнКод_Истина() Экспорт

	ЮТест.ОжидаетЧто(КИИ_МаркдаунПарсерКлиентСервер.ЭтоMarkdown("**жирный** и `код`")).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ТестыПреобразованияВHTML

// Заголовок первого уровня оборачивается в <h1>.
Процедура Преобразование_Заголовок1Уровня() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("# Привет");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<h1>Привет</h1>")).Равно(Истина);

КонецПроцедуры

// Заголовок третьего уровня оборачивается в <h3>.
Процедура Преобразование_Заголовок3Уровня() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("### Три");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<h3>Три</h3>")).Равно(Истина);

КонецПроцедуры

// Двойная звёздочка -> <strong>.
Процедура Преобразование_Жирный() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("**жирный**");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<strong>жирный</strong>")).Равно(Истина);

КонецПроцедуры

// Одинарная звёздочка -> <em>.
Процедура Преобразование_Курсив() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("*курсив*");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<em>курсив</em>")).Равно(Истина);

КонецПроцедуры

// Двойная тильда -> <del>.
Процедура Преобразование_Зачёркнутый() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("~~зачёркнуто~~");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<del>зачёркнуто</del>")).Равно(Истина);

КонецПроцедуры

// Тройная звёздочка -> вложенные <strong><em>.
Процедура Преобразование_ЖирныйКурсив() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("***оба***");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<strong><em>оба</em></strong>")).Равно(Истина);

КонецПроцедуры

// Строка из трёх дефисов -> <hr>.
Процедура Преобразование_ГоризонтальнаяЛиния() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("---");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<hr>")).Равно(Истина);

КонецПроцедуры

// Блок кода без языка -> <pre><code>.
Процедура Преобразование_БлокКодаБезЯзыка() Экспорт

	Исходник = "```" + Символы.ПС + "код" + Символы.ПС + "```";
	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML(Исходник);

	ЮТест.ОжидаетЧто(Содержит(HTML, "<pre><code>код")).Равно(Истина);

КонецПроцедуры

// Блок кода с языком -> class="language-...".
Процедура Преобразование_БлокКодаСЯзыком() Экспорт

	Исходник = "```bsl" + Символы.ПС + "Сообщить();" + Символы.ПС + "```";
	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML(Исходник);

	ЮТест.ОжидаетЧто(Содержит(HTML, "class=""language-bsl""")).Равно(Истина);

КонецПроцедуры

// Содержимое заголовка экранируется (защита от инъекции HTML в заголовок).
Процедура Преобразование_ЗаголовокЭкранируетHTML() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("# <b>");

	ЮТест.ОжидаетЧто(Содержит(HTML, "<h1>&lt;b&gt;</h1>")).Равно(Истина);

КонецПроцедуры

// Два блока кода: короткий первый не должен ломать обработку второго (регресс #458).
Процедура Преобразование_ДваБлокаКода_ОбаОбработаны() Экспорт

	Исходник = "```" + Символы.ПС + "первый" + Символы.ПС + "```"
		+ Символы.ПС + "текст между" + Символы.ПС
		+ "```" + Символы.ПС + "второй" + Символы.ПС + "```";
	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML(Исходник);

	ЮТест.ОжидаетЧто(Содержит(HTML, "<pre><code>первый")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(HTML, "<pre><code>второй")).Равно(Истина);

КонецПроцедуры

// Сырой HTML в plain-тексте экранируется (регресс #96, XSS из ответа LLM).
Процедура Преобразование_ЭкранируетСыройHTML() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("Текст <script>alert(1)</script> тут");

	ЮТест.ОжидаетЧто(Содержит(HTML, "&lt;script&gt;")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(HTML, "<script>")).Равно(Ложь);

КонецПроцедуры

// #15 (аудит P2): title у ссылок не парсился — искалась сырая кавычка, а вход уже экранирован (&quot;).
Процедура Преобразование_СсылкаСПодсказкой_TitleВHTML() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("[текст](http://example.com ""подсказка"")");

	ЮТест.ОжидаетЧто(Содержит(HTML, "title=""подсказка""")).Равно(Истина);
	ЮТест.ОжидаетЧто(Содержит(HTML, "href=""http://example.com""")).Равно(Истина);

КонецПроцедуры

// #16 (аудит P2): одиночная "]" (напр. [1]) обрывала поиск ВСЕХ последующих ссылок.
Процедура Преобразование_ОдиночнаяСкобкаНеРвётПоследующиеСсылки() Экспорт

	HTML = КИИ_МаркдаунПарсерКлиентСервер.ПреобразоватьВHTML("см [1] и [текст](http://example.com)");

	ЮТест.ОжидаетЧто(Содержит(HTML, "href=""http://example.com""")).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает Истина, если Фрагмент входит в Текст.
Функция Содержит(Знач Текст, Знач Фрагмент)

	Возврат СтрНайти(Текст, Фрагмент) > 0;

КонецФункции

#КонецОбласти
