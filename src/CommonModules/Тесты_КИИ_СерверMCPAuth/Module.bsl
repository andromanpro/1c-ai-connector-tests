// Проверяет закрытый доступ, если администратор еще не настроил credentials.
Процедура Auth_CredentialsНеНастроены_Возвращает_credentials_not_configured() Экспорт
	
	Если ЗначениеЗаполнено(Константы.КИИ_СерверMCPПользовательAPI.Получить()) Тогда
		ЮТест.Пропустить(НСтр("ru = 'КИИ_СерверMCPПользовательAPI уже заполнена в тестовой базе'"));
	КонецЕсли;
	
	Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(BasicAuthЗаголовок("user:pass"));
	
	ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.Пользователь).Равно("user");
	ЮТест.ОжидаетЧто(Результат.Причина).Равно("credentials_not_configured");
	
КонецПроцедуры

// Проверяет, что аудит пишет все поля в регистр сведений.
Процедура Аудит_ЗаписьВРегистр_СодержитВсеПоля() Экспорт
	
	IDЗапроса = "req-1";
	
	КИИ_СерверMCPАудит.ЗаписатьВызов("test-user", "tools/list", "{}", "ok", IDЗапроса);
	
	ЗаписьАудита = НайтиЗаписьАудита(IDЗапроса);
	
	ЮТест.ОжидаетЧто(ЗаписьАудита.Следующий()).Равно(Истина);
	ЮТест.ОжидаетЧто(ЗаписьАудита.Идентификатор).Заполнено();
	ЮТест.ОжидаетЧто(ЗаписьАудита.ДатаВызова).Заполнено();
	ЮТест.ОжидаетЧто(ЗаписьАудита.Вызывающий).Равно("test-user");
	ЮТест.ОжидаетЧто(ЗаписьАудита.Метод).Равно("tools/list");
	ЮТест.ОжидаетЧто(СтрДлина(ЗаписьАудита.ХешПараметров)).Равно(64);
	ЮТест.ОжидаетЧто(ЗаписьАудита.ХешПараметров).Равно(НРег(ЗаписьАудита.ХешПараметров));
	ЮТест.ОжидаетЧто(ЭтоHexСтрока(ЗаписьАудита.ХешПараметров)).Равно(Истина);
	ЮТест.ОжидаетЧто(ЗаписьАудита.Результат).Равно("ok");
	ЮТест.ОжидаетЧто(ЗаписьАудита.IDЗапроса).Равно(IDЗапроса);
	
	УдалитьЗаписьАудита(ЗаписьАудита.Идентификатор);
	
КонецПроцедуры

// ПОЗИТИВНЫЙ: верные юзер и пароль → авторизован (страхует SHA-256-рефакторинг сравнения).
Процедура Auth_ВерныйЮзерИПароль_Авторизован() Экспорт

	Сохраненные = СохранитьКреды();
	Попытка
		УстановитьКреды("mcp-test-user", "S3cure-Test-Pass-9137");

		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(BasicAuthЗаголовок("mcp-test-user:S3cure-Test-Pass-9137"));

		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Истина);
		ЮТест.ОжидаетЧто(Результат.Причина).Равно("ok");
		ЮТест.ОжидаетЧто(Результат.Пользователь).Равно("mcp-test-user");
	Исключение
		ВосстановитьКреды(Сохраненные);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКреды(Сохраненные);

КонецПроцедуры

// НЕГАТИВНЫЙ: верный юзер, неверный пароль той же длины → отклонен.
Процедура Auth_НеверныйПароль_Отклонен() Экспорт

	Сохраненные = СохранитьКреды();
	Попытка
		УстановитьКреды("mcp-test-user", "S3cure-Test-Pass-9137");

		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(BasicAuthЗаголовок("mcp-test-user:S3cure-Test-Pass-0000"));

		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
		ЮТест.ОжидаетЧто(Результат.Причина).Равно("wrong_password");
	Исключение
		ВосстановитьКреды(Сохраненные);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКреды(Сохраненные);

КонецПроцедуры

// НЕГАТИВНЫЙ (страховка тайминг-фикса): неверный пароль ДРУГОЙ длины → все равно отклонен.
// Прежний код рано выходил по разной длине; новый хеширует обе строки (64 hex) и обязан
// так же вернуть Ложь, не «пропустив» из-за иной длины.
Процедура Auth_НеверныйПарольДругойДлины_Отклонен() Экспорт

	Сохраненные = СохранитьКреды();
	Попытка
		УстановитьКреды("mcp-test-user", "S3cure-Test-Pass-9137");

		Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth(BasicAuthЗаголовок("mcp-test-user:x"));

		ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
		ЮТест.ОжидаетЧто(Результат.Причина).Равно("wrong_password");
	Исключение
		ВосстановитьКреды(Сохраненные);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьКреды(Сохраненные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СохранитьКреды()

	Сохраненные = Новый Структура;
	Сохраненные.Вставить("Пользователь", Константы.КИИ_СерверMCPПользовательAPI.Получить());
	Попытка
		Сохраненные.Вставить("Пароль", ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
			"КИИ_СерверMCPПользовательAPI", "Пароль"));
	Исключение
		Сохраненные.Вставить("Пароль", Неопределено);
	КонецПопытки;
	Возврат Сохраненные;

КонецФункции

Процедура УстановитьКреды(Знач Пользователь, Знач Пароль)

	КонстантаМенеджер = Константы.КИИ_СерверMCPПользовательAPI.СоздатьМенеджерЗначения();
	КонстантаМенеджер.Значение = Пользователь;
	КонстантаМенеджер.Записать();
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("КИИ_СерверMCPПользовательAPI", Пароль, "Пароль");

КонецПроцедуры

Процедура ВосстановитьКреды(Знач Сохраненные)

	КонстантаМенеджер = Константы.КИИ_СерверMCPПользовательAPI.СоздатьМенеджерЗначения();
	КонстантаМенеджер.Значение = Сохраненные.Пользователь;
	КонстантаМенеджер.Записать();
	Если Сохраненные.Пароль = Неопределено Тогда
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("КИИ_СерверMCPПользовательAPI", "Пароль");
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("КИИ_СерверMCPПользовательAPI", Сохраненные.Пароль, "Пароль");
	КонецЕсли;

КонецПроцедуры

Функция BasicAuthЗаголовок(Знач УчетныеДанные)
	
	ДанныеЗаголовка = ПолучитьДвоичныеДанныеИзСтроки(УчетныеДанные, КодировкаТекста.UTF8);
	Возврат "Basic " + Base64Строка(ДанныеЗаголовка);
	
КонецФункции

Функция ЭтоHexСтрока(Знач ПроверяемаяСтрока)
	
	Если СтрДлина(ПроверяемаяСтрока) <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДопустимыеСимволы = "0123456789abcdef";
	
	Для Индекс = 1 По СтрДлина(ПроверяемаяСтрока) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(ПроверяемаяСтрока, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиЗаписьАудита(Знач IDЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Аудит.Идентификатор КАК Идентификатор,
	|	Аудит.Дата КАК ДатаВызова,
	|	Аудит.Вызывающий КАК Вызывающий,
	|	Аудит.Метод КАК Метод,
	|	Аудит.ХешПараметров КАК ХешПараметров,
	|	Аудит.Результат КАК Результат,
	|	Аудит.IDЗапроса КАК IDЗапроса
	|ИЗ
	|	РегистрСведений.КИИ_СерверMCPАудитВызовов КАК Аудит
	|ГДЕ
	|	Аудит.IDЗапроса = &IDЗапроса
	|	И Аудит.Вызывающий = &Вызывающий
	|	И Аудит.Метод = &Метод
	|УПОРЯДОЧИТЬ ПО
	|	Аудит.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("IDЗапроса", IDЗапроса);
	Запрос.УстановитьПараметр("Вызывающий", "test-user");
	Запрос.УстановитьПараметр("Метод", "tools/list");
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

Процедура УдалитьЗаписьАудита(Знач ИдентификаторЗаписи)
	
	МенеджерЗаписи = РегистрыСведений.КИИ_СерверMCPАудитВызовов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = ИдентификаторЗаписи;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Удалить();
	
КонецПроцедуры

