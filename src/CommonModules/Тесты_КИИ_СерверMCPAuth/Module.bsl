// Проверяет отказ без заголовка Authorization.
Процедура Auth_БезЗаголовка_Возвращает_no_header() Экспорт
	
	Результат = КИИ_СерверMCPAuth.ПроверитьBasicAuth("");
	
	ЮТест.ОжидаетЧто(Результат.Авторизован).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.Пользователь).Равно("");
	ЮТест.ОжидаетЧто(Результат.Причина).Равно("no_header");
	
КонецПроцедуры

